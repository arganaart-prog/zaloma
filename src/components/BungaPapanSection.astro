---
import type { Product } from '../data/products';
import CategoryProductCard from './CategoryProductCard.astro';
import { withBase } from '../utils/paths';
import { getHomeBungaPapanProducts } from '../utils/productHelpers';

interface Props {
  allProducts?: any[];
  cityName?: string;
  citySlug?: string;
  hideWhenEmpty?: boolean;
  categorySlug?: string;
}

const {
  allProducts = [],
  cityName = 'Malang',
  citySlug = '',
  hideWhenEmpty = false,
  categorySlug = 'bunga-papan',
} = Astro.props;

const dukaCitaProducts = getHomeBungaPapanProducts(allProducts, `${categorySlug}--duka-cita`);
const weddingProducts = getHomeBungaPapanProducts(allProducts, `${categorySlug}--wedding`);
const congratulationsProducts = getHomeBungaPapanProducts(allProducts, `${categorySlug}--congratulations`);
const hasAnyProducts =
  dukaCitaProducts.length > 0 || weddingProducts.length > 0 || congratulationsProducts.length > 0;

const withCityQuery = (href: string) =>
  citySlug ? `${href}?city=${citySlug}&refer=city` : href;

interface Tab {
  id: string;
  label: string;
  products: Product[];
  categoryHref: string;
}

const tabs: Tab[] = [
  {
    id: 'duka-cita',
    label: 'Duka Cita',
    products: dukaCitaProducts,
    categoryHref: withCityQuery(`/kategori/${dukaCitaProducts[0]?.categorySlug || `${categorySlug}--duka-cita`}/`),
  },
  {
    id: 'wedding',
    label: 'Wedding',
    products: weddingProducts,
    categoryHref: withCityQuery(`/kategori/${weddingProducts[0]?.categorySlug || `${categorySlug}--wedding`}/`),
  },
  {
    id: 'congratulations',
    label: 'Congratulations',
    products: congratulationsProducts,
    categoryHref: withCityQuery(`/kategori/${congratulationsProducts[0]?.categorySlug || `${categorySlug}--congratulations`}/`),
  },
];

if (hideWhenEmpty && !hasAnyProducts) {
  return;
}
---

<section class="py-20 bg-accent-bg/40 border-y border-soft-cream/60" id="bunga-papan-ucapan">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section Header -->
    <div class="text-center max-w-2xl mx-auto mb-10">
      <h2 class="font-serif text-3xl sm:text-4xl font-bold text-slate-800">Bunga Papan {cityName}</h2>
      <p class="text-slate-500 text-sm mt-3 leading-relaxed">
        Selesai 3–4 jam, difoto sebelum diantar ke lokasi.
      </p>
    </div>

    <!-- Tab Navigation -->
    <div
      class="flex flex-wrap justify-center gap-3 mb-12"
      role="tablist"
      aria-label="Kategori bunga papan"
      data-bunga-papan-tabs
    >
      {tabs.map((tab, index) => (
        <button
          type="button"
          role="tab"
          id={`tab-${tab.id}`}
          aria-controls={`panel-${tab.id}`}
          aria-selected={index === 0 ? 'true' : 'false'}
          data-tab={tab.id}
          class:list={[
            'bunga-papan-tab px-6 py-2 rounded-full text-sm font-semibold transition-all duration-300 cursor-pointer border min-h-[44px] inline-flex items-center justify-center',
            index === 0
              ? 'bg-primary text-white border-primary shadow-md'
              : 'bg-white text-slate-500 border-soft-cream/80 hover:text-primary hover:border-primary/40',
          ]}
        >
          {tab.label}
        </button>
      ))}
    </div>

    <!-- Tab Panels -->
    <div data-bunga-papan-panels>
      {tabs.map((tab, index) => (
        <div
          id={`panel-${tab.id}`}
          role="tabpanel"
          aria-labelledby={`tab-${tab.id}`}
          data-panel={tab.id}
          class:list={['bunga-papan-panel', index !== 0 && 'hidden']}
        >
          <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4 sm:gap-6">
            {tab.products.length > 0 ? (
              tab.products.slice(0, 8).map((product, productIndex) => (
                <CategoryProductCard product={product} aspect="aspect-square" priority={index === 0 && productIndex < 2} />
              ))
            ) : (
              <div class="col-span-full py-12 text-center text-slate-400 text-xs">
                <svg class="w-6 h-6 animate-spin mx-auto text-primary mb-2 opacity-80" fill="none" viewBox="0 0 24 24">
                  <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                  <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
                </svg>
                Memuat bunga papan {tab.label}...
              </div>
            )}
          </div>

          <!-- View all link -->
          <div class="text-center mt-10">
            <a
              href={withBase(tab.categoryHref)}
              class="inline-flex items-center text-sm font-semibold text-primary hover:text-secondary transition-colors group"
            >
              Lihat Semua {tab.label}
              <svg class="h-4 w-4 ml-1.5 transform group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
              </svg>
            </a>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  function initBungaPapanTabs() {
    const tabContainers = document.querySelectorAll('[data-bunga-papan-tabs]');
    tabContainers.forEach((container) => {
      const tabs = container.querySelectorAll<HTMLButtonElement>('.bunga-papan-tab');
      const section = container.closest('section');
      if (!section) return;
      const panels = section.querySelectorAll<HTMLElement>('.bunga-papan-panel');

      tabs.forEach((tab) => {
        tab.addEventListener('click', () => {
          const targetId = tab.dataset.tab;
          if (!targetId) return;

          // Update tabs state
          tabs.forEach((t) => {
            const isSelected = t === tab;
            t.setAttribute('aria-selected', isSelected ? 'true' : 'false');
            if (isSelected) {
              t.classList.remove('bg-white', 'text-slate-500', 'border-soft-cream/80', 'hover:text-primary', 'hover:border-primary/40');
              t.classList.add('bg-primary', 'text-white', 'border-primary', 'shadow-md');
            } else {
              t.classList.remove('bg-primary', 'text-white', 'border-primary', 'shadow-md');
              t.classList.add('bg-white', 'text-slate-500', 'border-soft-cream/80', 'hover:text-primary', 'hover:border-primary/40');
            }
          });

          // Update panels state
          panels.forEach((panel) => {
            if (panel.dataset.panel === targetId) {
              panel.classList.remove('hidden');
            } else {
              panel.classList.add('hidden');
            }
          });
        });
      });
    });
  }

  initBungaPapanTabs();
  document.addEventListener('astro:page-load', initBungaPapanTabs);
</script>
