---
// Navbar.astro
import { WHATSAPP_NUMBER } from '../data/constants';
import { CATEGORIES } from '../data/products';
import { stripBase, withBase } from '../utils/paths';

const navItems = [
  { href: '/', label: 'Beranda' },
  { href: '/katalog/', label: 'Kategori', hasDropdown: true },
  { href: '/cara-pesan/', label: 'Cara Pesan' },
  { href: '/tentang/', label: 'Tentang Kami' },
  { href: '/kontak/', label: 'Kontak' }
];

const bungaPapanCategories = CATEGORIES.filter((category) => category.slug.startsWith('bunga-papan-'));
const otherCategories = CATEGORIES.filter((category) => !category.slug.startsWith('bunga-papan-'));
const bungaPapanParentHref = '/katalog/?search=bunga%20papan';
const shortBungaPapanName = (name: string) => name.replace('Bunga Papan ', '');
const currentPath = stripBase(Astro.url.pathname);
const isMobileHome = currentPath === '/';
const isMobileKatalog = currentPath.startsWith('/katalog/') || currentPath.startsWith('/kategori/') || currentPath.startsWith('/produk/');
const isMobileCaraPesan = currentPath.startsWith('/cara-pesan/');
const isMobileArtikel = currentPath.startsWith('/artikel/');
const isMobileTentang = currentPath.startsWith('/tentang/');
const isMobileKontak = currentPath.startsWith('/kontak/');
const isMobileFaq = currentPath.startsWith('/faq/');
---

<!-- ============================================= -->
<!-- DESKTOP NAVBAR (Two rows, shown on md and up) -->
<!-- ============================================= -->

<!-- Row 1: Brand, Search, & WhatsApp Button (Primary Theme Green) -->
<div class="relative z-[90] hidden md:block bg-primary border-b border-white/10 px-4 lg:px-8">
      <div class="max-w-7xl mx-auto flex items-center justify-between h-24 md:h-28">
        
        <!-- Logo & Brand Name -->
        <div class="flex items-center">
          <div class="flex-shrink-0 flex items-center relative h-24 md:h-28">
            <!-- Absolute shield hanging down -->
            <div class="absolute left-0 top-0 w-24 sm:w-26 md:w-28 h-28 sm:h-30 md:h-32 z-[100]">
              <a href={withBase('/')} class="brand-shield block w-full h-full relative group" id="logo-shield">
                <!-- SVG Shield Background with warm cream color #FDF7F7 and gold lines -->
                <svg width="100" height="115" class="absolute inset-0 w-full h-full drop-shadow-[0_4px_8px_rgba(0,0,0,0.15)] transition-transform duration-300 group-hover:scale-105" viewBox="0 0 100 115" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M0 0 H100 V55 C100 88 50 115 50 115 C50 115 0 88 0 55 Z" fill="#FDF7F7"/>
                </svg>
                <!-- Brand Logo Centered -->
                <div class="absolute inset-0 flex items-center justify-center pb-3 md:pb-4">
                  <img 
                    src={withBase('/images/logo/zaloma-logo.webp')} 
                    alt="Logo Zaloma Florist" 
                    class="h-14 sm:h-16 md:h-20 w-auto scale-[1.15] object-contain transition-transform duration-300 group-hover:scale-125"
                    width={64}
                    height={62}
                    loading="eager"
                    decoding="async"
                    fetchpriority="high"
                  />
                </div>
              </a>
            </div>
            <!-- Spacer for logo layout so the brand text starts after the logo -->
            <div class="w-22 sm:w-24 md:w-28 flex-shrink-0"></div>
          </div>

          <!-- Brand Text -->
          <div class="ml-4 md:ml-6 flex flex-col justify-center text-white select-none">
            <span class="font-serif text-2xl sm:text-3xl md:text-4xl font-bold tracking-wide leading-none">Zaloma Florist</span>
            <span class="text-[11px] sm:text-xs md:text-sm text-white/80 font-medium font-sans mt-2 tracking-wide leading-none">Florist Terbaik di Malang &mdash; 11 Tahun Pengalaman</span>
          </div>
        </div>

        <!-- Search Bar (Pill-shaped, aligned to the right) -->
        <div class="w-full max-w-[280px] lg:max-w-[340px] ml-auto mr-6 lg:mr-8">
          <form action={withBase('/katalog/')} method="GET" class="relative w-full">
            <input 
              type="text" 
              name="search"
              maxlength="80"
              autocomplete="off"
              placeholder="Cari produk bunga..." 
              class="search-input-field w-full px-5 py-3 pr-12 rounded-full border border-white/20 bg-white/10 text-white text-sm placeholder-white/60 focus:outline-none focus:ring-2 focus:ring-secondary/50 focus:border-secondary focus:bg-white/20 transition-all"
            />
            <button type="submit" aria-label="Cari" class="absolute right-4 top-1/2 -translate-y-1/2 text-white/70 hover:text-secondary transition-colors cursor-pointer">
              <svg width="16" height="16" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
              </svg>
            </button>
          </form>
        </div>

        <!-- WhatsApp Call to Action (Gold Button) -->
        <div class="flex-shrink-0">
          <a 
            href={`https://wa.me/${WHATSAPP_NUMBER}?text=Halo%20Zaloma%20Florist,%20saya%20ingin%20tanya%20mengenai%20layanan%20pemesanan%20bunga%20di%20Malang.`} 
            target="_blank" 
            rel="noopener noreferrer" 
            class="inline-flex items-center gap-2 px-5 py-3 rounded-full bg-secondary hover:bg-secondary-dark text-xs font-bold text-white transition-all duration-300 shadow-md hover:shadow-lg hover:-translate-y-0.5"
          >
            <svg width="16" height="16" class="h-4 w-4 shrink-0 text-white" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946C.06 5.348 5.397.01 12.008.01c3.202.001 6.212 1.246 8.477 3.514 2.266 2.268 3.507 5.28 3.505 8.484-.004 6.657-5.34 11.997-11.953 11.997-2.005-.001-3.973-.502-5.724-1.455L0 24zm6.59-4.846c1.6.95 3.188 1.449 4.825 1.451 5.436 0 9.86-4.37 9.864-9.799.002-2.63-1.023-5.101-2.885-6.965C16.588 2.02 14.12 1.022 11.5 1.022c-5.438 0-9.863 4.372-9.867 9.802-.001 1.73.473 3.42 1.37 4.947l-.994 3.63 3.734-.967c1.554.84 3.123 1.282 4.304 1.282zm11.304-6.858c-.31-.155-1.838-.895-2.122-.997-.284-.102-.49-.153-.696.155-.205.308-.796.997-.975 1.199-.179.203-.359.227-.669.073-.31-.155-1.31-.476-2.494-1.516-.922-.811-1.545-1.812-1.725-2.12-.179-.31-.018-.478.137-.631.14-.139.31-.359.464-.539.155-.179.206-.308.31-.513.102-.206.051-.385-.026-.539-.077-.154-.696-1.649-.953-2.263-.25-.596-.503-.515-.69-.525l-.59-.01c-.206 0-.54.077-.822.385-.282.308-1.079 1.052-1.079 2.565 0 1.513 1.103 2.977 1.257 3.182.155.206 2.17 3.267 5.257 4.569.735.31 1.307.495 1.753.634.739.231 1.412.197 1.944.119.593-.087 1.838-.739 2.095-1.453.258-.713.258-1.325.18-1.453-.077-.128-.283-.205-.593-.36z" />
            </svg>
            Order WhatsApp
          </a>
        </div>
        
      </div>
    </div>

<!-- Row 2: Centered Navigation Links (Primary Dark Theme Green - Sticky) -->
<div id="desktop-sticky-nav" class="relative z-40 hidden md:block bg-primary-dark px-4 shadow-md">
      <div class="max-w-7xl mx-auto flex justify-center items-center h-14 relative">
        <nav class="flex items-center gap-10" id="desktop-nav">
          {navItems.map(item => {
            const isHome = item.href === '/' && currentPath === '/';
            const isSubpage = item.href !== '/' && (
              item.hasDropdown
                ? currentPath.startsWith('/katalog/') || currentPath.startsWith('/kategori/') || currentPath.startsWith('/produk/')
                : currentPath.startsWith(item.href)
            );
            const isActive = isHome || isSubpage;
            
            if (item.hasDropdown) {
              return (
                <div class="relative group py-3" id="kategori-dropdown-trigger">
                  <a
                    href={withBase(item.href)}
                    class={`relative inline-flex py-3 text-[0.72rem] font-bold uppercase tracking-[0.22em] transition-colors after:absolute after:inset-x-0 after:-bottom-0.5 after:h-px after:origin-center after:scale-x-0 after:bg-secondary after:transition-transform after:duration-300 group-hover:after:scale-x-100 ${isActive ? 'text-white after:scale-x-100' : 'text-white/78 hover:text-white'}`}
                  >
                    {item.label}
                  </a>

                  <!-- Category Dropdown Menu -->
                  <div class="absolute left-1/2 top-full z-50 w-[20rem] lg:w-[23rem] -translate-x-1/2 translate-y-3 rounded-lg border border-soft-cream/70 bg-[#FDF7F7] p-3 opacity-0 invisible shadow-[0_22px_60px_rgba(15,23,42,0.18)] transition-all duration-200 group-hover:visible group-hover:translate-y-0 group-hover:opacity-100">
                    <div class="absolute -top-1.5 left-1/2 h-3 w-3 -translate-x-1/2 rotate-45 border-l border-t border-soft-cream/70 bg-[#FDF7F7]"></div>
                    <p class="px-3 pb-2 text-[0.62rem] font-bold uppercase tracking-[0.22em] text-secondary-dark">Kategori Produk</p>
                    <div class="grid gap-1.5">
                      <div class="relative group/sub">
                        <a
                          href={withBase(bungaPapanParentHref)}
                          class="group/item flex items-center justify-between gap-4 rounded-md px-3 py-3 transition-colors hover:bg-primary/10"
                        >
                          <span>
                            <span class="block font-serif text-base font-bold leading-tight text-primary-dark transition-colors group-hover/item:text-primary">Bunga Papan</span>
                            <span class="mt-1 block text-[0.68rem] font-semibold uppercase tracking-[0.14em] text-slate-500">Duka cita, wedding, congratulations</span>
                          </span>
                          <span class="text-sm font-bold text-secondary-dark" aria-hidden="true">&gt;</span>
                        </a>

                        <div class="absolute left-[calc(100%-1px)] top-0 hidden min-w-[13rem] lg:min-w-[15rem] rounded-lg border border-soft-cream/70 bg-[#FDF7F7] p-2 shadow-[0_20px_54px_rgba(15,23,42,0.16)] group-hover/sub:block">
                          {bungaPapanCategories.map((category) => (
                            <a
                              href={withBase(`/kategori/${category.slug}/`)}
                              class="block rounded-md px-3 py-2.5 font-serif text-[0.98rem] font-bold leading-tight text-primary-dark transition-colors hover:bg-primary/10 hover:text-primary"
                            >
                              {shortBungaPapanName(category.name)}
                            </a>
                          ))}
                        </div>
                      </div>

                      {otherCategories.map((category) => (
                        <a
                          href={withBase(`/kategori/${category.slug}/`)}
                          class="group/item rounded-md px-3 py-3 transition-colors hover:bg-primary/10"
                        >
                          <span class="block font-serif text-base font-bold leading-tight text-primary-dark transition-colors group-hover/item:text-primary">{category.name}</span>
                          <span class="mt-1 block text-[0.7rem] font-semibold uppercase tracking-[0.16em] text-slate-500">Zaloma Florist Malang</span>
                        </a>
                      ))}
                    </div>
                    <div class="mt-2 border-t border-soft-cream/70 pt-2">
                      <a
                        href={withBase('/katalog/')}
                        class="block rounded-md px-3 py-2 text-center text-[0.72rem] font-bold uppercase tracking-[0.16em] text-secondary-dark transition-colors hover:bg-secondary/10 hover:text-primary"
                      >
                        Lihat Semua Kategori
                      </a>
                    </div>
                  </div>
                </div>
              );
            }

            return (
              <a 
                href={withBase(item.href)} 
                class={`relative py-3 text-[0.72rem] font-bold uppercase tracking-[0.22em] transition-colors after:absolute after:inset-x-0 after:-bottom-0.5 after:h-px after:origin-center after:scale-x-0 after:bg-secondary after:transition-transform after:duration-300 ${isActive ? 'text-white after:scale-x-100' : 'text-white/78 hover:text-white hover:after:scale-x-100'}`}
              >
                {item.label}
              </a>
            );
          })}
        </nav>
      </div>
    </div>
<div id="desktop-nav-spacer" class="desktop-nav-spacer" aria-hidden="true"></div>

<!-- ============================================= -->
  <!-- MOBILE NAVBAR (One row, shown below md - Sticky) -->
  <!-- ============================================= -->
  <div class="fixed inset-x-0 top-0 z-[60] md:hidden bg-primary shadow-md">
    <div class="px-4">
    <div class="flex items-center justify-between h-20">
      
      <!-- Brand & Shield Logo Container -->
      <div class="flex items-center">
        <div class="flex-shrink-0 flex items-center relative h-20">
          <div class="absolute left-0 top-0 w-[58px] h-[82px] z-[100]">
            <a href={withBase('/')} class="brand-shield block w-full h-full relative" id="mobile-logo-shield">
              <svg width="100" height="115" class="absolute inset-0 w-full h-full drop-shadow-[0_2px_4px_rgba(0,0,0,0.15)]" viewBox="0 0 100 115" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M0 0 H100 V55 C100 88 50 115 50 115 C50 115 0 88 0 55 Z" fill="#FDF7F7"/>
              </svg>
              <div class="absolute inset-0 flex items-center justify-center pb-2.5">
                <img 
                  src={withBase('/images/logo/zaloma-logo.webp')} 
                  alt="Logo Zaloma Florist" 
                  class="h-10 w-auto scale-110 object-contain"
                  width={38}
                  height={37}
                  loading="eager"
                  decoding="async"
                  fetchpriority="high"
                />
              </div>
            </a>
          </div>
          <!-- Spacer -->
          <div class="w-[58px] flex-shrink-0"></div>
        </div>

        <div class="ml-2.5 text-white flex flex-col justify-center select-none">
          <span class="font-serif text-lg font-bold tracking-wide leading-none">Zaloma Florist</span>
          <span class="text-[9px] sm:text-[10px] text-white/80 font-sans mt-1 leading-tight">Florist Terbaik di Malang &mdash; 11 Tahun Pengalaman</span>
        </div>
      </div>

      <!-- Quick Action Buttons -->
      <div class="flex items-center gap-2">
        <!-- WhatsApp Quick Icon -->
        <a 
          href={`https://wa.me/${WHATSAPP_NUMBER}?text=Halo%20Zaloma%20Florist,%20saya%20ingin%20tanya%20mengenai%20layanan%20pemesanan%20bunga%20di%20Malang.`} 
          target="_blank" 
          rel="noopener noreferrer" 
          class="min-h-[44px] min-w-[44px] inline-flex items-center justify-center rounded-full bg-white text-primary hover:bg-slate-100 transition-colors shadow-sm"
          aria-label="Pesan via WhatsApp"
        >
          <svg width="16" height="16" class="h-4 w-4 shrink-0" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946C.06 5.348 5.397.01 12.008.01c3.202.001 6.212 1.246 8.477 3.514 2.266 2.268 3.507 5.28 3.505 8.484-.004 6.657-5.34 11.997-11.953 11.997-2.005-.001-3.973-.502-5.724-1.455L0 24zm6.59-4.846c1.6.95 3.188 1.449 4.825 1.451 5.436 0 9.86-4.37 9.864-9.799.002-2.63-1.023-5.101-2.885-6.965C16.588 2.02 14.12 1.022 11.5 1.022c-5.438 0-9.863 4.372-9.867 9.802-.001 1.73.473 3.42 1.37 4.947l-.994 3.63 3.734-.967c1.554.84 3.123 1.282 4.304 1.282zm11.304-6.858c-.31-.155-1.838-.895-2.122-.997-.284-.102-.49-.153-.696.155-.205.308-.796.997-.975 1.199-.179.203-.359.227-.669.073-.31-.155-1.31-.476-2.494-1.516-.922-.811-1.545-1.812-1.725-2.12-.179-.31-.018-.478.137-.631.14-.139.31-.359.464-.539.155-.179.206-.308.31-.513.102-.206.051-.385-.026-.539-.077-.154-.696-1.649-.953-2.263-.25-.596-.503-.515-.69-.525l-.59-.01c-.206 0-.54.077-.822.385-.282.308-1.079 1.052-1.079 2.565 0 1.513 1.103 2.977 1.257 3.182.155.206 2.17 3.267 5.257 4.569.735.31 1.307.495 1.753.634.739.231 1.412.197 1.944.119.593-.087 1.838-.739 2.095-1.453.258-.713.258-1.325.18-1.453-.077-.128-.283-.205-.593-.36z" />
          </svg>
        </a>

        <!-- Mobile Menu Button -->
        <button 
          id="mobile-menu-btn" 
          type="button" 
          class="min-h-[44px] min-w-[44px] inline-flex items-center justify-center rounded-md text-white/80 hover:text-white focus:outline-none"
          aria-expanded="false"
          aria-controls="mobile-menu"
          aria-label="Buka menu"
        >
          <span class="sr-only">Open main menu</span>
          <svg width="24" height="24" class="block h-6 w-6" id="menu-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg width="24" height="24" class="hidden h-6 w-6" id="close-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

    </div>
  </div>

  <!-- MOBILE MENU DRAWER (Hidden by default, shown when toggled) -->
  <div class="hidden md:hidden fixed inset-0 z-[140] mobile-menu-shell" id="mobile-menu" aria-hidden="true">
    <button id="mobile-menu-backdrop" type="button" class="mobile-menu-backdrop absolute inset-0 bg-slate-900/35 backdrop-blur-[2px]" aria-label="Tutup menu"></button>
    <aside class="mobile-menu-panel relative flex h-full w-[82vw] max-w-[410px] flex-col bg-[#FDF7F7] px-5 py-7 shadow-2xl rounded-r-2xl select-none">
      <div class="flex items-start justify-between gap-4 px-1">
        <h2 class="font-serif text-[1.75rem] font-bold leading-none text-primary">Zaloma Florist</h2>
        <button id="mobile-menu-close" type="button" class="inline-flex h-11 w-11 min-h-[44px] min-w-[44px] items-center justify-center rounded-full text-slate-600 hover:bg-primary/5 hover:text-primary" aria-label="Tutup menu">
          <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 6l12 12M18 6 6 18" />
          </svg>
        </button>
      </div>

      <nav class="mt-9 space-y-2.5" aria-label="Menu mobile Zaloma Florist">
        <a href={withBase('/')} class={`block rounded-lg border px-4 py-3.5 transition-colors ${isMobileHome ? 'border-primary/25 bg-primary/10 text-primary shadow-sm' : 'border-transparent text-slate-700 hover:border-soft-cream/70 hover:bg-primary/5 hover:text-primary'}`}>
          <span class="block font-serif text-[1.24rem] font-bold leading-tight tracking-wide">Beranda</span>
          <span class="mt-1 block text-[0.66rem] font-bold uppercase tracking-[0.2em] opacity-60">Halaman utama</span>
        </a>

        <details open={isMobileKatalog} class={`rounded-lg border transition-colors ${isMobileKatalog ? 'border-primary/25 bg-primary/10 text-primary shadow-sm' : 'border-transparent text-slate-700 hover:border-soft-cream/70 hover:bg-primary/5 hover:text-primary'}`}>
          <summary class="cursor-pointer px-4 py-3.5">
            <span class="block font-serif text-[1.24rem] font-bold leading-tight tracking-wide">Katalog</span>
            <span class="mt-1 block text-[0.66rem] font-bold uppercase tracking-[0.2em] opacity-60">Semua kategori produk</span>
          </summary>

          <div class="space-y-2 px-3 pb-3">
            <a href={withBase('/katalog/')} class="block rounded-md px-3 py-2.5 font-serif text-[1rem] font-bold text-slate-700 transition-colors hover:bg-white/70 hover:text-primary">
              Semua Produk
            </a>

            <details open={currentPath.startsWith('/kategori/bunga-papan-') || currentPath.startsWith('/produk/bunga-papan-')} class="rounded-md bg-white/55">
              <summary class="cursor-pointer px-3 py-2.5">
                <span class="block font-serif text-[1rem] font-bold text-slate-700">Bunga Papan</span>
                <span class="mt-1 block text-[0.58rem] font-bold uppercase tracking-[0.16em] text-slate-500">Duka cita, wedding, congratulations</span>
              </summary>

              <div class="border-t border-soft-cream/80 px-2 py-2">
                {bungaPapanCategories.map((category) => (
                  <a href={withBase(`/kategori/${category.slug}/`)} class="block rounded-md px-3 py-2 text-[0.9rem] font-semibold text-slate-700 transition-colors hover:bg-primary/10 hover:text-primary">
                    {shortBungaPapanName(category.name)}
                  </a>
                ))}
              </div>
            </details>

            {otherCategories.map((category) => (
              <a href={withBase(`/kategori/${category.slug}/`)} class="block rounded-md px-3 py-2.5 font-serif text-[1rem] font-bold text-slate-700 transition-colors hover:bg-white/70 hover:text-primary">
                {category.name}
              </a>
            ))}
          </div>
        </details>

        <a href={withBase('/cara-pesan/')} class={`block rounded-lg border px-4 py-3.5 transition-colors ${isMobileCaraPesan ? 'border-primary/25 bg-primary/10 text-primary shadow-sm' : 'border-transparent text-slate-700 hover:border-soft-cream/70 hover:bg-primary/5 hover:text-primary'}`}>
          <span class="block font-serif text-[1.24rem] font-bold leading-tight tracking-wide">Cara Pesan</span>
          <span class="mt-1 block text-[0.66rem] font-bold uppercase tracking-[0.2em] opacity-60">Alur pemesanan</span>
        </a>

        <a href={withBase('/faq/')} class={`block rounded-lg border px-4 py-3.5 transition-colors ${isMobileFaq ? 'border-primary/25 bg-primary/10 text-primary shadow-sm' : 'border-transparent text-slate-700 hover:border-soft-cream/70 hover:bg-primary/5 hover:text-primary'}`}>
          <span class="block font-serif text-[1.24rem] font-bold leading-tight tracking-wide">FAQ</span>
          <span class="mt-1 block text-[0.66rem] font-bold uppercase tracking-[0.2em] opacity-60">Bantuan pelanggan</span>
        </a>

        <a href={withBase('/tentang/')} class={`block rounded-lg border px-4 py-3.5 transition-colors ${isMobileTentang ? 'border-primary/25 bg-primary/10 text-primary shadow-sm' : 'border-transparent text-slate-700 hover:border-soft-cream/70 hover:bg-primary/5 hover:text-primary'}`}>
          <span class="block font-serif text-[1.24rem] font-bold leading-tight tracking-wide">Tentang Kami</span>
          <span class="mt-1 block text-[0.66rem] font-bold uppercase tracking-[0.2em] opacity-60">Profil toko</span>
        </a>

        <a href={withBase('/kontak/')} class={`block rounded-lg border px-4 py-3.5 transition-colors ${isMobileKontak ? 'border-primary/25 bg-primary/10 text-primary shadow-sm' : 'border-transparent text-slate-700 hover:border-soft-cream/70 hover:bg-primary/5 hover:text-primary'}`}>
          <span class="block font-serif text-[1.24rem] font-bold leading-tight tracking-wide">Kontak</span>
          <span class="mt-1 block text-[0.66rem] font-bold uppercase tracking-[0.2em] opacity-60">Hubungi admin</span>
        </a>
      </nav>
    </aside>
  </div>
</div>
<div class="md:hidden h-20" aria-hidden="true"></div>
<style>
  .desktop-nav-spacer {
    display: none;
    height: 3.5rem;
  }

  #desktop-sticky-nav.is-fixed {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 70;
  }

  @media (min-width: 768px) {
    .desktop-nav-spacer.is-active {
      display: block;
    }
  }
  .mobile-menu-shell {
    pointer-events: none;
  }

  .mobile-menu-shell.is-open {
    pointer-events: auto;
  }

  .mobile-menu-backdrop {
    opacity: 0;
    transition: opacity 260ms ease;
  }

  .mobile-menu-panel {
    transform: translateX(-104%);
    transition: transform 360ms cubic-bezier(0.22, 1, 0.36, 1);
    will-change: transform;
  }

  .mobile-menu-panel summary::-webkit-details-marker {
    display: none;
  }

  .mobile-menu-panel summary::marker {
    content: "";
  }
  .mobile-menu-shell.is-open .mobile-menu-backdrop {
    opacity: 1;
  }

  .mobile-menu-shell.is-open .mobile-menu-panel {
    transform: translateX(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .mobile-menu-backdrop,
    .mobile-menu-panel {
      transition: none;
    }
  }
</style>

<script>
  const desktopStickyNav = document.getElementById('desktop-sticky-nav');
  const desktopNavSpacer = document.getElementById('desktop-nav-spacer');
  const desktopNavQuery = window.matchMedia('(min-width: 768px)');
  let desktopStickyOffset = 0;

  const updateDesktopStickyNav = () => {
    if (!desktopStickyNav || !desktopNavSpacer) return;

    if (!desktopNavQuery.matches) {
      desktopStickyNav.classList.remove('is-fixed');
      desktopNavSpacer.classList.remove('is-active');
      return;
    }

    const shouldFix = window.scrollY >= desktopStickyOffset;
    desktopStickyNav.classList.toggle('is-fixed', shouldFix);
    desktopNavSpacer.classList.toggle('is-active', shouldFix);
  };

  const measureDesktopStickyNav = () => {
    if (!desktopStickyNav || !desktopNavSpacer || !desktopNavQuery.matches) return;
    desktopStickyNav.classList.remove('is-fixed');
    desktopNavSpacer.classList.remove('is-active');
    desktopStickyOffset = desktopStickyNav.getBoundingClientRect().top + window.scrollY;
    updateDesktopStickyNav();
  };

  window.addEventListener('scroll', updateDesktopStickyNav, { passive: true });
  window.addEventListener('resize', measureDesktopStickyNav);
  window.addEventListener('load', measureDesktopStickyNav);
  desktopNavQuery.addEventListener('change', measureDesktopStickyNav);
  window.requestAnimationFrame(measureDesktopStickyNav);

  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const menuIcon = document.getElementById('menu-icon');
  const closeIcon = document.getElementById('close-icon');
  const closeBtn = document.getElementById('mobile-menu-close');
  const backdrop = document.getElementById('mobile-menu-backdrop');
  let closeTimer = 0;

  const clearCloseTimer = () => {
    if (!closeTimer) return;
    window.clearTimeout(closeTimer);
    closeTimer = 0;
  };

  const showMenuIcon = () => {
    if (!btn || !menuIcon || !closeIcon) return;
    btn.setAttribute('aria-expanded', 'false');
    menuIcon.classList.remove('hidden');
    closeIcon.classList.add('hidden');
  };

  const showCloseIcon = () => {
    if (!btn || !menuIcon || !closeIcon) return;
    btn.setAttribute('aria-expanded', 'true');
    menuIcon.classList.add('hidden');
    closeIcon.classList.remove('hidden');
  };

  const openMobileMenu = () => {
    if (!menu) return;
    clearCloseTimer();
    menu.classList.remove('hidden');
    menu.setAttribute('aria-hidden', 'false');
    showCloseIcon();
    document.body.classList.add('overflow-hidden');
    window.requestAnimationFrame(() => {
      menu.classList.add('is-open');
    });
  };

  const finishClose = () => {
    if (!menu || !btn) return;
    if (btn.getAttribute('aria-expanded') === 'false') {
      menu.classList.add('hidden');
    }
    closeTimer = 0;
  };

  const closeMobileMenu = () => {
    if (!menu || menu.classList.contains('hidden')) return;
    clearCloseTimer();
    menu.classList.remove('is-open');
    menu.setAttribute('aria-hidden', 'true');
    showMenuIcon();
    document.body.classList.remove('overflow-hidden');
    closeTimer = window.setTimeout(finishClose, 420);
  };

  btn?.addEventListener('click', () => {
    const isExpanded = btn.getAttribute('aria-expanded') === 'true';
    if (isExpanded) {
      closeMobileMenu();
    } else {
      openMobileMenu();
    }
  });

  closeBtn?.addEventListener('click', closeMobileMenu);
  backdrop?.addEventListener('click', closeMobileMenu);
  menu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', closeMobileMenu));
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') closeMobileMenu();
  });
</script>