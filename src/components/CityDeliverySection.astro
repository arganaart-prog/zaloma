---
import { DEFAULT_CITIES, cityToSlug } from '../data/cities';
import { withBase } from '../utils/paths';
import { WHATSAPP_NUMBER } from '../data/constants';

interface Props {
  currentCitySlug?: string;
  allCities?: any[];
}

const { currentCitySlug = 'malang-raya', allCities = [] } = Astro.props;

// Merge provided cities with DEFAULT_CITIES
const mergedCities: any[] = [];
const seenSlugs = new Set<string>();

// 1. Prioritaskan DEFAULT_CITIES
DEFAULT_CITIES.forEach(dc => {
  if (dc && dc.slug && !seenSlugs.has(dc.slug)) {
    seenSlugs.add(dc.slug);
    const dynMatch = (allCities || []).find(c => {
      const s = typeof c === 'string' ? cityToSlug(c) : (c && (c.slug || cityToSlug(c.name)));
      return s === dc.slug;
    });
    mergedCities.push({
      ...dc,
      image: (dynMatch && (dynMatch.image || dynMatch.image_url)) ? (dynMatch.image || dynMatch.image_url) : dc.image,
      description: (dynMatch && dynMatch.description) ? dynMatch.description : dc.description
    });
  }
});

// 2. Tambahkan kota kustom dari Supabase bila ada
(allCities || []).forEach(c => {
  const name = typeof c === 'string' ? c : (c && c.name);
  if (!name) return;
  const slug = typeof c === 'string' ? cityToSlug(c) : (c.slug || cityToSlug(c.name));
  if (slug && !seenSlugs.has(slug)) {
    seenSlugs.add(slug);
    mergedCities.push({
      name,
      slug,
      image: (c && (c.image || c.image_url)) || '/images/galeri/gallery-1.webp',
      description: (c && c.description) || `Pengiriman karangan bunga & buket area ${name}`,
      tagline: (c && c.tagline) || `Area ${name} & Sekitarnya`
    });
  }
});

const waMainLink = `https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent('Halo Zaloma Florist, saya ingin tanya pengiriman karangan bunga ke kota saya...')}`;
---

<!-- =====================================================
     HOME CITY SHOWCASE (100% Sekarsari Architecture + Zaloma Colors)
     ===================================================== -->
<section id="city-section" class="city-showcase">
  <!-- Subtle Glow Ornaments -->
  <div class="city-showcase__bg-glow city-showcase__bg-glow--left" aria-hidden="true"></div>
  <div class="city-showcase__bg-glow city-showcase__bg-glow--right" aria-hidden="true"></div>

  <div class="city-showcase__container">
    <div class="city-showcase__header">
      <p class="city-showcase__label">LAYANAN PENGIRIMAN ANTAR KOTA</p>
      
      <div class="city-showcase__ornament" aria-hidden="true">
        <span></span>
        <svg class="w-4 h-4 text-secondary" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12 2C11.5 4 10 5.5 8 6C10 6.5 11.5 8 12 10C12.5 8 14 6.5 16 6C14 5.5 12.5 4 12 2ZM6 11C5.5 12.5 4.5 13.5 3 14C4.5 14.5 5.5 15.5 6 17C6.5 15.5 7.5 14.5 9 14C7.5 13.5 6.5 12.5 6 11ZM18 11C17.5 12.5 16.5 13.5 15 14C16.5 14.5 17.5 15.5 18 17C18.5 15.5 19.5 14.5 21 14C19.5 13.5 18.5 12.5 18 11ZM12 14C10.9 14 10 14.9 10 16C10 17.1 10.9 18 12 18C13.1 18 14 17.1 14 16C14 14.9 13.1 14 12 14Z" />
        </svg>
        <span></span>
      </div>

      <h2>Mau Kirim ke Luar Kota?</h2>
      <p>
        Pilih kota tujuan pengiriman, dan temukan koleksi bunga terbaik yang tersedia di area tersebut.
        Kami memastikan setiap pesanan dikirim dengan kualitas terjaga dan tepat waktu.
      </p>
    </div>

    <!-- Search input -->
    <div class="city-showcase__search">
      <svg class="w-5 h-5 text-slate-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
      </svg>
      <input 
        id="cityShowcaseSearchInput" 
        type="search" 
        placeholder="Cari kota tujuan pengiriman Anda..." 
        autocomplete="off"
      />
      <span id="cityShowcaseCount" class="text-xs font-bold text-secondary shrink-0">
        {mergedCities.length} Kota
      </span>
    </div>

    <!-- Actions button -->
    <div class="city-showcase__actions">
      <a href={withBase('/kota/')} class="city-filter-btn city-filter-btn--primary">
        <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
          <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/>
        </svg>
        <span>Jelajahi Semua Kota</span>
        <span>→</span>
      </a>
    </div>

    <!-- Grid of Cities (100% Sekarsari Card Aspect Ratio & Layout) -->
    <div class="city-showcase__grid" id="cityShowcaseCardsGrid">
      {mergedCities.map((city) => {
        const isCurrent = city.slug === currentCitySlug;
        const href = isCurrent ? '#' : (city.slug === 'malang-raya' ? withBase('/') : withBase(`/kota/${city.slug}/`));
        const imgPath = city.image || '/images/galeri/gallery-1.webp';

        return (
          <a
            href={href}
            class={`city-destination-card group ${isCurrent ? 'is-current-city' : ''}`}
            data-city-name={city.name.toLowerCase()}
            data-city-slug={city.slug}
          >
            <img
              src={withBase(imgPath)}
              alt={`Toko Bunga ${city.name}`}
              class="city-destination-card__image"
              loading="lazy"
              decoding="async"
            />

            <div class="city-destination-card__shade"></div>

            <div class="city-destination-card__content">
              <div>
                <div class="city-destination-card__title-row">
                  <h3>Toko Bunga {city.name}</h3>
                  <span class="city-destination-card__arrow">
                    <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                      <path d="M13.172 12l-4.95-4.95 1.414-1.414L16 12l-6.364 6.364-1.414-1.414z"/>
                    </svg>
                  </span>
                </div>
                <p>
                  <svg class="w-3.5 h-3.5 shrink-0 fill-current opacity-90" viewBox="0 0 24 24">
                    <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/>
                  </svg>
                  <span>{city.description || `Area ${city.name} & Sekitarnya`}</span>
                </p>
              </div>
            </div>

            {isCurrent && (
              <div class="current-city-badge">
                Kota Ini
              </div>
            )}
          </a>
        );
      })}
    </div>

    <!-- Empty State -->
    <div id="cityShowcaseEmpty" class="city-showcase__empty hidden">
      Kota yang Anda cari belum tersedia di daftar instan. Silakan hubungi kami untuk pengiriman khusus.
    </div>

    <!-- CTA WhatsApp -->
    <div class="city-showcase__cta">
      <div class="city-showcase__cta-icon">
        <svg class="w-6 h-6 fill-current" viewBox="0 0 24 24">
          <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.711 2.598 2.669-.699c.969.54 1.838.847 2.791.848 3.18 0 5.767-2.587 5.768-5.766.001-3.18-2.585-5.834-5.768-5.834zm3.377 8.243c-.147.411-.75.76-1.042.812-.292.052-.663.097-2.072-.49-1.409-.587-2.327-2.016-2.398-2.112-.07-.095-.572-.76-.572-1.45 0-.69.362-1.029.49-1.173.129-.144.281-.18.375-.18.094 0 .188.001.27.006.086.005.201-.033.315.241.114.275.39 1.025.424 1.107.034.082.057.178.002.288-.055.11-.082.179-.164.275-.082.096-.173.214-.247.288-.082.083-.168.172-.072.337.096.165.427.705.916 1.141.63.562 1.161.736 1.326.818.165.082.261.069.358-.041.096-.11.413-.48.523-.645.11-.165.22-.138.371-.082.151.055.955.45 1.12.533.165.082.275.124.316.192.041.069.041.399-.106.81zM12.012 2.002C6.488 2.002 2 6.49 2 12.014c0 1.942.553 3.755 1.517 5.289L2 22l4.821-1.488A9.97 9.97 0 0 0 12.012 22C17.535 22 22 17.51 22 12.014c0-5.524-4.465-10.012-9.988-10.012z"/>
        </svg>
      </div>
      <div class="city-showcase__cta-text">
        <h3>Tidak menemukan kota tujuan Anda?</h3>
        <p>Hubungi tim kami untuk layanan pengiriman khusus ke kota lainnya di Indonesia.</p>
      </div>
      <a href={waMainLink} target="_blank" rel="noopener noreferrer" class="city-showcase__cta-button">
        <span>Chat WhatsApp</span>
      </a>
    </div>
  </div>
</section>

<style>
/* =========================================================
   HOME CITY SHOWCASE (100% Sekarsari CSS + Zaloma Colorway)
   ========================================================= */

.city-showcase {
  position: relative;
  overflow: hidden;
  padding: 72px 20px 86px;
  background:
    linear-gradient(180deg, #FAF7F0 0%, #FFFFFF 100%),
    radial-gradient(circle at 50% 0%, rgba(197, 162, 93, 0.12), transparent 38%);
  border-top: 1px solid #EFE8DA;
}

.city-showcase__container {
  position: relative;
  z-index: 1;
  max-width: 1160px;
  margin: 0 auto;
}

.city-showcase__bg-glow {
  position: absolute;
  border-radius: 50%;
  filter: blur(80px);
  pointer-events: none;
  opacity: 0.4;
}

.city-showcase__bg-glow--left {
  left: -80px;
  top: 100px;
  width: 380px;
  height: 380px;
  background: radial-gradient(circle, rgba(197, 162, 93, 0.22) 0%, transparent 70%);
}

.city-showcase__bg-glow--right {
  right: -80px;
  top: 200px;
  width: 380px;
  height: 380px;
  background: radial-gradient(circle, rgba(63, 75, 55, 0.15) 0%, transparent 70%);
}

.city-showcase__header {
  max-width: 760px;
  margin: 0 auto 24px;
  text-align: center;
}

.city-showcase__label {
  margin: 0 0 8px;
  color: #B8934A;
  font-size: 13px;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: 3px;
}

.city-showcase__ornament {
  display: inline-flex;
  align-items: center;
  gap: 12px;
  margin-bottom: 8px;
  color: #B8934A;
}

.city-showcase__ornament span {
  display: block;
  width: 52px;
  height: 1px;
  background: #DFC397;
}

.city-showcase__header h2 {
  margin: 0;
  color: #1C2E24;
  font-family: var(--font-serif), Georgia, 'Times New Roman', serif;
  font-size: clamp(32px, 4vw, 48px);
  font-weight: 800;
  line-height: 1.15;
}

.city-showcase__header > p:last-child {
  max-width: 650px;
  margin: 12px auto 0;
  color: #556052;
  font-size: 15.5px;
  line-height: 1.6;
}

.city-showcase__search {
  display: flex;
  align-items: center;
  gap: 12px;
  width: min(100%, 540px);
  margin: 24px auto 20px;
  padding: 0 20px;
  border: 1.5px solid #E5DDC8;
  border-radius: 28px;
  background: rgba(255, 255, 255, 0.95);
  box-shadow: 0 6px 16px rgba(63, 75, 55, 0.05);
  transition: border-color 0.25s ease, box-shadow 0.25s ease;
}

.city-showcase__search:focus-within {
  border-color: #B8934A;
  box-shadow: 0 6px 20px rgba(184, 147, 74, 0.15);
}

.city-showcase__search input {
  width: 100%;
  height: 48px;
  border: 0;
  outline: 0;
  background: transparent;
  color: #1C2E24;
  font-size: 15px;
}

.city-showcase__search input::placeholder {
  color: #94a3b8;
}

.city-showcase__actions {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 10px;
  margin-bottom: 32px;
}

.city-filter-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  min-width: 140px;
  min-height: 42px;
  padding: 8px 22px;
  border: 1px solid #E5DDC8;
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.9);
  color: #475569;
  font-size: 14.5px;
  font-weight: 700;
  text-decoration: none;
  transition: transform 0.25s ease, box-shadow 0.25s ease, background 0.25s ease;
}

.city-filter-btn--primary {
  min-width: 230px;
  border-color: #3F4B37;
  background: #3F4B37;
  color: #fff;
  box-shadow: 0 10px 24px rgba(63, 75, 55, 0.2);
}

.city-filter-btn--primary:hover {
  background: #2D3A26;
  transform: translateY(-2px);
  box-shadow: 0 14px 28px rgba(63, 75, 55, 0.28);
}

/* 3-Column City Cards Grid */
.city-showcase__grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 20px;
}

.city-destination-card {
  position: relative;
  display: block;
  aspect-ratio: 372 / 232;
  overflow: hidden;
  border-radius: 16px;
  color: #fff;
  text-decoration: none;
  background:
    radial-gradient(circle at 35% 26%, rgba(255, 255, 255, 0.38), transparent 34%),
    linear-gradient(135deg, #FAF5E6, #3F4B37);
  box-shadow: 0 6px 14px rgba(24, 22, 23, 0.12);
  transition: transform 0.3s ease, box-shadow 0.3s ease;
}

.city-destination-card:hover {
  transform: translateY(-3px);
  box-shadow: 0 12px 24px rgba(45, 56, 46, 0.22);
}

.city-destination-card__image {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.6s ease;
}

.city-destination-card:hover .city-destination-card__image {
  transform: scale(1.06);
}

.city-destination-card__shade {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(0,0,0,0.02) 25%, rgba(15, 25, 20, 0.88) 100%);
}

.city-destination-card__content {
  position: absolute;
  inset: auto 20px 16px;
  z-index: 1;
}

.city-destination-card__title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
}

.city-destination-card h3 {
  margin: 0;
  font-family: var(--font-serif), Georgia, 'Times New Roman', serif;
  font-size: clamp(20px, 2.2vw, 26px);
  font-weight: 800;
  line-height: 1.1;
  text-shadow: 0 2px 8px rgba(0,0,0,0.4);
}

.city-destination-card__arrow {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 28px;
  height: 28px;
  flex: 0 0 28px;
  border: 1px solid rgba(255, 255, 255, 0.8);
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.15);
  color: #fff;
  transition: background 0.25s ease, border-color 0.25s ease;
}

.city-destination-card:hover .city-destination-card__arrow {
  background: var(--color-secondary, #C5A25D);
  border-color: var(--color-secondary, #C5A25D);
  color: #1C2E24;
}

.city-destination-card p {
  display: flex;
  align-items: center;
  gap: 6px;
  margin: 6px 0 0;
  color: rgba(255, 255, 255, 0.95);
  font-size: 13.5px;
  font-weight: 600;
  text-shadow: 0 1px 4px rgba(0,0,0,0.4);
}

.current-city-badge {
  position: absolute;
  top: 12px;
  right: 12px;
  z-index: 2;
  padding: 4px 12px;
  border-radius: 999px;
  font-size: 10.5px;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: 1px;
  background: var(--color-secondary, #C5A25D);
  color: #1C2E24;
  box-shadow: 0 3px 8px rgba(0, 0, 0, 0.25);
}

.city-showcase__empty {
  padding: 32px;
  color: #64748b;
  text-align: center;
  font-weight: 700;
  font-size: 15px;
}

/* CTA WhatsApp Box (Sesuai Sekarsari) */
.city-showcase__cta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  width: min(100%, 720px);
  margin: 40px auto 0;
  padding: 18px 26px;
  border-radius: 16px;
  background: #FAF7F0;
  border: 1px solid #E5DDC8;
  box-shadow: 0 8px 20px rgba(63, 75, 55, 0.05);
}

.city-showcase__cta-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 48px;
  height: 48px;
  border-radius: 50%;
  background: #25D366;
  color: #fff;
  flex-shrink: 0;
  box-shadow: 0 4px 12px rgba(37, 211, 102, 0.3);
}

.city-showcase__cta-text {
  flex: 1;
}

.city-showcase__cta-text h3 {
  margin: 0;
  color: #1C2E24;
  font-family: var(--font-serif), Georgia, 'Times New Roman', serif;
  font-size: 18px;
  font-weight: 800;
}

.city-showcase__cta-text p {
  margin: 4px 0 0;
  color: #64748b;
  font-size: 13.5px;
}

.city-showcase__cta-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  min-height: 42px;
  padding: 8px 22px;
  border-radius: 10px;
  background: #25D366;
  color: #fff;
  font-size: 13.5px;
  font-weight: 700;
  text-decoration: none;
  transition: transform 0.25s ease, background 0.25s ease;
  flex-shrink: 0;
  box-shadow: 0 4px 12px rgba(37, 211, 102, 0.25);
}

.city-showcase__cta-button:hover {
  background: #20BD5A;
  transform: translateY(-2px);
}

/* Responsive adjustments */
@media (max-width: 900px) {
  .city-showcase__grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }
}

@media (max-width: 640px) {
  .city-showcase {
    padding: 50px 16px 60px;
  }
  .city-showcase__grid {
    grid-template-columns: 1fr;
    gap: 14px;
  }
  .city-showcase__cta {
    flex-direction: column;
    text-align: center;
    padding: 20px 16px;
  }
  .city-showcase__cta-button {
    width: 100%;
  }
}
</style>

<script is:inline>
  (function initCityShowcaseSearch() {
    const searchInput = document.getElementById('cityShowcaseSearchInput');
    const cardsGrid = document.getElementById('cityShowcaseCardsGrid');
    const emptyState = document.getElementById('cityShowcaseEmpty');
    const countLabel = document.getElementById('cityShowcaseCount');
    if (!searchInput || !cardsGrid) return;

    searchInput.addEventListener('input', () => {
      const query = searchInput.value.trim().toLowerCase();
      const cards = cardsGrid.querySelectorAll('.city-destination-card');
      let visibleCount = 0;

      cards.forEach(card => {
        const cityName = card.getAttribute('data-city-name') || '';
        const isMatch = !query || cityName.includes(query);
        if (isMatch) {
          card.style.display = '';
          visibleCount++;
        } else {
          card.style.display = 'none';
        }
      });

      if (emptyState) {
        if (visibleCount === 0) {
          emptyState.classList.remove('hidden');
        } else {
          emptyState.classList.add('hidden');
        }
      }

      if (countLabel) {
        countLabel.textContent = `${visibleCount} Kota`;
      }
    });
  })();
</script>
