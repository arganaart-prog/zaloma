---
import { DEFAULT_CITIES, cityToSlug } from '../data/cities';
import { withBase } from '../utils/paths';
import { WHATSAPP_NUMBER } from '../data/constants';

interface Props {
  currentCitySlug?: string;
  allCities?: any[];
}

const { currentCitySlug = 'malang-raya', allCities = [] } = Astro.props;

// Merge provided cities with DEFAULT_CITIES
const mergedCities: any[] = [];
const seenSlugs = new Set<string>();

// 1. Prioritaskan DEFAULT_CITIES agar memiliki gambar resolusi tinggi & meta lengkap
DEFAULT_CITIES.forEach(dc => {
  if (dc && dc.slug && !seenSlugs.has(dc.slug)) {
    seenSlugs.add(dc.slug);
    const dynMatch = (allCities || []).find(c => {
      const s = typeof c === 'string' ? cityToSlug(c) : (c && (c.slug || cityToSlug(c.name)));
      return s === dc.slug;
    });
    mergedCities.push({
      ...dc,
      description: (dynMatch && dynMatch.description) ? dynMatch.description : dc.description
    });
  }
});

// 2. Tambahkan kota kustom dari Supabase bila ada
(allCities || []).forEach(c => {
  const name = typeof c === 'string' ? c : (c && c.name);
  if (!name) return;
  const slug = typeof c === 'string' ? cityToSlug(c) : (c.slug || cityToSlug(c.name));
  if (slug && !seenSlugs.has(slug)) {
    seenSlugs.add(slug);
    mergedCities.push({
      name,
      slug,
      image: (c && c.image) || '/images/galeri/gallery-1.webp',
      description: (c && c.description) || `Pengiriman karangan bunga & buket area ${name}`,
      tagline: (c && c.tagline) || `Area ${name} & Sekitarnya`
    });
  }
});

const waCtaUrl = `https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent('Halo Zaloma Florist, saya ingin konsultasi pengiriman karangan bunga ke luar kota.')}`;
---

<!-- Section: Jangkauan Pengiriman Luar Kota (Sekarsari Style) -->
<section class="py-20 bg-primary text-white relative overflow-hidden" id="pilih-pengiriman-luar-kota">
  <!-- Subtle Background Radial Glow -->
  <div class="absolute inset-0 bg-[radial-gradient(circle_at_50%_0%,rgba(191,167,122,0.16),transparent_55%)] pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Header (Sesuai Sekarsari HomeCityShowcase) -->
    <div class="max-w-3xl mx-auto text-center mb-10">
      <p class="text-xs sm:text-sm font-extrabold uppercase tracking-[0.25em] text-secondary-light mb-2">
        LAYANAN PENGIRIMAN ANTAR KOTA
      </p>

      <!-- Ornament Line -->
      <div class="inline-flex items-center justify-center gap-3 mb-3 text-secondary-light/70" aria-hidden="true">
        <span class="w-12 h-px bg-secondary/50"></span>
        <svg class="w-4 h-4 text-secondary-light" fill="currentColor" viewBox="0 0 20 20">
          <path d="M10 2a1 1 0 011 1v1.323l3.954 1.582 1.59-1.59a1 1 0 011.414 1.414l-1.59 1.59L17.95 10.27a1 1 0 01-1.27 1.272l-1.583-.633V17a1 1 0 01-1 1h-2a1 1 0 01-1-1v-4H9v4a1 1 0 01-1 1H6a1 1 0 01-1-1v-6.091l-1.583.633a1 1 0 01-1.27-1.272l1.59-3.953-1.59-1.59a1 1 0 011.414-1.414l1.59 1.59L8 4.323V3a1 1 0 011-1h1z" />
        </svg>
        <span class="w-12 h-px bg-secondary/50"></span>
      </div>

      <h2 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-bold leading-tight">
        Mau Kirim ke Luar Kota?
      </h2>
      <p class="text-white/80 text-sm sm:text-base mt-3 leading-relaxed max-w-2xl mx-auto">
        Pilih kota tujuan pengiriman, dan temukan koleksi karangan bunga terbaik yang tersedia di area tersebut. Kami memastikan setiap pesanan dikirim dengan kualitas terjaga dan tepat waktu.
      </p>

      <!-- Real-time City Search Bar (Sesuai Sekarsari) -->
      <div class="relative max-w-lg mx-auto mt-7">
        <div class="flex items-center gap-3 px-4 py-2.5 rounded-full bg-white/10 backdrop-blur-md border border-white/20 shadow-lg focus-within:border-secondary focus-within:ring-2 focus-within:ring-secondary/30 transition-all">
          <svg class="w-5 h-5 text-secondary-light/80 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
          <input 
            type="search" 
            id="city-search-input"
            placeholder="Cari kota tujuan pengiriman Anda..." 
            class="w-full bg-transparent text-sm sm:text-base text-white placeholder-white/60 focus:outline-hidden"
            autocomplete="off"
          />
          <span id="city-search-count" class="text-xs text-secondary-light font-bold shrink-0">
            {mergedCities.length} Kota
          </span>
        </div>
      </div>
    </div>

    <!-- 3 Rounded Grid of Cities (Sesuai Sekarsari .city-showcase__grid & .city-destination-card) -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" id="cities-delivery-grid">
      {mergedCities.map((city) => {
        const isCurrent = city.slug === currentCitySlug;
        const href = isCurrent 
          ? '#' 
          : (city.slug === 'malang-raya' ? withBase('/') : withBase(`/kota/${city.slug}/`));
        const isWorldwide = city.slug === 'bisa-dikirim-ke-mana-saja';
        const imgPath = city.image || '/images/galeri/gallery-1.webp';

        return (
          <a
            href={href}
            class={`group relative rounded-2xl sm:rounded-3xl overflow-hidden aspect-[16/10] border-2 transition-all duration-300 flex flex-col justify-between p-5 sm:p-6 shadow-xl hover:shadow-2xl hover:-translate-y-1.5 cursor-pointer block select-none ${
              isCurrent
                ? 'border-secondary ring-4 ring-secondary/30 shadow-2xl scale-[1.01]'
                : 'border-white/15 hover:border-secondary'
            }`}
            data-city-slug={city.slug}
            data-city-name={city.name.toLowerCase()}
            aria-label={`Buka website toko bunga kota ${city.name}`}
          >
            <!-- Background Image -->
            <img 
              src={withBase(imgPath)} 
              alt={`Toko Bunga ${city.name}`}
              loading="lazy"
              decoding="async"
              class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-108 z-0"
            />

            <!-- Dark Gradient Shade (Bottom Gradient Sesuai Sekarsari) -->
            <div class="absolute inset-0 bg-gradient-to-t from-black/95 via-black/45 to-transparent group-hover:from-black transition-colors z-10"></div>

            <!-- Top Pill / Badge -->
            <div class="relative z-20 flex items-center justify-between">
              <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[11px] font-bold uppercase tracking-wider backdrop-blur-md bg-black/40 text-white border border-white/20 shadow-xs">
                <span class="text-xs">{isWorldwide ? '🌍' : (city.name.includes('Batu') ? '🍎' : '📍')}</span>
                <span>{isWorldwide ? 'Ekspedisi' : 'Pengiriman Kilat'}</span>
              </span>

              {isCurrent ? (
                <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider bg-secondary text-primary-dark shadow-sm">
                  Kota Ini
                </span>
              ) : (
                <span class="w-7 h-7 rounded-full border border-white/60 group-hover:border-secondary group-hover:bg-secondary text-white group-hover:text-primary-dark flex items-center justify-center transition-all duration-300 text-sm font-bold shadow-xs group-hover:rotate-45">
                  ↗
                </span>
              )}
            </div>

            <!-- Bottom Content (Sesuai Sekarsari Title Row & Arrow) -->
            <div class="relative z-20 space-y-1.5">
              <div class="flex items-center justify-between gap-2">
                <h3 class="font-serif text-xl sm:text-2xl font-extrabold text-white tracking-tight drop-shadow-md group-hover:text-secondary-light transition-colors line-clamp-1">
                  Toko Bunga {city.name}
                </h3>
              </div>

              <p class="flex items-center gap-1.5 text-xs text-white/90 font-medium">
                <svg class="w-3.5 h-3.5 text-secondary-light shrink-0" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd" />
                </svg>
                <span class="line-clamp-1">{city.tagline || 'Jawa Timur & Sekitarnya'}</span>
              </p>

              <div class="pt-1 flex items-center text-xs font-bold text-secondary-light group-hover:text-white transition-colors gap-1.5">
                <span>Lihat Produk {city.name}</span>
                <span class="transform group-hover:translate-x-1 transition-transform">→</span>
              </div>
            </div>
          </a>
        );
      })}
    </div>

    <!-- Empty Search State -->
    <div id="city-search-empty" class="hidden text-center py-12 px-6 rounded-3xl bg-white/5 border border-dashed border-white/20 mt-6">
      <span class="text-4xl block mb-2">📍</span>
      <h4 class="font-serif text-xl font-bold text-white">Kota yang Anda cari belum tersedia di daftar</h4>
      <p class="text-xs sm:text-sm text-white/70 mt-1 max-w-md mx-auto">
        Zaloma Florist tetap melayani pengiriman khusus ke seluruh kota di Indonesia melalui jaringan mitra ekspedisi & kurir florist kami.
      </p>
      <div class="mt-4">
        <a 
          href={waCtaUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-secondary hover:bg-secondary-dark text-primary-dark font-bold text-xs transition-all shadow-md"
        >
          <span>Konsultasi Kota Lain via WhatsApp</span>
          <span>→</span>
        </a>
      </div>
    </div>

    <!-- Bottom WhatsApp Consultation Card (Sesuai Sekarsari .city-showcase__cta) -->
    <div class="mt-14 p-6 sm:p-7 rounded-3xl bg-primary-dark/85 border border-white/15 backdrop-blur-md shadow-2xl flex flex-col md:flex-row items-start md:items-center justify-between gap-5">
      <div class="flex items-center gap-4">
        <div class="w-12 h-12 rounded-2xl bg-secondary/20 text-secondary border border-secondary/30 flex items-center justify-center font-bold text-2xl shrink-0 shadow-inner">
          <svg class="w-6 h-6 fill-current text-secondary-light" viewBox="0 0 24 24">
            <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.711 2.598 2.669-.699c.969.54 1.838.847 2.791.848 3.18 0 5.767-2.587 5.768-5.766.001-3.18-2.585-5.834-5.768-5.834zm3.377 8.243c-.147.411-.75.76-1.042.812-.292.052-.663.097-2.072-.49-1.409-.587-2.327-2.016-2.398-2.112-.07-.095-.572-.76-.572-1.45 0-.69.362-1.029.49-1.173.129-.144.281-.18.375-.18.094 0 .188.001.27.006.086.005.201-.033.315.241.114.275.39 1.025.424 1.107.034.082.057.178.002.288-.055.11-.082.179-.164.275-.082.096-.173.214-.247.288-.082.083-.168.172-.072.337.096.165.427.705.916 1.141.63.562 1.161.736 1.326.818.165.082.261.069.358-.041.096-.11.413-.48.523-.645.11-.165.22-.138.371-.082.151.055.955.45 1.12.533.165.082.275.124.316.192.041.069.041.399-.106.81zM12.012 2.002C6.488 2.002 2 6.49 2 12.014c0 1.942.553 3.755 1.517 5.289L2 22l4.821-1.488A9.97 9.97 0 0 0 12.012 22C17.535 22 22 17.51 22 12.014c0-5.524-4.465-10.012-9.988-10.012z"/>
          </svg>
        </div>
        <div>
          <h3 class="font-serif text-lg sm:text-xl font-bold text-white">Tidak menemukan kota tujuan Anda?</h3>
          <p class="text-xs sm:text-sm text-white/80 mt-0.5">Hubungi tim kami untuk layanan pengiriman khusus dan kustomisasi rangkaian bunga ke kota lainnya.</p>
        </div>
      </div>
      <a 
        href={waCtaUrl} 
        target="_blank" 
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-6 py-3 rounded-2xl bg-[#25D366] hover:bg-[#20bd5a] text-white font-bold text-xs sm:text-sm transition-all shadow-lg hover:shadow-xl shrink-0"
      >
        <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
          <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.711 2.598 2.669-.699c.969.54 1.838.847 2.791.848 3.18 0 5.767-2.587 5.768-5.766.001-3.18-2.585-5.834-5.768-5.834zm3.377 8.243c-.147.411-.75.76-1.042.812-.292.052-.663.097-2.072-.49-1.409-.587-2.327-2.016-2.398-2.112-.07-.095-.572-.76-.572-1.45 0-.69.362-1.029.49-1.173.129-.144.281-.18.375-.18.094 0 .188.001.27.006.086.005.201-.033.315.241.114.275.39 1.025.424 1.107.034.082.057.178.002.288-.055.11-.082.179-.164.275-.082.096-.173.214-.247.288-.082.083-.168.172-.072.337.096.165.427.705.916 1.141.63.562 1.161.736 1.326.818.165.082.261.069.358-.041.096-.11.413-.48.523-.645.11-.165.22-.138.371-.082.151.055.955.45 1.12.533.165.082.275.124.316.192.041.069.041.399-.106.81zM12.012 2.002C6.488 2.002 2 6.49 2 12.014c0 1.942.553 3.755 1.517 5.289L2 22l4.821-1.488A9.97 9.97 0 0 0 12.012 22C17.535 22 22 17.51 22 12.014c0-5.524-4.465-10.012-9.988-10.012z"/>
        </svg>
        <span>Chat WhatsApp</span>
      </a>
    </div>

  </div>
</section>

<!-- Client Side Real-time Search & Supabase Live Sync -->
<script is:inline>
  (function initCitySearchAndSync() {
    const searchInput = document.getElementById('city-search-input');
    const emptyBox = document.getElementById('city-search-empty');
    const countBadge = document.getElementById('city-search-count');
    const grid = document.getElementById('cities-delivery-grid');

    if (!searchInput || !grid) return;

    searchInput.addEventListener('input', function(e) {
      const q = e.target.value.trim().toLowerCase();
      const cards = grid.querySelectorAll('[data-city-name]');
      let visibleCount = 0;

      cards.forEach(card => {
        const name = card.getAttribute('data-city-name') || '';
        const slug = card.getAttribute('data-city-slug') || '';
        const match = !q || name.includes(q) || slug.includes(q);
        
        if (match) {
          card.classList.remove('hidden');
          visibleCount++;
        } else {
          card.classList.add('hidden');
        }
      });

      if (countBadge) {
        countBadge.textContent = `${visibleCount} Kota`;
      }

      if (emptyBox) {
        if (visibleCount === 0) {
          emptyBox.classList.remove('hidden');
        } else {
          emptyBox.classList.add('hidden');
        }
      }
    });
  })();
</script>
