---
import { stripBase, withBase } from '../utils/paths';

interface Props {
  title: string;
  description: string;
  keywords?: string;
  image?: string;
  type?: 'website' | 'product';
  schema?: Record<string, any>;
  robots?: string;
  canonical?: string;
}

const {
  title,
  description,
  keywords,
  image = '/images/banner/default-og.webp',
  type = 'website',
  schema,
  robots = 'index, follow, max-image-preview:large',
  canonical
} = Astro.props;

const canonicalURL = canonical
  ? new URL(canonical, Astro.site)
  : new URL(withBase(stripBase(Astro.url.pathname)), Astro.site);
const ogImageURL = new URL(withBase(image), Astro.site);
const siteName = 'Zaloma Florist';
const fullTitle = title.toLowerCase().includes(siteName.toLowerCase()) ? title : `${title} | ${siteName}`;
const defaultKeywords = 'Zaloma Florist, florist profesional, toko bunga terpercaya, bunga papan, bunga papan duka cita, bunga papan wedding, bunga papan ucapan selamat, bunga papan semi styrofoam, hand bouquet, buket bunga, standing flower, bunga meja, rangkaian bunga segar, pengiriman bunga berbagai kota, toko bunga Jawa Timur';
const securityPolicy = [
  "default-src 'self'",
  "base-uri 'self'",
  "object-src 'none'",
  "img-src 'self' data: https:",
  "font-src 'self' https://fonts.gstatic.com data:",
  "style-src 'self' 'unsafe-inline' https://fonts.googleapis.com",
  "script-src 'self' 'unsafe-inline'",
  "connect-src 'self'",
  "form-action 'self' https://wa.me https://api.whatsapp.com"
].join('; ');
---

<!-- Primary Meta Tags -->
<title>{fullTitle}</title>
<meta name="title" content={fullTitle} />
<meta name="application-name" content={siteName} />
<meta name="author" content={siteName} />
<meta name="description" content={description} />
<meta name="keywords" content={keywords || defaultKeywords} />
<meta name="robots" content={robots} />
<meta name="google-site-verification" content="7Us_oOZCthT_K5TWBYtY-dri9dXwXgOBdp8SlustlLM" />
<meta name="google-site-verification" content="nwjkhiONn33gIymTNY90xOpP1sNgkK_bruwBNxZxk4k" />
<meta name="google-site-verification" content="google9ce433d6edbefe53" />
<meta name="referrer" content="strict-origin-when-cross-origin" />
<!-- <meta http-equiv="Content-Security-Policy" content={securityPolicy} /> -->
<link rel="canonical" href={canonicalURL} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={fullTitle} />
<meta property="og:site_name" content={siteName} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImageURL} />
<meta property="og:locale" content="id_ID" />

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={canonicalURL} />
<meta property="twitter:title" content={fullTitle} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={ogImageURL} />

<!-- Fonts & Icons -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&display=swap" rel="stylesheet" />

<!-- JSON-LD Schema Markup -->
{schema && (
  <script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />
)}
