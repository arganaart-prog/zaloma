---
import ProductCard from './ProductCard.astro';
import { withBase } from '../utils/paths';
import { getHomeCategoryProducts } from '../utils/productHelpers';

interface Props {
  allProducts?: any[];
  cityName?: string;
  citySlug?: string;
  hideWhenEmpty?: boolean;
  categorySlug?: string;
}

const {
  allProducts = [],
  cityName = '',
  citySlug = '',
  hideWhenEmpty = false,
  categorySlug = 'bouquet',
} = Astro.props;
const handBouquetProducts = getHomeCategoryProducts(allProducts, [
  categorySlug,
  'bouquet',
  'hand-bouquet',
  'hand-bouquet-malang',
]);
const resolvedCategorySlug = handBouquetProducts[0]?.categorySlug || categorySlug;

const categoryHref = citySlug
  ? `/kategori/${resolvedCategorySlug}/?city=${citySlug}&refer=city`
  : `/kategori/${resolvedCategorySlug}/`;

if (hideWhenEmpty && handBouquetProducts.length === 0) {
  return;
}
---

<section class="py-20 bg-white border-y border-soft-cream/60" id="hand-bouquet-malang">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-2xl mx-auto mb-12">
      <span class="text-secondary-dark font-bold text-xs tracking-widest uppercase block mb-1">Pilihan Buket Bunga</span>
      <h2 class="font-serif text-3xl sm:text-4xl font-bold text-slate-800">Hand Bouquet{cityName ? ` ${cityName}` : ''}</h2>
      <p class="text-slate-500 text-sm mt-3 leading-relaxed">
        Buket bunga segar dan snack bouquet untuk wisuda, lamaran, hari ulang tahun, dan kado spesial. Dirangkai rapi dan siap dikirim pada hari yang sama.
      </p>
    </div>

    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4 sm:gap-6">
      {handBouquetProducts.length > 0 ? (
        handBouquetProducts.slice(0, 8).map((product, index) => (
          <ProductCard product={product} variant="compact" priority={index < 2} />
        ))
      ) : (
        <div class="col-span-full py-12 text-center text-slate-400 text-xs">
          <svg class="w-6 h-6 animate-spin mx-auto text-primary mb-2 opacity-80" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
          </svg>
          Memuat pilihan buket bunga...
        </div>
      )}
    </div>

    <div class="text-center mt-10">
      <a
        href={withBase(categoryHref)}
        class="inline-flex items-center py-2.5 px-4 min-h-[44px] text-sm font-semibold text-primary hover:text-secondary transition-colors group"
      >
        Lihat Semua Hand Bouquet
        <svg class="h-4 w-4 ml-1.5 transform group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
        </svg>
      </a>
    </div>
  </div>
</section>
