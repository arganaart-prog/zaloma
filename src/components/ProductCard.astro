---
// ProductCard.astro
import type { Product } from '../data/products';
import { withBase } from '../utils/paths';
import { getProductCardShape, getProductDisplayName, isProductPopular } from '../utils/productHelpers';

interface Props {
  product: Product;
  variant?: 'modern' | 'classic' | 'compact';
  priority?: boolean;
  class?: string;
  hidden?: boolean;
  aspect?: string;
  [key: string]: any;
}

const { product, variant = 'modern', priority = false, class: className = '', hidden = false, aspect, ...rest } = Astro.props;
const cardShape = product.cardShape || getProductCardShape(product.description);
const productUrl = withBase(`/produk/${product.slug}/`);
const imageUrl = withBase(product.image);
const imageLoading = priority ? 'eager' : 'lazy';
const imageFetchPriority = priority ? 'high' : 'low';
const imageSizes = variant === 'compact'
  ? '(min-width: 1024px) 25vw, (min-width: 640px) 33vw, 50vw'
  : '(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw';
const displayName = getProductDisplayName(product);
const isPopular = isProductPopular(product);
const isBungaPapan = product.categorySlug.startsWith('bunga-papan') || product.categoryName.toLowerCase().includes('bunga papan');
const isHandBouquet = product.categorySlug === 'hand-bouquet-malang' || product.categoryName.toLowerCase().includes('hand bouquet');
const isLongTitle = isBungaPapan || displayName.length > 25;

const shapeAspect = cardShape === 'square' ? 'aspect-square' : cardShape ? 'aspect-[4/5]' : '';
const modernAspect = shapeAspect || aspect || (isHandBouquet ? 'aspect-[4/5]' : 'aspect-[20/19]');
const classicAspect = shapeAspect || aspect || (isHandBouquet ? 'aspect-[4/5]' : 'aspect-[20/19]');
const compactAspect = shapeAspect || aspect || (isHandBouquet ? 'aspect-[4/5]' : 'aspect-[4/4.5]');
---

{variant === 'compact' ? (
  <article class:list={['product-card-shell', 'compact-product-card', 'group', 'relative', 'h-full', 'flex', 'flex-col', 'overflow-hidden', 'rounded-[14px]', 'border', 'border-soft-cream/70', 'bg-white', 'shadow-[0_1px_4px_rgba(15,23,42,0.03)]', cardShape === 'arch' && 'product-card-shape-arch', className]} hidden={hidden ? true : undefined} {...rest}>
    <a href={productUrl} class="flex h-full flex-col no-underline">
      <!-- Image frame: full edge-to-edge (no side spaces), naturally proportioned -->
      <div class:list={['product-card-image', 'image-load-shell', 'relative', compactAspect, 'overflow-hidden', 'bg-clean-ivory', 'border-b', 'border-soft-cream/40']} data-image-frame>
        <span class="image-skeleton" aria-hidden="true"></span>
        <img
          src={imageUrl}
          alt={`Foto ${displayName} Florist Malang`}
          width={product.imageWidth}
          height={product.imageHeight}
          loading={imageLoading}
          decoding="async"
          fetchpriority={imageFetchPriority}
          sizes={imageSizes}
          data-image-loader="true"
          class={`relative z-0 block w-full h-full object-cover ${isHandBouquet ? 'object-center' : 'object-center'} transition-transform duration-700 ease-out group-hover:scale-[1.012]`}
        />

        {isPopular && (
          <span class="absolute top-2.5 left-2.5 z-10 rounded-sm bg-secondary px-2 py-0.5 text-[9px] font-bold uppercase tracking-wider text-primary-dark shadow-xs">
            Populer
          </span>
        )}
      </div>

      <!-- Compact Information -->
      <div class="flex flex-1 flex-col justify-between p-3.5 sm:p-4">
        <div>
          <p class="text-[10px] font-bold uppercase tracking-[0.16em] text-secondary-dark line-clamp-1">{product.categoryName}</p>
          <h3 class={`mt-1 font-serif font-bold leading-snug text-slate-800 line-clamp-2 transition-colors duration-200 group-hover:text-primary ${isLongTitle ? 'text-xs sm:text-sm' : 'text-[0.95rem] sm:text-base'}`}>
            {displayName}
          </h3>
        </div>

        <div class="mt-3 pt-3 border-t border-soft-cream/50 flex items-center justify-between gap-2">
          <div>
            <span class="text-[9px] font-bold uppercase tracking-[0.16em] text-slate-600 block leading-none">Harga</span>
            <p class="font-sans text-sm sm:text-base font-extrabold text-primary leading-tight mt-1">{product.priceLabel}</p>
          </div>
          <span class="inline-flex shrink-0 items-center gap-1 rounded-full bg-primary px-3 py-1.5 text-[11px] font-bold text-white shadow-xs transition-colors duration-200 group-hover:bg-primary-dark">
            Detail
            <svg width="12" height="12" class="h-3 w-3 shrink-0 transition-transform duration-200 group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.6" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
            </svg>
          </span>
        </div>
      </div>
    </a>
  </article>
) : variant === 'classic' ? (
  <div class:list={['classic-product-card', 'product-card-shell', 'group', 'bg-white', 'rounded-[14px]', 'border', 'border-soft-cream/70', 'overflow-hidden', 'shadow-[0_1px_4px_rgba(15,23,42,0.03)]', cardShape === 'arch' && 'product-card-shape-arch', className]} hidden={hidden ? true : undefined} {...rest}>
    <!-- Image Wrapper -->
    <a href={productUrl} class:list={['product-card-image', 'classic-product-image', 'image-load-shell', 'block', 'relative', classicAspect, 'bg-slate-100', 'overflow-hidden']} data-image-frame>
      <span class="image-skeleton" aria-hidden="true"></span>
      <img
        src={imageUrl}
        alt={`Foto ${displayName} Florist Malang`}
        width={product.imageWidth}
        height={product.imageHeight}
        loading={imageLoading}
        decoding="async"
        fetchpriority={imageFetchPriority}
        sizes={imageSizes}
        data-image-loader="true"
        class={`relative z-0 object-cover ${isHandBouquet ? 'object-center' : 'object-top'} w-full h-full transition-transform duration-700 ease-out group-hover:scale-[1.012]`}
      />
      {isPopular && (
        <div class="classic-product-badges absolute top-3 left-3 z-10 flex gap-2">
          <span class="bg-secondary text-primary-dark text-[10px] tracking-wider uppercase font-semibold px-2.5 py-1 rounded-xs shadow-xs">
            Terpopuler
          </span>
        </div>
      )}
    </a>

    <!-- Info Wrapper -->
    <div class="classic-product-info p-4.5 sm:p-5 flex flex-col justify-between min-h-[190px] sm:min-h-[200px]">
      <div>
        <p class="classic-product-category text-[11px] font-semibold tracking-wider text-slate-500 uppercase mb-1">{product.categoryName}</p>
        <h3 class={`classic-product-title font-serif font-bold text-slate-800 line-clamp-2 leading-snug group-hover:text-primary transition-colors duration-200 ${isLongTitle ? 'text-[0.95rem] sm:text-base lg:text-[1.02rem]' : 'text-base sm:text-lg lg:text-lg'}`}>
          <a href={productUrl}>{displayName}</a>
        </h3>
      </div>

      <div class="classic-product-price-wrap pt-3.5 sm:pt-4">
        <div class="classic-product-price-box rounded-md border border-soft-cream/70 bg-accent-bg/70 p-2.5 sm:p-3">
          <p class="classic-product-price-label text-[10px] font-bold uppercase tracking-[0.18em] text-secondary-dark">Harga</p>
          <div class="classic-product-price-row mt-1.5 flex items-center justify-between gap-2.5 sm:gap-3">
            <p class="classic-product-price font-sans text-lg sm:text-xl font-extrabold leading-none text-primary">{product.priceLabel}</p>
            <a
              href={productUrl}
              class="classic-product-detail inline-flex shrink-0 items-center justify-center rounded-full bg-primary px-3.5 py-2 text-[11px] font-bold text-white shadow-xs transition-colors duration-200 group-hover:bg-primary-dark"
              aria-label={`Lihat detail produk ${displayName}`}
            >
              Detail
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
) : (
  <article class:list={['product-card-shell', 'group', 'relative', 'h-full', 'overflow-hidden', 'rounded-[14px]', 'border', 'border-soft-cream/70', 'bg-white', 'shadow-[0_1px_4px_rgba(15,23,42,0.03)]', cardShape === 'arch' && 'product-card-shape-arch', className]} hidden={hidden ? true : undefined} {...rest}>
    <a href={productUrl} class="flex h-full flex-col no-underline">
      <div class:list={['product-card-image', 'image-load-shell', 'relative', '-mx-px', '-mt-px', modernAspect, 'overflow-hidden', 'bg-clean-ivory']} data-image-frame>
        <span class="image-skeleton" aria-hidden="true"></span>
        <img
          src={imageUrl}
          alt={`Foto ${displayName} Florist Malang`}
          width={product.imageWidth}
          height={product.imageHeight}
          loading={imageLoading}
          decoding="async"
          fetchpriority={imageFetchPriority}
          sizes={imageSizes}
          data-image-loader="true"
          class={`relative z-0 block h-full w-full object-cover ${isHandBouquet ? 'object-center' : 'object-top'} transition-transform duration-700 ease-out group-hover:scale-[1.012]`}
        />

        {isHandBouquet ? (
          <div class="pointer-events-none absolute inset-x-0 bottom-0 z-10 h-12 bg-gradient-to-t from-black/15 to-transparent"></div>
        ) : (
          <div class="pointer-events-none absolute inset-x-0 bottom-0 z-10 h-20 bg-gradient-to-t from-primary-dark/35 via-primary-dark/5 to-transparent"></div>
        )}

        <span class="absolute bottom-3 right-3 z-10 inline-flex h-9 w-9 items-center justify-center rounded-full bg-white/95 text-primary shadow-[0_2px_8px_rgba(15,23,42,0.08)] transition-all duration-200 group-hover:bg-primary group-hover:text-white" aria-hidden="true">
          <svg width="16" height="16" class="h-4 w-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.4">
            <path stroke-linecap="round" stroke-linejoin="round" d="M7 17L17 7M9 7h8v8" />
          </svg>
        </span>
      </div>

      <div class="flex min-h-[190px] sm:min-h-[200px] flex-col justify-between p-4.5 sm:p-5">
        <div>
          <p class="line-clamp-1 text-[10px] font-bold uppercase tracking-[0.18em] text-secondary-dark">{product.categoryName}</p>
          <h3 class={`mt-1.5 font-serif font-bold leading-snug text-slate-800 line-clamp-2 transition-colors duration-200 group-hover:text-primary ${isLongTitle ? 'text-[0.95rem] sm:text-base lg:text-[1.05rem]' : 'text-lg sm:text-xl lg:text-[1.15rem]'}`}>
            {displayName}
          </h3>
        </div>

        <div class="pt-3 sm:pt-4">
          <div class="rounded-md border border-soft-cream/70 bg-accent-bg/70 p-2.5 sm:p-3">
            <p class="text-[10px] font-bold uppercase tracking-[0.18em] text-secondary-dark">Harga</p>
            <div class="mt-1.5 flex items-end justify-between gap-2.5 sm:gap-3">
              <p class="font-sans text-lg sm:text-xl font-extrabold leading-none text-primary">{product.priceLabel}</p>
              <span class="inline-flex shrink-0 items-center gap-1.5 rounded-full bg-primary px-3 py-1.5 sm:px-3.5 sm:py-2 text-[11px] font-bold text-white shadow-xs transition-colors duration-200 group-hover:bg-primary-dark">
                Detail
                <svg width="14" height="14" class="h-3.5 w-3.5 shrink-0 transition-transform duration-200 group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.6" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                </svg>
              </span>
            </div>
          </div>
        </div>
      </div>
    </a>
  </article>
)}
