---
import CategoryProductCard from './CategoryProductCard.astro';
import { withBase } from '../utils/paths';
import { getDailyShuffledProducts } from '../utils/rotatingProducts';
import { getHomeCategoryProducts } from '../utils/productHelpers';

interface Props {
  allProducts?: any[];
  cityName?: string;
  citySlug?: string;
  hideWhenEmpty?: boolean;
  categorySlug?: string;
}

const {
  allProducts = [],
  cityName = '',
  citySlug = '',
  hideWhenEmpty = false,
  categorySlug = 'bunga-meja',
} = Astro.props;

const bungaMejaProducts = getDailyShuffledProducts(
  getHomeCategoryProducts(allProducts, [categorySlug, 'bunga-meja', 'bunga-meja-malang']),
  categorySlug,
);
const resolvedCategorySlug = bungaMejaProducts[0]?.categorySlug || categorySlug;

const categoryHref = citySlug
  ? `/kategori/${resolvedCategorySlug}/?city=${citySlug}&refer=city`
  : `/kategori/${resolvedCategorySlug}/`;

if (hideWhenEmpty && bungaMejaProducts.length === 0) {
  return;
}
---

<section class="py-20 bg-accent-bg/60 border-y border-soft-cream/60" id="bunga-meja-malang">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-2xl mx-auto mb-12">
      <h2 class="font-serif text-3xl sm:text-4xl font-bold text-slate-800">Bunga Meja{cityName ? ` ${cityName}` : ''}</h2>
      <p class="text-slate-500 text-sm mt-3 leading-relaxed">
        Bunga meja segar untuk meja kantor, resepsi, meeting, atau hadiah peresmian. Siap kirim rapi dengan kartu ucapan.
      </p>
    </div>

    <div
      class="daily-rotate-grid grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4 sm:gap-6 max-w-4xl mx-auto lg:max-w-none"
      data-daily-rotate-category={resolvedCategorySlug}
    >
      {bungaMejaProducts.length > 0 ? (
        bungaMejaProducts.slice(0, 8).map((product, index) => (
          <div class="daily-product-item h-full" data-product-slug={product.slug}>
            <CategoryProductCard product={product} aspect="aspect-square" priority={index < 2} />
          </div>
        ))
      ) : (
        <div class="col-span-full py-12 text-center text-slate-400 text-xs">
          <svg class="w-6 h-6 animate-spin mx-auto text-primary mb-2 opacity-80" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
          </svg>
          Memuat bunga meja...
        </div>
      )}
    </div>

    <div class="text-center mt-10">
      <a
        href={withBase(categoryHref)}
        class="inline-flex items-center py-2.5 px-4 min-h-[44px] text-sm font-semibold text-primary hover:text-secondary transition-colors group"
      >
        Lihat Semua Bunga Meja
        <svg class="h-4 w-4 ml-1.5 transform group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
        </svg>
      </a>
    </div>
  </div>
</section>
