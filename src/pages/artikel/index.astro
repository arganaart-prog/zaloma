---
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { ARTICLES } from '../../data/articles';
import { ARTICLES_CONFIG_SLUG } from '../../data/articles';
import '../../styles/blog.css';
import { withBase } from '../../utils/paths';
import { WHATSAPP_NUMBER } from '../../data/constants';
import { SUPABASE_ANON_KEY, SUPABASE_URL } from '../../data/supabaseConfig';

const title = "Artikel & Tips Florist Malang - Panduan Bunga Terlengkap | Zaloma Florist";
const description = "Kumpulan artikel edukatif, panduan memilih karangan bunga papan, tips merawat bunga segar tahan lama, dan tren kado bunga modern di Malang dari Zaloma Florist.";
const readingMinutes = (article: typeof ARTICLES[number]) => {
  const content = article.content;
  const text = [
    content.lead,
    ...content.sections.flatMap((section) => [section.heading, ...section.body, section.tip || '']),
    content.conclusion,
  ].join(' ');
  return Math.max(1, Math.ceil(text.trim().split(/\s+/).length / 200));
};
---

<Layout title={title} description={description}>
  <div id="article-list-view" class="bg-clean-ivory min-h-screen py-10 md:py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Breadcrumb -->
      <div class="mb-6">
        <Breadcrumb items={[{ label: 'Artikel & Panduan' }]} />
      </div>

      <!-- Hero Header -->
      <div class="text-center max-w-3xl mx-auto mb-14">
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-secondary/15 text-primary border border-secondary/30 mb-3">
          <svg class="w-3.5 h-3.5 text-secondary" fill="currentColor" viewBox="0 0 20 20">
            <path d="M9 4.804A7.968 7.968 0 005.5 4c-1.255 0-2.443.29-3.5.804v10A7.969 7.969 0 015.5 14c1.669 0 3.218.51 4.5 1.385A7.962 7.962 0 0114.5 14c1.255 0 2.443.29 3.5.804v-10A7.968 7.968 0 0014.5 4c-1.255 0-2.443.29-3.5.804V12a1 1 0 11-2 0V4.804z"/>
          </svg>
          Wawasan & Inspirasi
        </span>
        <h1 class="font-serif text-3xl sm:text-4xl md:text-5xl font-bold text-slate-800 tracking-tight leading-tight">
          Artikel & Tips Florist Malang
        </h1>
        <p class="text-slate-600 text-sm sm:text-base mt-4 leading-relaxed">
          Kumpulan panduan memilih karangan bunga papan, tips merawat bunga segar agar tahan lama, dan referensi hadiah bunga untuk berbagai momen di Malang.
        </p>
      </div>

      <!-- Articles Grid -->
      <div id="articles-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
        {ARTICLES.map((article) => (
          <article class="blog-card bg-white rounded-2xl border border-cream/90 shadow-sm hover:shadow-xl hover:border-secondary/60 transition-all duration-300 overflow-hidden flex flex-col group">
            <!-- Article Image -->
            <a href={withBase(`/artikel/?slug=${encodeURIComponent(article.slug)}`)} class="block relative aspect-[16/9] overflow-hidden bg-accent-bg">
              <img
                src={withBase(article.image)}
                alt={article.title}
                class="blog-card-image w-full h-full object-cover transform group-hover:scale-105 transition-transform duration-500"
                loading="lazy"
                decoding="async"
              />
              <span class="absolute top-4 left-4 inline-flex items-center px-3 py-1 rounded-full text-xs font-bold text-white bg-primary/90 backdrop-blur-sm shadow-sm">
                {article.category}
              </span>
            </a>

            <!-- Article Details -->
            <div class="p-5 sm:p-6 flex-1 flex flex-col justify-between">
              <div>
                <div class="flex items-center gap-2 text-[11px] text-slate-400 mb-3 font-medium">
                  <span>{article.date}</span>
                  <span aria-hidden="true">·</span>
                  <span>{readingMinutes(article)} menit baca</span>
                </div>

                <h2 class="font-serif text-xl font-bold text-slate-800 group-hover:text-primary transition-colors leading-snug line-clamp-2 mb-3">
                  <a href={withBase(`/artikel/?slug=${encodeURIComponent(article.slug)}`)}>
                    {article.title}
                  </a>
                </h2>

                <p class="text-slate-500 text-sm leading-relaxed line-clamp-3 mb-5">
                  {article.excerpt}
                </p>
              </div>

              <div class="pt-4 border-t border-slate-100 flex items-center justify-between gap-3 mt-auto">
                <div class="text-xs text-slate-500 min-w-0 truncate">
                  Oleh <span class="font-semibold text-slate-700">{article.author}</span>
                </div>
                <a
                  href={withBase(`/artikel/?slug=${encodeURIComponent(article.slug)}`)}
                  class="inline-flex items-center gap-1.5 text-xs font-bold text-primary group-hover:text-secondary group-hover:translate-x-1 transition-all"
                  aria-label={`Baca artikel: ${article.title}`}
                >
                  <span>Baca Selengkapnya</span>
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                  </svg>
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>

      <!-- Bottom WhatsApp CTA Box -->
      <div class="mt-16 bg-primary text-white rounded-2xl p-8 sm:p-12 shadow-xl border border-secondary/20 relative overflow-hidden">
        <div class="relative z-10 max-w-2xl">
          <span class="text-secondary text-xs font-bold uppercase tracking-widest block mb-2">Konsultasi Tanpa Biaya</span>
          <h2 class="font-serif text-2xl sm:text-3xl font-bold leading-tight">
            Butuh Saran Memilih Karangan Bunga yang Tepat?
          </h2>
          <p class="text-slate-200 text-sm mt-3 leading-relaxed">
            Admin dan tim florist Zaloma Florist siap membantu Anda menentukan model bunga, menyusun kalimat ucapan, serta mengecek jadwal pengantaran ke lokasi tujuan di Malang Raya.
          </p>
          <div class="mt-6 flex flex-wrap gap-4">
            <a
              href={`https://wa.me/${WHATSAPP_NUMBER}?text=Halo%20Zaloma Florist,%20saya%20membaca%20artikel%20di%20website%20dan%20ingin%20konsultasi%20pesanan%20bunga.`}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-6 py-3 bg-secondary hover:bg-secondary-dark text-white font-bold text-sm rounded-full transition-all duration-300 shadow-md hover:shadow-lg"
            >
              <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946C.06 5.348 5.397.01 12.008.01c3.202.001 6.212 1.246 8.477 3.514 2.266 2.268 3.507 5.28 3.505 8.484-.004 6.657-5.34 11.997-11.953 11.997-2.005-.001-3.973-.502-5.724-1.455L0 24zm6.59-4.846c1.6.95 3.188 1.449 4.825 1.451 5.436 0 9.86-4.37 9.864-9.799.002-2.63-1.023-5.101-2.885-6.965C16.588 2.02 14.12 1.022 11.5 1.022c-5.438 0-9.863 4.372-9.867 9.802-.001 1.73.473 3.42 1.37 4.947l-.994 3.63 3.734-.967c1.554.84 3.123 1.282 4.304 1.282zm11.304-6.858c-.31-.155-1.838-.895-2.122-.997-.284-.102-.49-.153-.696.155-.205.308-.796.997-.975 1.199-.179.203-.359.227-.669.073-.31-.155-1.31-.476-2.494-1.516-.922-.811-1.545-1.812-1.725-2.12-.179-.31-.018-.478.137-.631.14-.139.31-.359.464-.539.155-.179.206-.308.31-.513.102-.206.051-.385-.026-.539-.077-.154-.696-1.649-.953-2.263-.25-.596-.503-.515-.69-.525l-.59-.01c-.206 0-.54.077-.822.385-.282.308-1.079 1.052-1.079 2.565 0 1.513 1.103 2.977 1.257 3.182.155.206 2.17 3.267 5.257 4.569.735.31 1.307.495 1.753.634.739.231 1.412.197 1.944.119.593-.087 1.838-.739 2.095-1.453.258-.713.258-1.325.18-1.453-.077-.128-.283-.205-.593-.36z" />
              </svg>
              Konsultasi via WhatsApp
            </a>
            <a
              href={withBase('/katalog/')}
              class="inline-flex items-center gap-2 px-6 py-3 bg-white/10 hover:bg-white/20 text-white font-semibold text-sm rounded-full border border-white/20 transition-all duration-300"
            >
              Lihat Katalog Bunga
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <main id="article-detail-view" class="hidden blog-detail min-h-screen bg-clean-ivory py-8 md:py-12" aria-live="polite"></main>

  <script define:vars={{ DEFAULT_ARTICLES: ARTICLES, ARTICLES_CONFIG_SLUG, SUPABASE_URL, SUPABASE_ANON_KEY, ARTICLES_PATH: withBase('/artikel/') }}>
    const listView = document.getElementById('article-list-view');
    const detailView = document.getElementById('article-detail-view');
    const articlesGrid = document.getElementById('articles-grid');
    const fallbackArticles = DEFAULT_ARTICLES;

    function validArticle(article) {
      return article && typeof article.slug === 'string' && typeof article.title === 'string'
        && typeof article.excerpt === 'string' && typeof article.category === 'string'
        && typeof article.image === 'string' && typeof article.author === 'string'
        && (typeof article.content === 'string' || (
          article.content && typeof article.content === 'object'
          && (!article.content.sections || Array.isArray(article.content.sections))
        ));
    }

    function safeImageUrl(value) {
      try {
        const url = new URL(value, window.location.origin);
        return url.protocol === 'https:' || url.origin === window.location.origin ? url.href : '';
      } catch {
        return '';
      }
    }

    function articleUrl(slug) {
      return `${ARTICLES_PATH}?slug=${encodeURIComponent(slug)}`;
    }

    function readingTime(article) {
      const words = articleText(article).trim().split(/\s+/).filter(Boolean).length;
      return Math.max(1, Math.ceil(words / 200));
    }

    function articleText(article) {
      if (typeof article.content === 'string') return article.content;
      const content = article.content || {};
      return [
        content.lead || '',
        ...(content.sections || []).flatMap(section => [section.heading || '', ...(section.body || []), section.tip || '']),
        content.conclusion || '',
      ].join('\n\n');
    }

    function makeElement(tag, className, text) {
      const element = document.createElement(tag);
      if (className) element.className = className;
      if (text !== undefined) element.textContent = text;
      return element;
    }

    function renderArticleCards(articles) {
      if (!articlesGrid) return;
      articlesGrid.replaceChildren();
      articles.forEach(article => {
        const card = makeElement('article', 'blog-card');
        const imageLink = makeElement('a', 'blog-card-media');
        imageLink.href = articleUrl(article.slug);
        const image = document.createElement('img');
        image.src = safeImageUrl(article.image);
        image.alt = article.title;
        image.loading = 'lazy';
        imageLink.append(image);
        const category = makeElement('span', 'blog-card-category', article.category);
        imageLink.append(category);
        const body = makeElement('div', 'blog-card-body');
        const meta = makeElement('div', 'blog-card-meta', `${article.date || article.isoDate || ''} · ${readingTime(article)} menit baca`);
        const heading = makeElement('h2', 'blog-card-title');
        const titleLink = makeElement('a', '', article.title);
        titleLink.href = articleUrl(article.slug);
        heading.append(titleLink);
        const excerpt = makeElement('p', 'blog-card-excerpt', article.excerpt);
        const footer = makeElement('div', 'blog-card-footer');
        footer.append(makeElement('span', 'blog-card-author', `Oleh ${article.author}`));
        const readLink = makeElement('a', 'blog-card-read', 'Baca artikel →');
        readLink.href = articleUrl(article.slug);
        footer.append(readLink);
        body.append(meta, heading, excerpt, footer);
        card.append(imageLink, body);
        articlesGrid.append(card);
      });
    }

    function addParagraph(parent, text, className = '') {
      if (!text) return;
      const paragraph = makeElement('p', className, text);
      parent.append(paragraph);
    }

    function renderArticleDetail(article, allArticles) {
      if (!detailView || !listView) return;
      listView.classList.add('hidden');
      detailView.classList.remove('hidden');
      detailView.replaceChildren();
      document.title = `${article.title} | Zaloma Florist`;
      const progress = makeElement('div', 'blog-reading-progress');
      const progressBar = makeElement('span', 'blog-reading-progress-bar');
      progress.append(progressBar);
      detailView.append(progress);

      const container = makeElement('div', 'blog-detail-container');
      const breadcrumb = makeElement('nav', 'blog-detail-breadcrumb');
      breadcrumb.setAttribute('aria-label', 'Breadcrumb');
      const backLink = makeElement('a', '', 'Artikel & Tips');
      backLink.href = ARTICLES_PATH;
      breadcrumb.append(backLink, makeElement('span', '', '/'), makeElement('span', '', article.category));

      const header = makeElement('header', 'blog-detail-header');
      header.append(makeElement('span', 'blog-detail-category', article.category));
      header.append(makeElement('h1', 'blog-detail-title', article.title));
      header.append(makeElement('p', 'blog-detail-excerpt', article.excerpt));
      const authorRow = makeElement('div', 'blog-detail-byline');
      const authorInitial = makeElement('span', 'blog-author-initial', (article.author || 'Z').trim().charAt(0).toUpperCase());
      const authorInfo = makeElement('div', '');
      authorInfo.append(makeElement('strong', '', article.author || 'Tim Zaloma Florist'));
      authorInfo.append(makeElement('span', '', article.authorRole || 'Kontributor Zaloma Florist'));
      authorRow.append(authorInitial, authorInfo, makeElement('span', 'blog-detail-date', `${article.date || article.isoDate || ''} · ${readingTime(article)} menit baca`));
      header.append(authorRow);

      const hero = makeElement('div', 'blog-detail-hero');
      const heroImage = document.createElement('img');
      heroImage.src = safeImageUrl(article.image);
      heroImage.alt = article.title;
      heroImage.loading = 'eager';
      hero.append(heroImage);

      const layout = makeElement('div', 'blog-detail-layout');
      const contentColumn = makeElement('div', 'blog-detail-main');
      const content = article.content;
      if (typeof content === 'string') {
        content.split(/\n{2,}/).map(part => part.trim()).filter(Boolean).forEach((paragraph, index) => {
          addParagraph(contentColumn, paragraph, index === 0 ? 'blog-detail-lead' : 'blog-detail-paragraph');
        });
      } else {
        addParagraph(contentColumn, content?.lead || article.excerpt, 'blog-detail-lead');
        (content?.sections || []).forEach(section => {
          if (section.heading) contentColumn.append(makeElement('h2', 'blog-detail-heading', section.heading));
          (section.body || []).forEach(paragraph => addParagraph(contentColumn, paragraph, 'blog-detail-paragraph'));
          if (section.tip) {
            const tip = makeElement('aside', 'blog-detail-tip');
            tip.append(makeElement('strong', '', 'Tips Zaloma Florist'), makeElement('p', '', section.tip));
            contentColumn.append(tip);
          }
        });
        addParagraph(contentColumn, content?.conclusion || '', 'blog-detail-paragraph');
      }
      const share = makeElement('a', 'blog-detail-share', 'Bagikan artikel via WhatsApp');
      share.href = `https://wa.me/?text=${encodeURIComponent(`${article.title} ${window.location.href}`)}`;
      share.target = '_blank';
      share.rel = 'noopener noreferrer';
      contentColumn.append(share);

      const sidebar = makeElement('aside', 'blog-detail-sidebar');
      sidebar.append(makeElement('h2', '', 'Artikel lainnya'));
      allArticles.filter(item => item.slug !== article.slug).slice(0, 4).forEach(item => {
        const related = makeElement('a', 'blog-related-link');
        related.href = articleUrl(item.slug);
        const relatedImage = document.createElement('img');
        relatedImage.src = safeImageUrl(item.image);
        relatedImage.alt = '';
        relatedImage.loading = 'lazy';
        const relatedText = makeElement('span', '');
        relatedText.append(makeElement('small', '', item.category), makeElement('strong', '', item.title));
        related.append(relatedImage, relatedText);
        sidebar.append(related);
      });
      layout.append(contentColumn, sidebar);
      container.append(breadcrumb, header, hero, layout);
      detailView.append(container);

      const updateProgress = () => {
        const scrollable = document.documentElement.scrollHeight - window.innerHeight;
        const progressValue = scrollable > 0 ? Math.min(100, Math.max(0, window.scrollY / scrollable * 100)) : 0;
        progressBar.style.width = `${progressValue}%`;
      };
      window.addEventListener('scroll', updateProgress, { passive: true });
      updateProgress();
    }

    async function initializeArticlePage() {
      let articles = fallbackArticles.filter(validArticle);
      const requestedSlug = new URLSearchParams(window.location.search).get('slug');
      if (requestedSlug && listView && detailView) {
        listView.classList.add('hidden');
        detailView.classList.remove('hidden');
        detailView.textContent = 'Memuat artikel…';
      }
      try {
        const endpoint = new URL('/rest/v1/products', SUPABASE_URL);
        endpoint.searchParams.set('slug', `eq.${ARTICLES_CONFIG_SLUG}`);
        endpoint.searchParams.set('select', 'description');
        endpoint.searchParams.set('limit', '1');
        const response = await fetch(endpoint, { headers: { apikey: SUPABASE_ANON_KEY }, cache: 'no-store' });
        if (!response.ok) throw new Error(`Request failed with status ${response.status}`);
        const rows = await response.json();
        if (rows[0]?.description) {
          const configured = JSON.parse(rows[0].description);
          if (!Array.isArray(configured) || !configured.every(validArticle)) throw new Error('Data artikel tidak valid.');
          articles = configured;
        }
      } catch (error) {
        console.warn('[Zaloma Articles] Runtime article sync failed; using prerendered articles:', error);
      }

      if (requestedSlug) {
        const article = articles.find(item => item.slug === requestedSlug);
        if (article) {
          renderArticleDetail(article, articles);
        } else if (detailView && listView) {
          listView.classList.add('hidden');
          detailView.classList.remove('hidden');
          const notFound = makeElement('p', 'blog-detail-container py-16 text-center', 'Artikel tidak ditemukan atau sudah dihapus.');
          const backLink = makeElement('a', 'blog-card-read mt-4 inline-flex', 'Kembali ke semua artikel');
          backLink.href = ARTICLES_PATH;
          detailView.replaceChildren(notFound, backLink);
          document.title = 'Artikel tidak ditemukan | Zaloma Florist';
        }
      } else {
        renderArticleCards(articles);
      }
    }

    initializeArticlePage();
  </script>

</Layout>
