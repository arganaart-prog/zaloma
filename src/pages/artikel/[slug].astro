---
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { ARTICLES, getRelatedArticles, type Article } from '../../data/articles';
import '../../styles/blog.css';
import { withBase } from '../../utils/paths';

export function getStaticPaths() {
  return ARTICLES.map((article) => ({
    params: { slug: article.slug },
    props: { article },
  }));
}

interface Props {
  article: Article;
}

const { article } = Astro.props;
const relatedArticles = getRelatedArticles(article.slug, 3);
const canonicalArticleUrl = new URL(withBase(`/artikel/${article.slug}/`), 'https://zalomaflorist.com').toString();
const articleWords = [
  article.content.lead,
  ...article.content.sections.flatMap((section) => [section.heading, ...section.body, section.tip || '']),
  article.content.conclusion,
].join(' ').trim().split(/\s+/).filter(Boolean).length;
const readingMinutes = Math.max(1, Math.ceil(articleWords / 200));

const title = `${article.title} | Zaloma Florist`;
const description = article.excerpt;
---

<Layout title={title} description={description} image={withBase(article.image)}>
  <article class="blog-detail bg-clean-ivory min-h-screen py-8 md:py-14">
    <div class="blog-detail-container">
      <!-- Breadcrumb -->
      <div class="blog-detail-breadcrumb">
        <Breadcrumb items={[
          { label: 'Artikel & Panduan', href: '/artikel/' },
          { label: article.title }
        ]} />
      </div>

      <!-- Article Header -->
      <header class="blog-detail-header">
        <span class="blog-detail-category">{article.category}</span>
        <h1 class="blog-detail-title">
          {article.title}
        </h1>
        <p class="blog-detail-excerpt">{article.excerpt}</p>

        <!-- Author Strip -->
        <div class="blog-detail-byline">
          <span class="blog-author-initial">{article.author.charAt(0)}</span>
          <div>
            <strong>{article.author}</strong>
            <span>{article.authorRole}</span>
          </div>
          <span class="blog-detail-date">{article.date} · {readingMinutes} menit baca</span>
        </div>
      </header>

      <!-- Featured Image -->
      <div class="blog-detail-hero">
        <img
          src={withBase(article.image)}
          alt={article.title}
          loading="eager"
          decoding="async"
        />
      </div>

      <!-- Article Content Body -->
      <div class="blog-detail-layout">
        <div class="blog-detail-main">
          <p class="blog-detail-lead">{article.content.lead}</p>

          {article.content.sections.map((section) => (
            <div class="space-y-4 pt-2">
              <h2 class="blog-detail-heading">{section.heading}</h2>
              {section.body.map((para) => <p class="blog-detail-paragraph">{para}</p>)}
              {section.tip && (
                <aside class="blog-detail-tip">
                  <p><strong>Catatan Florist:</strong> {section.tip}</p>
                </aside>
              )}
            </div>
          ))}

          <div class="pt-6 border-t border-slate-200">
            <p class="blog-detail-paragraph">{article.content.conclusion}</p>
          </div>

          <div class="blog-detail-actions">
            <div class="flex flex-wrap items-center gap-2">
              {article.tags.map((tag) => (
                <span class="rounded-full border border-soft-cream bg-white px-3 py-1 text-xs text-slate-600">#{tag}</span>
              ))}
            </div>
            <div class="blog-share-actions">
              <a href={`https://wa.me/?text=${encodeURIComponent(`${article.title} ${canonicalArticleUrl}`)}`} target="_blank" rel="noopener noreferrer">Bagikan WhatsApp</a>
              <a href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(canonicalArticleUrl)}`} target="_blank" rel="noopener noreferrer">Facebook</a>
              <button type="button" data-copy-article-link>Salin tautan</button>
            </div>
            <p class="blog-copy-status" data-copy-status aria-live="polite"></p>
          </div>

          <a href={withBase('/artikel/')} class="blog-back-link">← Kembali ke artikel</a>
        </div>

        <aside class="blog-detail-sidebar">
          <h2>Artikel lainnya</h2>
          {relatedArticles.map((related) => (
            <a href={withBase(`/artikel/?slug=${encodeURIComponent(related.slug)}`)} class="blog-related-link">
              <img src={withBase(related.image)} alt="" loading="lazy" decoding="async" />
              <span>
                <small>{related.category} · {related.date}</small>
                <strong>{related.title}</strong>
              </span>
            </a>
          ))}
          <div class="blog-sidebar-promo">
            <p>Butuh bantuan memilih rangkaian?</p>
            <a href={withBase('/katalog/')}>Jelajahi katalog <span aria-hidden="true">→</span></a>
          </div>
        </aside>
      </div>
    </div>
    <div class="blog-reading-progress" aria-hidden="true"><span class="blog-reading-progress-bar"></span></div>
  </article>
  <script>
    const progressBar = document.querySelector('.blog-reading-progress-bar');
    if (progressBar instanceof HTMLElement) {
      const updateProgress = () => {
        const scrollable = document.documentElement.scrollHeight - window.innerHeight;
        const progress = scrollable > 0 ? Math.min(100, Math.max(0, window.scrollY / scrollable * 100)) : 0;
        progressBar.style.width = `${progress}%`;
      };
      window.addEventListener('scroll', updateProgress, { passive: true });
      updateProgress();
    }

    const copyLinkButton = document.querySelector('[data-copy-article-link]');
    const copyStatus = document.querySelector('[data-copy-status]');
    if (copyLinkButton instanceof HTMLButtonElement && copyStatus instanceof HTMLElement) {
      copyLinkButton.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(window.location.href);
          copyStatus.textContent = 'Tautan artikel berhasil disalin.';
        } catch (error) {
          console.error('[Zaloma Articles] Failed to copy article link:', error);
          copyStatus.textContent = 'Tautan tidak dapat disalin. Silakan salin dari bilah alamat.';
        }
      });
    }
  </script>
</Layout>
