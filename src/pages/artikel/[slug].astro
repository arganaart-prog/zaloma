---
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { ARTICLES, getRelatedArticles, type Article } from '../../data/articles';
import '../../styles/blog.css';
import { withBase } from '../../utils/paths';
import { WHATSAPP_NUMBER } from '../../data/constants';

export function getStaticPaths() {
  return ARTICLES.map((article) => ({
    params: { slug: article.slug },
    props: { article },
  }));
}

interface Props {
  article: Article;
}

const { article } = Astro.props;
const relatedArticles = getRelatedArticles(article.slug, 3);
const articleWords = [
  article.content.lead,
  ...article.content.sections.flatMap((section) => [section.heading, ...section.body, section.tip || '']),
  article.content.conclusion,
].join(' ').trim().split(/\s+/).filter(Boolean).length;
const readingMinutes = Math.max(1, Math.ceil(articleWords / 200));

const title = `${article.title} | Zaloma Florist Malang`;
const description = article.excerpt;
---

<Layout title={title} description={description} image={withBase(article.image)}>
  <article class="blog-detail bg-clean-ivory min-h-screen py-8 md:py-14">
    <div class="blog-detail-container">
      <!-- Breadcrumb -->
      <div class="blog-detail-breadcrumb">
        <Breadcrumb items={[
          { label: 'Artikel & Panduan', href: '/artikel/' },
          { label: article.title }
        ]} />
      </div>

      <!-- Article Header -->
      <header class="blog-detail-header">
        <span class="blog-detail-category">{article.category}</span>
        <h1 class="blog-detail-title">
          {article.title}
        </h1>
        <p class="blog-detail-excerpt">{article.excerpt}</p>

        <!-- Author Strip -->
        <div class="blog-detail-byline">
          <span class="blog-author-initial">{article.author.charAt(0)}</span>
          <div>
            <strong>{article.author}</strong>
            <span>{article.authorRole}</span>
          </div>
          <span class="blog-detail-date">{article.date} · {readingMinutes} menit baca</span>
        </div>
      </header>

      <!-- Featured Image -->
      <div class="blog-detail-hero">
        <img
          src={withBase(article.image)}
          alt={article.title}
          loading="eager"
          decoding="async"
        />
      </div>

      <!-- Article Content Body -->
      <div class="blog-detail-main max-w-3xl mx-auto mt-10">
        <!-- Lead Paragraph -->
        <p class="blog-detail-lead">
          {article.content.lead}
        </p>

        <!-- Sections -->
        {article.content.sections.map((section) => (
          <div class="space-y-4 pt-2">
            <h2 class="blog-detail-heading">
              {section.heading}
            </h2>
            {section.body.map((para) => (
              <p class="blog-detail-paragraph">
                {para}
              </p>
            ))}

            {section.tip && (
              <div class="blog-detail-tip">
                <p><strong>Tips Zaloma Florist:</strong> {section.tip}</p>
              </div>
            )}
          </div>
        ))}

        <!-- Conclusion -->
        <div class="pt-6 border-t border-slate-200">
          <p class="blog-detail-paragraph">
            {article.content.conclusion}
          </p>
        </div>
      </div>

      <!-- Tags & Share -->
      <div class="mt-10 pt-6 border-t border-cream/90 flex flex-wrap items-center justify-between gap-4">
        <div class="flex flex-wrap items-center gap-2">
          <span class="text-xs font-semibold text-slate-400">Tag:</span>
          {article.tags.map((tag) => (
            <span class="px-2.5 py-1 rounded-md bg-white border border-slate-200 text-xs text-slate-600 font-medium">
              #{tag}
            </span>
          ))}
        </div>

        <a
          href={`https://wa.me/?text=${encodeURIComponent(`Baca artikel bermanfaat dari Zaloma Florist: "${article.title}"`)}`}
          target="_blank"
          rel="noopener noreferrer"
          class="blog-detail-share"
        >
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.711 2.598 2.669-.699c.969.54 1.838.847 2.791.848 3.18 0 5.767-2.587 5.768-5.766.001-3.18-2.585-5.834-5.768-5.834zm3.377 8.243c-.147.411-.75.76-1.042.812-.292.052-.663.097-2.072-.49-1.409-.587-2.327-2.016-2.398-2.112-.07-.095-.572-.76-.572-1.45 0-.69.362-1.029.49-1.173.129-.144.281-.18.375-.18.094 0 .188.001.27.006.086.005.201-.033.315.241.114.275.39 1.025.424 1.107.034.082.057.178.002.288-.055.11-.082.179-.164.275-.082.096-.173.214-.247.288-.082.083-.168.172-.072.337.096.165.427.705.916 1.141.63.562 1.161.736 1.326.818.165.082.261.069.358-.041.096-.11.413-.48.523-.645.11-.165.22-.138.371-.082.151.055.955.45 1.12.533.165.082.275.124.316.192.041.069.041.399-.106.81zM12.012 2.002C6.488 2.002 2 6.49 2 12.014c0 1.942.553 3.755 1.517 5.289L2 22l4.821-1.488A9.97 9.97 0 0 0 12.012 22C17.535 22 22 17.51 22 12.014c0-5.524-4.465-10.012-9.988-10.012z"/>
          </svg>
          Bagikan ke WhatsApp
        </a>
      </div>

      <!-- Action Card -->
      <div class="mt-12 bg-white rounded-2xl border border-secondary/40 p-6 sm:p-8 shadow-md flex flex-col sm:flex-row items-center justify-between gap-6">
        <div>
          <h3 class="font-serif text-xl font-bold text-slate-800">Siap Pesan Karangan Bunga Impian Anda?</h3>
          <p class="text-xs sm:text-sm text-slate-500 mt-1">Konsultasikan kebutuhan bunga papan, buket, standing flower, atau tanbulampot sekarang.</p>
        </div>
        <div class="flex items-center gap-3 w-full sm:w-auto">
          <a
            href={withBase('/katalog/')}
            class="flex-1 sm:flex-initial text-center px-5 py-2.5 rounded-full bg-primary text-white text-xs font-bold hover:bg-primary-dark transition-all"
          >
            Lihat Katalog
          </a>
          <a
            href={`https://wa.me/${WHATSAPP_NUMBER}?text=Halo%20Zaloma Florist,%20saya%20tertarik%20dengan%20artikel%20"${encodeURIComponent(article.title)}"%20dan%20ingin%20tanya%20pemesanan%20bunga.`}
            target="_blank"
            rel="noopener noreferrer"
            class="flex-1 sm:flex-initial text-center px-5 py-2.5 rounded-full bg-secondary text-white text-xs font-bold hover:bg-secondary-dark transition-all"
          >
            Chat WhatsApp
          </a>
        </div>
      </div>

      <!-- Related Articles -->
      {relatedArticles.length > 0 && (
        <div class="mt-16 pt-10 border-t border-slate-200">
          <h3 class="font-serif text-2xl font-bold text-slate-800 mb-6">Artikel Terkait Lainnya</h3>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            {relatedArticles.map((rel) => (
              <a
                href={withBase(`/artikel/?slug=${encodeURIComponent(rel.slug)}`)}
                class="blog-card bg-white"
              >
                <div class="aspect-[16/10] rounded-lg overflow-hidden bg-accent-bg mb-3">
                  <img
                    src={withBase(rel.image)}
                    alt={rel.title}
                    class="w-full h-full object-cover"
                    loading="lazy"
                  />
                </div>
                <span class="text-[10px] font-bold uppercase tracking-wider text-secondary mb-1">
                  {rel.category}
                </span>
                <h4 class="font-serif text-sm font-bold text-slate-800 group-hover:text-primary transition-colors line-clamp-2 leading-snug flex-1">
                  {rel.title}
                </h4>
                <span class="text-[11px] text-slate-400 mt-2 font-medium">
                  {rel.date}
                </span>
              </a>
            ))}
          </div>
        </div>
      )}
    </div>
    <div class="blog-reading-progress" aria-hidden="true"><span class="blog-reading-progress-bar"></span></div>
  </article>
  <script lang="ts">
    const progressBar = document.querySelector('.blog-reading-progress-bar');
    if (progressBar instanceof HTMLElement) {
      const updateProgress = () => {
        const scrollable = document.documentElement.scrollHeight - window.innerHeight;
        const progress = scrollable > 0 ? Math.min(100, Math.max(0, window.scrollY / scrollable * 100)) : 0;
        progressBar.style.width = `${progress}%`;
      };
      window.addEventListener('scroll', updateProgress, { passive: true });
      updateProgress();
    }
  </script>
</Layout>
