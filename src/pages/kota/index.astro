</style>

<script is:inline>
(function() {
  const searchInput = document.getElementById('searchAllCitiesInput');
  const cityCards = Array.from(document.querySelectorAll('[data-city-card]'));
  const provinceSections = Array.from(document.querySelectorAll('[data-province-section]'));
  const emptyState = document.getElementById('allCitiesEmptyState');

  if (!searchInput) return;

  function handleSearch() {
    const q = searchInput.value.trim().toLowerCase();
    let totalVisible = 0;

    provinceSections.forEach(section => {
      const cards = Array.from(section.querySelectorAll('[data-city-card]'));
      let sectionVisibleCount = 0;

      cards.forEach(card => {
        const name = card.getAttribute('data-city-name') || '';
        const prov = card.getAttribute('data-province-name') || '';
        const matches = !q || name.includes(q) || prov.includes(q);

        if (matches) {
          card.style.display = '';
          sectionVisibleCount++;
          totalVisible++;
        } else {
          card.style.display = 'none';
        }
      });

      // Sembunyikan section provinsi jika seluruh kota di dalamnya tersembunyi
      if (sectionVisibleCount === 0) {
        section.style.display = 'none';
      } else {
        section.style.display = '';
      }
    });

    if (emptyState) {
      if (totalVisible === 0) {
        emptyState.classList.remove('hidden');
      } else {
        emptyState.classList.add('hidden');
      }
    }
  }

  searchInput.addEventListener('input', handleSearch);
})();
</script>
