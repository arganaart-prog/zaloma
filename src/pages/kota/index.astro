---
import Layout from '../../layouts/Layout.astro';
import { DEFAULT_CITIES, cityToSlug } from '../../data/cities';
import { SUPABASE_URL, SUPABASE_ANON_KEY } from '../../data/supabaseConfig';
import { WHATSAPP_NUMBER } from '../../data/constants';
import { withBase } from '../../utils/paths';

// Fetch dynamic cities from Supabase if available
let dynamicCities: any[] = [];
try {
  const res = await fetch(`${SUPABASE_URL}/rest/v1/cities?select=*&order=name.asc`, {
    headers: {
      apikey: SUPABASE_ANON_KEY,
      Authorization: `Bearer ${SUPABASE_ANON_KEY}`
    }
  });
  if (res.ok) {
    const data = await res.json();
    if (Array.isArray(data) && data.length > 0) {
      dynamicCities = data;
    }
  }
} catch (e) {
  // Silent fallback
}

// Fallback to settings if table empty
if (dynamicCities.length === 0) {
  try {
    const res = await fetch(`${SUPABASE_URL}/rest/v1/settings?key=eq.cities&select=value`, {
      headers: {
        apikey: SUPABASE_ANON_KEY,
        Authorization: `Bearer ${SUPABASE_ANON_KEY}`
      }
    });
    if (res.ok) {
      const data = await res.json();
      if (Array.isArray(data) && data[0]?.value) {
        let val = data[0].value;
        if (typeof val === 'string') val = JSON.parse(val);
        if (Array.isArray(val)) dynamicCities = val;
      }
    }
  } catch (e) {
    // Silent fallback
  }
}

// Merge & deduplicate
const cityMap = new Map<string, any>();
DEFAULT_CITIES.forEach(c => {
  cityMap.set(c.slug, {
    name: c.name,
    slug: c.slug,
    image: c.image || '/images/galeri/gallery-1.webp',
    description: c.description || 'Pengiriman karangan bunga, buket & standing flower cepat.',
    isMainArea: Boolean(c.isMainArea),
    province: c.isMainArea ? 'Jawa Timur (Workshop Utama)' : 'Area Pengiriman'
  });
});

dynamicCities.forEach(c => {
  const rawName = typeof c === 'string' ? c : (c.name || '');
  if (!rawName) return;
  const slug = typeof c === 'object' && c.slug ? c.slug : cityToSlug(rawName);
  const existing = cityMap.get(slug);
  const image = (typeof c === 'object' && c.image_url) ? c.image_url : (existing?.image || '/images/galeri/gallery-2.webp');
  const description = (typeof c === 'object' && c.description) ? c.description : (existing?.description || `Florist partner pengiriman karangan bunga & buket segar di ${rawName}.`);
  const province = (typeof c === 'object' && c.province_name) ? c.province_name : (existing?.province || 'Area Pengiriman');

  cityMap.set(slug, {
    name: rawName,
    slug,
    image,
    description,
    isMainArea: existing?.isMainArea || false,
    province
  });
});

const allCities = Array.from(cityMap.values());

const siteUrl = 'https://zalomaflorist.com';
const pageTitle = 'Area Pengiriman Bunga Indonesia | Zaloma Florist';
const pageDesc = 'Lihat daftar kota jangkauan pengiriman Zaloma Florist untuk pesan bunga online, karangan bunga papan, buket bunga, standing flower & bunga meja terpercaya di Indonesia.';
const waConsultUrl = `https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent('Halo Zaloma Florist, saya ingin tanya pengiriman bunga ke kota saya...')}`;

// Schema JSON-LD CollectionPage
const collectionSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  'name': pageTitle,
  'description': pageDesc,
  'url': `${siteUrl}/kota/`,
  'mainEntity': {
    '@type': 'ItemList',
    'itemListElement': allCities.map((c, i) => ({
      '@type': 'ListItem',
      'position': i + 1,
      'name': `Toko Bunga ${c.name} - Zaloma Florist`,
      'url': `${siteUrl}/kota/${c.slug}/`
    }))
  }
};
---

<Layout
  title={pageTitle}
  description={pageDesc}
  schema={collectionSchema}
  canonical={`${siteUrl}/kota/`}
>
  <div class="min-h-screen bg-[#FDFBF7]">
    <!-- HERO SECTION KOTA -->
    <section class="relative bg-gradient-to-br from-[#1C2E24] via-[#243B2E] to-[#16251D] text-white pt-28 pb-16 md:pt-36 md:pb-24 overflow-hidden">
      <!-- Decorative background blur/orbs -->
      <div class="absolute inset-0 opacity-15 pointer-events-none" style="background-image: radial-gradient(circle at 20% 30%, #C5A25D 0%, transparent 40%), radial-gradient(circle at 80% 70%, #5B8266 0%, transparent 45%);"></div>
      
      <div class="container mx-auto px-4 sm:px-6 lg:px-8 max-w-6xl relative z-10 text-center">
        <!-- Eyebrow -->
        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-white/10 backdrop-blur-md border border-white/20 text-[#E2C37E] text-xs font-semibold uppercase tracking-wider mb-5">
          <span class="w-2 h-2 rounded-full bg-[#E2C37E] animate-ping"></span>
          Jangkauan Pengiriman Florist Nasional
        </div>

        <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-serif font-bold tracking-tight text-white mb-5 leading-tight">
          Kirim Bunga ke <span class="text-[#E2C37E] underline decoration-[#C5A25D]/50 decoration-wavy">Seluruh Kota</span>
        </h1>

        <p class="text-gray-300 text-sm sm:text-base md:text-lg max-w-2xl mx-auto leading-relaxed mb-8">
          Pilih kota tujuan pengiriman Anda. Kami bermitra dengan workshop florist profesional di setiap kota untuk menjamin kesegaran bunga dan kecepatan tiba di lokasi acara.
        </p>

        <!-- Trust Badges Strip -->
        <div class="flex flex-wrap items-center justify-center gap-3 sm:gap-6 mb-10 text-xs sm:text-sm text-gray-200">
          <div class="flex items-center gap-2 bg-white/10 backdrop-blur-sm px-4 py-2 rounded-full border border-white/15">
            <svg class="w-4 h-4 text-[#E2C37E]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
            <span><strong class="text-white">{allCities.length}+ Kota</strong> Tersedia</span>
          </div>
          <div class="flex items-center gap-2 bg-white/10 backdrop-blur-sm px-4 py-2 rounded-full border border-white/15">
            <svg class="w-4 h-4 text-[#E2C37E]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            <span>Garansi Kesegaran Bunga</span>
          </div>
          <div class="flex items-center gap-2 bg-white/10 backdrop-blur-sm px-4 py-2 rounded-full border border-white/15">
            <svg class="w-4 h-4 text-[#E2C37E]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            <span>Same Day Delivery Cepat</span>
          </div>
        </div>

        <!-- Realtime Search Bar -->
        <div class="max-w-xl mx-auto relative">
          <div class="relative flex items-center bg-white/95 backdrop-blur-md rounded-2xl shadow-2xl p-2 border border-white/30 text-gray-800 transition-all focus-within:ring-4 focus-within:ring-[#C5A25D]/40">
            <div class="pl-3 pr-2 text-[#5B8266]">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
            </div>
            <input 
              id="directory-city-search" 
              type="text" 
              placeholder="Ketik nama kota tujuan Anda (contoh: Surabaya, Malang, Batu)..."
              class="w-full bg-transparent border-none text-gray-800 placeholder-gray-400 text-sm sm:text-base font-medium focus:outline-none focus:ring-0 py-2.5 px-2"
              autocomplete="off"
            />
            <button 
              id="clear-directory-search" 
              type="button" 
              class="hidden px-2.5 py-1 text-xs text-gray-400 hover:text-gray-700 font-semibold"
              title="Reset pencarian"
            >
              Clear
            </button>
          </div>
          <p class="text-xs text-gray-400 mt-2.5">
            Ditemukan <span id="cities-counter" class="text-[#E2C37E] font-bold">{allCities.length}</span> kota jangkauan aktif.
          </p>
        </div>
      </div>
    </section>

    <!-- BREADCRUMB -->
    <div class="bg-[#F4EFEA] border-b border-[#E8DFC8]/60 py-3">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8 max-w-6xl">
        <nav class="flex items-center text-xs text-gray-500 gap-2">
          <a href={withBase('/')} class="hover:text-[#5B8266] transition-colors">Beranda</a>
          <svg class="w-3.5 h-3.5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
          <span class="text-gray-800 font-semibold">Area Pengiriman Kota</span>
        </nav>
      </div>
    </div>

    <!-- MAIN CITIES GRID SECTION -->
    <section class="py-12 md:py-20">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8 max-w-6xl">
        
        <!-- Header -->
        <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-10 pb-4 border-b border-gray-200">
          <div>
            <span class="text-[#5B8266] text-xs font-bold uppercase tracking-wider block mb-1">Katalog Wilayah</span>
            <h2 class="text-2xl sm:text-3xl font-serif font-bold text-gray-900">Daftar Kota Jangkauan Pengiriman</h2>
          </div>
          <p class="text-xs sm:text-sm text-gray-500 max-w-md">
            Pilih kota untuk melihat katalog karangan bunga, buket & standing flower yang tersedia khusus untuk area tersebut.
          </p>
        </div>

        <!-- City Cards Grid -->
        <div id="city-cards-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {allCities.map((city) => (
            <a
              href={withBase(`/kota/${city.slug}/`)}
              data-city-card
              data-city-name={city.name.toLowerCase()}
              data-city-province={city.province.toLowerCase()}
              class="group relative h-56 sm:h-64 rounded-2xl overflow-hidden block border border-gray-100 shadow-md hover:shadow-2xl transition-all duration-500 hover:-translate-y-1.5 bg-[#1C2E24]"
            >
              <!-- Background Image -->
              <img
                src={withBase(city.image)}
                alt={`Toko Bunga ${city.name} - Zaloma Florist`}
                class="absolute inset-0 w-full h-full object-cover group-hover:scale-110 transition-transform duration-700 ease-out opacity-85"
                loading="lazy"
              />

              <!-- Multi-layer Gradient Overlay for readability -->
              <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/45 to-transparent"></div>

              <!-- Top Badges -->
              <div class="absolute top-4 left-4 right-4 flex items-center justify-between pointer-events-none z-10">
                <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[11px] font-semibold bg-white/20 backdrop-blur-md text-white border border-white/25">
                  <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
                  {city.isMainArea ? 'Workshop Pusat' : 'Layanan Mitra'}
                </span>
                <span class="inline-flex items-center text-[10px] text-white/90 bg-black/40 backdrop-blur-md px-2.5 py-1 rounded-full border border-white/10">
                  Same Day 3 Jam
                </span>
              </div>

              <!-- Content Bottom -->
              <div class="absolute inset-0 flex flex-col justify-end p-5 z-10">
                <div class="flex items-end justify-between gap-3">
                  <div class="min-w-0 flex-1">
                    <h3 class="text-xl sm:text-2xl font-serif font-bold text-white mb-1 group-hover:text-[#E2C37E] transition-colors drop-shadow line-clamp-1">
                      {city.name}
                    </h3>
                    <p class="text-white/80 text-xs font-medium flex items-center gap-1 line-clamp-1">
                      <svg class="w-3.5 h-3.5 text-[#E2C37E] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/></svg>
                      <span>{city.province}</span>
                    </p>
                  </div>

                  <!-- Arrow Circle Button -->
                  <div class="w-10 h-10 rounded-full bg-white/20 backdrop-blur-md flex items-center justify-center text-white border border-white/30 shrink-0 group-hover:bg-[#C5A25D] group-hover:border-[#C5A25D] transition-colors shadow-lg">
                    <svg class="w-4 h-4 transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
                  </div>
                </div>
              </div>
            </a>
          ))}
        </div>

        <!-- Empty State Container -->
        <div id="city-empty-container" class="hidden text-center py-16 px-4 bg-white rounded-3xl border border-gray-100 shadow-sm max-w-lg mx-auto mt-8">
          <div class="w-16 h-16 rounded-full bg-[#FAF5E6] flex items-center justify-center text-[#C5A25D] mx-auto mb-4">
            <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
          </div>
          <h3 class="text-lg font-bold text-gray-900 mb-1">Kota Tidak Ditemukan</h3>
          <p class="text-sm text-gray-500 mb-6">
            Kami mungkin belum menampilkan kota tersebut di daftar katalog web, namun kami siap membantu pengiriman melalui jaringan florist kami.
          </p>
          <a
            href={waConsultUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-[#25D366] text-white font-semibold text-sm hover:bg-[#1EBE5D] transition-colors shadow-md"
          >
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/></svg>
            Tanya Pengiriman ke Kota Anda via WA
          </a>
        </div>

        <!-- WhatsApp Consultation CTA Box (Sekarsari Style) -->
        <div class="mt-16 bg-gradient-to-br from-[#1C2E24] to-[#2E4A3B] rounded-3xl p-8 sm:p-12 text-white text-center shadow-xl relative overflow-hidden">
          <div class="absolute -right-16 -top-16 w-56 h-56 bg-[#C5A25D]/15 rounded-full blur-3xl pointer-events-none"></div>
          
          <div class="w-14 h-14 rounded-2xl bg-white/10 backdrop-blur-md border border-white/20 flex items-center justify-center text-[#E2C37E] mx-auto mb-5 shadow-inner">
            <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/></svg>
          </div>

          <h3 class="text-2xl sm:text-3xl font-serif font-bold mb-3">Tidak Menemukan Kota Tujuan Anda?</h3>
          <p class="text-gray-300 text-sm sm:text-base max-w-2xl mx-auto mb-8 font-light leading-relaxed">
            Zaloma Florist melayani pengiriman khusus ke seluruh Indonesia melalui jaringan rekanan workshop terpercaya. Konsultasikan kota, alamat dan jenis bunga yang Anda butuhkan dengan tim kami.
          </p>

          <a
            href={waConsultUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-3 bg-white text-[#1C2E24] px-8 py-4 rounded-full font-bold text-sm sm:text-base hover:bg-[#FAF5E6] hover:text-[#5B8266] transition-all shadow-lg hover:shadow-2xl hover:-translate-y-0.5"
          >
            <svg class="w-5 h-5 text-[#25D366]" fill="currentColor" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/></svg>
            Konsultasi WhatsApp Sekarang
          </a>
        </div>

      </div>
    </section>
  </div>
</Layout>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const searchInput = document.getElementById('directory-city-search');
    const clearBtn = document.getElementById('clear-directory-search');
    const counterEl = document.getElementById('cities-counter');
    const cards = Array.from(document.querySelectorAll('[data-city-card]'));
    const emptyContainer = document.getElementById('city-empty-container');

    if (!searchInput) return;

    function filterCities() {
      const q = searchInput.value.trim().toLowerCase();
      let visibleCount = 0;

      if (q) {
        clearBtn?.classList.remove('hidden');
      } else {
        clearBtn?.classList.add('hidden');
      }

      cards.forEach(card => {
        const name = card.getAttribute('data-city-name') || '';
        const prov = card.getAttribute('data-city-province') || '';
        const match = !q || name.includes(q) || prov.includes(q);

        if (match) {
          card.style.display = '';
          visibleCount++;
        } else {
          card.style.display = 'none';
        }
      });

      if (counterEl) {
        counterEl.textContent = String(visibleCount);
      }

      if (emptyContainer) {
        if (visibleCount === 0) {
          emptyContainer.classList.remove('hidden');
        } else {
          emptyContainer.classList.add('hidden');
        }
      }
    }

    searchInput.addEventListener('input', filterCities);

    if (clearBtn) {
      clearBtn.addEventListener('click', () => {
        searchInput.value = '';
        filterCities();
        searchInput.focus();
      });
    }
  });
</script>

