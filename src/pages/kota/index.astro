---
import Layout from '../../layouts/Layout.astro';
import { DEFAULT_CITIES, cityToSlug } from '../../data/cities';
import { SUPABASE_URL, SUPABASE_ANON_KEY } from '../../data/supabaseConfig';
import { WHATSAPP_NUMBER } from '../../data/constants';
import { withBase } from '../../utils/paths';

// Fetch dynamic cities from Supabase if available
let dynamicCities: any[] = [];
try {
  const res = await fetch(`${SUPABASE_URL}/rest/v1/cities?select=*&order=name.asc`, {
    headers: {
      apikey: SUPABASE_ANON_KEY,
      Authorization: `Bearer ${SUPABASE_ANON_KEY}`
    }
  });
  if (res.ok) {
    const data = await res.json();
    if (Array.isArray(data) && data.length > 0) {
      dynamicCities = data;
    }
  }
} catch (e) {
  // Silent fallback
}

// Fallback to settings if table empty
if (dynamicCities.length === 0) {
  try {
    const res = await fetch(`${SUPABASE_URL}/rest/v1/settings?key=eq.cities&select=value`, {
      headers: {
        apikey: SUPABASE_ANON_KEY,
        Authorization: `Bearer ${SUPABASE_ANON_KEY}`
      }
    });
    if (res.ok) {
      const data = await res.json();
      if (Array.isArray(data) && data[0]?.value) {
        let val = data[0].value;
        if (typeof val === 'string') val = JSON.parse(val);
        if (Array.isArray(val)) dynamicCities = val;
      }
    }
  } catch (e) {
    // Silent fallback
  }
}

// Merge & deduplicate
const cityMap = new Map<string, any>();
DEFAULT_CITIES.forEach(c => {
  cityMap.set(c.slug, {
    name: c.name,
    slug: c.slug,
    image: c.image || '/images/galeri/gallery-1.webp',
    description: c.description || 'Pengiriman karangan bunga, buket & standing flower cepat.',
    isMainArea: Boolean(c.isMainArea),
    province: c.isMainArea ? 'Jawa Timur (Workshop Utama)' : 'Area Pengiriman'
  });
});

dynamicCities.forEach(c => {
  const rawName = typeof c === 'string' ? c : (c.name || '');
  if (!rawName) return;
  const slug = typeof c === 'object' && c.slug ? c.slug : cityToSlug(rawName);
  const existing = cityMap.get(slug);
  const image = (typeof c === 'object' && c.image_url) ? c.image_url : (existing?.image || '/images/galeri/gallery-2.webp');
  const description = (typeof c === 'object' && c.description) ? c.description : (existing?.description || `Florist partner pengiriman karangan bunga & buket segar di ${rawName}.`);
  const province = (typeof c === 'object' && c.province_name) ? c.province_name : (existing?.province || 'Area Pengiriman');

  cityMap.set(slug, {
    name: rawName,
    slug,
    image,
    description,
    isMainArea: existing?.isMainArea || false,
    province
  });
});

const allCities = Array.from(cityMap.values());

// Group cities by Province (Persis Sekarsari)
const groupMap = new Map<string, any[]>();
allCities.forEach(city => {
  const prov = city.province || 'Area Pengiriman';
  if (!groupMap.has(prov)) {
    groupMap.set(prov, []);
  }
  groupMap.get(prov)!.push(city);
});

// Urutkan provinsi
const sortedProvinces = Array.from(groupMap.keys()).sort((a, b) => {
  if (a.includes('Jawa Timur')) return -1;
  if (b.includes('Jawa Timur')) return 1;
  return a.localeCompare(b);
});

const groupedCities = sortedProvinces.map(prov => ({
  province: prov,
  cities: groupMap.get(prov)!
}));

const siteUrl = 'https://zalomaflorist.com';
const pageTitle = 'Area Jangkauan Pengiriman Seluruh Kota | Zaloma Florist';
const pageDesc = 'Lihat daftar lengkap kota jangkauan pengiriman karangan bunga, buket bunga, standing flower & bunga meja terpercaya dari Zaloma Florist di seluruh Indonesia.';
const waConsultUrl = `https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent('Halo Zaloma Florist, saya ingin tanya ketersediaan pengiriman bunga ke kota saya...')}`;

// Schema JSON-LD CollectionPage
const collectionSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  'name': pageTitle,
  'description': pageDesc,
  'url': `${siteUrl}/kota/`,
  'mainEntity': {
    '@type': 'ItemList',
    'itemListElement': allCities.map((c, i) => ({
      '@type': 'ListItem',
      'position': i + 1,
      'name': `${c.name} - Zaloma Florist`,
      'url': `${siteUrl}/kota/${c.slug}/`
    }))
  }
};
---

<Layout
  title={pageTitle}
  description={pageDesc}
  schema={collectionSchema}
  canonical={`${siteUrl}/kota/`}
>
  <div class="kota-page-root">
    
    <!-- =====================================================
         HERO SECTION (Persis Desain Sekarsari dengan Warna Zaloma)
         ===================================================== -->
    <section class="kota-hero">
      <!-- Background Image -->
      <div class="kota-hero__bg" aria-hidden="true"></div>
      
      <!-- Multi-layer Gradient Overlay Zaloma (#20080F ke #671E2F) -->
      <div class="kota-hero__overlay" aria-hidden="true"></div>
      <div class="kota-hero__overlay-bottom" aria-hidden="true"></div>

      <!-- Decorative Orbs & Lines -->
      <div class="kota-hero__decor" aria-hidden="true">
        <div class="kota-hero__orb kota-hero__orb--1"></div>
        <div class="kota-hero__orb kota-hero__orb--2"></div>
        <div class="kota-hero__line kota-hero__line--1"></div>
        <div class="kota-hero__line kota-hero__line--2"></div>
        <div class="kota-hero__line kota-hero__line--3"></div>
      </div>

      <div class="kota-hero__container">
        <!-- Eyebrow -->
        <div class="kota-hero__eyebrow">
          <span class="kota-hero__eyebrow-dot"></span>
          JANGKAUAN NASIONAL
        </div>
        
        <h1 class="kota-hero__title">
          Kirim Bunga ke <span class="kota-hero__accent">Seluruh Kota</span>
        </h1>
        
        <p class="kota-hero__desc">
          Pilih kota tujuan pengiriman Anda. Kami bermitra dengan florist profesional di setiap wilayah untuk menjamin kesegaran dan keindahan bunga pesanan Anda.
        </p>

        <!-- Trust Badges Persis Sekarsari -->
        <div class="kota-hero__trust">
          <div class="kota-hero__trust-item">
            <svg class="w-4 h-4 text-[#DFC397]" fill="currentColor" viewBox="0 0 24 24">
              <path d="M19 13h-2V7h2m-6 6h-2V7h2m6 10a2 2 0 0 1-2 2a2 2 0 0 1-2-2a2 2 0 0 1 2-2a2 2 0 0 1 2 2m-10 0a2 2 0 0 1-2 2a2 2 0 0 1-2-2a2 2 0 0 1 2-2a2 2 0 0 1 2 2m11-8v6h-2v-6m-4-6H3a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h1.2A3 3 0 0 1 7 19a3 3 0 0 1 2.8-2h4.4a3 3 0 0 1 2.8 2a3 3 0 0 1 2.8-2H21a2 2 0 0 0 2-2V9l-3-4h-5z"/>
            </svg>
            <span>{allCities.length}+ Kota Tersedia</span>
          </div>
          <div class="kota-hero__trust-item">
            <svg class="w-4 h-4 text-[#DFC397]" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12c5.16-1.26 9-6.45 9-12V5l-9-4zm-2 16l-4-4l1.41-1.41L10 14.17l6.59-6.59L18 9l-8 8z"/>
            </svg>
            <span>Garansi Kualitas</span>
          </div>
          <div class="kota-hero__trust-item">
            <svg class="w-4 h-4 text-[#DFC397]" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 2A10 10 0 1 0 22 12A10 10 0 0 0 12 2zm1 15h-2v-6h2zm0-8h-2V7h2z"/>
            </svg>
            <span>Same Day Delivery</span>
          </div>
        </div>

        <!-- Glassmorphism Search Bar -->
        <div class="kota-hero__search">
          <div class="kota-hero__search-icon">
            <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
          </div>
          <input 
            id="searchAllCitiesInput" 
            type="search" 
            class="kota-hero__search-input" 
            placeholder="Cari kota atau provinsi tujuan Anda..." 
            autocomplete="off"
          />
        </div>
      </div>

      <!-- Bottom Wave Divider -->
      <div class="kota-hero__wave" aria-hidden="true">
        <svg viewBox="0 0 1440 100" fill="none" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none">
          <path d="M0,60L80,55C160,50,320,40,480,45C640,50,800,70,960,72C1120,74,1280,58,1360,50L1440,42L1440,100L1360,100C1280,100,1120,100,960,100C800,100,640,100,480,100C320,100,160,100,80,100L0,100Z" fill="rgba(250, 240, 241, 0.4)" />
          <path d="M0,75L80,78C160,81,320,87,480,83C640,79,800,65,960,62C1120,59,1280,67,1360,71L1440,75L1440,100L1360,100C1280,100,1120,100,960,100C800,100,640,100,480,100C320,100,160,100,80,100L0,100Z" fill="#FAF0F1" />
        </svg>
      </div>
    </section>

    <!-- =====================================================
         CONTENT SECTION (Grouped per Province Persis Sekarsari)
         ===================================================== -->
    <section class="py-16 bg-[#FAF0F1]/50">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8 max-w-7xl">
        
        <div id="provincesWrapper">
          {groupedCities.map((group) => (
            <div class="province-group mb-16 last:mb-0" data-province-section>
              
              <!-- Province Header -->
              <div class="flex items-center gap-4 mb-8">
                <div class="w-12 h-12 rounded-2xl bg-white border border-[#f0d5db] shadow-sm flex items-center justify-center text-[#893144] text-xl shrink-0">
                  <svg class="w-6 h-6 fill-current" viewBox="0 0 24 24">
                    <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/>
                  </svg>
                </div>
                <h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold text-[#671E2F] font-serif">
                  {group.province}
                </h2>
                <div class="h-px bg-[#f0d5db] flex-1 ml-4 mt-2"></div>
              </div>

              <!-- Cities Grid (Persis Sekarsari - Tanpa Teks "Toko Bunga") -->
              <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
                {group.cities.map((city) => {
                  const href = city.slug === 'malang-raya' ? withBase('/') : withBase(`/kota/${city.slug}/`);
                  return (
                    <a
                      href={href}
                      class="city-card group"
                      data-city-card
                      data-city-name={city.name.toLowerCase()}
                      data-province-name={city.province.toLowerCase()}
                    >
                      <!-- Background Image -->
                      <img
                        src={withBase(city.image)}
                        alt={city.name}
                        class="city-card__image"
                        loading="lazy"
                        decoding="async"
                        width="800"
                        height="600"
                      />

                      <!-- Gradient Overlay -->
                      <div class="city-card__overlay"></div>

                      <!-- Content -->
                      <div class="city-card__content">
                        <div class="flex items-end justify-between gap-3 w-full">
                          <div class="min-w-0 flex-1">
                            {/* HANYA NAMA KOTA - TANPA TEKS "TOKO BUNGA" */}
                            <h3 class="city-card__title">
                              {city.name}
                            </h3>
                            <p class="city-card__province">
                              <svg class="w-3.5 h-3.5 shrink-0 text-[#DFC397] fill-current" viewBox="0 0 24 24">
                                <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/>
                              </svg>
                              <span>{city.province || 'Indonesia'}</span>
                            </p>
                          </div>

                          <!-- Arrow Button -->
                          <div class="city-card__arrow">
                            <svg class="w-4 h-4 fill-current transform group-hover:translate-x-0.5 transition-transform" viewBox="0 0 24 24">
                              <path d="M13.172 12l-4.95-4.95 1.414-1.414L16 12l-6.364 6.364-1.414-1.414z"/>
                            </svg>
                          </div>
                        </div>
                      </div>
                    </a>
                  );
                })}
              </div>

            </div>
          ))}
        </div>

        <!-- Empty State -->
        <div id="allCitiesEmptyState" class="hidden text-center py-20">
          <div class="w-20 h-20 rounded-full bg-white border border-[#f0d5db] flex items-center justify-center text-[#893144] text-3xl mx-auto mb-4 shadow-sm">
            <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
            </svg>
          </div>
          <h3 class="text-xl font-bold text-[#671E2F] mb-2 font-serif">Kota Tidak Ditemukan</h3>
          <p class="text-gray-500 max-w-md mx-auto text-sm">
            Kami belum menampilkan atau belum menemukan area yang Anda cari. Anda dapat menghubungi layanan pelanggan kami untuk pengiriman khusus.
          </p>
        </div>

        <!-- WhatsApp Consultation CTA Box (Persis Sekarsari, Palet Zaloma) -->
        <div class="mt-20 max-w-4xl mx-auto bg-gradient-to-br from-[#893144] to-[#671E2F] rounded-[2rem] p-8 md:p-12 text-center text-white shadow-2xl relative overflow-hidden">
          <div class="absolute top-0 right-0 w-64 h-64 bg-white/10 rounded-full blur-3xl -translate-y-1/2 translate-x-1/2"></div>
          
          <div class="w-16 h-16 rounded-2xl bg-white/10 backdrop-blur-md border border-white/20 flex items-center justify-center text-white mx-auto mb-6 shadow-inner">
            <svg class="w-8 h-8 fill-current" viewBox="0 0 24 24">
              <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.711 2.598 2.669-.699c.969.54 1.838.847 2.791.848 3.18 0 5.767-2.587 5.768-5.766.001-3.18-2.585-5.834-5.768-5.834zm3.377 8.243c-.147.411-.75.76-1.042.812-.292.052-.663.097-2.072-.49-1.409-.587-2.327-2.016-2.398-2.112-.07-.095-.572-.76-.572-1.45 0-.69.362-1.029.49-1.173.129-.144.281-.18.375-.18.094 0 .188.001.27.006.086.005.201-.033.315.241.114.275.39 1.025.424 1.107.034.082.057.178.002.288-.055.11-.082.179-.164.275-.082.096-.173.214-.247.288-.082.083-.168.172-.072.337.096.165.427.705.916 1.141.63.562 1.161.736 1.326.818.165.082.261.069.358-.041.096-.11.413-.48.523-.645.11-.165.22-.138.371-.082.151.055.955.45 1.12.533.165.082.275.124.316.192.041.069.041.399-.106.81zM12.012 2.002C6.488 2.002 2 6.49 2 12.014c0 1.942.553 3.755 1.517 5.289L2 22l4.821-1.488A9.97 9.97 0 0 0 12.012 22C17.535 22 22 17.51 22 12.014c0-5.524-4.465-10.012-9.988-10.012z"/>
            </svg>
          </div>

          <h3 class="text-2xl md:text-3xl font-bold mb-4 font-serif">
            Tidak menemukan kota tujuan Anda?
          </h3>
          <p class="text-white/80 text-base md:text-lg font-light mb-8 max-w-2xl mx-auto leading-relaxed">
            Jangan khawatir! Hubungi tim layanan pelanggan kami via WhatsApp untuk meminta layanan pengiriman khusus ke kota Anda.
          </p>
          <a
            href={waConsultUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-3 bg-white text-[#893144] px-8 py-4 rounded-full font-bold text-base hover:bg-[#FAF0F1] transition-all shadow-lg hover:shadow-xl hover:-translate-y-0.5"
          >
            <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
              <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.711 2.598 2.669-.699c.969.54 1.838.847 2.791.848 3.18 0 5.767-2.587 5.768-5.766.001-3.18-2.585-5.834-5.768-5.834zm3.377 8.243c-.147.411-.75.76-1.042.812-.292.052-.663.097-2.072-.49-1.409-.587-2.327-2.016-2.398-2.112-.07-.095-.572-.76-.572-1.45 0-.69.362-1.029.49-1.173.129-.144.281-.18.375-.18.094 0 .188.001.27.006.086.005.201-.033.315.241.114.275.39 1.025.424 1.107.034.082.057.178.002.288-.055.11-.082.179-.164.275-.082.096-.173.214-.247.288-.082.083-.168.172-.072.337.096.165.427.705.916 1.141.63.562 1.161.736 1.326.818.165.082.261.069.358-.041.096-.11.413-.48.523-.645.11-.165.22-.138.371-.082.151.055.955.45 1.12.533.165.082.275.124.316.192.041.069.041.399-.106.81zM12.012 2.002C6.488 2.002 2 6.49 2 12.014c0 1.942.553 3.755 1.517 5.289L2 22l4.821-1.488A9.97 9.97 0 0 0 12.012 22C17.535 22 22 17.51 22 12.014c0-5.524-4.465-10.012-9.988-10.012z"/>
            </svg>
            <span>Chat dengan CS Kami</span>
          </a>
        </div>

      </div>
    </section>

  </div>
</Layout>

<style>
/* =========================================================
   KOTA DIRECTORY PAGE (Persis Sekarsari dengan Palet Zaloma)
   ========================================================= */

.kota-page-root {
  background-color: #FAF0F1;
  min-height: 100vh;
}

/* ── Hero Section ── */
.kota-hero {
  position: relative;
  min-height: 520px;
  display: flex;
  align-items: center;
  overflow: hidden;
  background-color: #240d13;
  padding-top: 130px;
  padding-bottom: 100px;
}

.kota-hero__bg {
  position: absolute;
  inset: 0;
  background-image: url('/images/showcase/hero-florist-premium.webp');
  background-size: cover;
  background-position: center right;
  background-repeat: no-repeat;
  z-index: 0;
  opacity: 0.45;
}

.kota-hero__overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(
    105deg,
    rgba(36, 13, 19, 0.95) 0%,
    rgba(50, 16, 25, 0.90) 35%,
    rgba(103, 30, 47, 0.72) 65%,
    rgba(137, 49, 68, 0.35) 90%,
    transparent 100%
  );
  z-index: 1;
}

.kota-hero__overlay-bottom {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, transparent 0%, rgba(36, 13, 19, 0.4) 100%);
  z-index: 1;
}

/* ── Decorative ── */
.kota-hero__decor {
  position: absolute;
  inset: 0;
  pointer-events: none;
  z-index: 2;
}

.kota-hero__orb {
  position: absolute;
  border-radius: 50%;
  filter: blur(70px);
}

.kota-hero__orb--1 {
  top: -40px;
  left: 15%;
  width: 260px;
  height: 260px;
  background: radial-gradient(circle, rgba(168, 71, 92, 0.28) 0%, transparent 70%);
}

.kota-hero__orb--2 {
  bottom: -50px;
  right: 25%;
  width: 220px;
  height: 220px;
  background: radial-gradient(circle, rgba(197, 146, 83, 0.18) 0%, transparent 70%);
}

.kota-hero__line {
  position: absolute;
  top: 0;
  width: 1px;
  height: 100%;
  background: linear-gradient(180deg, transparent, rgba(255,255,255,0.06), transparent);
}

.kota-hero__line--1 { left: 25%; }
.kota-hero__line--2 { left: 50%; }
.kota-hero__line--3 { left: 75%; }

/* ── Container ── */
.kota-hero__container {
  position: relative;
  z-index: 5;
  width: min(100%, 820px);
  margin: 0 auto;
  padding: 0 24px;
  text-align: center;
}

/* ── Eyebrow ── */
.kota-hero__eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  font-size: 12px;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: 0.22em;
  color: #DFC397;
  margin-bottom: 18px;
}

.kota-hero__eyebrow-dot {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: #C59253;
  animation: kotaDotPulse 2s ease-in-out infinite;
}

@keyframes kotaDotPulse {
  0%, 100% { opacity: 0.6; transform: scale(1); }
  50% { opacity: 1; transform: scale(1.3); }
}

/* ── Title ── */
.kota-hero__title {
  font-family: 'Playfair Display', Georgia, serif;
  font-size: clamp(34px, 5vw, 56px);
  font-weight: 800;
  color: #fff;
  line-height: 1.15;
  margin: 0 0 16px;
}

.kota-hero__accent {
  color: #DFC397;
  font-style: italic;
}

.kota-hero__desc {
  font-size: clamp(14px, 1.8vw, 17px);
  line-height: 1.7;
  color: rgba(255, 255, 255, 0.85);
  max-width: 660px;
  margin: 0 auto 30px;
}

/* ── Trust Badges ── */
.kota-hero__trust {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-wrap: wrap;
  gap: 12px;
  margin-bottom: 32px;
}

.kota-hero__trust-item {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 8px 18px;
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.08);
  backdrop-blur: 10px;
  border: 1px solid rgba(255, 255, 255, 0.15);
