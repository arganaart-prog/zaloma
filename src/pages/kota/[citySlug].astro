<!-- Client side sync script for live Supabase products & city fallback -->
<script define:vars={{ SUPABASE_URL, SUPABASE_ANON_KEY, citySlug: city.slug, cityName: city.name }}>
  (async function syncCityView() {
    try {
      if (!window.supabase) return;
      const client = window.supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY);
      const { data: allProducts, error } = await client
        .from('products')
        .select('*')
        .order('created_at', { ascending: false });

      if (error || !allProducts || allProducts.length === 0) return;

      const cloudSlugMap = new Map(allProducts.map(p => [p.slug, p]));

      // Clean deleted products
      document.querySelectorAll('a[href*="/produk/"]').forEach(link => {
        const match = link.getAttribute('href').match(/\/produk\/([^\/]+)/);
        if (!match || !match[1]) return;
        const slug = match[1];

        const card = link.closest('.product-card-shell, .category-product-card, .classic-product-card, article');
        if (!card) return;

        if (!cloudSlugMap.has(slug)) {
          card.remove();
        } else {
          const p = cloudSlugMap.get(slug);
          const priceEl = card.querySelector('.text-primary.font-extrabold, .font-extrabold.text-primary, [class*="font-extrabold"]');
          if (priceEl && p.price_label) priceEl.textContent = p.price_label;

          const titleEl = card.querySelector('h3');
          if (titleEl && p.name && titleEl.textContent.trim() !== p.name) {
            const linkInTitle = titleEl.querySelector('a');
            if (linkInTitle) {
              linkInTitle.textContent = p.name;
            } else {
              titleEl.textContent = p.name;
            }
          }
        }
      });
    } catch (e) {
      console.warn('City view sync notice:', e);
    }
  })();
</script>
