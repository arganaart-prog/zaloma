  </section>

  <!-- ── AREA LAYANAN / SEO TEXT ───────────────────────────────── -->
  <section class="py-12 bg-white border-b border-soft-cream/60">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
