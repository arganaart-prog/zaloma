---
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { WHATSAPP_NUMBER, SITE_DOMAIN } from '../../data/constants';
import { SUPABASE_URL, SUPABASE_ANON_KEY } from '../../data/supabaseConfig';
import { DEFAULT_CITIES, cityToSlug, productMatchesCity } from '../../data/cities';
import { withBase } from '../../utils/paths';

export async function getStaticPaths() {
  let allLiveProducts: any[] = [];
  let dynamicCities: any[] = [];

  try {
    const res = await fetch(`${SUPABASE_URL}/rest/v1/products?select=*&order=created_at.desc`, {
      headers: {
        apikey: SUPABASE_ANON_KEY,
        Authorization: `Bearer ${SUPABASE_ANON_KEY}`
      }
    });
    if (res.ok) {
      const data = await res.json();
      if (Array.isArray(data)) {
        allLiveProducts = data.filter(p => !p.slug.startsWith('_'));
        const citiesConfig = data.find(p => p.slug === '_cities_config_');
        if (citiesConfig && citiesConfig.description) {
          try {
            const parsed = JSON.parse(citiesConfig.description);
            if (Array.isArray(parsed)) dynamicCities = parsed;
          } catch (e) {}
        }
      }
    }
  } catch (err) {
    console.warn('[Zaloma Build] Warning fetching products for city paths:', err);
  }

  const combinedCities: any[] = [];
  const seenSlugs = new Set<string>();

  DEFAULT_CITIES.forEach(dc => {
    if (dc && dc.slug && !seenSlugs.has(dc.slug)) {
      seenSlugs.add(dc.slug);
      const dynMatch = dynamicCities.find(c => {
        const s = typeof c === 'string' ? cityToSlug(c) : (c && (c.slug || cityToSlug(c.name)));
        return s === dc.slug;
      });
      combinedCities.push({
        ...dc,
        image: (dynMatch && (dynMatch.image || dynMatch.image_url)) ? (dynMatch.image || dynMatch.image_url) : dc.image,
        description: (dynMatch && dynMatch.description) ? dynMatch.description : dc.description
      });
    }
  });

  dynamicCities.forEach(c => {
    const name = typeof c === 'string' ? c : (c && c.name);
    if (!name) return;
    const slug = typeof c === 'string' ? cityToSlug(c) : (c.slug || cityToSlug(c.name));
    if (slug && !seenSlugs.has(slug)) {
      seenSlugs.add(slug);
      combinedCities.push({
        name,
        slug,
        image: (c && (c.image || c.image_url)) || '/images/galeri/gallery-1.webp',
        description: (c && c.description) || `Pengiriman karangan bunga & buket area ${name}`,
        tagline: (c && c.tagline) || `Area ${name} & Sekitarnya`,
        seoTitle: `Toko Bunga ${name} | Buket, Karangan Bunga & Bunga Papan - Zaloma Florist`,
        seoDescription: `Pesan buket bunga, karangan bunga, bunga papan, papan ucapan, bunga duka cita, bunga pernikahan, dan standing flower di ${name} melalui Zaloma Florist. Pengerjaan cepat 3-5 jam, bunga segar & foto sebelum kirim.`
      });
    }
  });

  return combinedCities.map(city => {
    const filteredProducts = allLiveProducts
      .filter(p => productMatchesCity(p.city, city.name))
      .map(p => ({
        id: p.id,
        slug: p.slug,
        name: p.name,
        categorySlug: p.category_slug,
        categoryName: p.category_name,
        city: p.city || 'Malang',
        priceFrom: Number(p.price_from) || 0,
        priceLabel: p.price_label,
        promoPrice: p.promo_price ? Number(p.promo_price) : null,
        image: p.image,
        imageWidth: 800,
        imageHeight: 800,
        description: p.description || '',
        featured: Boolean(p.featured),
        whatsappText: `Halo Zaloma Florist, saya ingin pesan ${p.name} (${p.price_label}) untuk pengiriman ke ${city.name}.`,
        processingTime: p.processing_time || '3 - 5 Jam',
        serviceArea: [city.name, 'Bisa Dikirim ke Mana Saja']
      }));

    return {
      params: { citySlug: city.slug },
      props: {
        city,
        products: filteredProducts,
        allCities: combinedCities
      }
    };
  });
}

const { city, products = [], allCities = [] } = Astro.props;

// Best Seller Products untuk kota ini
const bestSellerProducts = products.length > 0 
  ? (products.filter(p => p.featured).length > 0 ? products.filter(p => p.featured) : products).slice(0, 10)
  : [];

// Kategori-kategori terkelompok untuk kota ini
const dukaCitaProducts = products.filter(p => p.categorySlug?.includes('duka') || p.name?.toLowerCase().includes('duka'));
const congratulationsProducts = products.filter(p => p.categorySlug?.includes('congrat') || p.name?.toLowerCase().includes('congrat') || p.name?.toLowerCase().includes('selamat'));
const weddingProducts = products.filter(p => p.categorySlug?.includes('wedding') || p.name?.toLowerCase().includes('wedding') || p.name?.toLowerCase().includes('nikah'));
const bouquetProducts = products.filter(p => p.categorySlug?.includes('bouquet') || p.categorySlug?.includes('buket'));
const standingProducts = products.filter(p => p.categorySlug?.includes('standing'));
const bungaMejaProducts = products.filter(p => p.categorySlug?.includes('meja'));
const paperFlowerProducts = products.filter(p => p.categorySlug?.includes('paper'));
const tanbulampotProducts = products.filter(p => p.categorySlug?.includes('tanbulampot') || p.categorySlug?.includes('tabulampot'));

// Kategori Momen Utama
const momentCategories = [
  {
    name: 'Bunga Papan Grand Opening',
    slug: 'bunga-papan-congratulations-malang',
    image: '/images/kategori/congratulations.webp',
  },
  {
    name: 'Bunga Papan Duka Cita',
    slug: 'bunga-papan-duka-cita-malang',
    image: '/images/kategori/duka-cita.webp',
  },
  {
    name: 'Bunga Papan Wedding',
    slug: 'bunga-papan-wedding-malang',
    image: '/images/kategori/wedding.webp',
  },
  {
    name: 'Bunga Papan Semi Styrofoam',
    slug: 'bunga-papan-semi-styrofoam-malang',
    image: '/images/kategori/semi-styrofoam.webp',
  },
  {
    name: 'Hand Bouquet',
    slug: 'hand-bouquet-malang',
    image: '/images/kategori/hand-bouquet.webp',
  },
  {
    name: 'Standing Flower',
    slug: 'standing-flower-malang',
    image: '/images/kategori/standing-flower.webp',
  },
  {
    name: 'Bunga Meja',
    slug: 'bunga-meja-malang',
    image: '/images/kategori/bunga-meja.svg',
  },
  {
    name: 'Paper Flower',
    slug: 'paper-flower-malang',
    image: '/images/kategori/paper-flower.webp',
  },
  {
    name: 'Tanbulampot',
    slug: 'tanbulampot-malang',
    image: '/images/kategori/tanbulampot.webp',
  }
];

// SEO Meta
const title = city.seoTitle || `Toko Bunga ${city.name} | Buket, Karangan Bunga & Bunga Papan - Zaloma Florist`;
const description = city.seoDescription || `Pesan buket bunga, karangan bunga, bunga papan, papan ucapan, bunga duka cita, bunga pernikahan, dan standing flower di ${city.name} melalui Zaloma Florist. Pengerjaan cepat 3-5 jam, bunga segar & foto sebelum kirim.`;

const waGeneralUrl = `https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent(`Halo Zaloma Florist, saya ingin pesan karangan bunga untuk pengiriman ke ${city.name}. Mohon info katalog dan format pemesanannya.`)}`;
const waConsultUrl = `https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent(`Halo Zaloma Gift Consultant, saya butuh bantuan memilih rangkaian bunga yang tepat untuk pengiriman ke ${city.name}.`)}`;

const siteUrl = SITE_DOMAIN;
const citySchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      '@id': `${siteUrl}/kota/${city.slug}/#webpage`,
      'url': `${siteUrl}/kota/${city.slug}/`,
      'name': title,
      'description': description,
      'about': { '@id': `${siteUrl}/#florist` },
      'mentions': [
        {
          '@type': 'Place',
          'name': city.name,
          'address': {
            '@type': 'PostalAddress',
            'addressLocality': city.name,
            'addressRegion': 'Jawa Timur',
            'addressCountry': 'ID'
          }
        }
      ],
      'mainEntity': {
        '@type': 'Florist',
        '@id': `${siteUrl}/kota/${city.slug}/#localbranch`,
        'name': `Zaloma Florist - ${city.name}`,
        'url': `${siteUrl}/kota/${city.slug}/`,
        'image': `${siteUrl}${city.image || '/images/logo/zaloma-logo.webp'}`,
        'description': description,
        'areaServed': city.name,
        'parentOrganization': { '@id': `${siteUrl}/#florist` }
      }
    }
  ]
};

// Galeri dokumentasi (Static Gallery)
const galleryList = [
  { id: 1, image_url: "/images/galeri/gallery-1.webp" },
  { id: 2, image_url: "/images/galeri/gallery-2.webp" },
  { id: 3, image_url: "/images/galeri/gallery-3.webp" },
  { id: 4, image_url: "/images/galeri/gallery-4.webp" },
  { id: 5, image_url: "/images/galeri/gallery-5.webp" },
  { id: 6, image_url: "/images/galeri/gallery-6.webp" },
  { id: 7, image_url: "/images/galeri/gallery-7.webp" },
  { id: 8, image_url: "/images/galeri/gallery-8.webp" }
];

// FAQ items
const faqItems = [
  {
    q: `Apakah Zaloma Florist melayani pengiriman bunga ke ${city.name}?`,
    a: `Ya, kami melayani pengiriman rangkaian bunga segar, bunga papan, buket, dan standing flower ke seluruh area ${city.name} dan sekitarnya dengan kurir armada khusus bunga.`
  },
  {
    q: `Berapa lama estimasi pengerjaan pesanan bunga untuk area ${city.name}?`,
    a: `Estimasi pengerjaan standar kami adalah 3 hingga 5 jam setelah konfirmasi pembayaran dan draft ucapan disetujui. Kami juga melayani pengiriman same-day (hari yang sama).`
  },
  {
    q: `Apakah pelanggan akan mendapatkan foto sebelum bunga dikirim?`,
    a: `Tentu saja! Kami selalu mengirimkan dokumentasi foto hasil jadi karangan bunga kepada Anda melalui WhatsApp sebelum bunga diantar ke alamat tujuan di ${city.name}.`
  },
  {
    q: `Bagaimana cara melakukan pemesanan bunga ke ${city.name}?`,
    a: `Sangat praktis: pilih rangkaian yang Anda sukai di website ini, lalu klik tombol "Pesan Sekarang" untuk terhubung langsung ke WhatsApp admin kami. Admin kami akan memandu pengisian format pemesanan.`
  },
  {
    q: `Metode pembayaran apa saja yang diterima?`,
    a: `Kami menerima pembayaran melalui transfer antar bank (BCA, Mandiri, BRI, BNI) serta e-wallet dan QRIS untuk kemudahan transaksi Anda.`
  }
];
---

<Layout title={title} description={description} activeNav="produk">
  <!-- Supabase JS SDK for live sync -->
  <script is:inline src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>

  <!-- Schema.org JSON-LD -->
  <script type="application/ld+json" set:html={JSON.stringify(citySchema)} />

  <!-- Breadcrumb -->
  <div class="bg-clean-ivory border-b border-soft-cream/60">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3">
      <Breadcrumb items={[
        { label: 'Beranda', href: withBase('/') },
        { label: 'Daftar Kota', href: withBase('/kota/') },
        { label: `Toko Bunga ${city.name}` }
      ]} />
    </div>
  </div>

  <div class="city-page-wrapper">
    <!-- =====================================================
         1. CITY HERO BANNER (100% Sekarsari Structure + Zaloma Colors)
         ===================================================== -->
    <section class="city-hero">
      <!-- Background Image -->
      <div 
        class="city-hero__bg-image" 
        style={`background-image: url('${city.image || '/images/galeri/gallery-1.webp'}')`}
        aria-hidden="true"
      ></div>
      
      <!-- Gradient Overlay (Left to Right: Warm Cream to transparent) -->
      <div class="city-hero__overlay"></div>

      <div class="city-hero__container">
        <div class="city-hero__content">
          <div class="city-hero__location">
            <svg class="w-5 h-5 text-secondary flex-shrink-0" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/>
            </svg>
            <span>Kirim ke</span>
            <strong class="city-hero__location-name">{city.name}</strong>
          </div>

          <h1 class="city-hero__title">
            Keindahan yang <span class="city-hero__title-accent">Disampaikan</span><br/>
            dengan Penuh Ketulusan
          </h1>

          <p class="city-hero__description">
            Rangkaian bunga segar pilihan terbaik, dirangkai oleh florist profesional dan dikirim langsung ke tujuan Anda di {city.name}. 
            Garansi kualitas premium &amp; pengiriman tepat waktu dengan armada terpercaya.
          </p>

          <div class="city-hero__actions">
            <a href="#city-section" class="city-hero__btn city-hero__btn--primary">
              Pilih Tujuan Pengiriman
            </a>
            <a href="#products" class="city-hero__btn city-hero__btn--outline">
              Lihat Produk
              <svg class="w-4 h-4 ml-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
              </svg>
            </a>
          </div>
        </div>
      </div>

      <!-- Elegant Bottom Wave -->
      <div class="city-hero__wave" aria-hidden="true">
        <svg viewBox="0 0 1440 180" fill="none" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none">
          <path d="M0,96L48,106.7C96,117,192,139,288,144C384,149,480,139,576,112C672,85,768,43,864,37.3C960,32,1056,64,1152,80C1248,96,1344,96,1392,96L1440,96L1440,200L1392,200C1344,200,1248,200,1152,200C1056,200,960,200,864,200C768,200,672,200,576,200C480,200,384,200,288,200C192,200,96,200,48,200L0,200Z" fill="rgba(255,255,255,0.4)" />
          <path d="M0,128L48,117.3C96,107,192,85,288,85.3C384,85,480,107,576,122.7C672,139,768,149,864,133.3C960,117,1056,75,1152,64C1248,53,1344,75,1392,85.3L1440,96L1440,200L1392,200C1344,200,1248,200,1152,200C1056,200,960,200,864,200C768,200,672,200,576,200C480,200,384,200,288,200C192,200,96,200,48,200L0,200Z" fill="#ffffff" />
        </svg>
      </div>
    </section>

    <!-- =====================================================
         2. KATEGORI PRODUK / PILIH BERDASARKAN MOMEN (Circular Cards)
         ===================================================== -->
    <section class="kategori-section">
      <div class="kategori-section__bg" aria-hidden="true">
        <div class="kategori-section__glow kategori-section__glow--left"></div>
        <div class="kategori-section__glow kategori-section__glow--right"></div>
      </div>

      <div class="kategori-section__container container mx-auto px-4">
        <div class="kategori-section__header">
          <span class="kategori-section__subtitle">PILIH BERDASARKAN MOMEN</span>
          <h2 class="kategori-section__title">Kategori Produk {city.name}</h2>
          <div class="kategori-section__divider">
            <span></span>
            <svg class="w-5 h-5 text-secondary" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 2C11.5 4 10 5.5 8 6C10 6.5 11.5 8 12 10C12.5 8 14 6.5 16 6C14 5.5 12.5 4 12 2ZM6 11C5.5 12.5 4.5 13.5 3 14C4.5 14.5 5.5 15.5 6 17C6.5 15.5 7.5 14.5 9 14C7.5 13.5 6.5 12.5 6 11ZM18 11C17.5 12.5 16.5 13.5 15 14C16.5 14.5 17.5 15.5 18 17C18.5 15.5 19.5 14.5 21 14C19.5 13.5 18.5 12.5 18 11ZM12 14C10.9 14 10 14.9 10 16C10 17.1 10.9 18 12 18C13.1 18 14 17.1 14 16C14 14.9 13.1 14 12 14Z" />
            </svg>
            <span></span>
          </div>
          <p class="kategori-section__desc">
            Temukan berbagai jenis rangkaian bunga segar yang dirangkai khusus untuk menyempurnakan setiap momen berharga Anda di {city.name}.
          </p>
        </div>

        <div class="kategori-section__grid">
          {momentCategories.map((item) => (
            <a href={withBase(`/kategori/${item.slug}/?city=${city.slug}&refer=city`)} class="kategori-card group">
              <div class="kategori-card__visual">
                <div class="kategori-card__ring"></div>
                <img 
                  src={withBase(item.image)} 
                  class="kategori-card__img" 
                  alt={`${item.name} ${city.name}`} 
                  loading="lazy" 
                  decoding="async" 
                  width="100" 
                  height="100" 
                />
              </div>
              <div class="kategori-card__content">
                <h3 class="kategori-card__title">{item.name} {city.name}</h3>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- =====================================================
         3. BEST SELLER (Auto-Slide Horizontal Carousel)
         ===================================================== -->
    <section class="best-seller-section py-10 relative bg-[#F5F2EB] border-y border-soft-cream/80">
      <div class="w-full h-8 bg-primary opacity-5 mb-4"></div>

      <div class="container mx-auto px-4">
        <h2 class="text-3xl font-extrabold text-primary-dark text-center tracking-wide font-serif">
          Koleksi Terlaris Kami di {city.name}
        </h2>
        <p class="text-slate-600 text-center mb-8 text-sm">
          Produk pilihan terbaik pelanggan Zaloma Florist area {city.name}
        </p>

        <div
          id="bestSellerSlider"
          class="flex gap-5 overflow-x-auto overflow-y-visible scrollbar-hide scroll-smooth pt-2 pb-3 px-2"
        >
          {bestSellerProducts.map((item) => (
            <div class="best-card min-w-[210px] max-w-[240px] flex flex-col shrink-0">
              <div class="best-image-wrapper">
                <img
                  src={item.image}
                  class="best-image is-loaded"
                  alt={item.name}
                  loading="lazy"
                  decoding="async"
                />
                {item.promoPrice && (
                  <div class="discount-badge">
                    Promo
                  </div>
                )}
                <div class="best-seller-badge">
                  Best Seller
                </div>
              </div>

              <div class="px-3 pt-2.5 pb-3 text-center flex flex-col flex-1 justify-between">
                <div>
                  <h3 class="name font-serif line-clamp-2">
                    {item.name} {city.name}
                  </h3>
                  <div class="mt-1.5 mb-3">
                    <p class="price-normal">
                      {item.priceLabel || `Rp ${Number(item.priceFrom).toLocaleString('id-ID')}`}
                    </p>
                  </div>
                </div>

                <a
                  href={`https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent(`Halo Zaloma Florist, saya ingin pesan ${item.name} (${item.priceLabel}) untuk pengiriman ke ${city.name}.`)}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="buy-button flex items-center justify-center gap-1.5 no-underline"
                >
                  <svg class="h-4 w-4 shrink-0 fill-current" viewBox="0 0 24 24">
                    <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.711 2.598 2.669-.699c.969.54 1.838.847 2.791.848 3.18 0 5.767-2.587 5.768-5.766.001-3.18-2.585-5.834-5.768-5.834zm3.377 8.243c-.147.411-.75.76-1.042.812-.292.052-.663.097-2.072-.49-1.409-.587-2.327-2.016-2.398-2.112-.07-.095-.572-.76-.572-1.45 0-.69.362-1.029.49-1.173.129-.144.281-.18.375-.18.094 0 .188.001.27.006.086.005.201-.033.315.241.114.275.39 1.025.424 1.107.034.082.057.178.002.288-.055.11-.082.179-.164.275-.082.096-.173.214-.247.288-.082.083-.168.172-.072.337.096.165.427.705.916 1.141.63.562 1.161.736 1.326.818.165.082.261.069.358-.041.096-.11.413-.48.523-.645.11-.165.22-.138.371-.082.151.055.955.45 1.12.533.165.082.275.124.316.192.041.069.041.399-.106.81zM12.012 2.002C6.488 2.002 2 6.49 2 12.014c0 1.942.553 3.755 1.517 5.289L2 22l4.821-1.488A9.97 9.97 0 0 0 12.012 22C17.535 22 22 17.51 22 12.014c0-5.524-4.465-10.012-9.988-10.012z"/>
                  </svg>
                  <span>Pesan Sekarang</span>
                </a>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- =====================================================
         4. HOME PRODUCT CATALOG (Katalog Tab Bunga Papan & Kategori Lainnya)
         ===================================================== -->
    <main id="products" class="product-catalog max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
      <div class="product-catalog__intro text-center max-w-2xl mx-auto mb-16">
        <span class="product-catalog__eyebrow">KOLEKSI ZALOMA</span>
        <h2 class="product-catalog__heading font-serif">Rangkaian Bunga Pilihan {city.name}</h2>
        <div class="product-catalog__accent-line"><span></span></div>
        <p class="product-catalog__desc">
          Temukan koleksi bunga segar untuk ucapan, perayaan, dan momen penting di {city.name}
          — pilih rangkaian yang sempurna untuk setiap kesempatan.
        </p>
        <a href={withBase('/katalog/')} class="product-catalog__main-link inline-flex items-center gap-1.5 font-bold text-sm">
          <span>Jelajahi Katalog Lengkap</span>
          <span>→</span>
        </a>
      </div>

      <!-- Section: Bunga Papan dengan Tab Subkategori (Duka Cita, Congratulations, Wedding) -->
      <section class="product-section mb-16" id="bunga-papan">
        <div class="product-section__head flex items-end justify-between mb-8 pb-4 border-b border-slate-200">
          <div>
            <p class="product-section__label uppercase tracking-widest text-xs font-bold text-secondary">Koleksi Bunga Papan</p>
