---
import Layout from '../../layouts/Layout.astro';
import HeroArticles from '../../components/HeroArticles.astro';
import BungaPapanSection from '../../components/BungaPapanSection.astro';
import HandBouquetSection from '../../components/HandBouquetSection.astro';
import StandingFlowerSection from '../../components/StandingFlowerSection.astro';
import PaperFlowerSection from '../../components/PaperFlowerSection.astro';
import BungaMejaSection from '../../components/BungaMejaSection.astro';
import TanbulampotSection from '../../components/TanbulampotSection.astro';
import CityDeliverySection from '../../components/CityDeliverySection.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { WHATSAPP_NUMBER, SITE_DOMAIN } from '../../data/constants';
import { SUPABASE_URL, SUPABASE_ANON_KEY } from '../../data/supabaseConfig';
import { DEFAULT_CITIES, cityToSlug, productMatchesCity } from '../../data/cities';
import { withBase } from '../../utils/paths';
import { getRotatingHomeProducts } from '../../utils/rotatingProducts';
import { getHomeDisplayProducts } from '../../utils/productHelpers';

export async function getStaticPaths() {
  let allLiveProducts: any[] = [];
  let dynamicCities: any[] = [];

  try {
    const res = await fetch(`${SUPABASE_URL}/rest/v1/products?select=*&order=created_at.desc`, {
      headers: {
        apikey: SUPABASE_ANON_KEY,
        Authorization: `Bearer ${SUPABASE_ANON_KEY}`
      }
    });
    if (res.ok) {
      const data = await res.json();
      if (Array.isArray(data)) {
        allLiveProducts = data.filter(p => !p.slug.startsWith('_'));
        const citiesConfig = data.find(p => p.slug === '_cities_config_');
        if (citiesConfig && citiesConfig.description) {
          try {
            const parsed = JSON.parse(citiesConfig.description);
            if (Array.isArray(parsed)) dynamicCities = parsed;
          } catch (e) {}
        }
      }
    }
  } catch (err) {
    console.warn('[Zaloma Build] Warning fetching products for city paths:', err);
  }

  const combinedCities: any[] = [];
  const seenSlugs = new Set<string>();

  DEFAULT_CITIES.forEach(dc => {
    if (dc && dc.slug && !seenSlugs.has(dc.slug)) {
      seenSlugs.add(dc.slug);
      const dynMatch = dynamicCities.find(c => {
        const s = typeof c === 'string' ? cityToSlug(c) : (c && (c.slug || cityToSlug(c.name)));
        return s === dc.slug;
      });
      combinedCities.push({
        ...dc,
        image: (dynMatch && dynMatch.image) ? dynMatch.image : dc.image,
        description: (dynMatch && dynMatch.description) ? dynMatch.description : dc.description
      });
    }
  });

  dynamicCities.forEach(c => {
    const name = typeof c === 'string' ? c : (c && c.name);
    if (!name) return;
    const slug = typeof c === 'string' ? cityToSlug(c) : (c.slug || cityToSlug(c.name));
    if (slug && !seenSlugs.has(slug)) {
      seenSlugs.add(slug);
      combinedCities.push({
        name,
        slug,
        image: (c && c.image) || '/images/galeri/gallery-1.webp',
        description: (c && c.description) || `Pengiriman karangan bunga & buket area ${name}`,
        tagline: (c && c.tagline) || `Area ${name} & Sekitarnya`,
        seoTitle: `Toko Bunga ${name} | Buket, Karangan Bunga & Bunga Papan - Zaloma Florist`,
        seoDescription: `Pesan buket bunga, karangan bunga, bunga papan, papan ucapan, bunga duka cita, bunga pernikahan, dan standing flower di ${name} melalui Zaloma Florist. Pengerjaan cepat 3-5 jam, bunga segar & foto sebelum kirim.`
      });
    }
  });

  return combinedCities.map(city => {
    const filteredProducts = allLiveProducts
      .filter(p => productMatchesCity(p.city, city.name))
      .map(p => ({
        id: p.id,
        slug: p.slug,
        name: p.name,
        categorySlug: p.category_slug,
        categoryName: p.category_name,
        city: p.city || 'Malang',
        priceFrom: Number(p.price_from) || 0,
        priceLabel: p.price_label,
        image: p.image,
        imageWidth: 800,
        imageHeight: 800,
        description: p.description || '',
        featured: Boolean(p.featured),
        whatsappText: `Halo Zaloma Florist, saya ingin pesan ${p.name} (${p.price_label}) untuk pengiriman ke ${city.name}.`,
        processingTime: p.processing_time || '3 - 5 Jam',
        serviceArea: [city.name, 'Bisa Dikirim ke Mana Saja']
      }));

    return {
      params: { citySlug: city.slug },
      props: {
        city,
        products: filteredProducts,
        allCities: combinedCities
      }
    };
  });
}

const { city, products = [], allCities = [] } = Astro.props;

// Featured Products untuk kota ini
const { activeProducts } = getRotatingHomeProducts(getHomeDisplayProducts(products), 8);

// SEO Meta
const title = city.seoTitle || `Toko Bunga ${city.name} | Buket, Karangan Bunga & Bunga Papan - Zaloma Florist`;
const description = city.seoDescription || `Pesan buket bunga, karangan bunga, bunga papan, papan ucapan, bunga duka cita, bunga pernikahan, dan standing flower di ${city.name} melalui Zaloma Florist. Pengerjaan cepat 3-5 jam, bunga segar & foto sebelum kirim.`;

const waGeneralUrl = `https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent(`Halo Zaloma Florist, saya ingin pesan karangan bunga untuk pengiriman ke ${city.name}. Mohon info katalog dan format pemesanannya.`)}`;

const siteUrl = SITE_DOMAIN;
const citySchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      '@id': `${siteUrl}/kota/${city.slug}/#webpage`,
      'url': `${siteUrl}/kota/${city.slug}/`,
      'name': title,
      'description': description,
      'about': { '@id': `${siteUrl}/#florist` },
      'mentions': [
        {
          '@type': 'Place',
          'name': city.name,
          'address': {
            '@type': 'PostalAddress',
            'addressLocality': city.name,
            'addressRegion': 'Jawa Timur',
            'addressCountry': 'ID'
          }
        }
      ],
      'mainEntity': {
        '@type': 'Florist',
        '@id': `${siteUrl}/kota/${city.slug}/#localbranch`,
        'name': `Zaloma Florist - ${city.name}`,
        'url': `${siteUrl}/kota/${city.slug}/`,
        'image': `${siteUrl}${city.image || '/images/logo/zaloma-logo.webp'}`,
        'description': description,
        'areaServed': city.name,
        'parentOrganization': { '@id': `${siteUrl}/#florist` },
        'makesOffer': [
          { '@type': 'Offer', 'itemOffered': { '@type': 'Service', 'name': `Bunga Papan & Papan Ucapan ${city.name}`, 'areaServed': city.name } },
          { '@type': 'Offer', 'itemOffered': { '@type': 'Service', 'name': `Buket Bunga & Hand Bouquet ${city.name}`, 'areaServed': city.name } },
          { '@type': 'Offer', 'itemOffered': { '@type': 'Service', 'name': `Standing Flower ${city.name}`, 'areaServed': city.name } },
          { '@type': 'Offer', 'itemOffered': { '@type': 'Service', 'name': `Bunga Duka Cita ${city.name}`, 'areaServed': city.name } },
          { '@type': 'Offer', 'itemOffered': { '@type': 'Service', 'name': `Bunga Pernikahan & Wedding ${city.name}`, 'areaServed': city.name } },
          { '@type': 'Offer', 'itemOffered': { '@type': 'Service', 'name': `Bunga Meja ${city.name}`, 'areaServed': city.name } }
        ],
        'address': {
          '@type': 'PostalAddress',
          'addressLocality': city.name,
          'addressRegion': 'Jawa Timur',
          'addressCountry': 'ID'
        }
      }
    }
  ]
};

// Kategori utama (untuk section SEO lokal)
const cityKeywordServices = [
  {
    title: `Bunga Papan & Papan Ucapan ${city.name}`,
    desc: `Karangan bunga papan untuk ucapan selamat, duka cita, grand opening, wisuda, peresmian, dan acara perusahaan di ${city.name}.`,
    keywords: [`bunga papan ${city.name}`, `papan ucapan ${city.name}`],
    icon: '🌸', targetHref: '#bunga-papan-ucapan'
  },
  {
    title: `Buket Bunga & Hand Bouquet ${city.name}`,
    desc: `Buket bunga segar untuk ulang tahun, wisuda, anniversary, lamaran, hadiah romantis, dan kejutan personal dengan pengiriman ke ${city.name}.`,
    keywords: [`buket bunga ${city.name}`, `hand bouquet ${city.name}`],
    icon: '💐', targetHref: '#hand-bouquet-section'
  },
  {
    title: `Standing Flower & Bunga Standing ${city.name}`,
    desc: `Standing flower premium untuk pembukaan usaha, peresmian, acara kantor, acara formal, dan kiriman ucapan elegan di ${city.name}.`,
    keywords: [`standing flower ${city.name}`, `bunga standing ${city.name}`],
    icon: '🏺', targetHref: '#standing-flower-section'
  },
  {
    title: `Bunga Duka Cita ${city.name}`,
    desc: `Rangkaian bunga belasungkawa dan papan duka cita untuk rumah duka, keluarga, instansi, atau rekan kerja di ${city.name}.`,
    keywords: [`bunga duka cita ${city.name}`, `karangan bunga duka cita ${city.name}`],
    icon: '🕊️', targetHref: '#bunga-papan-ucapan'
  },
  {
    title: `Bunga Pernikahan & Wedding ${city.name}`,
    desc: `Bunga wedding, dekorasi rangkaian, dan papan ucapan pernikahan untuk merayakan momen bahagia di ${city.name}.`,
    keywords: [`bunga pernikahan ${city.name}`, `bunga wedding ${city.name}`],
    icon: '💍', targetHref: '#bunga-papan-ucapan'
  },
  {
    title: `Bunga Meja & Rangkaian Bunga ${city.name}`,
    desc: `Bunga meja dan rangkaian bunga segar untuk kantor, hotel, rumah, meja resepsionis, dan hadiah elegan di ${city.name}.`,
    keywords: [`bunga meja ${city.name}`, `rangkaian bunga ${city.name}`],
    icon: '🪴', targetHref: '#bunga-meja-section'
  }
];
---

<Layout title={title} description={description} activeNav="produk">
  <!-- Supabase JS SDK for live sync -->
  <script is:inline src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>

  <!-- Schema.org JSON-LD -->
  <script type="application/ld+json" set:html={JSON.stringify(citySchema)} />

  <!-- ── BREADCRUMB ───────────────────────────────────────────────── -->
  <div class="bg-clean-ivory border-b border-soft-cream/60">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3">
      <Breadcrumb items={[
        { label: 'Beranda', href: withBase('/') },
        { label: 'Pilih Pengiriman Luar Kota', href: withBase('/#pilih-pengiriman-luar-kota') },
        { label: `Toko Bunga ${city.name}` }
      ]} />
    </div>
  </div>

  <!-- ── HERO SECTION (Identik dengan Homepage: Split Grid) ─────── -->
  <section class="city-hero-wrap">
    <div class="city-hero-grid max-w-7xl mx-auto">

      <!-- Kolom Kiri: Hero Card Kota (menggantikan HeroBanner) -->
      <div class="city-hero-card-col">
        <div
          class="city-hero-card relative rounded-3xl overflow-hidden text-white flex flex-col justify-between min-h-[440px]"
          style={city.image ? `background-image: url('${city.image}'); background-size: cover; background-position: center;` : ''}
        >
          <!-- Overlay gradient -->
          <div class="absolute inset-0 bg-gradient-to-t from-primary-dark/95 via-primary-dark/60 to-primary-dark/20 z-0"></div>
          <!-- Extra glow accent -->
          <div class="absolute -top-20 -right-20 w-80 h-80 rounded-full bg-secondary/20 blur-3xl pointer-events-none z-0"></div>

          <!-- Top badge -->
          <div class="relative z-10 flex items-center justify-between gap-3 p-6 sm:p-8">
            <span class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider bg-white/15 text-secondary-light border border-secondary/40 backdrop-blur-md shadow-xs">
              <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
              <span>TOKO BUNGA & FLORIST {city.name.toUpperCase()}</span>
            </span>
            <span class="text-xs font-semibold text-white/70 hidden sm:inline-block">
              {city.tagline || 'Layanan Florist Terpercaya'}
            </span>
          </div>

          <!-- Main hero content -->
          <div class="relative z-10 px-6 sm:px-8 pb-4 flex-1 flex flex-col justify-end">
            <h1 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white leading-tight drop-shadow-lg">
              Toko Bunga {city.name}
            </h1>
            <p class="font-sans text-sm sm:text-base text-white/85 mt-3 leading-relaxed max-w-xl">
              {city.description || `Layanan karangan bunga papan pernikahan, duka cita, peresmian, standing flower, dan buket bunga segar terbaik untuk area ${city.name} dan sekitarnya. Pengiriman kilat langsung dari florist profesional.`}
            </p>

            <!-- 3 Mini Guarantee Chips -->
            <div class="grid grid-cols-3 gap-2 my-5 max-w-sm">
              <div class="flex flex-col items-center gap-1 p-2 rounded-xl bg-white/10 backdrop-blur-xs border border-white/15 text-xs text-white text-center">
                <span class="text-base">⚡</span>
                <span class="font-semibold text-[10px] leading-tight">Kirim 3-5 Jam</span>
              </div>
              <div class="flex flex-col items-center gap-1 p-2 rounded-xl bg-white/10 backdrop-blur-xs border border-white/15 text-xs text-white text-center">
                <span class="text-base">📸</span>
                <span class="font-semibold text-[10px] leading-tight">Foto Sebelum Kirim</span>
              </div>
              <div class="flex flex-col items-center gap-1 p-2 rounded-xl bg-white/10 backdrop-blur-xs border border-white/15 text-xs text-white text-center">
                <span class="text-base">🌸</span>
                <span class="font-semibold text-[10px] leading-tight">100% Bunga Segar</span>
              </div>
            </div>

            <!-- CTA Buttons -->
            <div class="flex flex-wrap items-center gap-3 pb-6">
              <a
                href={waGeneralUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="px-5 py-3 rounded-2xl bg-[#25D366] hover:bg-[#20bd5a] text-white font-bold text-sm transition-all shadow-lg hover:shadow-xl flex items-center gap-2"
              >
                <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.711 2.598 2.669-.699c.969.54 1.838.847 2.791.848 3.18 0 5.767-2.587 5.768-5.766.001-3.18-2.585-5.834-5.768-5.834zm3.377 8.243c-.147.411-.75.76-1.042.812-.292.052-.663.097-2.072-.49-1.409-.587-2.327-2.016-2.398-2.112-.07-.095-.572-.76-.572-1.45 0-.69.362-1.029.49-1.173.129-.144.281-.18.375-.18.094 0 .188.001.27.006.086.005.201-.033.315.241.114.275.39 1.025.424 1.107.034.082.057.178.002.288-.055.11-.082.179-.164.275-.082.096-.173.214-.247.288-.082.083-.168.172-.072.337.096.165.427.705.916 1.141.63.562 1.161.736 1.326.818.165.082.261.069.358-.041.096-.11.413-.48.523-.645.11-.165.22-.138.371-.082.151.055.955.45 1.12.533.165.082.275.124.316.192.041.069.041.399-.106.81zM12.012 2.002C6.488 2.002 2 6.49 2 12.014c0 1.942.553 3.755 1.517 5.289L2 22l4.821-1.488A9.97 9.97 0 0 0 12.012 22C17.535 22 22 17.51 22 12.014c0-5.524-4.465-10.012-9.988-10.012z"/></svg>
                <span>Pesan via WhatsApp</span>
              </a>
              <a
                href="#featured-products-city"
                class="px-5 py-3 rounded-2xl bg-white/15 hover:bg-white/25 text-white font-semibold text-sm transition-all border border-white/25"
              >
                Lihat Katalog {city.name}
              </a>
            </div>
          </div>

          <!-- Bottom strip -->
          <div class="relative z-10 px-6 sm:px-8 py-3 border-t border-white/10 flex items-center justify-between text-[11px] text-white/60">
            <span>Garansi bunga tiba dalam kondisi segar & rapi</span>
            <span>Bebas Konsultasi 24 Jam</span>
          </div>
        </div>
      </div>

      <!-- Kolom Kanan: Artikel Edukasi (Persis Homepage) -->
      <aside class="city-hero-articles-col" aria-label="Artikel & Panduan Florist">
        <HeroArticles />
      </aside>
    </div>

    <!-- Trust Features Strip (Identik Homepage) -->
    <div class="city-trust-strip hidden md:block max-w-7xl mx-auto mt-5 pt-4 border-t border-slate-200/80">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-3.5 sm:gap-4 lg:gap-6">
        <div class="trust-item flex items-center gap-3">
          <div class="trust-icon-box w-10 h-10 rounded-xl bg-white border border-slate-200/80 flex items-center justify-center text-primary shadow-sm flex-shrink-0">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
          </div>
          <div>
            <h4 class="text-xs sm:text-sm font-bold text-slate-900 leading-tight">Difoto sebelum diantar</h4>
            <p class="text-[11px] sm:text-xs text-slate-500 mt-0.5 leading-tight">Laporan foto hasil jadi sebelum dikirim</p>
          </div>
        </div>
        <div class="trust-item flex items-center gap-3">
          <div class="trust-icon-box w-10 h-10 rounded-xl bg-white border border-slate-200/80 flex items-center justify-center text-[#0b825d] shadow-sm flex-shrink-0">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
          </div>
          <div>
            <h4 class="text-xs sm:text-sm font-bold text-slate-900 leading-tight">Selesai 3-5 jam, siap hari ini</h4>
            <p class="text-[11px] sm:text-xs text-slate-500 mt-0.5 leading-tight">Bisa pesan dadakan untuk area {city.name}</p>
          </div>
        </div>
        <div class="trust-item flex items-center gap-3">
          <div class="trust-icon-box w-10 h-10 rounded-xl bg-white border border-slate-200/80 flex items-center justify-center text-secondary shadow-sm flex-shrink-0">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
            </svg>
          </div>
          <div>
            <h4 class="text-xs sm:text-sm font-bold text-slate-900 leading-tight">Bunga Segar Pilihan</h4>
            <p class="text-[11px] sm:text-xs text-slate-500 mt-0.5 leading-tight">Rangkaian rapi dari bunga berkualitas premium</p>
          </div>
        </div>
        <div class="trust-item flex items-center gap-3">
          <div class="trust-icon-box w-10 h-10 rounded-xl bg-white border border-slate-200/80 flex items-center justify-center text-primary shadow-sm flex-shrink-0">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4" />
            </svg>
          </div>
          <div>
            <h4 class="text-xs sm:text-sm font-bold text-slate-900 leading-tight">Pengiriman Terpercaya</h4>
            <p class="text-[11px] sm:text-xs text-slate-500 mt-0.5 leading-tight">Diantar langsung ke lokasi tujuan di {city.name}</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── FEATURED PRODUCTS SECTION (Identik Homepage) ───────────── -->
  <section class="featured-products-section py-20 bg-white border-y border-soft-cream/60" id="featured-products-city">
    <div class="featured-products-mobile-band" aria-hidden="true"></div>
    <div class="max-w-7xl mx-auto">
      <div class="featured-products-header flex flex-col md:flex-row md:items-end justify-between mb-12 px-4 sm:px-6 lg:px-8">
        <div class="max-w-xl">
          <span class="text-xs font-bold uppercase tracking-wider text-secondary flex items-center gap-1.5 mb-1.5">
            <span class="w-1.5 h-1.5 rounded-full bg-secondary"></span>
            PRODUK TERLARIS DI {city.name.toUpperCase()}
          </span>
          <h2 class="font-serif text-3xl sm:text-4xl font-bold text-slate-800">Produk Favorit di {city.name}</h2>
          <p class="text-slate-500 text-sm mt-3 leading-relaxed">Paling banyak dipesan pelanggan area {city.name}.</p>
        </div>
        <a
          href={withBase('/katalog/')}
          class="mt-4 hidden md:mt-0 md:inline-flex items-center text-sm font-semibold text-primary hover:text-secondary transition-colors group"
        >
          Lihat Semua Produk
          <svg class="h-4 w-4 ml-1.5 transform group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      </div>

      <div class="featured-products-carousel-wrap">
        <div class="featured-products-fade-hint" aria-hidden="true"></div>
        <div id="featured-products-slider" data-featured-products-slider class="featured-products-slider grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 lg:gap-8 px-4 sm:px-6 lg:px-8">
          {activeProducts.length > 0 ? (
            activeProducts.map((p, index) => (
              <div class="classic-product-card product-card-shell group bg-white rounded-[14px] border border-soft-cream/70 overflow-hidden shadow-[0_1px_4px_rgba(15,23,42,0.03)]">
                <a href={withBase(`/produk/${p.slug}/`)} class="classic-product-image image-load-shell block relative aspect-[20/22] bg-slate-100 overflow-hidden">
                  <img
                    src={p.image}
                    alt={`Foto ${p.name} Florist ${city.name}`}
                    loading={index < 2 ? 'eager' : 'lazy'}
