<!-- =====================================================
     SCRIPTS (Interactive Tabs, FAQ, Auto-Slider)
     ===================================================== -->
<script is:inline>
  // 1. Auto Slider Best Seller
  (function initBestSellerSlider() {
    const slider = document.querySelector("#bestSellerSlider");
    if (!slider) return;
    let interval = null;

    function startAutoSlide() {
      if (interval) clearInterval(interval);
      interval = setInterval(() => {
        const card = slider.querySelector('.best-card');
        const cardWidth = card ? card.getBoundingClientRect().width : 210;
        const gap = 20;
        slider.scrollBy({ left: cardWidth + gap, behavior: 'smooth' });

        setTimeout(() => {
          if (slider.scrollLeft + slider.clientWidth >= slider.scrollWidth - 15) {
            slider.scrollLeft = 0;
          }
        }, 600);
      }, 2800);
    }

    function stopAutoSlide() {
      if (interval) clearInterval(interval);
    }

    slider.addEventListener('mouseenter', stopAutoSlide);
    slider.addEventListener('mouseleave', startAutoSlide);
    slider.addEventListener('touchstart', stopAutoSlide, { passive: true });
    slider.addEventListener('touchend', () => setTimeout(startAutoSlide, 3000), { passive: true });

    startAutoSlide();
  })();

  // 2. Interactive Bunga Papan Subtabs
  (function initPapanTabs() {
    const container = document.querySelector('[data-papan-tabs]');
    if (!container) return;

    const buttons = container.querySelectorAll('.product-section__subtab');
    const panels = document.querySelectorAll('.papan-tab-panel');

    buttons.forEach(btn => {
      btn.addEventListener('click', () => {
        buttons.forEach(b => b.classList.remove('product-section__subtab--active'));
        btn.classList.add('product-section__subtab--active');

        const targetId = btn.getAttribute('data-target');
        panels.forEach(p => {
          if (p.id === targetId) {
            p.classList.remove('hidden');
          } else {
            p.classList.add('hidden');
          }
        });
      });
    });
  })();

  // 3. FAQ Accordion
  (function initFaq() {
    const accordion = document.querySelector('#cityFaqAccordion');
    if (!accordion) return;

    accordion.addEventListener('click', (e) => {
      const btn = e.target.closest('.faq-question');
      if (!btn) return;

      const item = btn.closest('.faq-item');
      const answer = item.querySelector('.faq-answer');
      const isExpanded = !answer.classList.contains('hidden');

      // Close all
      accordion.querySelectorAll('.faq-item').forEach(el => {
        el.classList.remove('active');
        el.querySelector('.faq-answer').classList.add('hidden');
        el.querySelector('.faq-icon').textContent = '+';
      });

      // Toggle current
      if (!isExpanded) {
        item.classList.add('active');
        answer.classList.remove('hidden');
        btn.querySelector('.faq-icon').textContent = '−';
      }
    });
  })();

  // 4. City Search Filter
  (function initCitySearch() {
    const input = document.querySelector('#citySearchInput');
    const grid = document.querySelector('#cityCardsGrid');
    if (!input || !grid) return;

    input.addEventListener('input', () => {
      const val = input.value.trim().toLowerCase();
      const cards = grid.querySelectorAll('.city-destination-card');

      cards.forEach(card => {
        const name = card.getAttribute('data-city-name') || '';
        if (!val || name.includes(val)) {
          card.style.display = '';
        } else {
          card.style.display = 'none';
        }
      });
    });
  })();

  // 5. Mobile Gallery Auto Slide
  (function initGallerySlider() {
    const slider = document.querySelector("#gallerySlider");
    if (!slider) return;
    let interval = null;

    function startSlide() {
      if (window.innerWidth > 767) return;
      if (interval) clearInterval(interval);

      interval = setInterval(() => {
        if (window.innerWidth > 767) return;
        const step = slider.clientWidth / 2;
        slider.scrollBy({ left: step, behavior: 'smooth' });

        setTimeout(() => {
          if (slider.scrollLeft + slider.clientWidth >= slider.scrollWidth - 10) {
            slider.scrollLeft = 0;
          }
        }, 600);
      }, 2600);
    }

    startSlide();
  })();
</script>
