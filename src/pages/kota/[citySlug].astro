<script is:inline>
  // Featured Products Slider (copy dari homepage)
  (function initCityFeaturedSlider() {
    document.querySelectorAll('[data-featured-products-slider]').forEach(function(slider) {
      if (slider.dataset.featuredSliderReady === 'true') return;
      slider.dataset.featuredSliderReady = 'true';

      var mobileQuery = window.matchMedia('(max-width: 767px)');
      var reduceMotionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
      var intervalId = 0;
      var dotsContainer = document.getElementById('fp-dots');

      function getVisibleCards() {
        return Array.from(slider.querySelectorAll('.classic-product-card'));
      }

      function buildDots() {
        if (!dotsContainer || !mobileQuery.matches) return;
        dotsContainer.innerHTML = '';
        getVisibleCards().forEach(function(_, i) {
          var dot = document.createElement('span');
          dot.className = 'fp-dot' + (i === 0 ? ' active' : '');
          dot.setAttribute('aria-hidden', 'true');
          dotsContainer.appendChild(dot);
        });
      }

      function updateActiveDot() {
        if (!dotsContainer || !mobileQuery.matches) return;
        var cards = getVisibleCards();
        if (!cards.length) return;
        var sliderLeft = slider.getBoundingClientRect().left;
        var sliderWidth = slider.clientWidth;
        var bestIdx = 0, bestOverlap = -1;
        cards.forEach(function(card, i) {
          var rect = card.getBoundingClientRect();
          var overlap = Math.max(0, Math.min(rect.right, sliderLeft + sliderWidth) - Math.max(rect.left, sliderLeft));
          if (overlap > bestOverlap) { bestOverlap = overlap; bestIdx = i; }
        });
        dotsContainer.querySelectorAll('.fp-dot').forEach(function(dot, i) {
          dot.classList.toggle('active', i === bestIdx);
        });
      }

      function stopAutoSlide() { if (intervalId) { clearInterval(intervalId); intervalId = 0; } }

      function startAutoSlide() {
        stopAutoSlide();
        if (!mobileQuery.matches || reduceMotionQuery.matches) return;
        intervalId = setInterval(function() {
          var cards = getVisibleCards();
          if (!cards[0]) return;
          var gap = parseFloat(window.getComputedStyle(slider).gap) || 12;
          var step = cards[0].getBoundingClientRect().width + gap;
          slider.scrollBy({ left: step, behavior: 'smooth' });
          setTimeout(function() {
            if (slider.scrollLeft + slider.clientWidth >= slider.scrollWidth - 15) {
              slider.scrollTo({ left: 0, behavior: 'smooth' });
            }
          }, 600);
        }, 3200);
      }

      var scrollTicking = false;
      slider.addEventListener('scroll', function() {
        if (!scrollTicking) {
          requestAnimationFrame(function() { updateActiveDot(); scrollTicking = false; });
          scrollTicking = true;
        }
      }, { passive: true });

      slider.addEventListener('mouseenter', stopAutoSlide);
      slider.addEventListener('mouseleave', startAutoSlide);
      slider.addEventListener('touchstart', stopAutoSlide, { passive: true });
      slider.addEventListener('touchend', function() { setTimeout(startAutoSlide, 3000); }, { passive: true });
      mobileQuery.addEventListener('change', function() { buildDots(); startAutoSlide(); });

      buildDots();
      setTimeout(startAutoSlide, 5000);
    });
  })();

  // FAQ Accordion
  (function initFAQ() {
    var accordion = document.getElementById('faq-accordion');
    if (!accordion) return;
    accordion.addEventListener('click', function(e) {
      var trigger = e.target.closest('.faq-trigger');
      if (!trigger) return;
      var item = trigger.closest('.faq-item');
      var answer = item && item.querySelector('.faq-answer');
      var icon = trigger.querySelector('.faq-icon');
      if (!answer) return;

      var isOpen = !answer.classList.contains('hidden');
      // Close all
      accordion.querySelectorAll('.faq-answer').forEach(function(a) { a.classList.add('hidden'); });
      accordion.querySelectorAll('.faq-trigger').forEach(function(t) { t.setAttribute('aria-expanded', 'false'); });
      accordion.querySelectorAll('.faq-icon').forEach(function(ic) { ic.classList.remove('open'); });
      // Toggle current
      if (!isOpen) {
        answer.classList.remove('hidden');
        trigger.setAttribute('aria-expanded', 'true');
        icon && icon.classList.add('open');
      }
    });
  })();
</script>

<script define:vars={{ SUPABASE_URL, SUPABASE_ANON_KEY, citySlug: city.slug, cityName: city.name }}>
  (async function syncCityView() {
    try {
      if (!window.supabase) return;
      const client = window.supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY);
      const { data: allProducts, error } = await client
        .from('products')
        .select('*')
        .order('created_at', { ascending: false });

      if (error || !allProducts || allProducts.length === 0) return;

      const cloudSlugMap = new Map(allProducts.map(p => [p.slug, p]));

      document.querySelectorAll('a[href*="/produk/"]').forEach(link => {
        const match = link.getAttribute('href').match(/\/produk\/([^\/]+)/);
        if (!match || !match[1]) return;
        const slug = match[1];
        const card = link.closest('.product-card-shell, .category-product-card, .classic-product-card, article');
        if (!card) return;
        if (!cloudSlugMap.has(slug)) {
          card.remove();
        } else {
          const p = cloudSlugMap.get(slug);
          const priceEl = card.querySelector('.text-primary.font-extrabold, .font-extrabold.text-primary, [class*="font-extrabold"]');
          if (priceEl && p.price_label) priceEl.textContent = p.price_label;
          const titleEl = card.querySelector('h3');
          if (titleEl && p.name && titleEl.textContent.trim() !== p.name) {
            const linkInTitle = titleEl.querySelector('a');
            if (linkInTitle) linkInTitle.textContent = p.name;
            else titleEl.textContent = p.name;
          }
        }
      });

      // Sync category grids for this city
      function makeCard(p) {
        const prodUrl = `/produk/${p.slug}/`;
        return `<div class="product-item-wrapper h-full">
          <article class="category-product-card product-card-shell group flex h-full flex-col overflow-hidden rounded-[14px] border border-soft-cream/70 bg-white text-left no-underline shadow-[0_1px_4px_rgba(15,23,42,0.03)] hover-gold-grow">
            <a href="${prodUrl}" class="flex h-full flex-col no-underline">
              <div class="image-load-shell relative aspect-[4/5] overflow-hidden bg-clean-ivory">
                <img src="${p.image}" alt="Foto ${p.name} Zaloma Florist ${cityName}" loading="lazy" decoding="async" class="relative z-0 block h-full w-full object-cover object-top transition-transform duration-700 ease-out group-hover:scale-[1.012]" />
                <div class="absolute inset-x-0 bottom-0 z-10 h-24 bg-gradient-to-t from-primary-dark/45 via-primary-dark/10 to-transparent"></div>
              </div>
              <div class="flex min-h-[150px] flex-1 flex-col px-3.5 py-4 sm:min-h-[168px] sm:px-4 sm:py-4.5 justify-between">
                <h3 class="font-serif font-bold leading-snug text-slate-800 line-clamp-2 transition-colors duration-200 group-hover:text-primary text-sm sm:text-base">${p.name}</h3>
                <div class="mt-auto pt-4">
                  <div class="rounded-md border border-soft-cream/70 bg-accent-bg/70 px-3 py-2.5">
                    <p class="text-[9px] font-bold uppercase tracking-[0.18em] text-secondary-dark sm:text-[10px]">Harga</p>
                    <div class="mt-1 flex items-end justify-between gap-2">
                      <p class="font-sans text-[1.05rem] font-extrabold leading-none text-primary sm:text-xl">${p.price_label}</p>
                      <span class="inline-flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-primary text-white shadow-xs" aria-hidden="true">
                        <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.6"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
                      </span>
                    </div>
                  </div>
                </div>
              </div>
            </a>
          </article>
        </div>`;
      }

      // Sync grids by category
      document.querySelectorAll('[data-daily-rotate-category]').forEach(gridEl => {
        const cat = gridEl.getAttribute('data-daily-rotate-category');
        const prods = allProducts.filter(p => p.category_slug === cat);
        if (prods.length > 0) gridEl.innerHTML = prods.slice(0, 8).map(p => makeCard(p)).join('');
      });

      // Bunga Papan panels
      const dukaGrid = document.querySelector('[data-panel="duka-cita"] .grid');
      const dukaProds = allProducts.filter(p => p.category_slug === 'bunga-papan-duka-cita-malang');
      if (dukaGrid && dukaProds.length > 0) dukaGrid.innerHTML = dukaProds.slice(0, 8).map(p => makeCard(p)).join('');

      const wedGrid = document.querySelector('[data-panel="wedding"] .grid');
      const wedProds = allProducts.filter(p => p.category_slug === 'bunga-papan-wedding-malang');
      if (wedGrid && wedProds.length > 0) wedGrid.innerHTML = wedProds.slice(0, 8).map(p => makeCard(p)).join('');

      const congGrid = document.querySelector('[data-panel="congratulations"] .grid');
      const congProds = allProducts.filter(p => p.category_slug === 'bunga-papan-congratulations-malang');
      if (congGrid && congProds.length > 0) congGrid.innerHTML = congProds.slice(0, 8).map(p => makeCard(p)).join('');

    } catch (e) {
      console.warn('City view sync notice:', e);
    }
  })();
</script>
