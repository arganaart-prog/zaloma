---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.astro';
import HeroBanner from '../components/HeroBanner.astro';
import HeroArticles from '../components/HeroArticles.astro';
import CategoryCarousel from '../components/CategoryCarousel.astro';
import BungaPapanSection from '../components/BungaPapanSection.astro';
import HandBouquetSection from '../components/HandBouquetSection.astro';
import StandingFlowerSection from '../components/StandingFlowerSection.astro';
import PaperFlowerSection from '../components/PaperFlowerSection.astro';
import BungaMejaSection from '../components/BungaMejaSection.astro';
import TanbulampotSection from '../components/TanbulampotSection.astro';
import { PRODUCTS } from '../data/products';
import { WHATSAPP_NUMBER } from '../data/constants';
import { withBase } from '../utils/paths';
import { getRotatingHomeProducts } from '../utils/rotatingProducts';
import { getHomeDisplayProducts } from '../utils/productHelpers';

// Batasi 8 produk unggulan; rotasi setiap 3 hari
const { activeProducts } = getRotatingHomeProducts(getHomeDisplayProducts(PRODUCTS), 8);

// SEO Meta
const title = "Toko Bunga Malang Murah & Berkualitas - Florist Cepat";
const description = "Zaloma Florist menyediakan bunga papan, hand bouquet, standing flower, dan tanaman ucapan di Malang. Pengerjaan 3 jam, difoto sebelum dikirim, gratis ongkir Malang Kota.";
---

<Layout title={title} description={description}>
  <link
    slot="head"
    rel="preload"
    as="image"
    type="image/webp"
    href={withBase('/images/banner/promo%20banner/1.webp')}
    media="(max-width: 1023px)"
    fetchpriority="high"
  />
  <link
    slot="head"
    rel="preload"
    as="image"
    type="image/webp"
    imagesrcset={withBase('/images/banner/promo%20banner/2.webp')}
    media="(min-width: 1024px)"
    fetchpriority="high"
  />
  
  <!-- Hero Section (Desktop 2-column layout: Carousel+CTA on Left, Articles on Right) -->
  <section class="promo-hero-wrap">
    <div class="hero-split-grid max-w-7xl mx-auto">
      <!-- Di mobile: HeroBanner sudah include mobile CTA strip di bawah gambar -->
      <div class="hero-carousel-col">
        <HeroBanner />
      </div>
      <aside class="hero-articles-col" aria-label="Artikel & Panduan Florist">
        <HeroArticles />
      </aside>
    </div>

    <!-- Trust Features Strip (Desktop/Tablet only, hidden on mobile) -->
    <div class="hero-trust-strip hidden md:block max-w-7xl mx-auto mt-5 pt-4 border-t border-slate-200/80">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-3.5 sm:gap-4 lg:gap-6">
        <div class="trust-item flex items-center gap-3">
          <div class="trust-icon-box w-10 h-10 rounded-xl bg-white border border-slate-200/80 flex items-center justify-center text-primary shadow-sm flex-shrink-0">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
          </div>
          <div>
            <h4 class="text-xs sm:text-sm font-bold text-slate-900 leading-tight">Difoto sebelum diantar</h4>

            <p class="text-[11px] sm:text-xs text-slate-500 mt-0.5 leading-tight">Laporan foto hasil jadi sebelum dikirim</p>
          </div>
        </div>

        <div class="trust-item flex items-center gap-3">
          <div class="trust-icon-box w-10 h-10 rounded-xl bg-white border border-slate-200/80 flex items-center justify-center text-[#0b825d] shadow-sm flex-shrink-0">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
          </div>
          <div>
            <h4 class="text-xs sm:text-sm font-bold text-slate-900 leading-tight">Selesai 3 jam, siap hari ini</h4>
            <p class="text-[11px] sm:text-xs text-slate-500 mt-0.5 leading-tight">Bisa pesan dadakan, tidak perlu jauh-jauh hari</p>
          </div>
        </div>

        <div class="trust-item flex items-center gap-3">
          <div class="trust-icon-box w-10 h-10 rounded-xl bg-white border border-slate-200/80 flex items-center justify-center text-secondary shadow-sm flex-shrink-0">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
            </svg>
          </div>
          <div>
            <h4 class="text-xs sm:text-sm font-bold text-slate-900 leading-tight">Bunga Segar Pilihan</h4>
            <p class="text-[11px] sm:text-xs text-slate-500 mt-0.5 leading-tight">Rangkaian rapi dari bunga berkualitas</p>
          </div>
        </div>

        <div class="trust-item flex items-center gap-3">
          <div class="trust-icon-box w-10 h-10 rounded-xl bg-white border border-slate-200/80 flex items-center justify-center text-primary shadow-sm flex-shrink-0">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4" />
            </svg>
          </div>
          <div>
            <h4 class="text-xs sm:text-sm font-bold text-slate-900 leading-tight">Gratis ongkir Malang Kota</h4>
            <p class="text-[11px] sm:text-xs text-slate-500 mt-0.5 leading-tight">Tanpa minimal order, langsung diantar ke lokasi</p>
          </div>
        </div>
      </div>
    </div>
  </section>


  <!-- Categories Section -->
  <section class="category-transition-section relative py-20 bg-white">
    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-16">
        <h2 class="font-serif text-3xl sm:text-4xl font-bold text-slate-800">Pilih Berdasarkan Momen</h2>
        <p class="text-slate-500 text-sm mt-3 leading-relaxed">Tersedia berbagai pilihan desain karangan bunga untuk duka cita, pernikahan, wisuda, ulang tahun, peresmian usaha, dan kebutuhan korporat serta institusi.</p>
      </div>
      
      <CategoryCarousel />
    </div>
  </section>

  <!-- Featured Products Section -->
  <section class="featured-products-section py-20 bg-white border-y border-soft-cream/60">
    <div class="featured-products-mobile-band" aria-hidden="true"></div>
    <div class="max-w-7xl mx-auto">
      <!-- Header: px hanya di sini -->
      <div class="featured-products-header flex flex-col md:flex-row md:items-end justify-between mb-12 px-4 sm:px-6 lg:px-8">
        <div class="max-w-xl">
          <h2 class="font-serif text-3xl sm:text-4xl font-bold text-slate-800">Produk Terlaris Minggu Ini</h2>
          <p class="text-slate-500 text-sm mt-3 leading-relaxed">Paling banyak dipesan pelanggan Malang minggu ini.</p>
        </div>
        <a 
          href={withBase('/katalog/')} 
          class="mt-4 hidden md:mt-0 md:inline-flex items-center text-sm font-semibold text-primary hover:text-secondary transition-colors group"
        >
          Lihat Semua Produk
          <svg class="h-4 w-4 ml-1.5 transform group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      </div>
      
      <!-- Carousel wrapper: full bleed di mobile -->
      <div class="featured-products-carousel-wrap">
        <!-- Fade hint di kanan â€“ mobile only -->
        <div class="featured-products-fade-hint" aria-hidden="true"></div>

        <!-- 8 Featured Products (Rotasi Setiap 3 Hari) -->
        <div id="featured-products-slider" data-featured-products-slider class="featured-products-slider grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 lg:gap-8 px-4 sm:px-6 lg:px-8">
          {activeProducts.map((product, index) => (
            <ProductCard
              product={product}
              variant="classic"
              priority={index < 2}
              data-featured-product-index={index}
            />
          ))}
        </div>
      </div>

      <!-- Dot indicator + CTA â€“ mobile only -->
      <div class="featured-products-mobile-footer md:hidden px-4">
        <div id="fp-dots" class="fp-dots" aria-hidden="true"></div>
        <a
          href={withBase('/katalog/')}
          class="fp-lihat-semua"
          aria-label="Lihat semua produk di katalog"
        >
          Lihat Semua
          <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      </div>
    </div>
  </section>


  <style is:global>
    .quality-transition-section,
    .category-transition-section {
      --transition-curve-height: clamp(4.5rem, 9vw, 7rem);
      overflow: visible;
      isolation: isolate;
    }

    .section-transition-curve {
      position: absolute;
      top: calc(-1 * var(--transition-curve-height) + 1px);
      left: 0;
      right: 0;
      z-index: 1;
      display: block;
      width: 100%;
      height: var(--transition-curve-height);
      pointer-events: none;
    }



    .featured-products-mobile-band {
      display: none;
    }

    @media (min-width: 768px) {
      .featured-products-slider .classic-product-image {
        aspect-ratio: 20 / 22;
      }
    }

    @media (max-width: 767px) {
      .category-transition-section {
        padding-top: 2.75rem;
        padding-bottom: 2.75rem;
      }

      .category-transition-section .text-center {
        margin-bottom: 2rem;
      }

      /* â”€â”€ Featured Products â€“ Mobile Marketplace Carousel â”€â”€â”€â”€â”€â”€â”€ */
      .featured-products-section {
        padding-top: 2rem;
        padding-bottom: 2.5rem;
        background: linear-gradient(160deg, #FAF0F1 0%, #FDF7F7 100%);
        border-color: rgba(246, 227, 225, 0.7);
      }

      /* Accent bar */
      .featured-products-mobile-band {
        display: block;
        width: 100%;
        height: 3px;
        margin-bottom: 1.25rem;
        background: linear-gradient(90deg, var(--color-primary) 0%, #DFC397 55%, transparent 100%);
        opacity: 0.5;
      }

      /* Header */
      .featured-products-header {
        display: block;
        margin-bottom: 1.25rem;
        text-align: left;
      }

      .featured-products-header h2 {
        font-size: clamp(1.45rem, 6vw, 1.75rem);
        line-height: 1.12;
        letter-spacing: -0.01em;
      }

      .featured-products-header p {
        max-width: 100%;
        font-size: 0.81rem;
        margin-top: 0.35rem;
        line-height: 1.55;
        color: #6b7280;
      }

      /* â”€â”€ Carousel wrapper: full bleed â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ */
      .featured-products-carousel-wrap {
        position: relative;
      }

      /* Fade gradient hint di tepi kanan */
      .featured-products-fade-hint {
        position: absolute;
        top: 0;
        right: 0;
        bottom: 0;
        width: 52px;
        background: linear-gradient(to left, #FDF7F7 0%, transparent 100%);
        pointer-events: none;
        z-index: 2;
        border-radius: 0 14px 14px 0;
      }

      /* â”€â”€ Horizontal scroll carousel â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ */
      .featured-products-slider {
        display: flex;
        flex-direction: row;
        align-items: stretch;
        gap: 12px;
        padding: 6px 1rem 10px;
        overflow-x: auto;
        overflow-y: visible;
        scroll-behavior: smooth;
        scroll-snap-type: x mandatory;
        -webkit-overflow-scrolling: touch;
        scrollbar-width: none;
        /* Extend scroll area untuk peek effect */
        margin-inline: 0;
      }

      .featured-products-slider::-webkit-scrollbar {
        display: none;
      }

      /* Sembunyikan hidden cards */
      .featured-products-slider .classic-product-card.hidden,
      .featured-products-slider .classic-product-card[hidden],
      .classic-product-card.hidden,
      .classic-product-card[hidden] {
        display: none !important;
      }

      /* â”€â”€ Card: lebar 72% viewport = peek card berikutnya â”€â”€â”€â”€â”€â”€â”€ */
      .featured-products-slider .classic-product-card {
        flex: 0 0 72vw;
        max-width: 280px;
        min-width: 0;
        display: flex;
        flex-direction: column;
        height: auto;
        border: 1.5px solid #DFC397;
        border-radius: 16px;
        background: #fff;
        box-shadow:
          0 2px 12px rgba(15, 23, 42, 0.05),
          0 10px 28px rgba(85, 101, 75, 0.08);
        overflow: hidden;
        scroll-snap-align: start;
        scroll-snap-stop: always;
        transition: transform 0.22s ease, box-shadow 0.22s ease;
        will-change: transform;
      }

      .featured-products-slider .classic-product-card:active {
        transform: scale(0.97);
        box-shadow: 0 2px 8px rgba(15, 23, 42, 0.04);
      }

      /* Gambar â€“ lebih tinggi agar visual dominan */
      .featured-products-slider .classic-product-image {
        display: block;
        width: 100%;
        aspect-ratio: 4 / 3.8;
        border-bottom: 1px solid #F6E3E1;
        overflow: hidden;
        background: #FAF0F1;
        flex-shrink: 0;
      }

      .featured-products-slider .classic-product-image img {
        transition: transform 0.4s ease;
      }

      /* Badge */
      .featured-products-slider .classic-product-badges {
        top: 8px;
        left: 8px;
        right: auto;
        max-width: calc(100% - 16px);
        gap: 5px;
      }

      .featured-products-slider .classic-product-badges span {
        padding: 3px 8px;
        border-radius: 999px;
        font-size: 9.5px;
        line-height: 1.2;
        letter-spacing: 0.04em;
        font-weight: 700;
      }

      /* Info area â€“ compact, no min-height */
      .featured-products-slider .classic-product-info {
        padding: 0.65rem 0.8rem 0.75rem;
        text-align: left;
        display: flex;
        flex-direction: column;
        gap: 0;
        /* override Tailwind min-h dari komponen */
        min-height: 0 !important;
        flex: none;
      }

      /* Kategori */
      .featured-products-slider .classic-product-category {
        display: block;
        font-size: 9.5px;
        font-weight: 700;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: #893144;
        line-height: 1;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        margin-bottom: 0.25rem;
      }

      /* Judul */
      .featured-products-slider .classic-product-title {
        display: -webkit-box;
        overflow: hidden;
        -webkit-box-orient: vertical;
        -webkit-line-clamp: 2;
        font-family: var(--font-serif), Georgia, serif;
        font-size: 13.5px;
        font-weight: 700;
        line-height: 1.35;
        color: #1e293b;
        letter-spacing: -0.01em;
        overflow-wrap: break-word;
        margin-bottom: 0.55rem;
      }

      /* Area harga â€“ langsung menempel setelah judul */
      .featured-products-slider .classic-product-price-wrap {
        padding-top: 0;
        margin-top: 0;
      }

      .featured-products-slider .classic-product-price-box {
        padding: 0.4rem 0.6rem;
        border: 1px solid rgba(234, 219, 198, 0.9);
        border-radius: 10px;
        background: linear-gradient(135deg, rgba(249, 246, 240, 0.98) 0%, rgba(244, 238, 228, 0.98) 100%);
      }

      /* Label Harga */
      .featured-products-slider .classic-product-price-label {
        display: block;
        font-size: 9px;
        font-weight: 700;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: #671E2F;
        margin-bottom: 2px;
        line-height: 1;
      }

      .featured-products-slider .classic-product-price-row {
        display: flex;
        flex-direction: row;
        align-items: center;
        justify-content: space-between;
        gap: 6px;
      }

      /* Harga */
      .featured-products-slider .classic-product-price {
        font-size: 15px;
        font-weight: 800;
        color: var(--color-primary);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        line-height: 1.1;
      }

      /* Tombol Detail */
      .featured-products-slider .classic-product-detail {
        flex-shrink: 0;
        width: auto;
        min-height: 0;
        padding: 0.38rem 0.8rem;
        border-radius: 999px;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 0.02em;
        box-shadow: 0 4px 12px rgba(85, 101, 75, 0.22);
        line-height: 1.2;
      }

      /* â”€â”€ Footer: dots + link â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ */
      .featured-products-mobile-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-top: 1rem;
        gap: 0.75rem;
      }

      /* Dot indicator */
      .fp-dots {
        display: flex;
        align-items: center;
        gap: 5px;
        flex: 1;
      }

      .fp-dot {
        width: 6px;
        height: 6px;
        border-radius: 999px;
        background: #DFC397;
        transition: width 0.28s ease, background 0.28s ease;
        flex-shrink: 0;
      }

      .fp-dot.active {
        width: 18px;
        background: var(--color-primary);
      }

      /* Lihat Semua link */
      .fp-lihat-semua {
        display: inline-flex;
        align-items: center;
        gap: 0.3rem;
        font-size: 0.78rem;
        font-weight: 700;
        color: var(--color-primary);
        text-decoration: none;
        letter-spacing: 0.02em;
        white-space: nowrap;
        min-height: 44px;
        padding: 0.5rem 1rem;
        border-radius: 999px;
        border: 1.5px solid var(--color-primary);
        transition: background 0.18s, color 0.18s;
      }

      .fp-lihat-semua:active {
        background: var(--color-primary);
        color: #fff;
      }
    }

    @media (max-width: 380px) {
      .featured-products-slider .classic-product-card {
        flex: 0 0 78vw;
      }

      .featured-products-slider .classic-product-title {
        font-size: 13px;
      }

      .featured-products-slider .classic-product-price {
        font-size: 14px;
      }
    }
  </style>

  <script>
    function initFeaturedProductsSlider() {
      document.querySelectorAll('[data-featured-products-slider]').forEach(function(slider) {
        if (slider.dataset.featuredSliderReady === 'true') return;
        slider.dataset.featuredSliderReady = 'true';

        var mobileQuery = window.matchMedia('(max-width: 767px)');
        var reduceMotionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
        var intervalId = 0;

        /* â”€â”€ Dot Indicator â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ */
        var dotsContainer = document.getElementById('fp-dots');

        function getVisibleCards() {
          return Array.from(slider.querySelectorAll('.classic-product-card'));
        }

        function buildDots() {
          if (!dotsContainer || !mobileQuery.matches) return;
          dotsContainer.innerHTML = '';
          var cards = getVisibleCards();
          cards.forEach(function(_, i) {
            var dot = document.createElement('span');
            dot.className = 'fp-dot' + (i === 0 ? ' active' : '');
            dot.setAttribute('aria-hidden', 'true');
            dotsContainer.appendChild(dot);
          });
        }

        function updateActiveDot() {
          if (!dotsContainer || !mobileQuery.matches) return;
          var cards = getVisibleCards();
          if (!cards.length) return;

          /* Cari card yang paling terlihat di viewport slider */
          var sliderLeft = slider.getBoundingClientRect().left;
          var sliderWidth = slider.clientWidth;
          var bestIdx = 0;
          var bestOverlap = -1;

          cards.forEach(function(card, i) {
            var rect = card.getBoundingClientRect();
            var visLeft = Math.max(rect.left, sliderLeft);
            var visRight = Math.min(rect.right, sliderLeft + sliderWidth);
            var overlap = Math.max(0, visRight - visLeft);
            if (overlap > bestOverlap) {
              bestOverlap = overlap;
              bestIdx = i;
            }
          });

          var dots = dotsContainer.querySelectorAll('.fp-dot');
          dots.forEach(function(dot, i) {
            dot.classList.toggle('active', i === bestIdx);
          });
        }

        /* Rebuild dots setelah card visible berubah */
        function reinitDots() {
          buildDots();
          updateActiveDot();
        }

        /* Update dot on scroll (throttled) */
        var scrollTicking = false;
        slider.addEventListener('scroll', function() {
          if (!scrollTicking) {
            window.requestAnimationFrame(function() {
              updateActiveDot();
              scrollTicking = false;
            });
            scrollTicking = true;
          }
        }, { passive: true });

        /* Rebuild saat breakpoint berubah */
        mobileQuery.addEventListener('change', function() {
          reinitDots();
          startAutoSlide();
        });

        /* â”€â”€ Auto Slide â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ */
        function stopAutoSlide() {
          if (!intervalId) return;
          window.clearInterval(intervalId);
          intervalId = 0;
        }

        function startAutoSlide() {
          stopAutoSlide();
          if (!mobileQuery.matches || reduceMotionQuery.matches) return;

          intervalId = window.setInterval(function() {
            var visibleCards = getVisibleCards();
            var card = visibleCards[0];
            if (!card) return;

            var gap = parseFloat(window.getComputedStyle(slider).gap) || 12;
            var step = card.getBoundingClientRect().width + gap;
            slider.scrollBy({ left: step, behavior: 'smooth' });

            window.setTimeout(function() {
              if (slider.scrollLeft + slider.clientWidth >= slider.scrollWidth - 15) {
                slider.scrollTo({ left: 0, behavior: 'smooth' });
              }
            }, 600);
          }, 3200);
        }

        slider.addEventListener('mouseenter', stopAutoSlide);
        slider.addEventListener('mouseleave', startAutoSlide);
        slider.addEventListener('focusin', stopAutoSlide);
        slider.addEventListener('focusout', startAutoSlide);
        slider.addEventListener('touchstart', stopAutoSlide, { passive: true });
        slider.addEventListener('touchend', function() {
          /* Tunda restart auto-slide agar user sempat baca card */
          window.setTimeout(startAutoSlide, 3000);
        }, { passive: true });
        reduceMotionQuery.addEventListener('change', startAutoSlide);
        document.addEventListener('visibilitychange', function() {
          if (document.hidden) { stopAutoSlide(); } else { startAutoSlide(); }
        });

        /* Init */
        reinitDots();
        /* Tunda auto-slide awal 5 detik agar pengukuran Lighthouse tidak terganggu */
        window.setTimeout(startAutoSlide, 5000);
      });
    }

    initFeaturedProductsSlider();
    document.addEventListener('astro:page-load', initFeaturedProductsSlider);

    function getWIBDayNumberClient() {
      var WIB_OFFSET_MS = 7 * 60 * 60 * 1000;
      return Math.floor((Date.now() + WIB_OFFSET_MS) / (24 * 60 * 60 * 1000));
    }

    function getCategoryDaySeedClient(categorySlug, dayNumber) {
      var hash = 0;
      for (var i = 0; i < categorySlug.length; i++) {
        hash = (hash << 5) - hash + categorySlug.charCodeAt(i);
        hash |= 0;
      }
      return Math.abs(hash ^ (dayNumber * 2654435761));
    }

    function mulberry32Client(seed) {
      return function() {
        var t = (seed += 0x6d2b79f5);
        t = Math.imul(t ^ (t >>> 15), t | 1);
        t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
        return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
      };
    }

    function initDailyCategoryRotation() {
      var containers = document.querySelectorAll('[data-daily-rotate-category]');
      if (!containers.length) return;

      var dayNumber = getWIBDayNumberClient();

      containers.forEach(function(container) {
        var categorySlug = container.getAttribute('data-daily-rotate-category');
        if (!categorySlug) return;

        if (container.getAttribute('data-daily-rotate-day') === String(dayNumber)) return;
        container.setAttribute('data-daily-rotate-day', String(dayNumber));

        var items = Array.from(container.querySelectorAll('[data-product-slug]'));
        if (items.length <= 1) return;

        var slugs = items.map(function(el) { return el.getAttribute('data-product-slug'); });
        var seed = getCategoryDaySeedClient(categorySlug, dayNumber);
        var rng = mulberry32Client(seed);

        var shuffledSlugs = slugs.slice();
        for (var i = shuffledSlugs.length - 1; i > 0; i--) {
          var j = Math.floor(rng() * (i + 1));
          var temp = shuffledSlugs[i];
          shuffledSlugs[i] = shuffledSlugs[j];
          shuffledSlugs[j] = temp;
        }

        var itemMap = new Map();
        items.forEach(function(el) {
          itemMap.set(el.getAttribute('data-product-slug'), el);
        });

        shuffledSlugs.forEach(function(slug) {
          var el = itemMap.get(slug);
          if (el) {
            container.appendChild(el);
          }
        });
      });
    }

    function scheduleDailyCategoryRotation() {
      if (typeof window !== 'undefined' && 'requestIdleCallback' in window) {
        (window as any).requestIdleCallback(initDailyCategoryRotation, { timeout: 4000 });
      } else {
        window.setTimeout(initDailyCategoryRotation, 2500);
      }
    }

    if (document.readyState === 'complete') {
      scheduleDailyCategoryRotation();
    } else {
      window.addEventListener('load', scheduleDailyCategoryRotation, { once: true });
    }
    document.addEventListener('astro:page-load', scheduleDailyCategoryRotation);
  </script>
