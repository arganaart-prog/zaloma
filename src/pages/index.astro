---
import Layout from '../layouts/Layout.astro';
import HomeHero from '../components/HomeHero.astro';
import HomeLiveSync from '../components/HomeLiveSync.astro';
import CategoryCarousel from '../components/CategoryCarousel.astro';
import HomeDynamicCategorySections from '../components/HomeDynamicCategorySections.astro';
import FeaturedProductsSection from '../components/FeaturedProductsSection.astro';
import BungaPapanSection from '../components/BungaPapanSection.astro';
import HandBouquetSection from '../components/HandBouquetSection.astro';
import StandingFlowerSection from '../components/StandingFlowerSection.astro';
import PaperFlowerSection from '../components/PaperFlowerSection.astro';
import BungaMejaSection from '../components/BungaMejaSection.astro';
import TanbulampotSection from '../components/TanbulampotSection.astro';
import CityDeliverySection from '../components/CityDeliverySection.astro';
import DailyCategoryRotation from '../components/DailyCategoryRotation.astro';
import { SUPABASE_URL, SUPABASE_ANON_KEY } from '../data/supabaseConfig';
import { SITE_DOMAIN, WHATSAPP_NUMBER } from '../data/constants';
import { DEFAULT_SITE_SEO_TITLE } from '../utils/seo';
import { getRotatingHomeProducts } from '../utils/rotatingProducts';
import { getHomeDisplayProducts, getSellableProducts, extractConfigCategories, deriveCategoriesFromProducts, getMomentCategories, mergeCategories } from '../utils/productHelpers';

// Ambil produk live dari Supabase saat build time untuk SEO & instant SSR render
let homeLiveProducts: any[] = [];
let configCategories: any[] = [];
let homeCities: any[] = [];
try {
  const res = await fetch(`${SUPABASE_URL}/rest/v1/products?select=*&order=created_at.desc`, {
    headers: {
      apikey: SUPABASE_ANON_KEY,
      Authorization: `Bearer ${SUPABASE_ANON_KEY}`
    }
  });
  if (res.ok) {
    const data = await res.json();
    if (Array.isArray(data)) {
      configCategories = extractConfigCategories(data);
      const citiesConfig = data.find(p => p.slug === '_cities_config_');
      if (typeof citiesConfig?.description === 'string') {
        try {
          const parsedCities = JSON.parse(citiesConfig.description);
          if (Array.isArray(parsedCities)) homeCities = parsedCities;
        } catch (err) {
          console.warn('[Zaloma Build] Konfigurasi kota beranda tidak valid:', err);
        }
      }
      homeLiveProducts = getSellableProducts(data).map(p => ({
        id: p.id,
        slug: p.slug,
        name: p.name,
        categorySlug: p.category_slug,
        categoryName: p.category_name?.replace(/\s+(?:(?:kota|kabupaten)\s+)?(?:malang(?:\s+raya)?|batu|surabaya|sidoarjo|gresik|pasuruan|kediri|blitar|mojokerto|jombang|tulungagung)$/i, '').trim() || '',
        city: p.city || 'Berbagai Kota',
        priceFrom: Number(p.price_from) || 0,
        priceLabel: p.price_label,
        image: p.image,
        images: p.images || [],
        hoverPreviewIndex: p.hover_preview_index || undefined,
        imageWidth: 800,
        imageHeight: 800,
        description: p.description || '',
        featured: Boolean(p.featured),
        whatsappText: `Halo Zaloma Florist, saya ingin pesan ${p.name} (${p.price_label}).`,
        processingTime: p.processing_time || '3 - 5 Jam',
        serviceArea: p.city ? [p.city] : []
      }));
    }
  }
} catch (err) {
  console.warn('[Zaloma Build] Homepage fetch warning:', err);
}

// Batasi 5 produk unggulan; rotasi setiap 3 hari
const { activeProducts } = getRotatingHomeProducts(getHomeDisplayProducts(homeLiveProducts), 5);

// Derive categories dynamically from Supabase: config + product data (no static code)
const stripCitySuffix = (name: string) =>
  name.replace(/\s+(?:(?:kota|kabupaten)\s+)?(?:malang(?:\s+raya)?|batu|surabaya|sidoarjo|gresik|pasuruan|kediri|blitar|mojokerto|jombang|tulungagung)$/i, '').trim();
const homeCategories = mergeCategories(configCategories, deriveCategoriesFromProducts(homeLiveProducts))
  .map((category) => ({
    ...category,
    name: stripCitySuffix(category.name),
    subcategories: category.subcategories?.map((subcategory) => ({
      ...subcategory,
      name: stripCitySuffix(subcategory.name),
    })),
  }));
const homeMomentCategories = getMomentCategories(homeCategories);
const homeCategoryProductCounts = homeLiveProducts.reduce<Record<string, number>>((counts, product) => {
  if (product.categorySlug) {
    const normalizedSlug = product.categorySlug.toLowerCase().replace(/-malang$/, '');
    counts[normalizedSlug] = (counts[normalizedSlug] ?? 0) + 1;
  }
  return counts;
}, {});
homeMomentCategories.forEach((category) => {
  const normalizedSlug = category.slug.toLowerCase().replace(/-malang$/, '').replace(/--+/g, '-');
  if (homeCategoryProductCounts[normalizedSlug] !== undefined) {
    homeCategoryProductCounts[category.slug] = homeCategoryProductCounts[normalizedSlug];
  }
});
const getHomeCategorySlug = (slugs: string[]) => {
  const normalize = (slug: string) => slug.toLowerCase().replace(/-malang$/, '');
  const matches = new Set(slugs.map(normalize));
  return configCategories.find((category) => matches.has(normalize(category.slug)))?.slug
    || homeLiveProducts.find((product) => matches.has(normalize(product.categorySlug)))?.categorySlug
    || slugs[0];
};
const homeSectionCategories = {
  bouquet: getHomeCategorySlug(['bouquet', 'hand-bouquet', 'hand-bouquet-malang']),
  standingFlower: getHomeCategorySlug(['standing-flower', 'standing-flower-malang']),
  paperFlower: getHomeCategorySlug(['paper-flower', 'paper-flower-malang']),
  bungaMeja: getHomeCategorySlug(['bunga-meja', 'bunga-meja-malang']),
  tabulampot: getHomeCategorySlug(['tabulampot', 'tanbulampot', 'tanbulampot-malang']),
};

// SEO Meta
const title = DEFAULT_SITE_SEO_TITLE;
const description = "Zaloma Florist adalah toko bunga online 24 jam yang melayani bunga papan, hand bouquet, standing flower, dan tanaman ucapan ke berbagai kota. Produk difoto sebelum dikirim dan ketersediaan pengiriman dikonfirmasi sesuai tujuan.";
const homepageKeywords = "Zaloma Florist, florist profesional, toko bunga terbaik, bunga papan, hand bouquet, standing flower, bunga meja, tanaman ucapan, pengiriman bunga berbagai kota";
const homepageSchema = {
  '@context': 'https://schema.org',
  '@type': 'Florist',
  name: 'Zaloma Florist',
  alternateName: ['Toko Bunga Profesional Zaloma Florist'],
  description,
  slogan: 'Toko bunga online | Florist 24 jam | Florist Profesional',
  image: `${SITE_DOMAIN}/images/logo/zaloma-logo.webp`,
  logo: `${SITE_DOMAIN}/favicon-192.png`,
  url: SITE_DOMAIN,
  telephone: `+${WHATSAPP_NUMBER}`,
  areaServed: { '@type': 'Country', name: 'Indonesia' },
  keywords: homepageKeywords,
};
---

<Layout title={title} description={description} keywords={homepageKeywords} schema={homepageSchema}>
  <!-- Supabase JS SDK for live home sync -->
  <script is:inline src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
  <HomeHero />


  <section class="category-transition-section relative py-20 bg-white">
    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-16">
        <h2 class="font-serif text-3xl sm:text-4xl font-bold text-slate-800">Pilih Berdasarkan Momen</h2>
        <p class="text-slate-500 text-sm mt-3 leading-relaxed">Tersedia berbagai pilihan desain karangan bunga untuk duka cita, pernikahan, wisuda, ulang tahun, peresmian usaha, dan kebutuhan korporat serta institusi.</p>
      </div>
      <CategoryCarousel categories={homeMomentCategories} productCounts={homeCategoryProductCounts} />
    </div>
  </section>
  

  <FeaturedProductsSection products={activeProducts} />


  <style is:global>
    .quality-transition-section,
    .category-transition-section {
      --transition-curve-height: clamp(4.5rem, 9vw, 7rem);
      overflow: visible;
      isolation: isolate;
    }

    .section-transition-curve {
      position: absolute;
      top: calc(-1 * var(--transition-curve-height) + 1px);
      left: 0;
      right: 0;
      z-index: 1;
      display: block;
      width: 100%;
      height: var(--transition-curve-height);
      pointer-events: none;
    }



    .featured-products-mobile-band {
      display: none;
    }

    @media (min-width: 768px) {
      .featured-products-slider .classic-product-image {
        aspect-ratio: 20 / 22;
      }
    }

    @media (max-width: 767px) {
      .category-transition-section {
        padding-top: 2.75rem;
        padding-bottom: 2.75rem;
      }

      .category-transition-section .text-center {
        margin-bottom: 2rem;
      }

      /* â”€â”€ Featured Products â€“ Mobile Marketplace Carousel â”€â”€â”€â”€â”€â”€â”€ */
      .featured-products-section {
        padding-top: 2rem;
        padding-bottom: 2.5rem;
        background: linear-gradient(160deg, #FAF0F1 0%, #FDF7F7 100%);
        border-color: rgba(246, 227, 225, 0.7);
      }

      /* Accent bar */
      .featured-products-mobile-band {
        display: block;
        width: 100%;
        height: 3px;
        margin-bottom: 1.25rem;
        background: linear-gradient(90deg, var(--color-primary) 0%, #DFC397 55%, transparent 100%);
        opacity: 0.5;
      }

      /* Header */
      .featured-products-header {
        display: block;
        margin-bottom: 1.25rem;
        text-align: left;
      }

      .featured-products-header h2 {
        font-size: clamp(1.45rem, 6vw, 1.75rem);
        line-height: 1.12;
        letter-spacing: -0.01em;
      }

      .featured-products-header p {
        max-width: 100%;
        font-size: 0.81rem;
        margin-top: 0.35rem;
        line-height: 1.55;
        color: #6b7280;
      }

      /* â”€â”€ Carousel wrapper: full bleed â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ */
      .featured-products-carousel-wrap {
        position: relative;
      }

      /* Fade gradient hint di tepi kanan */
      .featured-products-fade-hint {
        position: absolute;
        top: 0;
        right: 0;
        bottom: 0;
        width: 52px;
        background: linear-gradient(to left, #FDF7F7 0%, transparent 100%);
        pointer-events: none;
        z-index: 2;
        border-radius: 0 14px 14px 0;
      }

      /* â”€â”€ Horizontal scroll carousel â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ */
      .featured-products-slider {
        display: flex;
        flex-direction: row;
        align-items: stretch;
        gap: 12px;
        padding: 6px 1rem 10px;
        overflow-x: auto;
        overflow-y: visible;
        scroll-behavior: smooth;
        scroll-snap-type: x mandatory;
        -webkit-overflow-scrolling: touch;
        scrollbar-width: none;
        /* Extend scroll area untuk peek effect */
        margin-inline: 0;
      }

      .featured-products-slider::-webkit-scrollbar {
        display: none;
      }

      /* Sembunyikan hidden cards */
      .featured-products-slider .classic-product-card.hidden,
      .featured-products-slider .classic-product-card[hidden],
      .classic-product-card.hidden,
      .classic-product-card[hidden] {
        display: none !important;
      }

      /* â”€â”€ Card: lebar 72% viewport = peek card berikutnya â”€â”€â”€â”€â”€â”€â”€ */
      .featured-products-slider .classic-product-card {
        flex: 0 0 72vw;
        max-width: 280px;
        min-width: 0;
        display: flex;
        flex-direction: column;
        height: auto;
        border: 1.5px solid #DFC397;
        border-radius: 16px;
        background: #fff;
        box-shadow:
          0 2px 12px rgba(15, 23, 42, 0.05),
          0 10px 28px rgba(85, 101, 75, 0.08);
        overflow: hidden;
        scroll-snap-align: start;
        scroll-snap-stop: always;
        transition: transform 0.22s ease, box-shadow 0.22s ease;
        will-change: transform;
      }

      .featured-products-slider .classic-product-card:active {
        transform: scale(0.97);
        box-shadow: 0 2px 8px rgba(15, 23, 42, 0.04);
      }

      /* Gambar â€“ lebih tinggi agar visual dominan */
      .featured-products-slider .classic-product-image {
        display: block;
        width: 100%;
        aspect-ratio: 4 / 3.8;
        border-bottom: 1px solid #F6E3E1;
        overflow: hidden;
        background: #FAF0F1;
        flex-shrink: 0;
      }

      .featured-products-slider .classic-product-image img {
        transition: transform 0.4s ease;
      }

      /* Badge */
      .featured-products-slider .classic-product-badges {
        top: 8px;
        left: 8px;
        right: auto;
        max-width: calc(100% - 16px);
        gap: 5px;
      }

      .featured-products-slider .classic-product-badges span {
        padding: 3px 8px;
        border-radius: 999px;
        font-size: 9.5px;
        line-height: 1.2;
        letter-spacing: 0.04em;
        font-weight: 700;
      }

      /* Info area â€“ compact, no min-height */
      .featured-products-slider .classic-product-info {
        padding: 0.65rem 0.8rem 0.75rem;
        text-align: left;
        display: flex;
        flex-direction: column;
        gap: 0;
        /* override Tailwind min-h dari komponen */
        min-height: 0 !important;
        flex: none;
      }

      /* Kategori */
      .featured-products-slider .classic-product-category {
        display: block;
        font-size: 9.5px;
        font-weight: 700;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: #893144;
        line-height: 1;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        margin-bottom: 0.25rem;
      }

      /* Judul */
      .featured-products-slider .classic-product-title {
        display: -webkit-box;
        overflow: hidden;
        -webkit-box-orient: vertical;
        -webkit-line-clamp: 2;
        font-family: var(--font-serif), Georgia, serif;
        font-size: 13.5px;
        font-weight: 700;
        line-height: 1.35;
        color: #1e293b;
        letter-spacing: -0.01em;
        overflow-wrap: break-word;
        margin-bottom: 0.55rem;
      }

      /* Area harga â€“ langsung menempel setelah judul */
      .featured-products-slider .classic-product-price-wrap {
        padding-top: 0;
        margin-top: 0;
      }

      .featured-products-slider .classic-product-price-box {
        padding: 0.4rem 0.6rem;
        border: 1px solid rgba(234, 219, 198, 0.9);
        border-radius: 10px;
        background: linear-gradient(135deg, rgba(249, 246, 240, 0.98) 0%, rgba(244, 238, 228, 0.98) 100%);
      }

      /* Label Harga */
      .featured-products-slider .classic-product-price-label {
        display: block;
        font-size: 9px;
        font-weight: 700;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: #671E2F;
        margin-bottom: 2px;
        line-height: 1;
      }

      .featured-products-slider .classic-product-price-row {
        display: flex;
        flex-direction: row;
        align-items: center;
        justify-content: space-between;
        gap: 6px;
      }

      /* Harga */
      .featured-products-slider .classic-product-price {
        font-size: 15px;
        font-weight: 800;
        color: var(--color-primary);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        line-height: 1.1;
      }

      /* Tombol Detail */
      .featured-products-slider .classic-product-detail {
        flex-shrink: 0;
        width: auto;
        min-height: 0;
        padding: 0.38rem 0.8rem;
        border-radius: 999px;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 0.02em;
        box-shadow: 0 4px 12px rgba(85, 101, 75, 0.22);
        line-height: 1.2;
      }

      /* â”€â”€ Footer: dots + link â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ */
      .featured-products-mobile-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-top: 1rem;
        gap: 0.75rem;
      }

      /* Dot indicator */
      .fp-dots {
        display: flex;
        align-items: center;
        gap: 5px;
        flex: 1;
      }

      .fp-dot {
        width: 6px;
        height: 6px;
        border-radius: 999px;
        background: #DFC397;
        transition: width 0.28s ease, background 0.28s ease;
        flex-shrink: 0;
      }

      .fp-dot.active {
        width: 18px;
        background: var(--color-primary);
      }

      /* Lihat Semua link */
      .fp-lihat-semua {
        display: inline-flex;
        align-items: center;
        gap: 0.3rem;
        font-size: 0.78rem;
        font-weight: 700;
        color: var(--color-primary);
        text-decoration: none;
        letter-spacing: 0.02em;
        white-space: nowrap;
        min-height: 44px;
        padding: 0.5rem 1rem;
        border-radius: 999px;
        border: 1.5px solid var(--color-primary);
        transition: background 0.18s, color 0.18s;
      }

      .fp-lihat-semua:active {
        background: var(--color-primary);
        color: #fff;
      }
    }

    @media (max-width: 380px) {
      .featured-products-slider .classic-product-card {
        flex: 0 0 72vw;
      }

      .featured-products-slider .classic-product-title {
        font-size: 13px;
      }

      .featured-products-slider .classic-product-price {
        font-size: 14px;
      }
    }
  </style>

  <script>
    function initFeaturedProductsSlider() {
      document.querySelectorAll('[data-featured-products-slider]').forEach(function(slider) {
        if (!(slider instanceof HTMLElement)) return;
        if (slider.dataset.featuredSliderReady === 'true') return;
        slider.dataset.featuredSliderReady = 'true';

        var mobileQuery = window.matchMedia('(max-width: 767px)');
        var reduceMotionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
        var intervalId = 0;

        /* â”€â”€ Dot Indicator â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ */
        var dotsContainer = document.getElementById('fp-dots');

        function getVisibleCards() {
          return Array.from(slider.querySelectorAll('.classic-product-card'));
        }

        function buildDots() {
          var container = dotsContainer;
          if (!container || !mobileQuery.matches) return;
          container.innerHTML = '';
          var cards = getVisibleCards();
          for (var i = 0; i < cards.length; i++) {
            var dot = document.createElement('span');
            dot.className = 'fp-dot' + (i === 0 ? ' active' : '');
            dot.setAttribute('aria-hidden', 'true');
            container.appendChild(dot);
          }
        }

        function updateActiveDot() {
          var container = dotsContainer;
          if (!container || !mobileQuery.matches) return;
          var cards = getVisibleCards();
          if (!cards.length) return;

          /* Cari card yang paling terlihat di viewport slider */
          var sliderLeft = slider.getBoundingClientRect().left;
          var sliderWidth = slider.clientWidth;
          var bestIdx = 0;
          var bestOverlap = -1;

          cards.forEach(function(card, i) {
            var rect = card.getBoundingClientRect();
            var visLeft = Math.max(rect.left, sliderLeft);
            var visRight = Math.min(rect.right, sliderLeft + sliderWidth);
            var overlap = Math.max(0, visRight - visLeft);
            if (overlap > bestOverlap) {
              bestOverlap = overlap;
              bestIdx = i;
            }
          });

          var dots = container.querySelectorAll('.fp-dot');
          dots.forEach(function(dot, i) {
            dot.classList.toggle('active', i === bestIdx);
          });
        }

        /* Rebuild dots setelah card visible berubah */
        function reinitDots() {
          buildDots();
          updateActiveDot();
        }

        /* Update dot on scroll (throttled) */
        var scrollTicking = false;
        slider.addEventListener('scroll', function() {
          if (!scrollTicking) {
            window.requestAnimationFrame(function() {
              updateActiveDot();
              scrollTicking = false;
            });
            scrollTicking = true;
          }
        }, { passive: true });

        /* Rebuild saat breakpoint berubah */
        mobileQuery.addEventListener('change', function() {
          reinitDots();
          startAutoSlide();
        });

        /* â”€â”€ Auto Slide â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ */
        function stopAutoSlide() {
          if (!intervalId) return;
          window.clearInterval(intervalId);
          intervalId = 0;
        }

        function startAutoSlide() {
          stopAutoSlide();
          if (!mobileQuery.matches || reduceMotionQuery.matches) return;

          intervalId = window.setInterval(function() {
            var visibleCards = getVisibleCards();
            var card = visibleCards[0];
            if (!card) return;

            var gap = parseFloat(window.getComputedStyle(slider).gap) || 12;
            var step = card.getBoundingClientRect().width + gap;
            slider.scrollBy({ left: step, behavior: 'smooth' });

            window.setTimeout(function() {
              if (slider.scrollLeft + slider.clientWidth >= slider.scrollWidth - 15) {
                slider.scrollTo({ left: 0, behavior: 'smooth' });
              }
            }, 600);
          }, 3200);
        }

        slider.addEventListener('mouseenter', stopAutoSlide);
        slider.addEventListener('mouseleave', startAutoSlide);
        slider.addEventListener('focusin', stopAutoSlide);
        slider.addEventListener('focusout', startAutoSlide);
        slider.addEventListener('touchstart', stopAutoSlide, { passive: true });
        slider.addEventListener('touchend', function() {
          /* Tunda restart auto-slide agar user sempat baca card */
          window.setTimeout(startAutoSlide, 3000);
        }, { passive: true });
        reduceMotionQuery.addEventListener('change', startAutoSlide);
        document.addEventListener('visibilitychange', function() {
          if (document.hidden) { stopAutoSlide(); } else { startAutoSlide(); }
        });

        /* Init */
        reinitDots();
        /* Tunda auto-slide awal 5 detik agar pengukuran Lighthouse tidak terganggu */
        window.setTimeout(startAutoSlide, 5000);
      });
    }

    window.initFeaturedProductsSlider = initFeaturedProductsSlider;
    initFeaturedProductsSlider();
    document.addEventListener('astro:page-load', initFeaturedProductsSlider);
  </script>

  <DailyCategoryRotation />

  <!-- Hand Bouquet Section -->
  <HandBouquetSection allProducts={homeLiveProducts} categorySlug={homeSectionCategories.bouquet} />

  <!-- Bunga Papan Section -->
  <BungaPapanSection allProducts={homeLiveProducts} />

  <!-- Standing Flower Section -->
  <StandingFlowerSection allProducts={homeLiveProducts} categorySlug={homeSectionCategories.standingFlower} />

  <!-- Paper Flower Section -->
  <PaperFlowerSection allProducts={homeLiveProducts} categorySlug={homeSectionCategories.paperFlower} />

