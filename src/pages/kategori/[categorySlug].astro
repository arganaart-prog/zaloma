---
import Layout from '../../layouts/Layout.astro';
import ProductCard from '../../components/ProductCard.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { CATEGORIES } from '../../data/products';
import { WHATSAPP_NUMBER, SITE_DOMAIN } from '../../data/constants';
import { SUPABASE_URL, SUPABASE_ANON_KEY } from '../../data/supabaseConfig';
import { withBase } from '../../utils/paths';

export async function getStaticPaths() {
  let allLiveProducts: any[] = [];
  try {
    const res = await fetch(`${SUPABASE_URL}/rest/v1/products?select=*`, {
      headers: {
        apikey: SUPABASE_ANON_KEY,
        Authorization: `Bearer ${SUPABASE_ANON_KEY}`
      }
    });
    if (res.ok) {
      allLiveProducts = await res.json();
    }
  } catch (err) {
    console.warn('[Zaloma Build] Warning fetching products for category paths:', err);
  }

  return CATEGORIES.map(category => {
    const filteredProducts = allLiveProducts
      .filter(p => p.category_slug === category.slug)
      .map(p => ({
        id: p.id,
        slug: p.slug,
        name: p.name,
        categorySlug: p.category_slug,
        categoryName: p.category_name,
        city: p.city || 'Malang',
        priceFrom: Number(p.price_from) || 0,
        priceLabel: p.price_label,
        image: p.image,
        imageWidth: 800,
        imageHeight: 800,
        description: p.description || '',
        featured: Boolean(p.featured),
        whatsappText: `Halo Zaloma Florist, saya ingin pesan ${p.name} (${p.price_label}).`,
        processingTime: p.processing_time || '3 - 5 Jam',
        serviceArea: ['Kota Malang', 'Kabupaten Malang', 'Kota Batu']
      }));

    return {
      params: { categorySlug: category.slug },
      props: { category, products: filteredProducts }
    };
  });
}

const { category, products = [] } = Astro.props;
const isTanbulampot = category.slug === 'tanbulampot-malang';
const isHandBouquet = category.slug === 'hand-bouquet-malang';
const categorySlug = category.slug;

// Structured Schema untuk Kategori & FAQ
const categoryUrl = `${SITE_DOMAIN}/kategori/${category.slug}/`;
const customCategorySchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": category.seoTitle,
  "description": category.seoDescription,
  "url": categoryUrl,
  "mainEntity": {
    "@type": "ItemList",
    "itemListElement": products.map((prod, index) => ({
      "@type": "ListItem",
      "position": index + 1,
      "url": `${SITE_DOMAIN}/produk/${prod.slug}/`,
      "name": prod.name
    }))
  },
  ...(isTanbulampot ? {
    "hasPart": {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Apa itu bunga ucapan tanaman dan pohon ucapan (tanbulampot)?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Bunga ucapan tanaman atau pohon ucapan adalah kreasi ucapan selamat & sukses menggunakan tanaman hidup dan bibit pohon buah dalam pot (tanbulampot) yang dirangkai estetis lengkap dengan pita satin mewah serta kartu ucapan kustom sebagai alternatif karangan bunga konvensional yang ramah lingkungan."
          }
        },
        {
          "@type": "Question",
          "name": "Mengapa memilih ucapan bibit pohon & buah dibanding karangan bunga biasa?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Ucapan bibit pohon & buah tidak mudah layu karena tanaman tetap hidup, dapat dirawat, tumbuh subur, dan menghasilkan buah. Hal ini menjadikannya simbol keberkahan dan doa pertumbuhan bisnis yang berkesan untuk jangka panjang."
          }
        },
        {
          "@type": "Question",
          "name": "Apakah bisa custom karangan bibit tanaman untuk grand opening di Malang?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Ya, Zaloma Florist menyediakan custom karangan bibit tanaman dan bunga ucapan tanaman hidup dengan pilihan jenis bibit buah (jeruk nagami, tin, dsb.), ukuran pot keramik eksklusif, serta ucapan kustom untuk pengiriman ke seluruh Malang Raya dan Kota Batu."
          }
        }
      ]
    }
  } : {})
};
---

<Layout
  title={category.seoTitle}
  description={category.seoDescription}
  keywords={category.seoKeywords}
  schema={customCategorySchema}
>
  <!-- Supabase SDK for live cloud products -->
  <script is:inline src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    
    <!-- Breadcrumb -->
    <Breadcrumb 
      items={[
        { label: 'Katalog', href: '/katalog/' },
        { label: category.name }
      ]} 
    />

    <!-- Category Header -->
    <div class="mt-6 mb-12 max-w-3xl">
      <span class="text-xs font-semibold text-secondary uppercase tracking-widest block mb-2">
        {isTanbulampot ? 'Kategori Eksklusif Eco-Friendly' : 'Kategori Pilihan'}
      </span>
      <h1 class="font-serif text-3xl sm:text-4xl font-bold text-slate-800">
        {isTanbulampot ? 'Bunga Ucapan Tanaman & Pohon Ucapan (Tanbulampot) Malang' : `Jual ${category.name} Malang`}
      </h1>
      <p class="text-slate-600 text-sm sm:text-base mt-3 leading-relaxed">
        {category.description}
      </p>

      {isTanbulampot && (
        <!-- Quick Keyword Badges for Crawlers & Visitors -->
        <div class="mt-4 flex flex-wrap gap-2 pt-2">
          <span class="inline-flex items-center rounded-full bg-accent-bg px-3 py-1 text-xs font-semibold text-primary-dark border border-soft-cream">
            Bunga Ucapan Tanaman
          </span>
          <span class="inline-flex items-center rounded-full bg-accent-bg px-3 py-1 text-xs font-semibold text-primary-dark border border-soft-cream">
            Pohon Ucapan
          </span>
          <span class="inline-flex items-center rounded-full bg-accent-bg px-3 py-1 text-xs font-semibold text-primary-dark border border-soft-cream">
            Ucapan Bibit Pohon & Buah
          </span>
          <span class="inline-flex items-center rounded-full bg-accent-bg px-3 py-1 text-xs font-semibold text-primary-dark border border-soft-cream">
            Karangan Bibit Tanaman
          </span>
          <span class="inline-flex items-center rounded-full bg-accent-bg px-3 py-1 text-xs font-semibold text-primary-dark border border-soft-cream">
            Bunga Ucapan Tanaman Hidup
          </span>
        </div>
      )}
    </div>

    <!-- Products Grid (100% Live dari Supabase) -->
    <div id="category-products-grid" class={`grid ${isHandBouquet ? 'grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8' : 'grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8'}`}>
      {products.length > 0 ? (
        products.map((p, index) => (
          <ProductCard product={p} priority={index < 3} />
        ))
      ) : (
        <div class="col-span-full py-16 text-center" id="category-loading">
          <svg class="w-8 h-8 animate-spin text-primary mx-auto mb-3" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
          </svg>
          <p class="text-xs font-semibold text-slate-500">Memuat produk kategori...</p>
        </div>
      )}
    </div>

    <!-- Dedicated SEO Rich Content Section for Tanbulampot -->
    {isTanbulampot && (
      <section class="mt-20 pt-16 border-t border-soft-cream/80">
        <div class="max-w-4xl mx-auto">
          <div class="text-center mb-12">
            <span class="text-secondary font-semibold text-xs tracking-widest uppercase block mb-2">Tren Hadiah Ramah Lingkungan</span>
            <h2 class="font-serif text-2xl sm:text-3xl font-bold text-slate-800">
              Mengenal Bunga Ucapan Tanaman &amp; Pohon Ucapan (Tanbulampot)
            </h2>
            <p class="text-slate-500 text-sm mt-3 leading-relaxed">
              Tanaman buah produktif dan tanaman hias dalam pot sebagai pilihan ucapan selamat yang tahan lama dan dapat terus dirawat.
            </p>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-12">
            <div class="p-6 rounded-2xl bg-white border border-soft-cream/70 shadow-xs">
              <div class="w-10 h-10 rounded-full bg-primary/10 text-primary flex items-center justify-center font-bold mb-4">
                🌱
              </div>
              <h3 class="font-serif font-bold text-slate-800 text-base mb-2">Bunga Ucapan Tanaman Hidup</h3>
              <p class="text-xs text-slate-500 leading-relaxed">
                Tanaman tetap hidup dan bertumbuh, menjadi simbol doa keberkahan yang terus bersemi bagi penerima ucapan selamat.
              </p>
            </div>

            <div class="p-6 rounded-2xl bg-white border border-soft-cream/70 shadow-xs">
              <div class="w-10 h-10 rounded-full bg-secondary/15 text-secondary-dark flex items-center justify-center font-bold mb-4">
                🍊
              </div>
              <h3 class="font-serif font-bold text-slate-800 text-base mb-2">Pohon Ucapan Berbuah</h3>
              <p class="text-xs text-slate-500 leading-relaxed">
                Pilihan pohon buah dalam pot (jeruk nagami, chokun, santang madu) yang produktif dan dapat dipanen sendiri.
              </p>
            </div>

            <div class="p-6 rounded-2xl bg-white border border-soft-cream/70 shadow-xs">
              <div class="w-10 h-10 rounded-full bg-primary/10 text-primary flex items-center justify-center font-bold mb-4">
                🎁
              </div>
              <h3 class="font-serif font-bold text-slate-800 text-base mb-2">Packaging Eksklusif &amp; Rapi</h3>
              <p class="text-xs text-slate-500 leading-relaxed">
                Dilengkapi pot keramik/terakota elegan, hiasan pita satin mewah, dan kartu ucapan kustom sesuai permintaan.
              </p>
            </div>
          </div>

          <!-- FAQ Accordion / Grid -->
          <div class="bg-white rounded-2xl border border-soft-cream/80 p-6 sm:p-8 shadow-xs">
            <h3 class="font-serif font-bold text-xl text-slate-800 mb-6 flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-primary"></span>
              Pertanyaan Seputar Bunga Ucapan Tanaman
            </h3>
            <div class="space-y-4">
              <div class="border-b border-soft-cream/60 pb-4">
                <h4 class="font-bold text-slate-800 text-sm mb-1">Apakah pohon ucapan bisa langsung dikirim hari ini?</h4>
                <p class="text-xs text-slate-500 leading-relaxed">
                  Ya, kami menyediakan stok bibit tanaman produktif siap kirim untuk pemesanan hari yang sama ke seluruh area Malang Raya &amp; Kota Batu.
                </p>
              </div>
              <div class="border-b border-soft-cream/60 pb-4">
                <h4 class="font-bold text-slate-800 text-sm mb-1">Bagaimana format ucapan pada pohon ucapan?</h4>
                <p class="text-xs text-slate-500 leading-relaxed">
                  Format ucapan dicetak pada papan akrilik atau kartu ucapan laminasi elegan yang dipasang kokoh di antara dahan tanaman bersama pita satin.
                </p>
              </div>
              <div>
                <h4 class="font-bold text-slate-800 text-sm mb-1">Apakah ada laporan foto sebelum dikirim?</h4>
                <p class="text-xs text-slate-500 leading-relaxed">
                  Tentu, tim kami selalu mengirimkan foto hasil rangkaian tanaman dan ucapan via WhatsApp sebelum kurir berangkat menuju lokasi pengantaran.
                </p>
              </div>
            </div>
          </div>
        </div>
      </section>
    )}

  </div>
</Layout>

<script define:vars={{ SUPABASE_URL, SUPABASE_ANON_KEY, categorySlug, isHandBouquet }}>
  async function syncCategoryProducts() {
    try {
      if (!window.supabase) return;
      const client = window.supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY);
      const { data: cloudProducts, error } = await client
        .from('products')
        .select('*')
        .eq('category_slug', categorySlug)
        .order('created_at', { ascending: false });

      if (error || !cloudProducts || cloudProducts.length === 0) return;

      const grid = document.getElementById('category-products-grid');
      if (!grid) return;

      grid.innerHTML = '';

      cloudProducts.forEach((p, index) => {
        const productUrl = `/produk/${p.slug}/`;
        const buttonLabel = 'Detail';
        const aspectClass = isHandBouquet ? 'aspect-[4/5]' : 'aspect-[20/19]';

        const card = document.createElement('article');
        card.className = 'product-card-shell group relative h-full overflow-hidden rounded-[14px] border border-soft-cream/70 bg-white shadow-[0_1px_4px_rgba(15,23,42,0.03)] hover-gold-grow';
        card.innerHTML = `
          <a href="${productUrl}" class="flex h-full flex-col no-underline">
            <div class="image-load-shell relative -mx-px -mt-px ${aspectClass} overflow-hidden bg-clean-ivory">
              <img
                src="${p.image}"
                alt="Foto ${p.name} Florist Malang"
                loading="${index < 3 ? 'eager' : 'lazy'}"
                decoding="async"
                class="relative z-0 block h-full w-full object-cover object-top transition-transform duration-700 ease-out group-hover:scale-[1.012]"
              />
              ${p.featured ? '<span class="absolute top-2.5 left-2.5 z-10 rounded-sm bg-secondary px-2 py-0.5 text-[9px] font-bold uppercase tracking-wider text-primary-dark shadow-xs">Populer</span>' : ''}
              <div class="pointer-events-none absolute inset-x-0 bottom-0 z-10 h-20 bg-gradient-to-t from-primary-dark/35 via-primary-dark/5 to-transparent"></div>
              <span class="absolute bottom-3 right-3 z-10 inline-flex h-9 w-9 items-center justify-center rounded-full bg-white/95 text-primary shadow-[0_2px_8px_rgba(15,23,42,0.08)] transition-all duration-200 group-hover:bg-primary group-hover:text-white" aria-hidden="true">
                <svg width="16" height="16" class="h-4 w-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.4">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M7 17L17 7M9 7h8v8" />
                </svg>
              </span>
            </div>

            <div class="flex min-h-[190px] sm:min-h-[200px] flex-col justify-between p-4.5 sm:p-5">
              <div>
                <p class="line-clamp-1 text-[10px] font-bold uppercase tracking-[0.18em] text-secondary-dark">${p.category_name || ''}</p>
                <h3 class="mt-1.5 font-serif font-bold leading-snug text-slate-800 line-clamp-2 transition-colors duration-200 group-hover:text-primary text-base sm:text-lg">
                  ${p.name}
                </h3>
              </div>

              <div class="pt-3 sm:pt-4">
                <div class="rounded-md border border-soft-cream/70 bg-accent-bg/70 p-2.5 sm:p-3">
                  <p class="text-[10px] font-bold uppercase tracking-[0.18em] text-secondary-dark">Harga</p>
                  <div class="mt-1.5 flex items-end justify-between gap-2.5 sm:gap-3">
                    <p class="font-sans text-lg sm:text-xl font-extrabold leading-none text-primary">${p.price_label}</p>
                    <span class="inline-flex shrink-0 items-center gap-1.5 rounded-full bg-primary px-3 py-1.5 sm:px-3.5 sm:py-2 text-[11px] font-bold text-white shadow-xs transition-colors duration-200 group-hover:bg-primary-dark">
                      ${buttonLabel}
                      <svg width="14" height="14" class="h-3.5 w-3.5 shrink-0 transition-transform duration-200 group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.6" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                      </svg>
                    </span>
                  </div>
                </div>
              </div>
            </div>
          </a>
        `;
        grid.appendChild(card);
      });
    } catch (err) {
      console.warn('Gagal memuat kategori live:', err);
    }
  }

  syncCategoryProducts();
</script>
