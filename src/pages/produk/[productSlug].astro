---
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import WhatsAppButton from '../../components/WhatsAppButton.astro';
import ProductCard from '../../components/ProductCard.astro';
import { stripBase, withBase } from '../../utils/paths';
import { getProductDisplayName, getProductGalleryImages, getProductSize, stripProductMetadata } from '../../utils/productHelpers';
import { SUPABASE_URL, SUPABASE_ANON_KEY } from '../../data/supabaseConfig';

export async function getStaticPaths() {
  try {
    const res = await fetch(`${SUPABASE_URL}/rest/v1/products?select=*`, {
      headers: {
        apikey: SUPABASE_ANON_KEY,
        Authorization: `Bearer ${SUPABASE_ANON_KEY}`
      }
    });
    if (res.ok) {
      const liveProducts = await res.json();
      if (Array.isArray(liveProducts) && liveProducts.length > 0) {
        return liveProducts.map(p => ({
          params: { productSlug: p.slug },
          props: {
            product: {
              id: p.id,
              slug: p.slug,
              name: p.name,
              categorySlug: p.category_slug,
              categoryName: p.category_name,
              city: p.city || 'Malang',
              priceFrom: Number(p.price_from) || 0,
              priceLabel: p.price_label,
              image: p.image,
              images: p.images || [],
              hoverPreviewIndex: p.hover_preview_index || undefined,
              imageWidth: 800,
              imageHeight: 800,
              description: p.description || '',
              featured: Boolean(p.featured),
              whatsappText: `Halo Zaloma Florist, saya ingin pesan ${p.name} (${p.price_label}). Mohon info ketersediaan dan format pemesanannya.`,
              processingTime: p.processing_time || '3 - 5 Jam',
              serviceArea: ['Kota Malang', 'Kabupaten Malang', 'Kota Batu']
            },
            relatedProducts: liveProducts
              .filter(p2 => p2.category_slug === p.category_slug && p2.id !== p.id)
              .slice(0, 8)
              .map(p2 => ({
                id: p2.id,
                slug: p2.slug,
                name: p2.name,
                categorySlug: p2.category_slug,
                categoryName: p2.category_name,
                city: p2.city || 'Malang',
                priceFrom: Number(p2.price_from) || 0,
                priceLabel: p2.price_label,
                image: p2.image,
                images: p2.images || [],
                hoverPreviewIndex: p2.hover_preview_index || undefined,
                imageWidth: 800,
                imageHeight: 800,
                description: p2.description || '',
                featured: Boolean(p2.featured),
                whatsappText: `Halo Zaloma Florist, saya ingin pesan ${p2.name} (${p2.price_label}).`,
                processingTime: p2.processing_time || '3 - 5 Jam',
                serviceArea: ['Kota Malang', 'Kabupaten Malang', 'Kota Batu']
              }))
          }
        }));
      }
    }
  } catch (err) {
    console.warn('[Zaloma Build] Warning fetching products for getStaticPaths:', err);
  }

  // Fallback placeholder agar build tidak error jika sedang offline
  return [{
    params: { productSlug: 'detail' },
    props: {
      product: {
        id: 'default',
        slug: 'detail',
        name: 'Produk Zaloma Florist',
        categorySlug: 'bunga-papan-malang',
        categoryName: 'Bunga Papan',
        city: 'Malang',
        priceFrom: 0,
        priceLabel: 'Hubungi Kami',
        image: '/images/hero/hero-1.webp',
        imageWidth: 800,
        imageHeight: 800,
        description: 'Pilihan karangan bunga segar dari Zaloma Florist Malang.',
        featured: false,
        whatsappText: 'Halo Zaloma Florist, saya ingin pesan bunga.',
        processingTime: '3 - 5 Jam',
        serviceArea: ['Malang']
      },
      relatedProducts: []
    }
  }];
}

const { product, relatedProducts = [] } = Astro.props;
const displayName = getProductDisplayName(product);
const galleryImages = getProductGalleryImages(product.image, product.images);
const displayDescription = stripProductMetadata(product.description);
const productSize = getProductSize(product.description);
const shippingArea = product.city || 'Malang Raya (Kota Malang, Kab. Malang, Kota Batu)';
const currentSlug = product.slug;
const currentCategorySlug = product.categorySlug;

// SEO Meta
const title = `${displayName} | Toko Bunga Online 24 Jam - Zaloma Florist`;
const description = `Pesan ${displayName} melalui Zaloma Florist, toko bunga online 24 jam. ${displayDescription.substring(0, 110)}... Pengerjaan ${product.processingTime}; konfirmasi pengiriman sesuai area tujuan.`;

// JSON-LD Product Schema
const productSchema = {
  "@context": "https://schema.org/",
  "@type": "Product",
  "name": displayName,
  "image": galleryImages.map((image) => new URL(withBase(image), Astro.site).toString()),
  "description": `${displayDescription} Tersedia di Zaloma Florist, toko bunga profesional dengan pengerjaan cepat.`,
  "brand": {
    "@type": "Brand",
    "name": "Zaloma Florist"
  },
  "offers": {
    "@type": "Offer",
    "url": new URL(withBase(`/produk/${product.slug}/`), Astro.site).toString(),
    "priceCurrency": "IDR",
    "price": product.priceFrom,
    "availability": "https://schema.org/InStock",
    "itemCondition": "https://schema.org/NewCondition",
    "seller": {
      "@type": "Organization",
      "name": "Zaloma Florist"
    }
  }
};
---

<Layout title={title} description={description} schema={productSchema}>
  <!-- Supabase SDK for live sync -->
  <script is:inline src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    
    <!-- Breadcrumb -->
    <Breadcrumb 
      items={[
        { label: 'Katalog', href: '/katalog/' },
        { label: product.categoryName, href: `/kategori/${product.categorySlug}/` },
        { label: displayName }
      ]} 
    />

    <!-- Product Detail Container -->
    <div class="mt-6 bg-white rounded-2xl sm:rounded-3xl border border-soft-cream/80 overflow-hidden shadow-xs">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 p-5 sm:p-8 lg:p-12">
        
        <!-- Left: Product Image & Highlights -->
        <div class="lg:col-span-6 flex flex-col gap-6">
          <div id="product-gallery-frame" tabindex="0" aria-label="Galeri foto produk. Gunakan panah kiri atau kanan untuk mengganti foto." class="relative aspect-square sm:aspect-[4/3] lg:aspect-square rounded-2xl overflow-hidden bg-clean-ivory border border-soft-cream/60 touch-pan-y">
            <img
              id="product-gallery-image"
              src={withBase(product.image)}
              alt={`Foto ${displayName} dari Zaloma Florist Malang`}
              width={product.imageWidth}
              height={product.imageHeight}
              loading="eager"
              decoding="async"
              fetchpriority="high"
              class="w-full h-full object-cover object-top"
            />
            <button type="button" data-gallery-step="-1" aria-label="Lihat foto sebelumnya" class:list={['absolute left-3 top-1/2 z-20 -translate-y-1/2 rounded-full bg-white/90 p-2 text-primary shadow transition hover:bg-white', galleryImages.length <= 1 && 'hidden']}>
              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m15 18-6-6 6-6" /></svg>
            </button>
            <button type="button" data-gallery-step="1" aria-label="Lihat foto berikutnya" class:list={['absolute right-3 top-1/2 z-20 -translate-y-1/2 rounded-full bg-white/90 p-2 text-primary shadow transition hover:bg-white', galleryImages.length <= 1 && 'hidden']}>
              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m9 18 6-6-6-6" /></svg>
            </button>
            <span id="product-gallery-count" class:list={['absolute bottom-3 right-3 z-20 rounded-full bg-black/60 px-2.5 py-1 text-xs font-semibold text-white', galleryImages.length <= 1 && 'hidden']}>1 / {galleryImages.length}</span>
            {product.featured && (
              <div class="absolute top-4 left-4">
                <span class="bg-secondary text-primary-dark text-xs uppercase tracking-wider font-bold px-3 py-1.5 rounded-full shadow-sm">
                  Populer &amp; Terlaris
                </span>
              </div>
            )}
          </div>
          <div id="product-gallery-thumbnails" class:list={['flex gap-2 overflow-x-auto pb-1', galleryImages.length <= 1 && 'hidden']} role="group" aria-label="Foto produk">
              {galleryImages.map((image, index) => (
                <button
                  type="button"
                  data-gallery-index={index}
                  data-gallery-src={withBase(image)}
                  aria-label={`Tampilkan foto ${index + 1}`}
                  aria-pressed={index === 0 ? 'true' : 'false'}
                  class:list={['h-16 w-16 shrink-0 overflow-hidden rounded-lg border-2 transition sm:h-20 sm:w-20', index === 0 ? 'border-primary' : 'border-transparent opacity-70 hover:opacity-100']}
                >
                  <img src={withBase(image)} alt="" loading="lazy" class="h-full w-full object-cover" />
                </button>
              ))}
          </div>

          <!-- Trust Badges Desktop / Tablet -->
          <div class="grid grid-cols-3 gap-3 p-4 rounded-xl bg-accent-bg/60 border border-soft-cream/60 text-center">
            <div>
              <span class="block text-primary font-bold text-xs sm:text-sm">3 - 5 Jam</span>
              <span class="text-[11px] text-slate-500">Pengerjaan</span>
            </div>
            <div class="border-x border-soft-cream/80">
              <span class="block text-primary font-bold text-xs sm:text-sm">Difoto</span>
              <span class="text-[11px] text-slate-500">Sebelum Kirim</span>
            </div>
            <div>
              <span class="block text-primary font-bold text-xs sm:text-sm">Gratis Ongkir</span>
              <span class="text-[11px] text-slate-500">Malang Kota</span>
            </div>
          </div>
        </div>

        <!-- Right: Product Information & Order Actions -->
        <div class="lg:col-span-6 flex flex-col justify-between space-y-6">
          <div class="space-y-4">
            
            <!-- Category & Location Badge -->
            <div class="flex items-center gap-2 flex-wrap">
              <a 
                href={withBase(`/kategori/${product.categorySlug}/`)}
                class="inline-block text-xs font-semibold text-secondary hover:text-secondary-dark uppercase tracking-wider bg-accent-bg px-2.5 py-1 rounded-md border border-soft-cream transition-colors"
              >
                {product.categoryName}
              </a>
              <span class="text-xs text-slate-400">&bull;</span>
              <span class="text-xs font-medium text-slate-500">Toko Bunga Malang</span>
            </div>

            <!-- Product Title -->
            <h1 class="font-serif text-2xl sm:text-3xl lg:text-4xl font-bold text-slate-900 leading-tight">
              {displayName}
            </h1>

            <!-- Price Card -->
            <div class="p-4 sm:p-5 rounded-2xl bg-gradient-to-br from-clean-ivory to-accent-bg border border-soft-cream">
              <span class="text-xs font-semibold uppercase tracking-wider text-slate-500 block mb-1">
                Estimasi Harga
              </span>
              <div class="flex items-baseline gap-3">
                <span id="product-detail-price" class="font-sans text-3xl sm:text-4xl font-extrabold text-primary">
                  {product.priceLabel}
                </span>
                <span class="text-xs text-slate-500 font-medium">
                  (Bisa kustom sesuai budget)
                </span>
              </div>
            </div>

            <!-- Description -->
            <div class="pt-2">
              <h2 class="text-sm font-bold text-slate-800 uppercase tracking-wider mb-2">Deskripsi Produk</h2>
              <p id="product-detail-description" class="text-slate-600 text-sm sm:text-base leading-relaxed">
                {displayDescription}
              </p>
              <dl class="mt-4 grid grid-cols-1 gap-2 sm:grid-cols-2">
                <div class="rounded-lg border border-soft-cream/70 bg-clean-ivory/70 px-3.5 py-3">
                  <dt class="text-[10px] font-bold uppercase tracking-wider text-slate-500">Ukuran Produk</dt>
                  <dd id="product-detail-size" class="mt-1 text-sm font-semibold text-slate-800">
                    {productSize || 'Hubungi kami untuk pilihan ukuran'}
                  </dd>
                </div>
                <div class="rounded-lg border border-soft-cream/70 bg-clean-ivory/70 px-3.5 py-3">
                  <dt class="text-[10px] font-bold uppercase tracking-wider text-slate-500">Area Pengiriman</dt>
                  <dd id="product-detail-area" class="mt-1 text-sm font-semibold text-slate-800">{shippingArea}</dd>
                </div>
              </dl>
            </div>

            <!-- Order Instructions -->
            <div class="p-4 rounded-xl bg-slate-50 border border-slate-200/60 space-y-2 text-xs sm:text-sm text-slate-600">
              <p class="font-semibold text-slate-800 flex items-center gap-2">
                <svg class="w-4 h-4 text-emerald-600 shrink-0" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                </svg>
                Cara Pemesanan Cepat via WhatsApp:
              </p>
              <ol class="list-decimal list-inside space-y-1 pl-1 text-slate-500">
                <li>Klik tombol WhatsApp di bawah ini untuk konsultasi format ucapan.</li>
                <li>Kirim teks ucapan, nama pengirim, dan alamat tujuan pengiriman.</li>
                <li>Rangkaian bunga dikerjakan &amp; difotokan sebelum kurir berangkat.</li>
              </ol>
            </div>

          </div>

          <!-- Call to Action Buttons -->
          <div class="pt-4 border-t border-soft-cream/80 space-y-3">
            <WhatsAppButton 
              text="Pesan Sekarang via WhatsApp"
              whatsappText={product.whatsappText}
              className="w-full rounded-full text-center py-4 text-base font-bold shadow-md hover:shadow-lg transition-all"
            />
            <p class="text-center text-xs text-slate-400">
              Respons cepat 24 jam &bull; Konsultasi gratis &bull; Pembayaran via transfer bank
            </p>
          </div>

        </div>

      </div>
    </div>

    <!-- Related Products -->
    <section class="mt-16 sm:mt-20 pt-10 border-t border-soft-cream/60" id="related-products-section" aria-labelledby="related-products-heading">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-3 mb-6 sm:mb-8">
        <div>
          <span class="text-secondary font-semibold text-xs tracking-widest uppercase block mb-1">Pilihan Lainnya</span>
          <h2 id="related-products-heading" class="font-serif text-2xl sm:text-3xl font-bold text-slate-800">Produk Serupa Lainnya</h2>
        </div>
        <a 
          href={withBase(`/kategori/${product.categorySlug}/`)} 
          class="inline-flex items-center gap-1.5 text-xs sm:text-sm font-semibold text-primary hover:text-secondary transition-colors group"
        >
          Lihat Semua {product.categoryName}
          <svg class="w-4 h-4 transition-transform duration-200 group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
          </svg>
        </a>
      </div>

      <div id="related-products-grid" class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4 sm:gap-6">
        {relatedProducts.length > 0 ? (
          relatedProducts.map(prod => (
            <ProductCard product={prod} variant="compact" />
          ))
        ) : (
          <div class="col-span-full py-10 text-center text-slate-400 text-xs">
            <svg class="w-6 h-6 animate-spin mx-auto text-primary mb-2 opacity-80" fill="none" viewBox="0 0 24 24">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
            </svg>
            Memuat produk serupa...
          </div>
        )}
      </div>
    </section>

  </div>
</Layout>

  <script is:inline>
      const galleryFrame = document.getElementById('product-gallery-frame');
      const galleryImage = document.getElementById('product-gallery-image');
      const galleryCount = document.getElementById('product-gallery-count');
      const galleryThumbnailContainer = document.getElementById('product-gallery-thumbnails');
      let galleryThumbnails = Array.from(document.querySelectorAll('[data-gallery-index]'));
      const galleryNavigation = Array.from(document.querySelectorAll('[data-gallery-step]'));
      let activeGalleryIndex = 0;
      let galleryTransitionTimer;

      function updateProductGallery(images) {
        const validImages = Array.isArray(images) ? [...new Set(images.filter((image) => typeof image === 'string' && image.trim()))].slice(0, 3) : [];
        if (!validImages.length || !galleryImage || !galleryThumbnailContainer) return;

        galleryImage.src = validImages[0];
        activeGalleryIndex = 0;
        galleryThumbnailContainer.replaceChildren(...validImages.map((image, index) => {
          const button = document.createElement('button');
          button.type = 'button';
          button.dataset.galleryIndex = String(index);
          button.dataset.gallerySrc = image;
          button.setAttribute('aria-label', `Tampilkan foto ${index + 1}`);
          button.setAttribute('aria-pressed', String(index === 0));
          button.className = `h-16 w-16 shrink-0 overflow-hidden rounded-lg border-2 transition sm:h-20 sm:w-20 ${index === 0 ? 'border-primary' : 'border-transparent opacity-70 hover:opacity-100'}`;
          const thumbnail = document.createElement('img');
          thumbnail.src = image;
          thumbnail.alt = '';
          thumbnail.loading = 'lazy';
          thumbnail.className = 'h-full w-full object-cover';
          button.append(thumbnail);
          return button;
        }));
        galleryThumbnails = Array.from(galleryThumbnailContainer.querySelectorAll('[data-gallery-index]'));
        galleryThumbnailContainer.classList.toggle('hidden', validImages.length <= 1);
        galleryNavigation.forEach((button) => button.classList.toggle('hidden', validImages.length <= 1));
        galleryCount?.classList.toggle('hidden', validImages.length <= 1);
        if (galleryCount) galleryCount.textContent = `1 / ${validImages.length}`;
      }

      function showGalleryImage(index) {
        if (!galleryThumbnails.length || !galleryImage) return;
        activeGalleryIndex = (index + galleryThumbnails.length) % galleryThumbnails.length;
        const activeThumbnail = galleryThumbnails[activeGalleryIndex];
        window.clearTimeout(galleryTransitionTimer);
        galleryImage.style.opacity = '0.35';
        galleryTransitionTimer = window.setTimeout(() => {
          galleryImage.src = activeThumbnail.dataset.gallerySrc;
          galleryImage.style.opacity = '1';
        }, 100);
        galleryThumbnails.forEach((thumbnail, thumbnailIndex) => {
          const isActive = thumbnailIndex === activeGalleryIndex;
          thumbnail.setAttribute('aria-pressed', String(isActive));
          thumbnail.classList.toggle('border-primary', isActive);
          thumbnail.classList.toggle('border-transparent', !isActive);
          thumbnail.classList.toggle('opacity-70', !isActive);
        });
        if (galleryCount) galleryCount.textContent = `${activeGalleryIndex + 1} / ${galleryThumbnails.length}`;
      }

      galleryThumbnailContainer?.addEventListener('click', (event) => {
        const thumbnail = event.target.closest('[data-gallery-index]');
        if (thumbnail) showGalleryImage(Number(thumbnail.dataset.galleryIndex));
      });
      galleryNavigation.forEach((button) => {
        button.addEventListener('click', () => showGalleryImage(activeGalleryIndex + Number(button.dataset.galleryStep)));
      });

      window.addEventListener('zaloma:product-gallery-updated', (event) => {
        updateProductGallery(event.detail?.images);
      });

      let swipeStartX = 0;
      galleryFrame?.addEventListener('touchstart', (event) => {
        swipeStartX = event.changedTouches[0].clientX;
      }, { passive: true });
      galleryFrame?.addEventListener('touchend', (event) => {
        const swipeDistance = event.changedTouches[0].clientX - swipeStartX;
        if (Math.abs(swipeDistance) >= 45) showGalleryImage(activeGalleryIndex + (swipeDistance < 0 ? 1 : -1));
      }, { passive: true });

      galleryFrame?.addEventListener('keydown', (event) => {
        if (event.key === 'ArrowRight') showGalleryImage(activeGalleryIndex + 1);
        if (event.key === 'ArrowLeft') showGalleryImage(activeGalleryIndex - 1);
      });
  </script>

  <script define:vars={{ SUPABASE_URL, SUPABASE_ANON_KEY, currentSlug, currentCategorySlug }}>
  async function syncProductDetail() {
    try {
      if (!window.supabase) return;
      const client = window.supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY);
      const { data: cloudProducts, error } = await client.from('products').select('*');
      if (error || !cloudProducts || cloudProducts.length === 0) return;

      const cloudMap = new Map(cloudProducts.map(p => [p.slug, p]));

      // 1. Cek jika produk utama sudah dihapus di Supabase
      if (!cloudMap.has(currentSlug)) {
        const alertBanner = document.createElement('div');
        alertBanner.className = 'mb-6 p-4 rounded-xl bg-amber-50 border border-amber-300 text-amber-900 text-sm flex items-center justify-between gap-4';
        alertBanner.innerHTML = `
          <div class="flex items-center gap-2">
            <svg class="w-5 h-5 text-amber-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" /></svg>
            <span>Produk ini sedang tidak tersedia atau telah diarsipkan.</span>
          </div>
          <a href="/katalog/" class="px-4 py-1.5 rounded-lg bg-amber-600 text-white font-bold text-xs hover:bg-amber-700 transition-colors shrink-0">Lihat Katalog</a>
        `;
        const container = document.querySelector('.bg-white.rounded-2xl, .bg-white.rounded-xl');
        if (container) container.parentElement?.insertBefore(alertBanner, container);
      } else {
        // Update harga dan nama jika berubah di Supabase
        const p = cloudMap.get(currentSlug);
        window.dispatchEvent(new CustomEvent('zaloma:product-gallery-updated', {
          detail: { images: [p.image, ...(Array.isArray(p.images) ? p.images : [])].filter(Boolean).slice(0, 3) }
        }));
        const priceEl = document.getElementById('product-detail-price');
        if (priceEl && p.price_label) priceEl.textContent = p.price_label;

        const h1El = document.querySelector('h1');
        if (h1El && p.name && h1El.textContent.trim() !== p.name) h1El.textContent = p.name;

        const descriptionValue = String(p.description || '');
        const descriptionEl = document.getElementById('product-detail-description');
        const sizeEl = document.getElementById('product-detail-size');
        const areaEl = document.getElementById('product-detail-area');
        const cleanDescription = descriptionValue
          .replace(/^(?:\[(?:Ukuran|Bentuk Kartu):[^\]]+\]\s*\r?\n?)+/i, '')
          .trim();
        const size = descriptionValue.match(/^\[Ukuran:\s*([^\]]+)\]/im)?.[1]?.trim();
        if (descriptionEl) descriptionEl.textContent = cleanDescription;
        if (sizeEl) sizeEl.textContent = size || 'Hubungi kami untuk pilihan ukuran';
        if (areaEl) areaEl.textContent = p.city || 'Malang Raya (Kota Malang, Kab. Malang, Kota Batu)';
      }

      // 2. Sinkronisasi Related Products
      const relatedGrid = document.getElementById('related-products-grid');
      if (relatedGrid) {
        const matchingRel = cloudProducts.filter(p => p.category_slug === currentCategorySlug && p.slug !== currentSlug);
        if (matchingRel.length > 0) {
          relatedGrid.innerHTML = matchingRel.slice(0, 8).map(relP => `
            <article class="product-card-shell compact-product-card group relative h-full flex flex-col overflow-hidden rounded-[14px] border border-soft-cream/70 bg-white shadow-[0_1px_4px_rgba(15,23,42,0.03)] hover-gold-grow">
              <a href="/produk/${relP.slug}/" class="flex h-full flex-col no-underline">
                <div class="image-load-shell relative aspect-[4/4.5] overflow-hidden bg-clean-ivory border-b border-soft-cream/40">
                  <img
                    src="${relP.image}"
                    alt="Foto ${relP.name} Florist Malang"
                    loading="lazy"
                    decoding="async"
                    class="relative z-0 h-full w-full object-cover object-top transition-transform duration-700 ease-out group-hover:scale-[1.012]"
                  />
                  <div class="pointer-events-none absolute inset-x-0 bottom-0 z-10 h-16 bg-gradient-to-t from-primary-dark/30 via-transparent to-transparent"></div>
                </div>
                <div class="flex flex-1 flex-col justify-between p-3 sm:p-3.5">
                  <h3 class="font-serif font-bold text-slate-800 line-clamp-2 transition-colors duration-200 group-hover:text-primary text-xs sm:text-sm">
                    ${relP.name}
                  </h3>
                  <div class="mt-2 pt-2 border-t border-soft-cream/60 flex items-center justify-between">
                    <span class="font-sans font-extrabold text-primary text-xs sm:text-sm">${relP.price_label}</span>
                    <span class="inline-flex h-6 w-6 items-center justify-center rounded-full bg-primary text-white text-[10px]">
                      <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                      </svg>
                    </span>
                  </div>
                </div>
              </a>
            </article>
          `).join('');
        }
      }

    } catch (err) {
      console.warn('Gagal sinkronisasi detail produk:', err);
    }
  }

  syncProductDetail();
</script>
