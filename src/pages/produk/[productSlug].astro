---
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import WhatsAppButton from '../../components/WhatsAppButton.astro';
import ProductCard from '../../components/ProductCard.astro';
import { PRODUCTS } from '../../data/products';
import { stripBase, withBase } from '../../utils/paths';
import { getProductDisplayName } from '../../utils/productHelpers';
import { SUPABASE_URL, SUPABASE_ANON_KEY } from '../../data/supabaseConfig';

export async function getStaticPaths() {
  try {
    const res = await fetch(`${SUPABASE_URL}/rest/v1/products?select=*`, {
      headers: {
        apikey: SUPABASE_ANON_KEY,
        Authorization: `Bearer ${SUPABASE_ANON_KEY}`
      }
    });
    if (res.ok) {
      const liveProducts = await res.json();
      if (Array.isArray(liveProducts) && liveProducts.length > 0) {
        return liveProducts.map(p => ({
          params: { productSlug: p.slug },
          props: {
            product: {
              id: p.id,
              slug: p.slug,
              name: p.name,
              categorySlug: p.category_slug,
              categoryName: p.category_name,
              city: p.city || 'Malang',
              priceFrom: Number(p.price_from) || 0,
              priceLabel: p.price_label,
              image: p.image,
              imageWidth: 800,
              imageHeight: 800,
              description: p.description || '',
              featured: Boolean(p.featured),
              whatsappText: `Halo Zaloma Florist, saya ingin pesan ${p.name} (${p.price_label}). Mohon info ketersediaan dan format pemesanannya.`,
              processingTime: p.processing_time || '3 - 5 Jam',
              serviceArea: ['Kota Malang', 'Kabupaten Malang', 'Kota Batu']
            }
          }
        }));
      }
    }
  } catch (err) {
    console.warn('[Zaloma Build] Warning fetching products for getStaticPaths:', err);
  }

  // Fallback placeholder agar build tidak error jika sedang offline
  return [{
    params: { productSlug: 'detail' },
    props: {
      product: {
        id: 'default',
        slug: 'detail',
        name: 'Produk Zaloma Florist',
        categorySlug: 'bunga-papan-malang',
        categoryName: 'Bunga Papan',
        city: 'Malang',
        priceFrom: 0,
        priceLabel: 'Hubungi Kami',
        image: '/images/hero/hero-1.webp',
        imageWidth: 800,
        imageHeight: 800,
        description: 'Pilihan karangan bunga segar dari Zaloma Florist Malang.',
        featured: false,
        whatsappText: 'Halo Zaloma Florist, saya ingin pesan bunga.',
        processingTime: '3 - 5 Jam',
        serviceArea: ['Malang']
      }
    }
  }];
}

const { product } = Astro.props;
const displayName = getProductDisplayName(product);
const currentSlug = product.slug;

// Filter produk terkait hanya dari kategori yang sama (kecuali produk yang sedang aktif).
// Jika produk di kategori mencukupi, batas maksimal (12 produk) tetap berlaku.
// Jika tidak mencukupi, hanya tampilkan produk dari kategori yang sama tanpa mencampur produk dari kategori lain yang tidak relevan.
const sameCategoryProducts = PRODUCTS.filter(
  p => p.categorySlug === product.categorySlug && p.id !== product.id
);
const relatedProducts = sameCategoryProducts.slice(0, 12);


// SEO Meta
const title = `${displayName} Malang - Murah & Berkualitas`;
const description = `Beli ${displayName} di Zaloma Florist, toko bunga Malang murah dan berkualitas. ${product.description.substring(0, 110)}... Pengerjaan cepat ${product.processingTime}, gratis ongkir area Kota Malang.`;

// JSON-LD Product Schema
const productSchema = {
  "@context": "https://schema.org/",
  "@type": "Product",
  "name": displayName,
  "image": new URL(withBase(product.image), Astro.site).toString(),
  "description": `${product.description} Tersedia di Zaloma Florist, toko bunga Malang murah dan berkualitas dengan pengerjaan cepat.`,
  "sku": product.id,
  "mpn": product.id,
  "brand": {
    "@type": "Brand",
    "name": "Zaloma Florist"
  },
  "offers": {
    "@type": "Offer",
    "url": new URL(withBase(stripBase(Astro.url.pathname)), Astro.site).toString(),
    "priceCurrency": "IDR",
    "price": product.priceFrom,
    "priceValidUntil": "2030-12-31",
    "itemCondition": "https://schema.org/NewCondition",
    "availability": "https://schema.org/InStock",
    "seller": {
      "@type": "Florist",
      "name": "Zaloma Florist"
    }
  }
};
---

<Layout title={title} description={description} image={product.image} type="product" schema={productSchema}>
  <!-- Supabase JS SDK for live product sync -->
  <script is:inline src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    
    <!-- Breadcrumb -->
    <Breadcrumb 
      items={[
        { label: 'Katalog', href: '/katalog/' },
        { label: product.categoryName, href: `/kategori/${product.categorySlug}/` },
        { label: displayName }
      ]} 
    />

    <!-- Product Detail Card Grid -->
    <div class="bg-white rounded-xl border border-soft-cream/60 shadow-xs overflow-hidden mt-6 p-4 sm:p-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12">
        
        <!-- Left Column: Product Image -->
        <div class="lg:col-span-6 flex flex-col justify-start">
          <div class="image-load-shell relative bg-clean-ivory rounded-lg overflow-hidden border border-soft-cream/60" data-image-frame>
            <span class="image-skeleton" aria-hidden="true"></span>
            <img 
              src={withBase(product.image)} 
              alt={`Karangan ${displayName} Florist Malang`}
              width={product.imageWidth}
              height={product.imageHeight}
              loading="eager"
              decoding="async"
              fetchpriority="high"
              sizes="(min-width: 1024px) 50vw, 100vw"
              data-image-loader="true"
              class="relative z-0 block h-auto w-full" 
            />
            <div class="absolute top-4 left-4 bg-primary text-white text-[10px] uppercase font-bold tracking-widest px-3 py-1 rounded-xs">
              {product.city}
            </div>
          </div>
        </div>

        <!-- Right Column: Product Metadata & Actions -->
        <div class="lg:col-span-6 flex flex-col justify-between">
          <div class="space-y-6">
            <!-- Category and ID -->
            <div class="flex items-center justify-between border-b border-soft-cream/30 pb-4">
              <a href={withBase(`/kategori/${product.categorySlug}/`)} class="text-xs font-bold text-secondary uppercase tracking-wider hover:underline">
                {product.categoryName}
              </a>
              <span class="text-xs text-slate-400 font-mono">ID: {product.id}</span>
            </div>
            
            <!-- Title -->
            <h1 class="font-serif text-2xl sm:text-3xl font-bold text-slate-800 leading-snug">
              {displayName}
            </h1>

            <!-- Price -->
            <div class="bg-primary/5 p-4 rounded-md border border-primary/10">
              <span class="text-xs text-slate-500 font-medium block">Harga:</span>
              <span id="product-detail-price" class="text-2xl sm:text-3xl font-bold text-primary font-sans mt-1 block">{product.priceLabel}</span>
              <p class="text-[10px] text-slate-400 mt-1">Harga tertera untuk spesifikasi standar. Tambahan ukuran atau permintaan bunga khusus dapat dikonfirmasikan ke admin.</p>
            </div>

            <!-- Delivery & Processing Specs -->
            <div class="grid grid-cols-2 gap-4 border-t border-b border-soft-cream/30 py-4 text-xs">
              <div>
                <span class="text-slate-400 block mb-1">Estimasi Pengerjaan:</span>
                <span class="font-bold text-slate-700 flex items-center">
                  <svg class="h-4 w-4 mr-1 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                  {product.processingTime}
                </span>
              </div>
              <div>
                <span class="text-slate-400 block mb-1">Layanan:</span>
                <span class="font-bold text-slate-700 flex items-center">
                  <svg class="h-4 w-4 mr-1 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                  </svg>
                  Pemesanan {product.city}
                </span>
              </div>
            </div>

            <!-- Description -->
            <div class="space-y-2">
              <h3 class="font-bold text-sm text-slate-800">Deskripsi Bunga:</h3>
              <p class="text-slate-600 text-sm leading-relaxed whitespace-pre-line">
                {product.description}
              </p>
            </div>

            <!-- Service Area List -->
            <div class="space-y-2">
              <h3 class="font-bold text-sm text-slate-800">Jangkauan Pengiriman:</h3>
              <div class="flex flex-wrap gap-2">
                {product.serviceArea.map(area => (
                  <span class="bg-soft-cream/40 text-primary-dark text-xs px-2.5 py-1 rounded-sm">
                    {area}
                  </span>
                ))}
              </div>
            </div>
          </div>

          <!-- CTA Button Section -->
          <div class="mt-8 pt-6 border-t border-soft-cream/30">
            <WhatsAppButton 
              whatsappText={product.whatsappText} 
              text="Pesan via WhatsApp Sekarang" 
              className="w-full py-4 text-base shadow-md"
            />
            <p class="text-center text-[11px] text-slate-500 mt-2">Terhubung langsung ke admin WhatsApp Zaloma Florist untuk konfirmasi teks ucapan dan jadwal kirim.</p>

            <div class="mt-4 pt-3 border-t border-slate-100 flex flex-wrap items-center justify-around gap-2 text-center text-[11px] text-slate-600">
              <span class="inline-flex items-center gap-1 font-medium">
                <svg class="w-3.5 h-3.5 text-primary flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                Difoto sebelum diantar
              </span>
              <span class="inline-flex items-center gap-1 font-medium">
                <svg class="w-3.5 h-3.5 text-primary flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                Jaminan tepat waktu
              </span>
              <span class="inline-flex items-center gap-1 font-medium">
                <svg class="w-3.5 h-3.5 text-primary flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                Bunga segar pilihan
              </span>
            </div>
          </div>

        </div>
      </div>
    </div>

    <!-- Related Products -->
    {relatedProducts.length > 0 && (
      <section class="mt-16 sm:mt-20 pt-10 border-t border-soft-cream/60" aria-labelledby="related-products-heading">
        <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-3 mb-6 sm:mb-8">
          <div>
            <span class="text-secondary font-semibold text-xs tracking-widest uppercase block mb-1">Pilihan Lainnya</span>
            <h2 id="related-products-heading" class="font-serif text-2xl sm:text-3xl font-bold text-slate-800">Produk Serupa Lainnya</h2>
          </div>
          <a 
            href={withBase(`/kategori/${product.categorySlug}/`)} 
            class="inline-flex items-center gap-1.5 text-xs sm:text-sm font-semibold text-primary hover:text-secondary transition-colors group"
          >
            Lihat Semua {product.categoryName}
            <svg class="w-4 h-4 transition-transform duration-200 group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
            </svg>
          </a>
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4 sm:gap-6">
          {relatedProducts.map(prod => (
            <ProductCard product={prod} variant="compact" />
          ))}
        </div>
      </section>
    )}

  </div>
</Layout>

<script define:vars={{ SUPABASE_URL, SUPABASE_ANON_KEY, currentSlug }}>
  async function syncProductDetail() {
    try {
      if (!window.supabase) return;
      const client = window.supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY);
      const { data: cloudProducts, error } = await client.from('products').select('*');
      if (error || !cloudProducts || cloudProducts.length === 0) return;

      const cloudMap = new Map(cloudProducts.map(p => [p.slug, p]));

      // 1. Cek jika produk utama sudah dihapus di Supabase
      if (!cloudMap.has(currentSlug)) {
        const alertBanner = document.createElement('div');
        alertBanner.className = 'mb-6 p-4 rounded-xl bg-amber-50 border border-amber-300 text-amber-900 text-sm flex items-center justify-between gap-4';
        alertBanner.innerHTML = `
          <div class="flex items-center gap-2">
            <svg class="w-5 h-5 text-amber-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" /></svg>
            <span>Produk ini sedang tidak tersedia atau telah diarsipkan.</span>
          </div>
          <a href="/katalog/" class="px-4 py-1.5 rounded-lg bg-amber-600 text-white font-bold text-xs hover:bg-amber-700 transition-colors shrink-0">Lihat Katalog</a>
        `;
        const container = document.querySelector('.bg-white.rounded-xl.border');
        if (container) container.parentElement?.insertBefore(alertBanner, container);
      } else {
        // Update harga jika berubah di Supabase
        const p = cloudMap.get(currentSlug);
        const priceEl = document.getElementById('product-detail-price');
        if (priceEl && p.price_label) priceEl.textContent = p.price_label;

        const h1El = document.querySelector('h1');
        if (h1El && p.name && h1El.textContent.trim() !== p.name) h1El.textContent = p.name;
      }

      // 2. Bersihkan produk serupa (related products) jika ada yang sudah dihapus di Supabase
      document.querySelectorAll('a[href*="/produk/"]').forEach(link => {
        const match = link.getAttribute('href').match(/\/produk\/([^\/]+)/);
        if (!match || !match[1]) return;
        const relSlug = match[1];
        if (relSlug === currentSlug) return;

        const card = link.closest('.product-card-shell, article');
        if (!card) return;

        if (!cloudMap.has(relSlug)) {
          card.remove();
        } else {
          const relP = cloudMap.get(relSlug);
          const relPrice = card.querySelector('.font-sans.font-extrabold, .text-primary.font-extrabold');
          if (relPrice && relP.price_label) relPrice.textContent = relP.price_label;
        }
      });

    } catch (err) {
      console.warn('Gagal sinkronisasi detail produk:', err);
    }
  }

  syncProductDetail();
</script>

