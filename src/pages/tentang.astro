---
import Layout from '../layouts/Layout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { WHATSAPP_NUMBER } from '../data/constants';
import { withBase } from '../utils/paths';

const title = "Tentang Zaloma Florist - Toko Bunga Malang Terpercaya 11 Tahun";
const description = "Zaloma Florist adalah toko bunga Malang terpercaya dengan pengalaman 11 tahun. Kami menyediakan bunga papan, hand bouquet, standing flower, bunga meja, dan rangkaian bunga segar berkualitas untuk seluruh wilayah Malang Raya dan Jawa Timur.";

const whatsappUrl = `https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent('Halo Zaloma Florist, saya ingin berkonsultasi dan memesan karangan bunga dari Zaloma Florist di Malang.')}`;

const process = [
  {
    num: '01',
    title: 'Pilih & Konsultasi',
    body: 'Pilih model bunga di katalog atau kirimkan foto referensi yang Anda miliki via WhatsApp, lengkap dengan teks ucapan dan alamat tujuan.'
  },
  {
    num: '02',
    title: 'Konfirmasi Pesanan',
    body: 'Admin mengonfirmasi ketersediaan stok bunga segar hari ini, memastikan nuansa warna sesuai permintaan, dan memberi tahu estimasi waktu selesai.'
  },
  {
    num: '03',
    title: 'Proses Perangkaian',
    body: 'Pesanan dirangkai langsung oleh florist senior Zaloma Florist dengan susunan rapi dan teks ucapan yang jelas terbaca — rata-rata selesai dalam 1–3 jam.'
  },
  {
    num: '04',
    title: 'Foto Hasil & Pengiriman',
    body: 'Sebelum berangkat, foto hasil jadi dikirimkan ke WhatsApp Anda untuk dicek. Setelah disetujui, pesanan langsung diantar ke lokasi tujuan.'
  }
];

const teamValues = [
  {
    num: '01',
    title: 'Ketepatan Waktu',
    body: 'Kami memahami betapa pentingnya momen ucapan — terutama duka cita. Rata-rata pengerjaan bunga papan kami selesai dalam 1–3 jam, cocok untuk pesanan mendadak.'
  },
  {
    num: '02',
    title: 'Bunga Segar Berkualitas',
    body: 'Bunga potong baru dirangkai pada hari pengiriman agar tetap segar selama acara berlangsung. Foto hasil jadi dikirimkan sebelum pesanan diberangkatkan.'
  },
  {
    num: '03',
    title: 'Kerapian Rangkaian',
    body: 'Setiap karangan bunga dirangkai dengan tata letak yang tertata, huruf ucapan yang jelas terbaca, dan kombinasi warna bunga yang harmonis sesuai request.'
  }
];
---

<Layout title={title} description={description}>
<div class="ta-page">

  <!-- BREADCRUMB -->
  <div class="ta-breadcrumb">
    <Breadcrumb items={[{ label: 'Tentang Kami' }]} />
  </div>

  <!-- HERO: asymmetric split -->
  <section class="ta-hero">
    <div class="ta-hero-text">
      <p class="ta-label">Toko Bunga Malang Terpercaya</p>
      <h1 class="ta-hero-title">
        Florist Terbaik di Malang — Pengalaman 11 Tahun Merangkai Momen Bermakna
      </h1>
      <div class="ta-hero-body">
        <p>
          Tim kami terdiri dari florist senior yang sudah berpengalaman lebih dari 11 tahun dalam dunia karangan bunga. Berawal dari Surabaya — di mana kami berhasil membangun toko bunga selama 6 tahun — kami kemudian melihat peluang di Malang dan membuka cabang di area Batu Malang untuk hadir lebih dekat bagi pelanggan Malang Raya.
        </p>
        <p>
          Zaloma Florist melayani pemesanan bunga papan wedding, bunga papan ucapan duka cita, bunga papan ucapan selamat (congratulation), bunga meja, hand bouquet, standing flower, paper flower, dan tanaman pohon ucapan. Kami mengutamakan kecepatan, kerapian, ketepatan waktu, dan kepuasan pelanggan di atas segalanya.
        </p>
      </div>
      <div class="ta-hero-stats">
        <div class="ta-stat">
          <span class="ta-stat-n">11 Tahun</span>
          <span class="ta-stat-l">Pengalaman Florist</span>
        </div>
        <div class="ta-stat-sep" aria-hidden="true"></div>
        <div class="ta-stat">
          <span class="ta-stat-n">1–3 Jam</span>
          <span class="ta-stat-l">Rata-rata pengerjaan</span>
        </div>
        <div class="ta-stat-sep" aria-hidden="true"></div>
        <div class="ta-stat">
          <span class="ta-stat-n">Jawa Timur</span>
          <span class="ta-stat-l">Area pengiriman</span>
        </div>
      </div>
    </div>

    <div class="ta-hero-visual">
      <div class="ta-hero-img-wrap image-load-shell" data-image-frame>
        <span class="image-skeleton" aria-hidden="true"></span>
        <img
          src={withBase('/images/produk/tanbulampot/875.webp')}
          alt="Karangan bunga segar berkualitas dari Zaloma Florist Malang — florist terpercaya 11 tahun"
          width="640"
          height="800"
          loading="eager"
          decoding="async"
          fetchpriority="high"
          sizes="(min-width: 1024px) 42vw, 100vw"
          data-image-loader="true"
          class="relative z-0 w-full h-full object-cover object-center"
        />
      </div>
      <!-- Offset accent block -->
      <div class="ta-hero-accent" aria-hidden="true">
        <span class="ta-hero-accent-num">Zaloma Florist</span>
        <span class="ta-hero-accent-sub">Malang &middot; 11 Tahun Pengalaman</span>
      </div>
    </div>
  </section>

  <!-- STORY SECTION -->
  <section class="ta-story">
    <div class="ta-story-inner">
      <div class="ta-story-text">
        <p class="ta-label">Cerita Kami</p>
        <h2 class="ta-story-title">Dari Surabaya ke Malang — Membawa Standar Florist Terbaik</h2>
        <div class="ta-story-body">
          <p>
            Perjalanan Zaloma Florist dimulai dari Surabaya, di mana selama 6 tahun kami sukses melayani ribuan pesanan karangan bunga dari berbagai kalangan — mulai dari perusahaan besar, instansi pemerintah, hingga keluarga yang ingin menyampaikan ucapan tulus kepada orang tersayang.
          </p>
          <p>
            Melihat potensi besar di Malang dan belum banyaknya toko bunga yang hadir dengan standar ketepatan waktu yang baik, tim kami memutuskan membuka cabang di Batu Malang. Sejak itu, kami terus berkembang dan kini menjadi salah satu pilihan utama florist di Malang Raya.
          </p>
          <p>
            Kami bangga dengan reputasi yang kami bangun selama lebih dari satu dekade: cepat, rapi, tepat waktu, dan selalu mengutamakan kepuasan setiap pelanggan.
          </p>
        </div>
      </div>
      <div class="ta-story-highlights">
        <div class="ta-highlight">
          <div class="ta-highlight-icon" aria-hidden="true">
            <svg width="22" height="22" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          </div>
          <div>
            <h3 class="ta-highlight-title">Pengerjaan 1–3 Jam</h3>
            <p class="ta-highlight-body">Rata-rata bunga papan kami selesai dalam 1–3 jam — cocok untuk kebutuhan mendadak, terutama ucapan duka cita yang membutuhkan ketepatan waktu.</p>
          </div>
        </div>
        <div class="ta-highlight">
          <div class="ta-highlight-icon" aria-hidden="true">
            <svg width="22" height="22" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
          </div>
          <div>
            <h3 class="ta-highlight-title">Jangkauan Luas Jawa Timur</h3>
            <p class="ta-highlight-body">Melayani pengiriman ke Malang Raya, Surabaya, Gresik, Mojokerto, Jombang, Kediri, Blitar, Tulungagung, dan sekitarnya. Hubungi kami untuk info pengiriman ke luar area.</p>
          </div>
        </div>
        <div class="ta-highlight">
          <div class="ta-highlight-icon" aria-hidden="true">
            <svg width="22" height="22" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"/><path stroke-linecap="round" stroke-linejoin="round" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
          </div>
          <div>
            <h3 class="ta-highlight-title">Difoto Sebelum Diantar</h3>
            <p class="ta-highlight-body">Setiap pesanan difoto setelah selesai dirangkai dan dikirimkan ke WhatsApp Anda sebelum keberangkatan. Pastikan ejaan ucapan dan kerapian sudah sesuai harapan.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- BUNGA PAPAN SECTION -->
  <section class="ta-papan">
    <div class="ta-papan-inner">
      <div class="ta-papan-head">
        <p class="ta-label">Produk Unggulan</p>
        <h2 class="ta-papan-title">Bunga Papan Malang — Ucapan Bermakna untuk Setiap Momen</h2>
      </div>
      <div class="ta-papan-body">
        <p>
          Bunga papan telah menjadi pilihan favorit bagi perusahaan maupun personal yang ingin menyampaikan ucapan selamat maupun duka cita kepada rekan atau mitra mereka. Ucapan selamat yang diungkapkan melalui bunga papan meliputi acara pembukaan gedung atau perusahaan, pernikahan, anniversary, kenaikan jabatan, wisuda, dan berbagai momen spesial lainnya.
        </p>
        <p>
          Setiap bunga papan kami dirancang dengan sekumpulan bunga segar dan rangkaian kata-kata yang menggambarkan perasaan pemberi kepada penerima — rapi, elegan, dan tepat waktu sampai di lokasi.
        </p>
      </div>
      <div class="ta-papan-sizes">
        <p class="ta-papan-sizes-title">Pilihan Ukuran Bunga Papan</p>
        <div class="ta-size-grid">
          <div class="ta-size-card ta-size-card--popular">
            <div class="ta-size-badge">Paling Diminati</div>
            <div class="ta-size-dim">2 × 1,25 m</div>
            <div class="ta-size-label">Ukuran Standar</div>
            <div class="ta-size-price">Rp 400.000 – Rp 750.000</div>
            <p class="ta-size-desc">Pilihan ekonomis dan paling sering dipesan — cocok untuk segala jenis ucapan.</p>
          </div>
          <div class="ta-size-card">
            <div class="ta-size-dim">2 × 1,5 m</div>
            <div class="ta-size-label">Ukuran Medium</div>
            <div class="ta-size-price">Rp 750.000 – Rp 1.500.000</div>
            <p class="ta-size-desc">Tampilan lebih besar dan berkesan — tepat untuk acara pernikahan dan peresmian kantor.</p>
          </div>
          <div class="ta-size-card">
            <div class="ta-size-dim">2 × 3 m</div>
            <div class="ta-size-label">Ukuran Premium</div>
            <div class="ta-size-price">Rp 1.500.000+</div>
            <p class="ta-size-desc">Kehadiran yang impresif untuk perusahaan atau momen prestisius yang ingin tampil menonjol.</p>
          </div>
          <div class="ta-size-card">
            <div class="ta-size-dim">2 × 3 m+</div>
            <div class="ta-size-label">Custom Jumbo</div>
            <div class="ta-size-price">Hubungi Kami</div>
            <p class="ta-size-desc">Pesanan custom hingga 10 meter untuk perusahaan prestisius atau tokoh terkemuka. Harga sesuai spesifikasi.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- VALUES: 3-column editorial grid -->
  <section class="ta-values">
    <div class="ta-values-head">
      <p class="ta-label">Standar Pengerjaan</p>
      <h2 class="ta-values-title">Komitmen layanan Zaloma Florist untuk setiap pesanan</h2>
    </div>

    <div class="ta-values-grid">
      {teamValues.map((val) => (
        <div class="ta-val">
          <div class="ta-val-num" aria-hidden="true">{val.num}</div>
          <h3 class="ta-val-title">{val.title}</h3>
          <p class="ta-val-body">{val.body}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- RANGKAIAN BUNGA SECTION -->
  <section class="ta-rangkaian">
    <div class="ta-rangkaian-inner">
      <div class="ta-rangkaian-head">
        <p class="ta-label">Koleksi Rangkaian</p>
        <h2 class="ta-rangkaian-title">Rangkaian Bunga Segar & Buket Berkualitas di Malang</h2>
      </div>
      <div class="ta-rangkaian-grid">
        <div class="ta-rangkaian-item">
          <h3 class="ta-rangkaian-item-title">Hand Bouquet (Buket Bunga)</h3>
          <p class="ta-rangkaian-item-body">
            Buket bunga kami umumnya terdiri dari mawar, lily, tulip, gerbera, anyelir, dan bunga pilihan lainnya — ditata rapi dalam balutan wrapping elegan. Sangat cocok untuk wisuda, ulang tahun, anniversary pernikahan, maupun momen spesial lainnya. Sampaikan perasaan tulus Anda dengan buket bunga segar dari Zaloma Florist.
          </p>
        </div>
        <div class="ta-rangkaian-item">
          <h3 class="ta-rangkaian-item-title">Rangkaian Bunga Meja & Standing Flower</h3>
          <p class="ta-rangkaian-item-body">
            Rangkaian bunga terbaik kami tersusun dari bunga segar pilihan, daun hijau yang menambah keindahan, dan tempat rangkaian yang tertata rapi. Tersedia dalam dua pilihan: rangkaian bunga segar untuk tampilan hidup yang menawan, dan rangkaian bunga artificial yang tahan lama dan cocok sebagai dekorasi kantor maupun ruang pameran.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- PROCESS: horizontal numbered steps -->
  <section class="ta-process">
    <div class="ta-process-head">
      <p class="ta-label">Alur Pemesanan</p>
      <h2 class="ta-process-title">Alur pesan praktis hingga bunga tiba di lokasi tujuan</h2>
    </div>

    <div class="ta-steps">
      {process.map((step, i) => (
        <div class="ta-step">
          <div class="ta-step-num" aria-hidden="true">{step.num}</div>
          {i < process.length - 1 && (
            <div class="ta-step-connector" aria-hidden="true"></div>
          )}
          <h3 class="ta-step-title">{step.title}</h3>
          <p class="ta-step-body">{step.body}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- PHOTOS: product evidence -->
  <section class="ta-photos">
    <div class="ta-photo-wrap">
      <div class="ta-photo image-load-shell is-loaded" data-image-frame>
        <span class="image-skeleton" aria-hidden="true"></span>
        <img
          src={withBase('/images/produk/tanbulampot/1165.webp')}
          alt="Tanaman buah dalam pot (tanbulampot) berbuah lebat dari Zaloma Florist Malang"
          width="520" height="680"
          loading="eager" decoding="async"
          data-image-loader="true"
          onload="this.closest('[data-image-frame]')?.classList.add('is-loaded')"
          class="relative z-0 w-full h-full object-cover"
        />
      </div>
      <div class="ta-photo ta-photo--offset image-load-shell is-loaded" data-image-frame>
        <span class="image-skeleton" aria-hidden="true"></span>
        <img
          src={withBase('/images/produk/tanbulampot/845.webp')}
          alt="Bunga papan dan rangkaian bunga segar berkualitas dari Zaloma Florist Malang"
          width="520" height="680"
          loading="eager" decoding="async"
          data-image-loader="true"
          onload="this.closest('[data-image-frame]')?.classList.add('is-loaded')"
          class="relative z-0 w-full h-full object-cover"
        />
      </div>
    </div>
    <div class="ta-photo-caption">
      <p class="ta-label">Dokumentasi Produk</p>
      <p class="ta-photo-body">
        Semua foto produk di website ini adalah dokumentasi nyata dari pesanan yang kami kerjakan dan kirimkan ke wilayah Malang Raya, Surabaya, Gresik, Mojokerto, Jombang, Kediri, Blitar, Tulungagung, dan sekitarnya. Percayakan momen istimewa Anda kepada florist berpengalaman 11 tahun.
      </p>
      <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="ta-cta-link" id="tentang-wa-cta">
        Konsultasi & Pesan Sekarang
        <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
          <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd"/>
        </svg>
      </a>
    </div>
  </section>

</div>
</Layout>

<style>
  /* --------------------------------------------------------------------------
     Page wrapper
     -------------------------------------------------------------------------- */
  .ta-page {
    background: #FDF7F7;
    min-height: 100vh;
  }

  .ta-breadcrumb {
    max-width: 1200px;
    margin: 0 auto;
    padding: 1.5rem 2rem 0;
  }

  /* Shared eyebrow label */
  .ta-label {
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #C59253;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 0.9rem;
  }

  .ta-label::before {
    content: '';
    display: inline-block;
    width: 20px;
    height: 1.5px;
    background: currentColor;
    flex-shrink: 0;
  }

  /* --------------------------------------------------------------------------
     HERO
     -------------------------------------------------------------------------- */
  .ta-hero {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
    max-width: 100%;
    min-height: 90vh;
    border-bottom: 1px solid #F6E3E1;
  }

  .ta-hero-text {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 5rem 3.5rem 5rem 6%;
    max-width: 640px;
    margin-left: auto;
    box-sizing: border-box;
  }

  .ta-hero-title {
    font-family: var(--font-serif, Georgia, serif);
    font-size: clamp(1.65rem, 2.8vw, 2.5rem);
    font-weight: 700;
    line-height: 1.22;
    letter-spacing: -0.025em;
    color: #2E0C15;
    margin: 0 0 1.75rem;
  }

  .ta-hero-body {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 2.5rem;
  }

  .ta-hero-body p {
    font-size: 0.895rem;
    line-height: 1.78;
    color: #671E2F;
    margin: 0;
  }

  /* Stats */
  .ta-hero-stats {
    display: flex;
    align-items: center;
    gap: 1.75rem;
    padding-top: 1.75rem;
    border-top: 1px solid #DFC397;
  }

  .ta-stat {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .ta-stat-n {
    font-family: var(--font-serif, Georgia, serif);
    font-size: 1.3rem;
    font-weight: 700;
    color: #4A1522;
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .ta-stat-l {
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #C59253;
    white-space: nowrap;
  }

  .ta-stat-sep {
    width: 1px;
    height: 34px;
    background: #DFC397;
    flex-shrink: 0;
  }

  /* Right visual column */
  .ta-hero-visual {
    position: relative;
    background: #FAF0F1;
    overflow: hidden;
  }

  .ta-hero-img-wrap {
    position: absolute;
    inset: 0;
  }

  .ta-hero-accent {
    position: absolute;
    bottom: 2rem;
    left: 2rem;
    background: rgba(103, 30, 47, 0.88);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border-radius: 10px;
    padding: 1rem 1.4rem;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .ta-hero-accent-num {
    font-family: var(--font-serif, Georgia, serif);
    font-size: 1.1rem;
    font-weight: 700;
    color: #fff;
    letter-spacing: -0.01em;
    line-height: 1;
  }

  .ta-hero-accent-sub {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #C59253;
  }

  /* --------------------------------------------------------------------------
     STORY SECTION
     -------------------------------------------------------------------------- */
  .ta-story {
    border-bottom: 1px solid #F6E3E1;
    background: #fff;
  }

  .ta-story-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 5rem 2rem;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 5rem;
    align-items: start;
  }

  .ta-story-title {
    font-family: var(--font-serif, Georgia, serif);
    font-size: clamp(1.5rem, 2.5vw, 2.1rem);
    font-weight: 700;
    line-height: 1.22;
    letter-spacing: -0.022em;
    color: #2E0C15;
    margin: 0 0 1.5rem;
  }

  .ta-story-body {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .ta-story-body p {
    font-size: 0.895rem;
    line-height: 1.78;
    color: #64748b;
    margin: 0;
  }

  .ta-story-highlights {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
    padding-top: 0.5rem;
  }

  .ta-highlight {
    display: flex;
    gap: 1.1rem;
    align-items: flex-start;
  }

  .ta-highlight-icon {
    flex-shrink: 0;
    width: 42px;
    height: 42px;
    border-radius: 10px;
    background: #FAF0F1;
    border: 1px solid #F6E3E1;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #893144;
  }

  .ta-highlight-title {
    font-family: var(--font-serif, Georgia, serif);
    font-size: 1rem;
    font-weight: 700;
    color: #2E0C15;
    margin: 0 0 0.4rem;
    line-height: 1.3;
