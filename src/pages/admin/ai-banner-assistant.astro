---
import '../../styles/global.css';

const title = "AI Banner Assistant — Zaloma Florist Admin";

function withBase(path: string): string {
  const base = import.meta.env.BASE_URL || '/';
  return base.endsWith('/') ? `${base.slice(0, -1)}${path}` : `${base}${path}`;
}

// Read guidelines from file
import { readFileSync } from 'fs';
import { fileURLToPath } from 'url';
import { dirname, join } from 'path';

const __filename = fileURLToPath(import.meta.url);
const __dirname = dirname(__filename);
const guidelinesPath = join(process.cwd(), 'PROMPT-GUIDELINES.md');
const guidelines = readFileSync(guidelinesPath, 'utf-8');
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/x-icon" href={withBase('/favicon.ico')} />
  </head>
  <body class="bg-gradient-to-br from-slate-50 via-white to-slate-50 text-slate-800 font-sans antialiased h-screen flex flex-col overflow-hidden">

    <!-- Toast Notification -->
    <div id="toast-container" class="fixed top-4 right-4 z-50 flex flex-col gap-2 pointer-events-none" aria-live="polite"></div>

    <!-- Header -->
    <header class="bg-white border-b border-slate-200 shadow-sm flex-shrink-0">
      <div class="max-w-7xl mx-auto px-4 py-4 sm:px-6">
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-4">
            <div class="flex items-center gap-3">
              <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-gradient-to-br from-[#671e2f] to-[#893144] text-white font-bold text-lg shadow-sm">
                AI
              </span>
              <div>
                <h1 class="text-lg font-bold text-slate-900">AI Banner Assistant</h1>
                <p class="text-xs text-slate-500">Chat dengan AI untuk generate banner prompts</p>
              </div>
            </div>
          </div>
          <a href={withBase('/admin/')} class="text-sm font-semibold text-primary hover:text-primary-dark transition-colors">
            ← Kembali
          </a>
        </div>
      </div>
    </header>

    <!-- Main Chat Container -->
    <main class="flex-1 max-w-5xl mx-auto w-full px-4 sm:px-6 flex flex-col overflow-hidden py-4">
      
      <!-- API Key Setup (show only once) -->
      <div id="api-setup" class="bg-blue-50 border border-blue-200 rounded-xl p-4 mb-4 flex-shrink-0">
        <div class="flex items-start gap-3">
          <svg class="w-5 h-5 text-blue-600 flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z" />
          </svg>
          <div class="flex-1">
            <p class="text-sm font-semibold text-blue-900 mb-2">Setup OpenAI API Key:</p>
            <div class="flex gap-2">
              <input 
                type="password" 
                id="api-key-input" 
                placeholder="sk-proj-..."
                class="flex-1 px-3 py-2 text-sm rounded-lg border border-blue-300 focus:outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-200 font-mono"
              />
              <button 
                id="save-api-key"
                class="px-4 py-2 bg-primary text-white text-sm font-semibold rounded-lg hover:bg-primary-dark transition-all cursor-pointer"
              >
                Simpan
              </button>
            </div>
            <p class="text-xs text-blue-700 mt-1.5">
              Get API key at <a href="https://platform.openai.com/api-keys" target="_blank" rel="noopener" class="underline font-semibold">OpenAI Platform</a>
            </p>
          </div>
        </div>
      </div>

      <!-- Chat Messages Area -->
      <div id="chat-messages" class="flex-1 overflow-y-auto space-y-4 mb-4 pr-2 scrollbar-thin scrollbar-thumb-slate-300 scrollbar-track-slate-100">
        <!-- Welcome message -->
        <div class="flex gap-3 animate-fade-in">
          <div class="flex-shrink-0 w-8 h-8 rounded-full bg-gradient-to-br from-purple-500 to-purple-600 flex items-center justify-center text-white font-bold text-sm">
            AI
          </div>
          <div class="flex-1">
            <div class="bg-white rounded-2xl rounded-tl-sm border border-slate-200 p-4 shadow-sm">
              <p class="text-sm text-slate-700 leading-relaxed mb-3">
                👋 Halo! Saya AI Assistant untuk Zaloma Florist. Saya akan membantu Anda membuat prompt banner yang sempurna sesuai brand guidelines.
              </p>
              <p class="text-sm text-slate-700 leading-relaxed mb-3">
                Saya akan bertanya beberapa hal tentang banner yang Anda inginkan, lalu saya akan buatkan prompt JSON yang siap dipakai di DALL-E 3.
              </p>
              <p class="text-sm font-semibold text-slate-900">
                Untuk mulai, ceritakan banner apa yang Anda ingin buat?
              </p>
              <p class="text-xs text-slate-500 mt-2">
                Contoh: "Saya ingin banner gratis ongkir ke Malang" atau "Banner promo Valentine diskon 50%"
              </p>
            </div>
            <p class="text-xs text-slate-400 mt-1">Baru saja</p>
          </div>
        </div>
      </div>

      <!-- Input Area -->
      <div class="flex-shrink-0 bg-white border border-slate-200 rounded-xl p-3 shadow-sm">
        <div class="flex gap-2">
          <textarea 
            id="user-input" 
            placeholder="Ketik pesan Anda..."
            rows="1"
            class="flex-1 px-4 py-3 text-sm rounded-lg border border-slate-300 focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 resize-none"
            style="max-height: 120px;"
          ></textarea>
          <button 
            id="send-btn"
            class="px-6 py-3 bg-primary text-white font-semibold rounded-lg hover:bg-primary-dark transition-all cursor-pointer flex items-center gap-2 disabled:opacity-50 disabled:cursor-not-allowed"
          >
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" />
            </svg>
            <span class="hidden sm:inline">Kirim</span>
          </button>
        </div>
        <div class="flex items-center justify-between mt-2 px-1">
          <div class="flex items-center gap-3 text-xs text-slate-500">
            <span id="status-indicator" class="flex items-center gap-1.5">
              <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
              Siap
            </span>
          </div>
          <button 
            id="reset-chat"
            class="text-xs font-semibold text-slate-500 hover:text-slate-700 cursor-pointer"
          >
            🔄 Reset Chat
          </button>
        </div>
      </div>

    </main>

    <script is:inline define:vars={{ guidelines }}>
      // State management
      let apiKey = '';
      let conversationHistory = [];
      let bannerDetails = {};
      
      // Elements
      const apiSetup = document.getElementById('api-setup');
      const apiKeyInput = document.getElementById('api-key-input');
      const saveApiKeyBtn = document.getElementById('save-api-key');
      const chatMessages = document.getElementById('chat-messages');
      const userInput = document.getElementById('user-input');
      const sendBtn = document.getElementById('send-btn');
      const resetBtn = document.getElementById('reset-chat');
      const statusIndicator = document.getElementById('status-indicator');

      // Toast function
      function showToast(message, type = 'info') {
        const container = document.getElementById('toast-container');
        const toast = document.createElement('div');
        const bgColor = type === 'success' ? 'bg-emerald-500' : type === 'error' ? 'bg-rose-500' : 'bg-blue-500';
        
        toast.className = `${bgColor} text-white px-5 py-3 rounded-xl shadow-lg text-sm font-semibold pointer-events-auto animate-slide-in max-w-md`;
        toast.textContent = message;
        container.appendChild(toast);
        
        setTimeout(() => {
          toast.style.opacity = '0';
          setTimeout(() => toast.remove(), 300);
        }, 4000);
      }

      // Save API Key
      saveApiKeyBtn.addEventListener('click', () => {
        const key = apiKeyInput.value.trim();
        if (!key) {
          showToast('Masukkan API key terlebih dahulu', 'error');
          return;
        }
        if (!key.startsWith('sk-')) {
          showToast('API key tidak valid (harus dimulai dengan sk-)', 'error');
          return;
        }
        
        apiKey = key;
        apiSetup.style.display = 'none';
        showToast('API key berhasil disimpan', 'success');
      });

      // Auto-resize textarea
      userInput.addEventListener('input', function() {
        this.style.height = 'auto';
        this.style.height = Math.min(this.scrollHeight, 120) + 'px';
      });

      // Send message on Enter (Shift+Enter for new line)
      userInput.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' && !e.shiftKey) {
          e.preventDefault();
          sendMessage();
        }
      });

      sendBtn.addEventListener('click', sendMessage);
      resetBtn.addEventListener('click', resetChat);

      // Add message to chat
      function addMessage(content, isUser = false, isJson = false) {
        const messageDiv = document.createElement('div');
        messageDiv.className = 'flex gap-3 animate-fade-in';
        
        if (isUser) {
          messageDiv.classList.add('justify-end');
          messageDiv.innerHTML = `
            <div class="max-w-[80%]">
              <div class="bg-primary text-white rounded-2xl rounded-tr-sm p-4 shadow-sm">
                <p class="text-sm leading-relaxed whitespace-pre-wrap">${escapeHtml(content)}</p>
              </div>
              <p class="text-xs text-slate-400 mt-1 text-right">Baru saja</p>
            </div>
            <div class="flex-shrink-0 w-8 h-8 rounded-full bg-slate-300 flex items-center justify-center text-slate-600 font-bold text-sm">
              👤
            </div>
          `;
        } else {
          if (isJson) {
            // JSON output with copy button
            messageDiv.innerHTML = `
              <div class="flex-shrink-0 w-8 h-8 rounded-full bg-gradient-to-br from-purple-500 to-purple-600 flex items-center justify-center text-white font-bold text-sm">
                AI
              </div>
              <div class="flex-1 max-w-[85%]">
                <div class="bg-gradient-to-br from-emerald-50 to-emerald-100 rounded-2xl rounded-tl-sm border border-emerald-200 p-4 shadow-sm">
                  <p class="text-sm font-semibold text-emerald-900 mb-3 flex items-center gap-2">
                    ✅ Prompt JSON Siap!
                  </p>
                  <div class="relative">
                    <pre class="bg-slate-900 text-slate-100 p-4 rounded-lg text-xs overflow-x-auto font-mono max-h-96 overflow-y-auto">${escapeHtml(content)}</pre>
                    <button 
                      onclick="copyToClipboard(this)" 
                      data-content="${escapeHtml(content).replace(/"/g, '&quot;')}"
                      class="absolute top-2 right-2 px-3 py-1.5 bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-semibold rounded-md transition-all cursor-pointer"
                    >
                      📋 Copy
                    </button>
                  </div>
                  <p class="text-xs text-emerald-700 mt-3">
                    Paste JSON ini ke DALL-E 3 prompt. Semua guidelines Zaloma sudah included.
                  </p>
                </div>
                <p class="text-xs text-slate-400 mt-1">Baru saja</p>
              </div>
            `;
          } else {
            // Regular AI message
            messageDiv.innerHTML = `
              <div class="flex-shrink-0 w-8 h-8 rounded-full bg-gradient-to-br from-purple-500 to-purple-600 flex items-center justify-center text-white font-bold text-sm">
                AI
              </div>
              <div class="flex-1 max-w-[85%]">
                <div class="bg-white rounded-2xl rounded-tl-sm border border-slate-200 p-4 shadow-sm">
                  <p class="text-sm text-slate-700 leading-relaxed whitespace-pre-wrap">${formatMessage(content)}</p>
                </div>
                <p class="text-xs text-slate-400 mt-1">Baru saja</p>
              </div>
            `;
          }
        }
        
        chatMessages.appendChild(messageDiv);
        chatMessages.scrollTop = chatMessages.scrollHeight;
      }

      // Format message with markdown-like formatting
      function formatMessage(text) {
        return escapeHtml(text)
          .replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')
          .replace(/\n/g, '<br>');
      }

      // Escape HTML
      function escapeHtml(text) {
        const div = document.createElement('div');
        div.textContent = text;
        return div.innerHTML;
      }

      // Copy to clipboard
      window.copyToClipboard = async function(button) {
        const content = button.dataset.content.replace(/&quot;/g, '"');
        try {
          await navigator.clipboard.writeText(content);
          button.textContent = '✓ Copied!';
          button.classList.add('bg-emerald-700');
          showToast('Prompt JSON berhasil di-copy!', 'success');
          setTimeout(() => {
            button.textContent = '📋 Copy';
            button.classList.remove('bg-emerald-700');
          }, 2000);
        } catch (err) {
          showToast('Gagal copy, silakan copy manual', 'error');
        }
      };

      // Send message to OpenAI
      async function sendMessage() {
        if (!apiKey) {
          showToast('Simpan API key terlebih dahulu', 'error');
          apiSetup.style.display = 'block';
          return;
        }

        const message = userInput.value.trim();
        if (!message) return;

        // Add user message
        addMessage(message, true);
        userInput.value = '';
        userInput.style.height = 'auto';

        // Update status
        statusIndicator.innerHTML = `
          <svg class="w-3 h-3 animate-spin" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
          </svg>
          AI sedang berpikir...
        `;
        sendBtn.disabled = true;

        // Build conversation context
        conversationHistory.push({
          role: 'user',
          content: message
        });

        try {
          const response = await fetch('https://api.openai.com/v1/chat/completions', {
            method: 'POST',
            headers: {
              'Authorization': `Bearer ${apiKey}`,
              'Content-Type': 'application/json'
            },
            body: JSON.stringify({
              model: 'gpt-4o-mini',
              messages: [
                {
                  role: 'system',
                  content: `Anda adalah AI Assistant untuk Zaloma Florist yang membantu admin membuat prompt banner sesuai brand guidelines.

TUGAS ANDA:
1. Tanyakan detail banner yang diinginkan secara natural (headline, deskripsi promo, objek utama, ukuran)
2. Jangan tanya semua sekaligus - tanya satu-satu seperti percakapan natural
3. Ketika admin berkata "berikan promptnya" atau "buatkan promptnya", generate JSON prompt lengkap
4. JSON harus mengikuti STRICT guidelines Zaloma

BRAND GUIDELINES ZALOMA:
${guidelines}

ATURAN PERCAKAPAN:
- Ramah dan helpful
- Tanyakan detail secara bertahap
- Pastikan semua info terkumpul sebelum generate prompt
- Info yang perlu: headline, subheadline (optional), deskripsi, objek utama, ukuran banner
- Jika admin minta prompt tapi info belum lengkap, tanyakan yang kurang
- Saat generate prompt, pastikan warna Burgundy #842D43, Cream #FFF8F0, Gold #C99A45
- Pastikan style premium florist, elegant editorial
- Output JSON dalam format yang bisa langsung di-copy

CONTOH OUTPUT JSON:
\`\`\`json
{
  "task": "Create a promotional banner for Zaloma Florist.",
  "brand_identity": {
    "brand_name": "ZALOMA FLORIST",
    "location_line": "FLORIST MALANG"
  },
  "brand_color_system": {
    "primary": "#842D43",
    "background": "#FFF8F0",
    "accent": "#C99A45"
  },
  "campaign_content": {
    "headline": "[DARI USER]",
    "description": "[DARI USER]"
  },
  "visual_subject": {
    "main_subject": "[DARI USER]"
  },
  "canvas": {
    "width": 1792,
    "height": 1024
  }
}
\`\`\`

Jangan jelaskan cara pakai - langsung generate JSON saja saat diminta.`
                },
                ...conversationHistory
              ],
              temperature: 0.7,
              max_tokens: 2000
            })
          });

          if (!response.ok) {
            const error = await response.json().catch(() => ({}));
            throw new Error(error?.error?.message || `API error (${response.status})`);
          }

          const data = await response.json();
          const aiMessage = data.choices[0].message.content;

          // Check if response contains JSON (prompt output)
          const jsonMatch = aiMessage.match(/```json\n([\s\S]*?)\n```/);
          
          if (jsonMatch) {
            // Extract JSON and show as copyable
            const jsonContent = jsonMatch[1].trim();
            addMessage(jsonContent, false, true);
            
            // Also add explanation if any
            const explanation = aiMessage.replace(/```json[\s\S]*?```/, '').trim();
            if (explanation) {
              setTimeout(() => addMessage(explanation, false, false), 500);
            }
          } else {
            // Regular conversation
            addMessage(aiMessage, false, false);
          }

          conversationHistory.push({
            role: 'assistant',
            content: aiMessage
          });

        } catch (error) {
          console.error('Chat error:', error);
          showToast(error.message || 'Gagal berkomunikasi dengan AI', 'error');
          addMessage('Maaf, terjadi kesalahan. Silakan coba lagi.', false, false);
        } finally {
          statusIndicator.innerHTML = `
            <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
            Siap
          `;
          sendBtn.disabled = false;
          userInput.focus();
        }
      }

      // Reset chat
      function resetChat() {
        if (!confirm('Reset chat? Semua percakapan akan hilang.')) return;
        
        conversationHistory = [];
        bannerDetails = {};
        
        // Clear chat except welcome message
        const messages = chatMessages.querySelectorAll('.animate-fade-in');
        messages.forEach((msg, idx) => {
          if (idx > 0) msg.remove();
        });
        
        showToast('Chat telah direset', 'success');
      }

      // Animations
      const style = document.createElement('style');
      style.textContent = `
        @keyframes slide-in {
          from { transform: translateX(100%); opacity: 0; }
          to { transform: translateX(0); opacity: 1; }
        }
        .animate-slide-in {
          animation: slide-in 0.3s ease-out;
        }
        .animate-fade-in {
          animation: fadeIn 0.3s ease-in;
        }
        @keyframes fadeIn {
          from { opacity: 0; transform: translateY(10px); }
          to { opacity: 1; transform: translateY(0); }
        }
        .scrollbar-thin::-webkit-scrollbar {
          width: 6px;
        }
        .scrollbar-thumb-slate-300::-webkit-scrollbar-thumb {
          background-color: #cbd5e1;
          border-radius: 3px;
        }
        .scrollbar-track-slate-100::-webkit-scrollbar-track {
          background-color: #f1f5f9;
        }
      `;
      document.head.appendChild(style);

      // Focus input on load
      userInput.focus();
    </script>

  </body>
</html>
