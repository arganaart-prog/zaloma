---
const title = "AI Banner Assistant — Zaloma Florist Admin";

function withBase(path: string): string {
  const base = import.meta.env.BASE_URL || '/';
  return base.endsWith('/') ? `${base.slice(0, -1)}${path}` : `${base}${path}`;
}

// Brand guidelines embedded (dari PROMPT-GUIDELINES.md)
const guidelines = `
# Zaloma Florist Brand Guidelines

## Color Palette (STRICT):
- Primary: Burgundy #842D43
- Deep: #641E32
- Background: Warm ivory cream #FFF8F0 (must dominate)
- Secondary BG: Soft blush #F7E5E3
- Accent: Champagne gold #C99A45 (restrained, never dominant)
- Body text: Warm charcoal #625653
- Neutral: White #FFFFFF

## Visual Style:
- Premium florist, elegant editorial, warm romantic, refined floral
- Photorealistic premium florist photography
- Realistic flower details, natural materials, soft warm lighting

## Typography:
- Headline: Elegant editorial serif (large, readable)
- Supporting text: Clean readable sans-serif
- Brand identity: ZALOMA FLORIST (exact spelling)

## Layout:
- Balanced editorial composition
- Clear text area and visual subject area
- Safe area on all sides
- No cropping of important elements

## Design Language:
- Background: Warm ivory cream with subtle blush transitions
- Decorative elements: Elegant burgundy curved shapes, thin gold accents
- Lighting: Soft, warm, premium studio or natural ambient

## Negative Prompt (Auto-applied):
- No unrelated brands/logos
- No green botanical dominant palette
- No bright blue, neon purple, neon green, oversaturated orange
- No cyberpunk, futuristic, cartoon, childish, plastic 3D style
- No cluttered layout or excessive decorative elements
- No tiny, crowded, distorted, or misspelled typography
`;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/x-icon" href={withBase('/favicon.ico')} />
    
    <!-- Load non-critical CSS asynchronously -->
    <link rel="preload" href="../../styles/global.css" as="style" onload="this.onload=null;this.rel='stylesheet'" />
    <noscript><link rel="stylesheet" href="../../styles/global.css" /></noscript>
    
    <!-- DNS Prefetch & Preconnect untuk resource pihak ketiga -->
    <link rel="dns-prefetch" href="https://api.openai.com" />
    <link rel="preconnect" href="https://api.openai.com" crossorigin />
    
    <!-- Inline critical CSS untuk menghindari render blocking -->
    <style>
      /* Critical CSS - inline untuk FCP & LCP optimization */
      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }
      
      html {
        height: 100%;
      }
      
      body {
        background: linear-gradient(135deg, #f8fafc 0%, #ffffff 50%, #f8fafc 100%);
        color: #1e293b;
        font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
        height: 100vh;
        display: flex;
        flex-direction: column;
        overflow: hidden;
        margin: 0;
      }
      
      /* Ensure content is visible immediately for LCP */
      header {
        background: #ffffff;
        border-bottom: 1px solid #e2e8f0;
        box-shadow: 0 1px 3px 0 rgba(0,0,0,0.05);
        flex-shrink: 0;
      }
      
      .header-container {
        max-width: 80rem;
        margin: 0 auto;
        padding: 1rem;
      }
      
      .header-content {
        display: flex;
        align-items: center;
        justify-content: space-between;
      }
      
      .header-left {
        display: flex;
        align-items: center;
        gap: 1rem;
      }
      
      .ai-icon {
        display: flex;
        height: 2.5rem;
        width: 2.5rem;
        align-items: center;
        justify-content: center;
        border-radius: 0.75rem;
        background: linear-gradient(135deg, #671e2f 0%, #893144 100%);
        color: white;
        font-weight: 700;
        font-size: 1.125rem;
        box-shadow: 0 1px 2px rgba(0,0,0,0.05);
      }
      
      h1 {
        font-size: 1.125rem;
        font-weight: 700;
        color: #0f172a;
        margin-bottom: 0.125rem;
      }
      
      .subtitle {
        font-size: 0.75rem;
        color: #64748b;
      }
      
      .back-link {
        font-size: 0.875rem;
        font-weight: 600;
        color: #842D43;
        text-decoration: none;
        transition: color 0.15s;
      }
      
      .back-link:hover {
        color: #671e2f;
      }
      
      main {
        flex: 1;
        max-width: 80rem;
        margin: 0 auto;
        width: 100%;
        padding: 1rem;
        display: flex;
        flex-direction: column;
        overflow: hidden;
      }
      
      /* Prevent layout shift */
      #api-setup {
        background: #eff6ff;
        border: 1px solid #bfdbfe;
        border-radius: 0.75rem;
        padding: 1rem;
        margin-bottom: 1rem;
        flex-shrink: 0;
      }
      
      #chat-messages {
        flex: 1;
        overflow-y: auto;
        margin-bottom: 1rem;
        padding-right: 0.5rem;
      }
      
      /* Ensure input area is visible for LCP */
      #input-container {
        flex-shrink: 0;
        background: white;
        border: 1px solid #e2e8f0;
        border-radius: 0.75rem;
        padding: 0.75rem;
        box-shadow: 0 1px 2px rgba(0,0,0,0.05);
      }
      
      /* Prevent FOUC */
      .hidden {
        display: none;
      }
      
      /* Loading state */
      button:disabled {
        opacity: 0.5;
        cursor: not-allowed;
      }
    </style>
  </head>
  <body>

    <!-- Toast Notification -->
    <div id="toast-container" class="fixed top-4 right-4 z-50 flex flex-col gap-2 pointer-events-none" aria-live="polite"></div>

    <!-- Header -->
    <header>
      <div class="header-container">
        <div class="header-content">
          <div class="header-left">
            <div style="display: flex; align-items: center; gap: 0.75rem;">
              <span class="ai-icon">AI</span>
              <div>
                <h1>AI Banner Assistant</h1>
                <p class="subtitle">Chat dengan AI untuk generate banner prompts</p>
              </div>
            </div>
          </div>
          <a href={withBase('/admin/')} class="back-link">← Kembali</a>
        </div>
      </div>
    </header>

    <!-- Main Chat Container -->
    <main class="flex-1 max-w-5xl mx-auto w-full px-4 sm:px-6 flex flex-col overflow-hidden py-4">
      
      <!-- API Key Setup (show only once) -->
      <div id="api-setup" class="bg-blue-50 border border-blue-200 rounded-xl p-4 mb-4 flex-shrink-0">
        <div class="flex items-start gap-3">
          <svg class="w-5 h-5 text-blue-600 flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z" />
          </svg>
          <div class="flex-1">
            <p class="text-sm font-semibold text-blue-900 mb-2">Setup OpenAI API Key:</p>
            <div class="flex gap-2">
              <input 
                type="password" 
                id="api-key-input" 
                placeholder="sk-proj-..."
                class="flex-1 px-3 py-2 text-sm rounded-lg border border-blue-300 focus:outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-200 font-mono"
              />
              <button 
                id="save-api-key"
                class="px-4 py-2 bg-primary text-white text-sm font-semibold rounded-lg hover:bg-primary-dark transition-all cursor-pointer"
              >
                Simpan
              </button>
            </div>
            <p class="text-xs text-blue-700 mt-1.5">
              Get API key at <a href="https://platform.openai.com/api-keys" target="_blank" rel="noopener" class="underline font-semibold">OpenAI Platform</a>
            </p>
          </div>
        </div>
      </div>

      <!-- Chat Messages Area -->
      <div id="chat-messages" class="flex-1 overflow-y-auto space-y-4 mb-4 pr-2 scrollbar-thin scrollbar-thumb-slate-300 scrollbar-track-slate-100">
        <!-- Welcome message -->
        <div class="flex gap-3 animate-fade-in">
          <div class="flex-shrink-0 w-8 h-8 rounded-full bg-gradient-to-br from-purple-500 to-purple-600 flex items-center justify-center text-white font-bold text-sm">
            AI
          </div>
          <div class="flex-1">
            <div class="bg-white rounded-2xl rounded-tl-sm border border-slate-200 p-4 shadow-sm">
              <p class="text-sm text-slate-700 leading-relaxed mb-3">
                👋 Halo! Saya AI Assistant untuk Zaloma Florist. Saya akan membantu Anda membuat prompt banner yang sempurna sesuai brand guidelines.
              </p>
              <p class="text-sm text-slate-700 leading-relaxed mb-3">
                Saya akan bertanya beberapa hal tentang banner yang Anda inginkan, lalu saya akan buatkan prompt JSON yang siap dipakai di DALL-E 3.
              </p>
              <p class="text-sm font-semibold text-slate-900">
                Untuk mulai, ceritakan banner apa yang Anda ingin buat?
              </p>
              <p class="text-xs text-slate-500 mt-2">
                Contoh: "Saya ingin banner gratis ongkir ke Malang" atau "Banner promo Valentine diskon 50%"
              </p>
            </div>
            <p class="text-xs text-slate-400 mt-1">Baru saja</p>
          </div>
        </div>
      </div>

      <!-- Input Area -->
      <div id="input-container" class="flex-shrink-0 bg-white border border-slate-200 rounded-xl p-3 shadow-sm">
        <div class="flex gap-2">
          <textarea 
            id="user-input" 
            placeholder="Ketik pesan Anda..."
            rows="1"
            class="flex-1 px-4 py-3 text-sm rounded-lg border border-slate-300 focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 resize-none"
            style="max-height: 120px;"
          ></textarea>
          <button 
            id="send-btn"
            class="px-6 py-3 bg-primary text-white font-semibold rounded-lg hover:bg-primary-dark transition-all cursor-pointer flex items-center gap-2 disabled:opacity-50 disabled:cursor-not-allowed"
          >
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" />
            </svg>
            <span class="hidden sm:inline">Kirim</span>
          </button>
        </div>
        <div class="flex items-center justify-between mt-2 px-1">
          <div class="flex items-center gap-3 text-xs text-slate-500">
            <span id="status-indicator" class="flex items-center gap-1.5">
              <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
              Siap
            </span>
          </div>
          <button 
            id="reset-chat"
            class="text-xs font-semibold text-slate-500 hover:text-slate-700 cursor-pointer"
          >
            🔄 Reset Chat
          </button>
        </div>
      </div>

    </main>

    <!-- Defer non-critical JavaScript -->
    <script type="module" is:inline define:vars={{ guidelines }}>
      // Import external script - deferred automatically
      import { initChatApp } from '../../scripts/ai-banner-chat.js';
      
      // Initialize when DOM is ready
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', () => {
          initChatApp(guidelines);
        });
      } else {
        initChatApp(guidelines);
      }
    </script>

  </body>
</html>
