---
import '../../styles/global.css';
import { CATEGORIES } from '../../data/products';
import { DEFAULT_CATEGORIES } from '../../data/categories';
import { SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_BUCKET } from '../../data/supabaseConfig';
import { withBase } from '../../utils/paths';

const title = "Admin — Zaloma Florist";
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/x-icon" href={withBase('/favicon.ico')} />
    <script is:inline src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
  </head>
  <body class="bg-slate-100/70 text-slate-800 font-sans antialiased min-h-screen flex flex-col">

    <!-- Toast Notification Container -->
    <div id="toast-container" class="fixed top-4 right-4 z-50 flex flex-col gap-2 pointer-events-none" aria-live="polite"></div>

    <!-- ================= LOGIN SCREEN ================= -->
    <div id="login-gate" class="flex-1 flex items-center justify-center p-4">
      <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-8 w-full max-w-sm animate-fade-in">
        <div class="mb-6 text-center">
          <div class="w-12 h-12 rounded-2xl bg-primary text-white font-serif font-bold text-2xl flex items-center justify-center mx-auto mb-3 shadow-sm">
            Z
          </div>
          <h1 class="text-xl font-bold text-slate-900 tracking-tight">Admin Zaloma Florist</h1>
          <p class="text-xs text-slate-500 mt-1">Masuk untuk mengelola produk toko.</p>
        </div>

        <form id="login-form" class="space-y-4">
          <div>
            <label for="admin-email-input" class="block text-xs font-semibold text-slate-700 mb-1">Email</label>
            <input 
              type="email" 
              id="admin-email-input" 
              placeholder="nama@gmail.com" 
              class="w-full px-3.5 py-2.5 rounded-lg border border-slate-300 focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary/20 transition-all text-sm"
              required
              autocomplete="email"
            />
          </div>
          <div>
            <label for="admin-password-input" class="block text-xs font-semibold text-slate-700 mb-1">Password</label>
            <input 
              type="password" 
              id="admin-password-input" 
              placeholder="••••••••" 
              class="w-full px-3.5 py-2.5 rounded-lg border border-slate-300 focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary/20 transition-all text-sm"
              required
              autocomplete="current-password"
            />
            <p id="login-error" class="text-xs text-rose-600 mt-2 font-medium hidden animate-fade-in"></p>
          </div>
          <button 
            type="submit" 
            id="login-btn"
            class="w-full bg-primary hover:bg-primary-dark text-white font-semibold py-2.5 px-4 rounded-lg transition-all duration-150 cursor-pointer text-sm flex items-center justify-center gap-2 active:scale-[0.98] shadow-sm"
          >
            <span id="login-btn-text">Masuk</span>
            <svg id="login-spinner" class="w-4 h-4 animate-spin hidden" fill="none" viewBox="0 0 24 24">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
            </svg>
          </button>
        </form>
      </div>
    </div>

    <!-- ================= MAIN ADMIN APP ================= -->
    <div id="admin-dashboard" class="hidden flex-1 flex flex-col">

      <!-- Minimal Navbar with Elegant Brand Accents -->
      <nav class="bg-white border-b border-slate-200 sticky top-0 z-30">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 flex items-center justify-between h-14">
          
          <!-- Left: Brand & Tabs -->
          <div class="flex items-center gap-6">
            <span class="font-bold text-slate-900 text-sm tracking-tight flex items-center gap-2">
              <span class="w-6 h-6 rounded-md bg-primary text-white font-serif font-bold text-xs flex items-center justify-center shadow-2xs">Z</span>
              <span>Zaloma Admin</span>
            </span>

            <div class="flex items-center gap-1 border-l border-slate-200 pl-4 sm:pl-6">
              <button 
                type="button" 
                id="tab-btn-catalog" 
                class="tab-btn active px-3 py-1.5 rounded-md text-xs font-semibold bg-primary text-white transition-all cursor-pointer flex items-center gap-1.5 shadow-2xs"
              >
                <span>Produk</span>
                <span id="tab-count-badge" class="px-1.5 py-0.2 rounded-full text-[10px] font-bold bg-white/20 text-white">0</span>
              </button>
              <button 
                type="button" 
                id="tab-btn-add" 
                class="tab-btn px-3 py-1.5 rounded-md text-xs font-semibold text-slate-600 hover:text-primary hover:bg-accent-bg/50 transition-all cursor-pointer"
              >
                + Tambah Produk
              </button>
              <button 
                type="button" 
                id="tab-btn-categories" 
                class="tab-btn px-3 py-1.5 rounded-md text-xs font-semibold text-slate-600 hover:text-primary hover:bg-accent-bg/50 transition-all cursor-pointer flex items-center gap-1.5"
              >
                <span>Kategori</span>
                <span id="tab-cat-badge" class="px-1.5 py-0.2 rounded-full text-[10px] font-bold bg-slate-200 text-slate-700">0</span>
              </button>
            </div>
          </div>

          <!-- Right: User Email & Actions -->
          <div class="flex items-center gap-3">
            <a 
              href="/katalog/" 
              target="_blank" 
              class="text-xs font-medium text-slate-500 hover:text-primary transition-colors hidden sm:inline-block"
            >
              Lihat Website ↗
            </a>
            <span id="user-email-display" class="text-xs text-slate-400 hidden md:inline-block max-w-[180px] truncate"></span>
            <button 
              id="logout-btn" 
              type="button" 
              class="text-xs font-semibold text-rose-600 hover:text-rose-700 hover:bg-rose-50 px-2.5 py-1.5 rounded-md transition-colors cursor-pointer"
            >
              Keluar
            </button>
          </div>

        </div>
      </nav>

      <!-- Content Area -->
      <main class="flex-1 max-w-7xl w-full mx-auto p-4 sm:p-6 space-y-4">

        <!-- ================= TAB 1: DAFTAR PRODUK ================= -->
        <section id="tab-catalog" class="space-y-4 animate-fade-in">
          
          <!-- Filter & Search Toolbar -->
          <div class="bg-white p-3 rounded-xl border border-slate-200 flex flex-col sm:flex-row gap-2.5 items-stretch sm:items-center justify-between">
            <div class="relative flex-1">
              <input 
                type="text" 
                id="search-filter-input" 
                placeholder="Cari nama produk..." 
                class="w-full pl-3 pr-8 py-1.5 rounded-lg border border-slate-200 text-xs focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary/20 transition-all"
              />
              <button 
                type="button" 
                id="clear-search-btn" 
                class="hidden absolute right-2.5 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-600 text-xs font-bold cursor-pointer"
              >
                ✕
              </button>
            </div>

            <div class="flex items-center gap-2">
              <select 
                id="category-filter-select" 
                class="px-2.5 py-1.5 rounded-lg border border-slate-200 text-xs bg-white text-slate-700 focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary/20 transition-all cursor-pointer"
              >
                <option value="all">Semua Kategori</option>
              </select>

              <select 
                id="subcategory-filter-select" 
                class="hidden px-2.5 py-1.5 rounded-lg border border-slate-200 text-xs bg-white text-slate-700 focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary/20 transition-all cursor-pointer animate-fade-in"
              >
                <option value="all">Semua Subkategori</option>
              </select>

              <select 
                id="sort-select" 
                class="px-2.5 py-1.5 rounded-lg border border-slate-200 text-xs bg-white text-slate-700 focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary/20 transition-all cursor-pointer"
              >
                <option value="newest">Terbaru</option>
                <option value="price-asc">Harga Terendah</option>
                <option value="price-desc">Harga Tertinggi</option>
                <option value="name-asc">Nama A-Z</option>
              </select>

              <button 
                type="button" 
                id="refresh-btn" 
                title="Muat ulang data" 
                class="px-2.5 py-1.5 rounded-lg border border-slate-200 text-slate-600 hover:text-primary hover:border-primary/40 hover:bg-accent-bg/40 text-xs font-semibold transition-all cursor-pointer active:scale-95"
              >
                Muat Ulang
              </button>
            </div>
          </div>

          <!-- Products Grid -->
          <div id="catalog-products-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-3.5">
            <div class="col-span-full py-16 text-center text-slate-400 text-xs">
              <svg class="w-6 h-6 animate-spin mx-auto text-slate-400 mb-2" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
              </svg>
              Memuat data produk...
            </div>
          </div>

          <!-- Pagination Container -->
          <div id="admin-pagination-container" class="bg-white p-3 rounded-xl border border-slate-200 flex flex-col sm:flex-row items-center justify-between gap-2.5 text-xs">
            <p id="admin-pag-info" class="text-slate-500 font-medium">
              Menampilkan <span id="admin-pag-start" class="font-bold text-slate-800">0</span> - <span id="admin-pag-end" class="font-bold text-slate-800">0</span> dari <span id="admin-pag-total" class="font-bold text-slate-800">0</span> produk
            </p>
            <div class="flex items-center gap-1" id="admin-pag-controls"></div>
          </div>
        </section>

        <!-- ================= TAB 2: TAMBAH PRODUK ================= -->
        <section id="tab-add" class="hidden animate-fade-in max-w-2xl mx-auto">
          <div class="bg-white rounded-2xl p-5 sm:p-6 border border-slate-200 shadow-xs">
            <div class="mb-5 pb-3 border-b border-slate-100 flex items-center justify-between">
              <div>
                <h2 class="text-base font-bold text-slate-900 flex items-center gap-2">
                  <span class="w-2 h-2 rounded-full bg-primary"></span>
                  Tambah Produk Baru
                </h2>
                <p class="text-xs text-slate-500 mt-0.5">Produk akan langsung tampil di website.</p>
              </div>
              <span class="text-[11px] font-semibold px-2.5 py-1 rounded-full bg-accent-bg text-primary border border-soft-cream">
                Instant Cloud
              </span>
            </div>

            <form id="add-product-form" class="space-y-4">
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                
                <div class="sm:col-span-2">
                  <label for="prod-name" class="block text-xs font-semibold text-slate-700 mb-1">
                    Nama Produk <span class="text-rose-500">*</span>
                  </label>
                  <input 
                    type="text" 
                    id="prod-name" 
                    required 
                    placeholder="Contoh: Bunga Papan Wedding 2x1.5m"
                    class="w-full px-3 py-2 rounded-lg border border-slate-300 text-xs focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary/20 transition-all"
                  />
                </div>

                <div>
                  <label for="prod-category" class="block text-xs font-semibold text-slate-700 mb-1">
                    Kategori <span class="text-rose-500">*</span>
                  </label>
                  <select 
                    id="prod-category" 
                    required
                    class="w-full px-3 py-2 rounded-lg border border-slate-300 text-xs focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary/20 transition-all bg-white cursor-pointer"
                  >
                    <option value="" disabled selected>Pilih Kategori...</option>
                  </select>
                </div>

                <div id="prod-subcategory-wrapper" class="hidden animate-fade-in">
                  <label for="prod-subcategory" class="block text-xs font-semibold text-slate-700 mb-1">
                    Subkategori <span class="text-slate-400 font-normal">(Opsional)</span>
                  </label>
                  <select 
                    id="prod-subcategory" 
                    class="w-full px-3 py-2 rounded-lg border border-slate-300 text-xs focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary/20 transition-all bg-white cursor-pointer"
                  >
                    <option value="">Pilih Subkategori...</option>
                  </select>
                </div>

                <div>
                  <label for="prod-price" class="block text-xs font-semibold text-slate-700 mb-1">
                    Harga (Rp) <span class="text-rose-500">*</span>
                  </label>
                  <input 
                    type="number" 
                    id="prod-price" 
                    required 
                    min="10000" 
                    step="5000"
                    placeholder="450000"
                    class="w-full px-3 py-2 rounded-lg border border-slate-300 text-xs font-mono focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary/20 transition-all"
                  />
                  <p id="price-preview" class="text-[11px] font-bold text-primary mt-1">Rp 0</p>
                </div>

                <div class="sm:col-span-2">
                  <label for="prod-time" class="block text-xs font-semibold text-slate-700 mb-1">
                    Estimasi Pengerjaan
                  </label>
                  <input 
                    type="text" 
                    id="prod-time" 
                    value="3 - 5 Jam" 
                    placeholder="Contoh: 3 - 5 Jam"
                    class="w-full px-3 py-2 rounded-lg border border-slate-300 text-xs focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary/20 transition-all"
                  />
                </div>

              </div>

              <!-- Upload Foto -->
              <div>
                <label class="block text-xs font-semibold text-slate-700 mb-1">
                  Foto Produk <span class="text-rose-500">*</span>
                </label>
                
                <div class="border border-dashed border-slate-300 hover:border-primary hover:bg-accent-bg/20 rounded-xl p-4 text-center bg-slate-50 transition-all relative cursor-pointer" id="dropzone">
                  <input 
                    type="file" 
                    id="prod-image-file" 
                    accept="image/*" 
                    required
                    class="absolute inset-0 w-full h-full opacity-0 cursor-pointer z-10"
                  />
                  
                  <div id="upload-prompt" class="space-y-1 py-3">
                    <p class="text-xs font-semibold text-slate-700">Pilih Foto atau Potret dari Kamera</p>
                    <p class="text-[11px] text-slate-400">Otomatis dikompres ke WebP ringan sebelum diupload.</p>
                  </div>

                  <div id="image-preview-container" class="hidden space-y-2 animate-fade-in">
                    <img id="image-preview" src="" alt="Preview" class="max-h-48 mx-auto rounded-lg object-contain border border-slate-200 bg-white" />
                    <div class="flex items-center justify-center gap-2 text-[11px]">
                      <span id="orig-size-label" class="text-slate-400">0 KB</span>
                      <span class="text-slate-300">→</span>
                      <span id="comp-size-label" class="font-semibold text-emerald-600">0 KB (WebP)</span>
                    </div>
                  </div>
                </div>
              </div>

              <!-- Deskripsi -->
              <div>
                <label for="prod-desc" class="block text-xs font-semibold text-slate-700 mb-1">
                  Deskripsi Singkat (Opsional)
                </label>
                <textarea 
                  id="prod-desc" 
                  rows="2" 
                  placeholder="Keterangan singkat produk..."
                  class="w-full px-3 py-2 rounded-lg border border-slate-300 text-xs focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary/20 transition-all resize-y"
                ></textarea>
              </div>

              <!-- Featured Checkbox -->
              <div class="flex items-center gap-2 pt-1">
                <input 
                  type="checkbox" 
                  id="prod-featured" 
                  class="w-4 h-4 rounded text-primary accent-primary border-slate-300 cursor-pointer"
                />
                <label for="prod-featured" class="text-xs text-slate-700 cursor-pointer font-medium">
                  Tampilkan sebagai produk unggulan di beranda
                </label>
              </div>

              <div class="pt-3 border-t border-slate-100 flex items-center justify-end">
                <button 
                  type="submit" 
                  id="submit-btn" 
                  class="bg-primary hover:bg-primary-dark text-white font-semibold py-2 px-5 rounded-lg transition-all duration-150 cursor-pointer text-xs active:scale-95 flex items-center gap-1.5 shadow-sm"
                >
                  <span id="btn-text">Simpan Produk</span>
                  <svg id="btn-spinner" class="w-3.5 h-3.5 animate-spin hidden" fill="none" viewBox="0 0 24 24">
                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
                  </svg>
                </button>
              </div>
            </form>
          </div>
        </section>

        <!-- ================= TAB 3: KELOLA KATEGORI ================= -->
        <section id="tab-categories" class="hidden animate-fade-in space-y-4 max-w-4xl mx-auto">
          <div class="bg-white rounded-2xl p-4 sm:p-5 border border-slate-200 shadow-xs flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3">
            <div>
              <h2 class="text-base font-bold text-slate-900 flex items-center gap-2">
                <span class="w-2 h-2 rounded-full bg-primary"></span>
                Kelola Kategori &amp; Subkategori
              </h2>
              <p class="text-xs text-slate-500 mt-0.5">Atur kategori utama dan subkategori untuk pengelompokan produk toko.</p>
            </div>
            <button 
              type="button" 
              id="open-add-category-btn" 
              class="bg-primary hover:bg-primary-dark text-white font-semibold py-2 px-4 rounded-lg text-xs transition-all active:scale-95 flex items-center gap-1.5 shadow-sm cursor-pointer shrink-0"
            >
              + Tambah Kategori
            </button>
          </div>

          <!-- Categories Grid -->
          <div id="categories-cards-grid" class="grid grid-cols-1 md:grid-cols-2 gap-3.5">
            <!-- Populated by JS -->
          </div>
        </section>

      </main>

    </div>

    <!-- ================= EDIT MODAL ================= -->
    <div id="edit-modal" class="hidden fixed inset-0 z-50 bg-black/40 backdrop-blur-xs flex items-center justify-center p-4 animate-fade-in">
      <div class="bg-white rounded-2xl max-w-md w-full p-5 sm:p-6 shadow-xl border border-slate-200 space-y-4 animate-modal-pop">
        <div class="flex items-center justify-between pb-3 border-b border-slate-100">
          <h3 class="text-sm font-bold text-slate-900 flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-primary"></span>
            Edit Produk
          </h3>
          <button id="close-modal-btn" type="button" class="text-slate-400 hover:text-slate-600 text-sm font-bold cursor-pointer">✕</button>
        </div>

        <form id="edit-product-form" class="space-y-3">
          <input type="hidden" id="edit-prod-id" />
          <input type="hidden" id="edit-prod-current-image" />

          <div>
            <label class="block text-xs font-semibold text-slate-700 mb-1">Nama Produk</label>
            <input type="text" id="edit-prod-name" required class="w-full px-3 py-1.5 rounded-lg border border-slate-300 text-xs focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary/20 transition-all" />
          </div>

          <div class="grid grid-cols-2 gap-3">
            <div>
              <label class="block text-xs font-semibold text-slate-700 mb-1">Kategori</label>
              <select id="edit-prod-category" required class="w-full px-2.5 py-1.5 rounded-lg border border-slate-300 text-xs bg-white focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary/20 transition-all cursor-pointer">
              </select>
            </div>
            <div>
              <label class="block text-xs font-semibold text-slate-700 mb-1">Harga (Rp)</label>
              <input type="number" id="edit-prod-price" required step="5000" class="w-full px-2.5 py-1.5 rounded-lg border border-slate-300 text-xs font-mono focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary/20 transition-all" />
              <p id="edit-price-preview" class="text-[10px] font-bold text-primary mt-0.5 truncate"></p>
            </div>
            <div id="edit-prod-subcategory-wrapper" class="hidden col-span-2 animate-fade-in">
              <label class="block text-xs font-semibold text-slate-700 mb-1">
                Subkategori <span class="text-slate-400 font-normal">(Opsional)</span>
              </label>
              <select id="edit-prod-subcategory" class="w-full px-2.5 py-1.5 rounded-lg border border-slate-300 text-xs bg-white focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary/20 transition-all cursor-pointer">
                <option value="">Pilih Subkategori...</option>
              </select>
            </div>
          </div>

          <div>
            <label class="block text-xs font-semibold text-slate-700 mb-1">Foto</label>
            <div class="flex items-center gap-2.5 p-2 rounded-lg border border-slate-200 bg-slate-50">
              <img id="edit-image-thumbnail" src="" alt="Thumb" class="w-10 h-10 rounded object-cover border border-slate-200 bg-white shrink-0" />
              <div class="flex-1 min-w-0">
                <label for="edit-prod-image-file" class="text-[11px] font-semibold text-primary hover:text-primary-dark cursor-pointer underline">
                  Ganti Foto
                  <input type="file" id="edit-prod-image-file" accept="image/*" class="hidden" />
                </label>
                <p id="edit-image-note" class="text-[10px] text-slate-400 truncate">Kosongkan jika tidak diganti.</p>
              </div>
            </div>
          </div>

          <div>
            <label class="block text-xs font-semibold text-slate-700 mb-1">Estimasi Pengerjaan</label>
            <input type="text" id="edit-prod-time" class="w-full px-3 py-1.5 rounded-lg border border-slate-300 text-xs focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary/20 transition-all" />
          </div>

          <div>
            <label class="block text-xs font-semibold text-slate-700 mb-1">Deskripsi</label>
            <textarea id="edit-prod-desc" rows="2" class="w-full px-3 py-1.5 rounded-lg border border-slate-300 text-xs focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary/20 transition-all resize-y"></textarea>
          </div>

          <div class="flex items-center gap-2 pt-1">
            <input type="checkbox" id="edit-prod-featured" class="w-4 h-4 rounded text-primary accent-primary border-slate-300 cursor-pointer" />
            <label for="edit-prod-featured" class="text-xs text-slate-700 cursor-pointer font-medium">Produk unggulan beranda</label>
          </div>

          <div class="pt-3 border-t border-slate-100 flex items-center justify-end gap-2">
            <button type="button" id="cancel-edit-btn" class="px-3 py-1.5 rounded-lg text-xs font-semibold text-slate-500 hover:bg-slate-100 cursor-pointer">Batal</button>
            <button type="submit" id="save-edit-btn" class="bg-primary hover:bg-primary-dark text-white font-semibold py-1.5 px-4 rounded-lg text-xs transition-all active:scale-95 flex items-center gap-1.5 cursor-pointer shadow-sm">
              <span id="save-btn-text">Simpan</span>
              <svg id="save-spinner" class="w-3.5 h-3.5 animate-spin hidden" fill="none" viewBox="0 0 24 24">
