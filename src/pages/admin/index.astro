---
import '../../styles/global.css';
import { CATEGORIES } from '../../data/products';
import { DEFAULT_CATEGORIES } from '../../data/categories';
import { SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_BUCKET } from '../../data/supabaseConfig';
import { withBase } from '../../utils/paths';

const title = "Admin — Zaloma Florist";
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/x-icon" href={withBase('/favicon.ico')} />
    <script is:inline src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
  </head>
  <body class="bg-slate-100/70 text-slate-800 font-sans antialiased min-h-screen flex flex-col">

    <!-- Toast Notification Container -->
    <div id="toast-container" class="fixed top-4 right-4 z-50 flex flex-col gap-2 pointer-events-none" aria-live="polite"></div>

    <!-- ================= LOGIN SCREEN ================= -->
    <div id="login-gate" class="flex-1 flex items-center justify-center p-4">
      <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-8 w-full max-w-sm animate-fade-in">
        <div class="mb-6 text-center">
          <div class="w-12 h-12 rounded-2xl bg-primary text-white font-serif font-bold text-2xl flex items-center justify-center mx-auto mb-3 shadow-sm">
            Z
          </div>
          <h1 class="text-xl font-bold text-slate-900 tracking-tight">Admin Zaloma Florist</h1>
          <p class="text-xs text-slate-500 mt-1">Masuk untuk mengelola produk toko.</p>
        </div>

        <form id="login-form" class="space-y-4">
          <div>
            <label for="admin-email-input" class="block text-xs font-semibold text-slate-700 mb-1">Email</label>
            <input 
              type="email" 
              id="admin-email-input" 
              placeholder="nama@gmail.com" 
              class="w-full px-3.5 py-2.5 rounded-lg border border-slate-300 focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary/20 transition-all text-sm"
              required
              autocomplete="email"
            />
          </div>
          <div>
            <label for="admin-password-input" class="block text-xs font-semibold text-slate-700 mb-1">Password</label>
            <input 
              type="password" 
              id="admin-password-input" 
              placeholder="••••••••" 
              class="w-full px-3.5 py-2.5 rounded-lg border border-slate-300 focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary/20 transition-all text-sm"
              required
              autocomplete="current-password"
            />
            <p id="login-error" class="text-xs text-rose-600 mt-2 font-medium hidden animate-fade-in"></p>
          </div>
          <button 
            type="submit" 
            id="login-btn"
            class="w-full bg-primary hover:bg-primary-dark text-white font-semibold py-2.5 px-4 rounded-lg transition-all duration-150 cursor-pointer text-sm flex items-center justify-center gap-2 active:scale-[0.98] shadow-sm"
          >
            <span id="login-btn-text">Masuk</span>
            <svg id="login-spinner" class="w-4 h-4 animate-spin hidden" fill="none" viewBox="0 0 24 24">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
            </svg>
          </button>
        </form>
      </div>
    </div>

    <!-- ================= MAIN ADMIN APP ================= -->
    <div id="admin-dashboard" class="hidden flex-1 flex flex-col">

      <!-- Minimal Navbar with Elegant Brand Accents -->
      <nav class="bg-white border-b border-slate-200 sticky top-0 z-30">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 flex items-center justify-between h-14">
          
          <!-- Left: Brand & Tabs -->
          <div class="flex items-center gap-6">
            <span class="font-bold text-slate-900 text-sm tracking-tight flex items-center gap-2">
              <span class="w-6 h-6 rounded-md bg-primary text-white font-serif font-bold text-xs flex items-center justify-center shadow-2xs">Z</span>
              <span>Zaloma Admin</span>
            </span>

            <div class="flex items-center gap-1 border-l border-slate-200 pl-4 sm:pl-6">
              <button 
                type="button" 
                id="tab-btn-catalog" 
                class="tab-btn active px-3 py-1.5 rounded-md text-xs font-semibold bg-primary text-white transition-all cursor-pointer flex items-center gap-1.5 shadow-2xs"
              >
                <span>Produk</span>
                <span id="tab-count-badge" class="px-1.5 py-0.2 rounded-full text-[10px] font-bold bg-white/20 text-white">0</span>
              </button>
              <button 
                type="button" 
                id="tab-btn-add" 
                class="tab-btn px-3 py-1.5 rounded-md text-xs font-semibold text-slate-600 hover:text-primary hover:bg-accent-bg/50 transition-all cursor-pointer"
              >
                + Tambah Produk
              </button>
              <button 
                type="button" 
                id="tab-btn-categories" 
                class="tab-btn px-3 py-1.5 rounded-md text-xs font-semibold text-slate-600 hover:text-primary hover:bg-accent-bg/50 transition-all cursor-pointer flex items-center gap-1.5"
              >
                <span>Kategori</span>
                <span id="tab-cat-badge" class="px-1.5 py-0.2 rounded-full text-[10px] font-bold bg-slate-200 text-slate-700">0</span>
              </button>
              <button 
                type="button" 
                id="tab-btn-cities" 
                class="tab-btn px-3 py-1.5 rounded-md text-xs font-semibold text-slate-600 hover:text-primary hover:bg-accent-bg/50 transition-all cursor-pointer flex items-center gap-1.5"
              >
                <span>Kota</span>
                <span id="tab-city-badge" class="px-1.5 py-0.2 rounded-full text-[10px] font-bold bg-slate-200 text-slate-700">0</span>
              </button>
              <button 
                type="button" 
                id="tab-btn-sizes" 
                class="tab-btn px-3 py-1.5 rounded-md text-xs font-semibold text-slate-600 hover:text-primary hover:bg-accent-bg/50 transition-all cursor-pointer flex items-center gap-1.5"
              >
                <span>Ukuran</span>
                <span id="tab-size-badge" class="px-1.5 py-0.2 rounded-full text-[10px] font-bold bg-slate-200 text-slate-700">0</span>
              </button>
            </div>
          </div>

          <!-- Right: User Email & Actions -->
          <div class="flex items-center gap-3">
            <a 
              href="/katalog/" 
              target="_blank" 
              class="text-xs font-medium text-slate-500 hover:text-primary transition-colors hidden sm:inline-block"
            >
              Lihat Website ↗
            </a>
            <span id="user-email-display" class="text-xs text-slate-400 hidden md:inline-block max-w-[180px] truncate"></span>
            <button 
              id="logout-btn" 
              type="button" 
              class="text-xs font-semibold text-rose-600 hover:text-rose-700 hover:bg-rose-50 px-2.5 py-1.5 rounded-md transition-colors cursor-pointer"
            >
              Keluar
            </button>
          </div>

        </div>
      </nav>

      <!-- Content Area -->
      <main class="flex-1 max-w-7xl w-full mx-auto p-4 sm:p-6 space-y-4">

        <!-- ================= TAB 1: DAFTAR PRODUK ================= -->
        <section id="tab-catalog" class="space-y-4 animate-fade-in">
          
          <!-- Filter & Search Toolbar -->
          <div class="bg-white p-3 rounded-xl border border-slate-200 flex flex-col sm:flex-row gap-2.5 items-stretch sm:items-center justify-between">
            <div class="relative flex-1">
              <input 
                type="text" 
                id="search-filter-input" 
                placeholder="Cari nama produk..." 
                class="w-full pl-3 pr-8 py-1.5 rounded-lg border border-slate-200 text-xs focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary/20 transition-all"
              />
              <button 
                type="button" 
                id="clear-search-btn" 
                class="hidden absolute right-2.5 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-600 text-xs font-bold cursor-pointer"
              >
                ✕
              </button>
            </div>

            <div class="flex items-center gap-2">
              <select 
                id="category-filter-select" 
                class="px-2.5 py-1.5 rounded-lg border border-slate-200 text-xs bg-white text-slate-700 focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary/20 transition-all cursor-pointer"
              >
                <option value="all">Semua Kategori</option>
                <option value="bunga-papan">Bunga Papan</option>
                <option value="bunga-papan-semi-styrofoam">Bunga Papan Semi Styrofoam</option>
                <option value="bouquet">Bouquet</option>
                <option value="standing-flower">Standing Flower</option>
                <option value="bunga-meja">Bunga Meja</option>
                <option value="tabulampot">Tabulampot</option>
                <option value="paper-flower">Paper Flower</option>
              </select>

              <select 
                id="subcategory-filter-select" 
                class="hidden px-2.5 py-1.5 rounded-lg border border-slate-200 text-xs bg-white text-slate-700 focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary/20 transition-all cursor-pointer animate-fade-in"
              >
                <option value="all">Semua Subkategori</option>
              </select>

              <select 
                id="sort-select" 
                class="px-2.5 py-1.5 rounded-lg border border-slate-200 text-xs bg-white text-slate-700 focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary/20 transition-all cursor-pointer"
              >
                <option value="newest">Terbaru</option>
                <option value="price-asc">Harga Terendah</option>
                <option value="price-desc">Harga Tertinggi</option>
                <option value="name-asc">Nama A-Z</option>
              </select>

              <button 
                type="button" 
                id="refresh-btn" 
                title="Muat ulang data" 
                class="px-2.5 py-1.5 rounded-lg border border-slate-200 text-slate-600 hover:text-primary hover:border-primary/40 hover:bg-accent-bg/40 text-xs font-semibold transition-all cursor-pointer active:scale-95"
              >
                Muat Ulang
              </button>
            </div>
          </div>

          <!-- Products Grid -->
          <div id="catalog-products-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-3.5">
            <div class="col-span-full py-16 text-center text-slate-400 text-xs">
              <svg class="w-6 h-6 animate-spin mx-auto text-slate-400 mb-2" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
              </svg>
              Memuat data produk...
            </div>
          </div>

          <!-- Pagination Container -->
          <div id="admin-pagination-container" class="bg-white p-3 rounded-xl border border-slate-200 flex flex-col sm:flex-row items-center justify-between gap-2.5 text-xs">
            <p id="admin-pag-info" class="text-slate-500 font-medium">
              Menampilkan <span id="admin-pag-start" class="font-bold text-slate-800">0</span> - <span id="admin-pag-end" class="font-bold text-slate-800">0</span> dari <span id="admin-pag-total" class="font-bold text-slate-800">0</span> produk
            </p>
            <div class="flex items-center gap-1" id="admin-pag-controls"></div>
          </div>
        </section>

        <!-- ================= TAB 2: TAMBAH PRODUK ================= -->
        <section id="tab-add" class="hidden animate-fade-in max-w-2xl mx-auto">
          <div class="bg-white rounded-2xl p-5 sm:p-6 border border-slate-200 shadow-xs">
            <div class="mb-5 pb-3 border-b border-slate-100 flex items-center justify-between">
              <div>
                <h2 class="text-base font-bold text-slate-900 flex items-center gap-2">
                  <span class="w-2 h-2 rounded-full bg-primary"></span>
                  Tambah Produk Baru
                </h2>
                <p class="text-xs text-slate-500 mt-0.5">Produk akan langsung tampil di website.</p>
              </div>
              <span class="text-[11px] font-semibold px-2.5 py-1 rounded-full bg-accent-bg text-primary border border-soft-cream">
                Instant Cloud
              </span>
            </div>

            <form id="add-product-form" class="space-y-4">
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                
                <div class="sm:col-span-2">
                  <label for="prod-name" class="block text-xs font-semibold text-slate-700 mb-1">
                    Nama Produk <span class="text-rose-500">*</span>
                  </label>
                  <input 
                    type="text" 
                    id="prod-name" 
                    required 
                    placeholder="Contoh: Bunga Papan Wedding 2x1.5m"
                    class="w-full px-3 py-2 rounded-lg border border-slate-300 text-xs focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary/20 transition-all"
                  />
                </div>

                <div>
                  <label for="prod-category" class="block text-xs font-semibold text-slate-700 mb-1">
                    Kategori <span class="text-rose-500">*</span>
                  </label>
                  <select 
                    id="prod-category" 
                    required
                    class="w-full px-3 py-2 rounded-lg border border-slate-300 text-xs focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary/20 transition-all bg-white cursor-pointer"
                  >
                    <option value="" disabled selected>Pilih Kategori...</option>
                    <option value="bunga-papan" data-name="Bunga Papan">Bunga Papan</option>
                    <option value="bunga-papan-semi-styrofoam" data-name="Bunga Papan Semi Styrofoam">Bunga Papan Semi Styrofoam</option>
                    <option value="bouquet" data-name="Bouquet">Bouquet</option>
                    <option value="standing-flower" data-name="Standing Flower">Standing Flower</option>
                    <option value="bunga-meja" data-name="Bunga Meja">Bunga Meja</option>
                    <option value="tabulampot" data-name="Tabulampot">Tabulampot</option>
                    <option value="paper-flower" data-name="Paper Flower">Paper Flower</option>
                  </select>
                </div>

                <div id="prod-subcategory-wrapper" class="hidden animate-fade-in">
                  <label for="prod-subcategory" class="block text-xs font-semibold text-slate-700 mb-1">
                    Subkategori <span class="text-slate-400 font-normal">(Opsional)</span>
                  </label>
                  <select 
                    id="prod-subcategory" 
                    class="w-full px-3 py-2 rounded-lg border border-slate-300 text-xs focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary/20 transition-all bg-white cursor-pointer"
                  >
                    <option value="">Pilih Subkategori...</option>
                  </select>
                </div>

                <div>
                  <label for="prod-price" class="block text-xs font-semibold text-slate-700 mb-1">
                    Harga (Rp) <span class="text-rose-500">*</span>
                  </label>
                  <input 
                    type="number" 
                    id="prod-price" 
                    required 
                    min="10000" 
                    step="5000"
                    placeholder="450000"
                    class="w-full px-3 py-2 rounded-lg border border-slate-300 text-xs font-mono focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary/20 transition-all"
                  />
                  <p id="price-preview" class="text-[11px] font-bold text-primary mt-1">Rp 0</p>
                </div>

                <div>
                  <label for="prod-time" class="block text-xs font-semibold text-slate-700 mb-1">
                    Estimasi Pengerjaan
                  </label>
                  <input 
                    type="text" 
                    id="prod-time" 
                    value="3 - 5 Jam" 
                    placeholder="Contoh: 3 - 5 Jam"
                    class="w-full px-3 py-2 rounded-lg border border-slate-300 text-xs focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary/20 transition-all"
                  />
                </div>

                <div>
                  <div class="flex items-center justify-between mb-1">
                    <label for="prod-city" class="block text-xs font-semibold text-slate-700">
                      Wilayah / Area Pengiriman <span class="text-rose-500">*</span>
                    </label>
                    <div class="flex items-center gap-1.5">
                      <button type="button" id="quick-add-city-btn" class="text-[11px] text-primary hover:text-primary-dark font-semibold cursor-pointer">
                        + Tambah Kota
                      </button>
                      <span class="text-slate-300">|</span>
                      <button type="button" id="quick-manage-city-btn" class="text-[11px] text-slate-500 hover:text-slate-700 font-medium cursor-pointer">
                        ⚙️ Kelola
                      </button>
                    </div>
                  </div>
                  <select 
                    id="prod-city" 
                    required
                    class="w-full px-3 py-2 rounded-lg border border-slate-300 text-xs bg-white focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary/20 transition-all cursor-pointer"
                  >
                    <option value="" disabled>Pilih Wilayah / Kota Pengiriman...</option>
                    <option value="__ADD_NEW_CITY__" class="font-semibold text-primary">➕ + Tambah Kota Pengiriman Baru...</option>
                    <option value="Malang Raya (Kota Malang, Kab. Malang, Kota Batu)" selected>📍 Malang Raya (Kota Malang, Kab. Malang, Kota Batu)</option>
                    <option value="Bisa Dikirim ke Mana Saja">🌍 Bisa Dikirim ke Mana Saja</option>
                    <option value="Kota Malang">📍 Kota Malang</option>
                    <option value="Kota Batu">📍 Kota Batu</option>
                    <option value="Kabupaten Malang">📍 Kabupaten Malang</option>
                    <option value="Surabaya">📍 Surabaya</option>
                    <option value="Sidoarjo">📍 Sidoarjo</option>
                    <option value="Gresik">📍 Gresik</option>
                    <option value="Pasuruan">📍 Pasuruan</option>
                    <option value="Kediri">📍 Kediri</option>
                    <option value="Blitar">📍 Blitar</option>
                  </select>
                  <p class="text-[10px] text-slate-400 mt-1">Pilih kota pengiriman atau klik "+ Tambah Kota" untuk menambah wilayah baru.</p>
                </div>

                <div>
                  <div class="flex items-center justify-between mb-1">
                    <label for="prod-size" class="block text-xs font-semibold text-slate-700">
                      Ukuran Produk <span class="text-slate-400 font-normal">(Opsional)</span>
                    </label>
                    <div class="flex items-center gap-1.5">
                      <button type="button" id="quick-add-size-btn" class="text-[11px] text-primary hover:text-primary-dark font-semibold cursor-pointer">
                        + Tambah Ukuran
                      </button>
                      <span class="text-slate-300">|</span>
                      <button type="button" id="quick-manage-size-btn" class="text-[11px] text-slate-500 hover:text-slate-700 font-medium cursor-pointer">
                        ⚙️ Kelola
                      </button>
                    </div>
                  </div>
                  <select 
                    id="prod-size" 
                    class="w-full px-3 py-2 rounded-lg border border-slate-300 text-xs bg-white focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary/20 transition-all cursor-pointer"
                  >
                    <option value="">-- Pilih Ukuran (Opsional) --</option>
                    <option value="__ADD_NEW_SIZE__" class="font-semibold text-primary">➕ + Tambah Ukuran Baru ke Database...</option>
                    <optgroup label="Bunga Papan">
                      <option value="2 x 1.2 m" data-category="bunga-papan">📏 2 x 1.2 m (Ukuran Standar)</option>
                      <option value="2 x 1.5 m" data-category="bunga-papan">📏 2 x 1.5 m (Ukuran Sedang)</option>
                      <option value="2 x 1.8 m" data-category="bunga-papan">📏 2 x 1.8 m (Ukuran Besar)</option>
                      <option value="2 x 2 m" data-category="bunga-papan">📏 2 x 2 m (Ukuran Jumbo)</option>
                      <option value="4 x 2 m" data-category="bunga-papan">📏 4 x 2 m (Ukuran Gandeng Double)</option>
                    </optgroup>
                    <optgroup label="Bunga Papan Semi Styrofoam">
                      <option value="2 x 1.2 m" data-category="bunga-papan-semi-styrofoam">📏 2 x 1.2 m (Standar Semi 3D)</option>
                      <option value="2 x 1.5 m" data-category="bunga-papan-semi-styrofoam">📏 2 x 1.5 m (Sedang Semi 3D)</option>
                      <option value="2 x 2 m" data-category="bunga-papan-semi-styrofoam">📏 2 x 2 m (Jumbo Semi 3D)</option>
                    </optgroup>
                    <optgroup label="Bouquet">
                      <option value="Small (5 - 7 Tangkai)" data-category="bouquet">📏 Small (5 - 7 Tangkai)</option>
                      <option value="Medium (10 - 15 Tangkai)" data-category="bouquet">📏 Medium (10 - 15 Tangkai)</option>
                      <option value="Large (20 - 30 Tangkai)" data-category="bouquet">📏 Large (20 - 30 Tangkai)</option>
                      <option value="Jumbo (50+ Tangkai)" data-category="bouquet">📏 Jumbo (50+ Tangkai)</option>
                    </optgroup>
                    <optgroup label="Standing Flower">
                      <option value="1 Tingkat (Tinggi ± 1.2 m)" data-category="standing-flower">📏 1 Tingkat (Tinggi ± 1.2 m)</option>
                      <option value="2 Tingkat (Tinggi ± 1.5 - 1.7 m)" data-category="standing-flower">📏 2 Tingkat (Tinggi ± 1.5 - 1.7 m)</option>
                      <option value="3 Tingkat / Luxury (Tinggi ± 2 m)" data-category="standing-flower">📏 3 Tingkat / Luxury (Tinggi ± 2 m)</option>
                    </optgroup>
                    <optgroup label="Bunga Meja">
                      <option value="Compact / Mini (Vas 15 - 20 cm)" data-category="bunga-meja">📏 Compact / Mini (Vas 15 - 20 cm)</option>
                      <option value="Medium (Vas 25 - 30 cm)" data-category="bunga-meja">📏 Medium (Vas 25 - 30 cm)</option>
                      <option value="Large / Mewah (Vas > 35 cm)" data-category="bunga-meja">📏 Large / Mewah (Vas > 35 cm)</option>
                    </optgroup>
                    <optgroup label="Tabulampot">
                      <option value="Pot Kecil (Diameter 25 - 30 cm)" data-category="tabulampot">📏 Pot Kecil (Diameter 25 - 30 cm)</option>
                      <option value="Pot Sedang (Diameter 35 - 45 cm)" data-category="tabulampot">📏 Pot Sedang (Diameter 35 - 45 cm)</option>
                      <option value="Pot Besar (Diameter > 50 cm)" data-category="tabulampot">📏 Pot Besar (Diameter > 50 cm)</option>
                    </optgroup>
                    <optgroup label="Paper Flower">
                      <option value="2 x 1.2 m (Papan Kertas Standar)" data-category="paper-flower">📏 2 x 1.2 m (Papan Kertas Standar)</option>
                      <option value="2 x 1.5 m (Papan Kertas Sedang)" data-category="paper-flower">📏 2 x 1.5 m (Papan Kertas Sedang)</option>
                      <option value="Frame / Box (20 x 25 cm)" data-category="paper-flower">📏 Frame / Box (20 x 25 cm)</option>
                    </optgroup>
                  </select>
                  <p class="text-[10px] text-slate-400 mt-1">Pilihan ukuran otomatis menyesuaikan kategori yang dipilih.</p>
                </div>

              </div>

              <!-- Upload Foto -->
              <div>
                <label class="block text-xs font-semibold text-slate-700 mb-1">
                  Foto Produk <span class="text-rose-500">*</span>
                </label>
                
                <div class="border border-dashed border-slate-300 hover:border-primary hover:bg-accent-bg/20 rounded-xl p-4 text-center bg-slate-50 transition-all relative cursor-pointer" id="dropzone">
                  <input 
                    type="file" 
                    id="prod-image-file" 
                    accept="image/*" 
                    required
                    class="absolute inset-0 w-full h-full opacity-0 cursor-pointer z-10"
                  />
                  
                  <div id="upload-prompt" class="space-y-1 py-3">
                    <p class="text-xs font-semibold text-slate-700">Pilih Foto atau Potret dari Kamera</p>
