      function updateSizeDropdownForCategory(categorySlug, selectId) {
        const select = document.getElementById(selectId);
        if (!select) return;

        const prevVal = select.value;
        const baseSlug = (categorySlug || '').split('--')[0];

        // Combine categories
        const combinedCats = [];
        const seenSlugs = new Set();
        (categoriesList || []).forEach(c => {
          if (c && c.slug && !seenSlugs.has(c.slug)) {
            seenSlugs.add(c.slug);
            combinedCats.push(c);
          }
        });
        (DEFAULT_CATEGORIES || []).forEach(c => {
          if (c && c.slug && !seenSlugs.has(c.slug)) {
            seenSlugs.add(c.slug);
            combinedCats.push(c);
          }
        });

        let html = '<option value="">-- Pilih Ukuran (Opsional) --</option>';
        html += '<option value="__ADD_NEW_SIZE__" class="font-semibold text-primary">➕ + Tambah Ukuran Baru ke Database...</option>';

        if (baseSlug) {
          const matchedSizes = sizesList.filter(s => s.category_slug === baseSlug || s.category_slug === categorySlug);
          const otherSizes = sizesList.filter(s => s.category_slug !== baseSlug && s.category_slug !== categorySlug);

          if (matchedSizes.length > 0) {
            const currentCatObj = combinedCats.find(c => c.slug === baseSlug);
            const currentCatName = currentCatObj ? currentCatObj.name : baseSlug;
            html += `<optgroup label="Ukuran untuk ${currentCatName}">`;
            html += matchedSizes.map(s => {
              const desc = s.description ? ` (${s.description})` : '';
              return `<option value="${s.name}" data-category="${s.category_slug}">📏 ${s.name}${desc}</option>`;
            }).join('');
            html += `</optgroup>`;
          }

          if (otherSizes.length > 0) {
            combinedCats.forEach(cat => {
              if (cat.slug === baseSlug) return;
              const catSizes = otherSizes.filter(s => s.category_slug === cat.slug);
              if (catSizes.length > 0) {
                html += `<optgroup label="Ukuran ${cat.name}">`;
                html += catSizes.map(s => {
                  const desc = s.description ? ` (${s.description})` : '';
                  return `<option value="${s.name}" data-category="${s.category_slug}">📏 ${s.name}${desc}</option>`;
                }).join('');
                html += `</optgroup>`;
              }
            });
          }
        } else {
          // NO category selected yet: SHOW ALL SIZES FROM DATABASE GROUPED BY CATEGORY!
          combinedCats.forEach(cat => {
            const catSizes = sizesList.filter(s => s.category_slug === cat.slug);
            if (catSizes.length > 0) {
              html += `<optgroup label="${cat.name}">`;
              html += catSizes.map(s => {
                const desc = s.description ? ` (${s.description})` : '';
                return `<option value="${s.name}" data-category="${s.category_slug}">📏 ${s.name}${desc}</option>`;
              }).join('');
              html += `</optgroup>`;
            }
          });
        }

        select.innerHTML = html;

        if (prevVal && prevVal !== '__ADD_NEW_SIZE__') {
          select.value = prevVal;
        }
        syncCustomDropdown(selectId);
      }

