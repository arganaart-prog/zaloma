---
import '../../styles/global.css';
import { SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_BUCKET } from '../../data/supabaseConfig';
import { DEFAULT_PROMO_BANNERS, PROMO_BANNERS_CONFIG_SLUG } from '../../data/promoBanners';
import { ARTICLES, ARTICLES_CONFIG_SLUG } from '../../data/articles';

const title = "Admin — Zaloma Florist";
const R2_IMAGE_API_URL = 'https://images-api.zalomaflorist.com';

// Helper function for base path
function withBase(path: string): string {
  const base = import.meta.env.BASE_URL || '/';
  return base.endsWith('/') ? `${base.slice(0, -1)}${path}` : `${base}${path}`;
}
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/x-icon" href={withBase('/favicon.ico')} />
    <script is:inline src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
  </head>
  <body class="admin-page bg-[#f7f5f2] text-slate-800 font-sans antialiased min-h-screen flex flex-col">

    <!-- Toast Notification Container -->
    <div id="toast-container" class="fixed top-3 inset-x-3 sm:inset-x-auto sm:right-4 sm:top-4 z-50 flex flex-col gap-2 pointer-events-none" aria-live="polite"></div>

    <!-- ================= LOGIN SCREEN ================= -->
    <div id="login-gate" class="relative isolate flex-1 flex items-center justify-center overflow-hidden bg-[radial-gradient(ellipse_at_top_left,_rgba(142,95,43,0.12),_transparent_44%),radial-gradient(ellipse_at_bottom_right,_rgba(103,30,47,0.12),_transparent_42%)] p-4 py-10 sm:p-8">
      <div class="pointer-events-none absolute -left-24 top-1/4 h-64 w-64 rounded-full border border-[#8e5f2b]/10 sm:h-96 sm:w-96" aria-hidden="true"></div>
      <div class="pointer-events-none absolute -right-20 bottom-1/4 h-56 w-56 rounded-full border border-[#671e2f]/10 sm:h-80 sm:w-80" aria-hidden="true"></div>
      <div class="relative w-full max-w-md overflow-hidden rounded-3xl border border-white/80 bg-white/95 p-6 shadow-[0_28px_90px_rgba(54,36,32,0.14)] backdrop-blur sm:p-9 animate-fade-in">
        <div class="absolute inset-x-0 top-0 h-1 bg-gradient-to-r from-[#671e2f] via-[#c59253] to-[#671e2f]" aria-hidden="true"></div>
        <div class="mb-7 text-center">
          <div class="mx-auto mb-5 flex h-[4.5rem] w-[4.5rem] items-center justify-center rounded-2xl border border-[#eadbd0] bg-[#fdf7f7] shadow-sm">
            <img src={withBase('/images/logo/zaloma-logo.webp')} alt="" class="h-14 w-14 object-contain" width="56" height="56" />
          </div>
          <p class="mb-2 text-[0.65rem] font-bold uppercase tracking-[0.24em] text-[#8e5f2b]">Ruang Kontrol Toko</p>
          <h1 class="text-2xl font-bold tracking-tight text-slate-900 sm:text-[1.7rem]">Selamat datang</h1>
          <p class="mx-auto mt-2 max-w-xs text-sm leading-relaxed text-slate-500">Masuk untuk mengelola produk, kategori, wilayah, dan ukuran Zaloma Florist.</p>
        </div>

        <form id="login-form" class="space-y-5">
          <div>
            <label for="admin-email-input" class="mb-2 block text-sm font-semibold text-slate-700">Email</label>
            <input 
              type="email" 
              id="admin-email-input" 
              placeholder="nama@gmail.com" 
              class="w-full rounded-xl border border-slate-200 bg-slate-50/70 px-4 py-3.5 text-base transition-all placeholder:text-slate-400 focus:border-primary focus:bg-white focus:outline-none focus:ring-4 focus:ring-primary/10 sm:text-sm"
              required
              autocomplete="email"
            />
          </div>
          <div>
            <label for="admin-password-input" class="mb-2 block text-sm font-semibold text-slate-700">Password</label>
            <input 
              type="password" 
              id="admin-password-input" 
              placeholder="••••••••" 
              class="w-full rounded-xl border border-slate-200 bg-slate-50/70 px-4 py-3.5 text-base transition-all placeholder:text-slate-400 focus:border-primary focus:bg-white focus:outline-none focus:ring-4 focus:ring-primary/10 sm:text-sm"
              required
              autocomplete="current-password"
            />
            <p id="login-error" class="text-sm text-rose-600 mt-2 font-medium hidden animate-fade-in"></p>
          </div>
          <button 
            type="submit" 
            id="login-btn"
            class="mt-1 flex min-h-12 w-full cursor-pointer items-center justify-center gap-2 rounded-xl bg-primary px-4 py-3 text-sm font-semibold text-white shadow-[0_8px_18px_rgba(103,30,47,0.18)] transition-all duration-150 hover:bg-primary-dark hover:shadow-lg active:scale-[0.99]"
          >
            <span id="login-btn-text">Masuk</span>
            <svg id="login-spinner" class="w-4 h-4 animate-spin hidden" fill="none" viewBox="0 0 24 24">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
            </svg>
          </button>
        </form>
      </div>
    </div>

    <!-- ================= MAIN ADMIN APP ================= -->
    <div id="admin-dashboard" class="hidden flex-1 flex flex-col">

      <!-- Admin Navbar -->
      <nav class="admin-nav sticky top-0 z-30 border-b border-slate-200/80 bg-white/95 shadow-[0_4px_18px_rgba(30,41,59,0.04)] backdrop-blur">
        <!-- Row 1: Brand + User Actions -->
        <div class="mx-auto flex h-16 max-w-7xl items-center justify-between px-3 sm:px-6">
          <span class="flex min-w-0 items-center gap-2.5 font-bold tracking-tight text-slate-900 sm:gap-3">
            <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-gradient-to-br from-[#671e2f] to-[#893144] font-serif text-base font-bold text-white shadow-sm ring-1 ring-[#671e2f]/10">Z</span>
            <span class="min-w-0">
              <span class="block truncate text-sm sm:text-base">Zaloma Florist</span>
              <span class="mt-0.5 hidden text-[0.6rem] font-bold uppercase tracking-[0.18em] text-slate-400 sm:block">Admin Workspace</span>
            </span>
          </span>

          <div class="flex shrink-0 items-center gap-1 sm:gap-3">
            <a href={withBase('/katalog/')} target="_blank" rel="noopener noreferrer" class="inline-flex min-h-10 items-center gap-1 rounded-lg px-2 text-xs font-semibold text-slate-500 transition-colors hover:bg-slate-50 hover:text-primary sm:px-3">
              <span class="hidden sm:inline">Lihat Website</span>
              <span class="sm:hidden">Website</span>
              <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7-7 7M21 12H3" /></svg>
            </a>
            <span id="user-email-display" class="text-xs text-slate-400 hidden md:inline-block max-w-[180px] truncate"></span>
            <button id="logout-btn" type="button" class="text-sm font-semibold text-rose-600 hover:text-rose-700 hover:bg-rose-50 px-3 py-2.5 rounded-lg transition-colors cursor-pointer flex items-center gap-2 min-h-[44px]">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" /></svg>
              <span class="hidden sm:inline">Keluar</span>
            </button>
          </div>
        </div>

        <!-- Row 2: Tab Navigation (horizontally scrollable on mobile) -->
        <div class="border-t border-slate-100/90 bg-slate-50/60">
          <div class="admin-tabs mx-auto flex max-w-7xl items-center gap-1.5 overflow-x-auto px-3 py-2 scrollbar-hide sm:gap-2 sm:px-6">
            <button type="button" id="tab-btn-catalog" class="tab-btn active flex min-h-11 shrink-0 cursor-pointer items-center gap-2 rounded-xl bg-primary px-3.5 py-2.5 text-sm font-semibold text-white shadow-sm transition-all sm:px-4">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 10h16M4 14h16M4 18h16" /></svg>
              <span>Produk</span>
              <span id="tab-count-badge" class="px-2 py-0.5 rounded-full text-xs font-bold bg-white/20 text-white">0</span>
            </button>
            <button type="button" id="tab-btn-add" class="tab-btn flex min-h-11 shrink-0 cursor-pointer items-center gap-2 rounded-xl px-3.5 py-2.5 text-sm font-semibold text-slate-600 transition-all hover:bg-white hover:text-primary sm:px-4">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" /></svg>
              <span>Tambah Produk</span>
            </button>
            <button type="button" id="tab-btn-categories" class="tab-btn flex min-h-11 shrink-0 cursor-pointer items-center gap-2 rounded-xl px-3.5 py-2.5 text-sm font-semibold text-slate-600 transition-all hover:bg-white hover:text-primary sm:px-4">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h8m-8 6h16" /></svg>
              <span>Kategori</span>
              <span id="tab-cat-badge" class="px-2 py-0.5 rounded-full text-xs font-bold bg-slate-200 text-slate-700">0</span>
            </button>
            <button type="button" id="tab-btn-cities" class="tab-btn flex min-h-11 shrink-0 cursor-pointer items-center gap-2 rounded-xl px-3.5 py-2.5 text-sm font-semibold text-slate-600 transition-all hover:bg-white hover:text-primary sm:px-4">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" /><path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
              <span>Kota</span>
              <span id="tab-city-badge" class="px-2 py-0.5 rounded-full text-xs font-bold bg-slate-200 text-slate-700">0</span>
            </button>
            <button type="button" id="tab-btn-sizes" class="tab-btn flex min-h-11 shrink-0 cursor-pointer items-center gap-2 rounded-xl px-3.5 py-2.5 text-sm font-semibold text-slate-600 transition-all hover:bg-white hover:text-primary sm:px-4">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 6h18M3 12h18M3 18h18" /></svg>
              <span>Ukuran</span>
              <span id="tab-size-badge" class="px-2 py-0.5 rounded-full text-xs font-bold bg-slate-200 text-slate-700">0</span>
            </button>
            <button type="button" id="tab-btn-banners" class="tab-btn flex min-h-11 shrink-0 cursor-pointer items-center gap-2 rounded-xl px-3.5 py-2.5 text-sm font-semibold text-slate-600 transition-all hover:bg-white hover:text-primary sm:px-4">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="16" rx="2" /><path stroke-linecap="round" d="M3 14l5-5 4 4 3-3 6 6" /></svg>
              <span>Banner Promo</span>
              <span id="tab-banner-badge" class="px-2 py-0.5 rounded-full text-xs font-bold bg-slate-200 text-slate-700">0</span>
            </button>
            <button type="button" id="tab-btn-articles" class="tab-btn flex min-h-11 shrink-0 cursor-pointer items-center gap-2 rounded-xl px-3.5 py-2.5 text-sm font-semibold text-slate-600 transition-all hover:bg-white hover:text-primary sm:px-4">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01" /></svg>
              <span>Artikel</span>
              <span id="tab-article-badge" class="px-2 py-0.5 rounded-full text-xs font-bold bg-slate-200 text-slate-700">0</span>
            </button>
          </div>
        </div>
      </nav>

      <!-- Content Area -->
      <main class="admin-main mx-auto w-full max-w-7xl flex-1 space-y-5 px-3 py-5 sm:space-y-6 sm:px-6 sm:py-8">
        <header class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
          <div>
            <p class="mb-1 text-[0.65rem] font-bold uppercase tracking-[0.2em] text-[#8e5f2b]">Ringkasan Toko</p>
            <h1 class="text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">Panel Admin</h1>
            <p class="mt-1 text-sm text-slate-500">Kelola katalog dan informasi toko dari satu tempat.</p>
          </div>
          <div class="inline-flex w-fit items-center gap-2 rounded-full border border-emerald-100 bg-white px-3 py-2 text-xs font-semibold text-slate-600 shadow-sm">
            <span class="relative flex h-2 w-2">
              <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-50"></span>
              <span class="relative inline-flex h-2 w-2 rounded-full bg-emerald-500"></span>
            </span>
            Terhubung ke Supabase
          </div>
        </header>

        <!-- ================= TAB 1: DAFTAR PRODUK ================= -->
        <section id="tab-catalog" class="space-y-4 animate-fade-in">
          
          <!-- Filter & Search Toolbar -->
          <div class="bg-white p-4 rounded-xl border border-slate-200 shadow-sm flex flex-col sm:flex-row gap-3 items-stretch sm:items-center justify-between">
            <div class="relative flex-1">
              <input 
                type="text" 
                id="search-filter-input" 
                placeholder="Cari nama produk..." 
                class="w-full pl-3 pr-10 py-2.5 rounded-lg border border-slate-200 text-sm focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all"
              />
              <button 
                type="button" 
                id="clear-search-btn" 
                class="hidden absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-600 text-sm font-bold cursor-pointer min-w-[24px] min-h-[24px]"
              >
                ✕
              </button>
            </div>

            <div class="flex items-center gap-2 flex-wrap">
              <select 
                id="category-filter-select" 
                class="px-3 py-2.5 rounded-lg border border-slate-200 text-sm bg-white text-slate-700 focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all cursor-pointer min-h-[44px]"
              >
                <option value="all">Semua Kategori</option>
                <option value="bunga-papan">Bunga Papan</option>
                <option value="bunga-papan-semi-styrofoam">Bunga Papan Semi Styrofoam</option>
                <option value="bouquet">Bouquet</option>
                <option value="standing-flower">Standing Flower</option>
                <option value="bunga-meja">Bunga Meja</option>
                <option value="tabulampot">Tabulampot</option>
                <option value="paper-flower">Paper Flower</option>
              </select>

              <select 
                id="subcategory-filter-select" 
                class="hidden px-3 py-2.5 rounded-lg border border-slate-200 text-sm bg-white text-slate-700 focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all cursor-pointer animate-fade-in min-h-[44px]"
              >
                <option value="all">Semua Subkategori</option>
              </select>

              <select 
                id="sort-select" 
                class="px-3 py-2.5 rounded-lg border border-slate-200 text-sm bg-white text-slate-700 focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all cursor-pointer min-h-[44px]"
              >
                <option value="newest">Terbaru</option>
                <option value="price-asc">Harga Terendah</option>
                <option value="price-desc">Harga Tertinggi</option>
                <option value="name-asc">Nama A-Z</option>
              </select>

              <button 
                type="button" 
                id="refresh-btn" 
                title="Muat ulang data" 
                class="px-3 py-2.5 rounded-lg border border-slate-200 text-slate-600 hover:text-primary hover:border-primary/40 hover:bg-accent-bg/40 text-sm font-semibold transition-all cursor-pointer active:scale-95 min-h-[44px]"
              >
                Muat Ulang
              </button>
            </div>
          </div>

          <!-- Products Grid -->
          <div id="catalog-products-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-3.5">
            <div class="col-span-full py-16 text-center text-slate-400 text-xs">
              <svg class="w-6 h-6 animate-spin mx-auto text-slate-400 mb-2" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
              </svg>
              Memuat data produk...
            </div>
          </div>

          <!-- Pagination Container -->
          <div id="admin-pagination-container" class="bg-white p-4 rounded-xl border border-slate-200 flex flex-col sm:flex-row items-center justify-between gap-3 text-sm shadow-sm">
            <p id="admin-pag-info" class="text-slate-500 font-medium">
              Menampilkan <span id="admin-pag-start" class="font-bold text-slate-800">0</span> - <span id="admin-pag-end" class="font-bold text-slate-800">0</span> dari <span id="admin-pag-total" class="font-bold text-slate-800">0</span> produk
            </p>
            <div class="flex items-center gap-1.5" id="admin-pag-controls"></div>
          </div>
        </section>

        <!-- ================= TAB 2: TAMBAH PRODUK ================= -->
        <section id="tab-add" class="hidden animate-fade-in max-w-2xl mx-auto">
          <div class="bg-white rounded-2xl p-5 sm:p-6 border border-slate-200 shadow-sm">
            <div class="mb-6 pb-4 border-b border-slate-100 flex items-center justify-between">
              <div>
                <h2 class="text-lg font-bold text-slate-900 flex items-center gap-2.5 mb-1">
                  <span class="w-2.5 h-2.5 rounded-full bg-primary"></span>
                  Tambah Produk Baru
                </h2>
                <p class="text-sm text-slate-500">Produk akan langsung tampil di website.</p>
              </div>
              <span class="text-xs font-semibold px-3 py-1.5 rounded-full bg-accent-bg text-primary border border-soft-cream">
                Instant Cloud
              </span>
            </div>

            <form id="add-product-form" class="space-y-5">
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                
                <div class="sm:col-span-2">
                  <label for="prod-name" class="block text-sm font-semibold text-slate-700 mb-2">
                    Nama Produk <span class="text-rose-500">*</span>
                  </label>
                  <input 
                    type="text" 
                    id="prod-name" 
                    required 
                    placeholder="Contoh: Bunga Papan Wedding 2x1.5m"
                    class="w-full px-4 py-3 rounded-lg border border-slate-300 text-sm focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all"
                  />
                </div>

                <div>
                  <label for="prod-category" class="block text-sm font-semibold text-slate-700 mb-2">
                    Kategori <span class="text-rose-500">*</span>
                  </label>
                  <select 
                    id="prod-category" 
                    required
                    class="w-full px-4 py-3 rounded-lg border border-slate-300 text-sm focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all bg-white cursor-pointer"
                  >
                    <option value="" disabled selected>Pilih Kategori...</option>
                    <option value="bunga-papan" data-name="Bunga Papan">Bunga Papan</option>
                    <option value="bunga-papan-semi-styrofoam" data-name="Bunga Papan Semi Styrofoam">Bunga Papan Semi Styrofoam</option>
                    <option value="bouquet" data-name="Bouquet">Bouquet</option>
                    <option value="standing-flower" data-name="Standing Flower">Standing Flower</option>
                    <option value="bunga-meja" data-name="Bunga Meja">Bunga Meja</option>
                    <option value="tabulampot" data-name="Tabulampot">Tabulampot</option>
                    <option value="paper-flower" data-name="Paper Flower">Paper Flower</option>
                  </select>
                </div>

                <div id="prod-subcategory-wrapper" class="hidden animate-fade-in">
                  <label for="prod-subcategory" class="block text-sm font-semibold text-slate-700 mb-2">
                    Subkategori <span class="text-slate-400 font-normal">(Opsional)</span>
                  </label>
                  <select 
                    id="prod-subcategory" 
                    class="w-full px-4 py-3 rounded-lg border border-slate-300 text-sm focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all bg-white cursor-pointer"
                  >
                    <option value="">Pilih Subkategori...</option>
                  </select>
                </div>

                <div>
                  <label for="prod-price" class="block text-sm font-semibold text-slate-700 mb-2">
                    Harga (Rp) <span class="text-rose-500">*</span>
                  </label>
                  <input 
                    type="number" 
                    id="prod-price" 
                    required 
                    min="10000" 
                    step="5000"
                    placeholder="450000"
                    class="w-full px-4 py-3 rounded-lg border border-slate-300 text-sm font-mono focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all"
                  />
                  <p id="price-preview" class="text-xs font-bold text-primary mt-1.5">Rp 0</p>
                </div>

                <div>
                  <label for="prod-time" class="block text-sm font-semibold text-slate-700 mb-2">
                    Estimasi Pengerjaan
                  </label>
                  <input 
                    type="text" 
                    id="prod-time" 
                    value="3 - 5 Jam" 
                    placeholder="Contoh: 3 - 5 Jam"
                    class="w-full px-4 py-3 rounded-lg border border-slate-300 text-sm focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all"
                  />
                </div>

                <div>
                  <div class="flex items-center justify-between mb-2">
                    <label for="prod-city" class="block text-sm font-semibold text-slate-700">
                      Wilayah / Area Pengiriman <span class="text-rose-500">*</span>
                    </label>
                    <div class="flex items-center gap-2">
                      <button type="button" id="quick-add-city-btn" class="text-xs text-primary hover:text-primary-dark font-semibold cursor-pointer">
                        + Tambah Kota
                      </button>
                      <span class="text-slate-300">|</span>
                      <button type="button" id="quick-manage-city-btn" class="text-xs text-slate-500 hover:text-slate-700 font-medium cursor-pointer">
                        ⚙️ Kelola
                      </button>
                    </div>
                  </div>
                  <select 
                    id="prod-city" 
                    required
