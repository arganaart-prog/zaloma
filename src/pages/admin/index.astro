    <div id="image-crop-modal" class="hidden fixed inset-0 z-[70] bg-slate-950/75 backdrop-blur-sm flex items-center justify-center p-3 sm:p-6">
      <div class="w-full max-w-3xl rounded-2xl bg-white p-4 shadow-2xl sm:p-6">
        <div class="mb-4 flex items-start justify-between gap-4">
