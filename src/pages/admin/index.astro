      cityForm?.addEventListener('submit', async (e) => {
        e.preventDefault();
        const saveBtn = document.getElementById('save-city-btn');
        const saveBtnText = document.getElementById('save-city-btn-text');
        const saveSpinner = document.getElementById('save-city-spinner');

        const editIdx = Number(document.getElementById('city-edit-index').value);
        const provinceOption = cityProvinceSelect?.selectedOptions?.[0];
        const selectedProvinceName = provinceOption?.getAttribute('data-name') || provinceOption?.textContent?.trim() || '';
