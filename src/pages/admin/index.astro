      // Sizes UI Rendering in Tab 5
      let currentSizeFilterCat = 'all';

      function renderSizesCards(filterCat = 'all') {
        currentSizeFilterCat = filterCat;
        const grid = document.getElementById('sizes-cards-grid');
        const chipsContainer = document.getElementById('sizes-category-filter-chips');
        if (!grid) return;

        // Combine all categories so ALL categories are always available in the filter
        const allCategorySlugs = new Set();
        (categoriesList || []).forEach(c => c && c.slug && allCategorySlugs.add(c.slug));
        (DEFAULT_CATEGORIES || []).forEach(c => c && c.slug && allCategorySlugs.add(c.slug));
        (sizesList || []).forEach(s => s && s.category_slug && allCategorySlugs.add(s.category_slug));

        const uniqueCats = ['all', ...allCategorySlugs];

        // Populate Category Filter Chips
        if (chipsContainer) {
          chipsContainer.innerHTML = uniqueCats.map(catSlug => {
            const isActive = catSlug === currentSizeFilterCat;
            let label = 'Semua Kategori';
            if (catSlug !== 'all') {
              const catObj = (categoriesList || []).find(c => c.slug === catSlug) || (DEFAULT_CATEGORIES || []).find(c => c.slug === catSlug);
              label = catObj ? catObj.name : catSlug;
            }
            const count = catSlug === 'all' ? sizesList.length : sizesList.filter(s => s.category_slug === catSlug).length;

            return `
              <button 
                type="button" 
                data-cat="${catSlug}" 
                class="size-filter-chip px-3 py-1 rounded-full text-xs font-semibold whitespace-nowrap transition-all cursor-pointer ${
                  isActive 
                    ? 'bg-primary text-white shadow-xs' 
                    : 'bg-white text-slate-600 border border-slate-200 hover:border-slate-300 hover:bg-slate-50'
                }"
              >
                ${label} <span class="${isActive ? 'bg-white/20 text-white' : 'bg-slate-100 text-slate-600'} px-1.5 py-0.2 rounded-full text-[10px] ml-1">${count}</span>
              </button>
            `;
          }).join('');

          chipsContainer.querySelectorAll('.size-filter-chip').forEach(btn => {
            btn.addEventListener('click', () => {
              const cat = btn.getAttribute('data-cat');
              renderSizesCards(cat);
            });
          });

          // Enable mouse wheel horizontal scrolling
          if (!chipsContainer.dataset.wheelBound) {
            chipsContainer.dataset.wheelBound = 'true';
            chipsContainer.addEventListener('wheel', (e) => {
              if (e.deltaY !== 0) {
                e.preventDefault();
                chipsContainer.scrollLeft += e.deltaY;
              }
            }, { passive: false });

            // Enable desktop mouse drag-to-scroll
            let isDown = false;
            let startX = 0;
            let scrollLeftPos = 0;

            chipsContainer.addEventListener('mousedown', (e) => {
              isDown = true;
              startX = e.pageX - chipsContainer.offsetLeft;
              scrollLeftPos = chipsContainer.scrollLeft;
            });
            window.addEventListener('mouseup', () => {
              isDown = false;
            });
            chipsContainer.addEventListener('mousemove', (e) => {
              if (!isDown) return;
              e.preventDefault();
              const x = e.pageX - chipsContainer.offsetLeft;
              const walk = (x - startX) * 1.5;
              chipsContainer.scrollLeft = scrollLeftPos - walk;
            });
          }
        }

        // Wire up scroll buttons
        const scrollLeftBtn = document.getElementById('sizes-chip-scroll-left');
        const scrollRightBtn = document.getElementById('sizes-chip-scroll-right');
        if (scrollLeftBtn) scrollLeftBtn.onclick = () => chipsContainer?.scrollBy({ left: -220, behavior: 'smooth' });
        if (scrollRightBtn) scrollRightBtn.onclick = () => chipsContainer?.scrollBy({ left: 220, behavior: 'smooth' });

        // Populate and sync dropdown selector
        const selectEl = document.getElementById('sizes-category-filter-select');
        if (selectEl) {
          selectEl.innerHTML = uniqueCats.map(catSlug => {
            let label = 'Semua Kategori';
            if (catSlug !== 'all') {
              const catObj = (categoriesList || []).find(c => c.slug === catSlug) || (DEFAULT_CATEGORIES || []).find(c => c.slug === catSlug);
              label = catObj ? catObj.name : catSlug;
            }
            const count = catSlug === 'all' ? sizesList.length : sizesList.filter(s => s.category_slug === catSlug).length;
            const isSel = catSlug === currentSizeFilterCat ? 'selected' : '';
            return `<option value="${catSlug}" ${isSel}>${label} (${count})</option>`;
          }).join('');

          selectEl.onchange = () => {
            renderSizesCards(selectEl.value);
          };
        }

        // Filter sizes
        const filtered = currentSizeFilterCat === 'all'
          ? sizesList
          : sizesList.filter(s => s.category_slug === currentSizeFilterCat);

        if (filtered.length === 0) {
          const currentCatObj = (categoriesList || []).find(c => c.slug === currentSizeFilterCat) || (DEFAULT_CATEGORIES || []).find(c => c.slug === currentSizeFilterCat);
          const currentCatName = currentCatObj ? currentCatObj.name : currentSizeFilterCat;
          grid.innerHTML = `
            <div class="col-span-full py-12 text-center text-slate-500 bg-white rounded-xl border border-dashed border-slate-200 p-6 text-xs space-y-2">
              <p>Belum ada ukuran khusus untuk kategori <strong>"${currentCatName}"</strong>.</p>
              <button type="button" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-primary hover:bg-primary-dark text-white font-semibold text-xs cursor-pointer shadow-xs" onclick="document.getElementById('open-add-size-btn')?.click()">
                + Tambah Ukuran untuk ${currentCatName}
              </button>
            </div>
          `;
          return;
        }

        grid.innerHTML = filtered.map(s => {
          const catObj = categoriesList.find(c => c.slug === s.category_slug);
          const catName = catObj ? catObj.name : s.category_slug;
          const isPapan = s.category_slug.includes('papan') || Boolean(s.width && s.height);

          return `
            <div class="bg-white rounded-xl p-3.5 border border-slate-200 shadow-2xs hover:border-slate-300 transition-all flex flex-col justify-between group">
              <div>
                <div class="flex items-center justify-between gap-1 mb-1.5">
                  <span class="text-[10px] font-semibold text-rose-700 bg-rose-50 border border-rose-100 px-2 py-0.5 rounded-md truncate max-w-[160px]">
                    ${catName}
                  </span>
                  ${isPapan && s.width && s.height ? `
                    <span class="text-[10px] font-mono font-bold text-slate-500 bg-slate-100 px-1.5 py-0.5 rounded">
                      📐 ${s.width}m × ${s.height}m
                    </span>
                  ` : ''}
                </div>

                <h4 class="font-bold text-slate-900 text-sm leading-snug flex items-center gap-1.5">
                  <span class="text-emerald-600">📏</span>
                  <span>${s.name}</span>
                </h4>

                ${s.description ? `
                  <p class="text-[11px] text-slate-500 mt-1 leading-relaxed">${s.description}</p>
                ` : `
                  <p class="text-[10px] text-slate-400 mt-1 italic">Tersedia saat memilih kategori ini</p>
                `}
              </div>

              <div class="pt-2.5 mt-2.5 border-t border-slate-100 flex items-center justify-end gap-1 text-[11px]">
                <button type="button" data-id="${s.id}" class="edit-size-btn px-2 py-0.5 rounded text-slate-600 hover:text-primary hover:bg-slate-100 font-medium cursor-pointer transition-colors">
                  Edit
                </button>
                <button type="button" data-id="${s.id}" class="delete-size-btn px-2 py-0.5 rounded text-rose-600 hover:text-rose-700 hover:bg-rose-50 font-medium cursor-pointer transition-colors">
                  Hapus
                </button>
              </div>
            </div>
          `;
        }).join('');

        // Attach action listeners for sizes
        grid.querySelectorAll('.edit-size-btn').forEach(btn => {
          btn.addEventListener('click', () => {
            const id = btn.getAttribute('data-id');
            const s = sizesList.find(x => x.id === id);
            if (!s) return;
            openSizeModalForEdit(s);
          });
        });

        grid.querySelectorAll('.delete-size-btn').forEach(btn => {
          btn.addEventListener('click', async () => {
            const id = btn.getAttribute('data-id');
            const s = sizesList.find(x => x.id === id);
            if (!s) return;

            if (confirm(`Hapus ukuran "${s.name}"?`)) {
              sizesList = sizesList.filter(x => x.id !== id);
              await persistSizes();
              showToast(`Ukuran "${s.name}" berhasil dihapus.`);
            }
          });
        });
      }

      // Size Modal Logic
      const sizeModal = document.getElementById('size-modal');
      const openAddSizeBtn = document.getElementById('open-add-size-btn');
      const closeSizeModalBtn = document.getElementById('close-size-modal-btn');
      const cancelSizeBtn = document.getElementById('cancel-size-btn');
      const sizeForm = document.getElementById('size-form');
      const sizeCategorySelect = document.getElementById('size-category-select');
      const sizePapanFields = document.getElementById('size-papan-fields');
      const sizeGeneralFields = document.getElementById('size-general-fields');
      const sizeWidthInput = document.getElementById('size-width-input');
      const sizeHeightInput = document.getElementById('size-height-input');
      const sizeLabelPapanInput = document.getElementById('size-label-papan-input');
      const sizePapanPreview = document.getElementById('size-papan-preview');
      const sizeNameInput = document.getElementById('size-name-input');
      const sizeDescInput = document.getElementById('size-desc-input');
      const sizeHintText = document.getElementById('size-hint-text');

      function populateSizeCategoryOptions(selectedSlug = '') {
        if (!sizeCategorySelect) return;
        const combinedCats = [];
        const seenSlugs = new Set();
        (categoriesList || []).forEach(c => {
          if (c && c.slug && !seenSlugs.has(c.slug)) {
            seenSlugs.add(c.slug);
            combinedCats.push(c);
          }
        });
        (DEFAULT_CATEGORIES || []).forEach(c => {
          if (c && c.slug && !seenSlugs.has(c.slug)) {
            seenSlugs.add(c.slug);
            combinedCats.push(c);
          }
        });

        sizeCategorySelect.innerHTML = '<option value="" disabled selected>-- Pilih Kategori Produk --</option>' +
          combinedCats.map(c => `<option value="${c.slug}">${c.name}</option>`).join('');

        if (selectedSlug && seenSlugs.has(selectedSlug)) {
          sizeCategorySelect.value = selectedSlug;
        } else if (combinedCats.length > 0) {
          sizeCategorySelect.value = combinedCats[0].slug;
        }
        syncCustomDropdown('size-category-select');
      }

      function updatePapanPreview() {
        const w = (sizeWidthInput?.value || '2').trim();
        const h = (sizeHeightInput?.value || '1.2').trim();
        const formatted = `${w} x ${h} m`;
        if (sizePapanPreview) sizePapanPreview.textContent = formatted;
        if (sizeLabelPapanInput && (!sizeLabelPapanInput.dataset.customized || sizeLabelPapanInput.value.includes(' x '))) {
          sizeLabelPapanInput.value = formatted;
        }
      }

      sizeWidthInput?.addEventListener('input', updatePapanPreview);
      sizeHeightInput?.addEventListener('input', updatePapanPreview);
      sizeLabelPapanInput?.addEventListener('input', () => {
        if (sizeLabelPapanInput) sizeLabelPapanInput.dataset.customized = 'true';
      });

      function handleSizeCategoryChange() {
        const selectedCatSlug = sizeCategorySelect.value;
        const isPapan = selectedCatSlug.includes('papan');

        if (isPapan) {
          sizePapanFields?.classList.remove('hidden');
          sizeGeneralFields?.classList.add('hidden');
          updatePapanPreview();
        } else {
          sizePapanFields?.classList.add('hidden');
          sizeGeneralFields?.classList.remove('hidden');

          if (selectedCatSlug === 'bouquet') {
            if (sizeHintText) sizeHintText.textContent = 'Contoh: Small (5-7 Tangkai), Medium (10-15 Tangkai), Jumbo (50 Tangkai).';
            if (sizeNameInput && !sizeNameInput.value) sizeNameInput.placeholder = 'Contoh: Medium (10 - 15 Tangkai)';
          } else if (selectedCatSlug === 'standing-flower') {
            if (sizeHintText) sizeHintText.textContent = 'Contoh: 1 Tingkat (Tinggi ± 1.2 m), 2 Tingkat (Tinggi ± 1.7 m).';
            if (sizeNameInput && !sizeNameInput.value) sizeNameInput.placeholder = 'Contoh: 2 Tingkat (Tinggi ± 1.5 - 1.7 m)';
          } else if (selectedCatSlug === 'bunga-meja') {
            if (sizeHintText) sizeHintText.textContent = 'Contoh: Mini (Vas 15-20 cm), Medium (Vas 25-30 cm), Rangkaian Mewah.';
            if (sizeNameInput && !sizeNameInput.value) sizeNameInput.placeholder = 'Contoh: Medium (Vas 25 - 30 cm)';
          } else if (selectedCatSlug === 'tabulampot') {
            if (sizeHintText) sizeHintText.textContent = 'Contoh: Pot Diameter 35 cm, Tinggi 100 cm.';
            if (sizeNameInput && !sizeNameInput.value) sizeNameInput.placeholder = 'Contoh: Pot Sedang (Diameter 35 - 45 cm)';
          } else {
            if (sizeHintText) sizeHintText.textContent = 'Masukkan ukuran, dimensi, atau spesifikasi rangkaian produk.';
            if (sizeNameInput && !sizeNameInput.value) sizeNameInput.placeholder = 'Contoh: Ukuran Standar';
          }
        }
      }

      sizeCategorySelect?.addEventListener('change', handleSizeCategoryChange);
      sizeCategorySelect?.addEventListener('input', handleSizeCategoryChange);

      function openAddSizeModal(targetCat = '') {
        document.getElementById('size-edit-id').value = '';
        document.getElementById('size-modal-title').innerHTML = '<span class="w-2 h-2 rounded-full bg-primary"></span> Tambah Ukuran Produk';
        sizeForm.reset();
        if (sizeLabelPapanInput) delete sizeLabelPapanInput.dataset.customized;

        const initialCat = targetCat || (currentSizeFilterCat !== 'all' ? currentSizeFilterCat : (categoriesList[0]?.slug || 'bunga-papan'));
        populateSizeCategoryOptions(initialCat);
        if (initialCat) {
          sizeCategorySelect.value = initialCat;
          handleSizeCategoryChange();
        }

        sizeModal.classList.remove('hidden');
      }

      openAddSizeBtn?.addEventListener('click', () => {
        openAddSizeModal();
      });

      function openSizeModalForEdit(s) {
        document.getElementById('size-edit-id').value = s.id;
        document.getElementById('size-modal-title').innerHTML = '<span class="w-2 h-2 rounded-full bg-primary"></span> Edit Ukuran Produk';
        populateSizeCategoryOptions(s.category_slug);
        sizeCategorySelect.value = s.category_slug;
        handleSizeCategoryChange();

        const isPapan = s.category_slug.includes('papan') || Boolean(s.width && s.height);
        if (isPapan) {
          if (sizeWidthInput) sizeWidthInput.value = s.width || '2';
          if (sizeHeightInput) sizeHeightInput.value = s.height || '1.2';
          if (sizeLabelPapanInput) {
            sizeLabelPapanInput.value = s.name;
            sizeLabelPapanInput.dataset.customized = 'true';
          }
          if (sizePapanPreview) sizePapanPreview.textContent = `${s.width || '2'} x ${s.height || '1.2'} m`;
        } else {
          if (sizeNameInput) sizeNameInput.value = s.name;
        }

        if (sizeDescInput) sizeDescInput.value = s.description || '';
        sizeModal.classList.remove('hidden');
      }

      closeSizeModalBtn?.addEventListener('click', () => sizeModal.classList.add('hidden'));
      cancelSizeBtn?.addEventListener('click', () => sizeModal.classList.add('hidden'));

      sizeForm?.addEventListener('submit', async (e) => {
        e.preventDefault();
        const editId = document.getElementById('size-edit-id').value;
        const catSlug = sizeCategorySelect.value;
        if (!catSlug) {
          showToast('Pilih kategori terlebih dahulu.', 'error');
          return;
        }

        const isPapan = catSlug.includes('papan');
        let sizeName = '';
        let widthVal = '';
        let heightVal = '';

        if (isPapan) {
          widthVal = (sizeWidthInput?.value || '').trim();
          heightVal = (sizeHeightInput?.value || '').trim();
          if (!widthVal || !heightVal) {
            showToast('Lebar dan Tinggi harus diisi.', 'error');
            return;
          }
          sizeName = (sizeLabelPapanInput?.value || '').trim() || `${widthVal} x ${heightVal} m`;
        } else {
          sizeName = (sizeNameInput?.value || '').trim();
          if (!sizeName) {
            showToast('Nama ukuran harus diisi.', 'error');
            return;
          }
        }

        const descVal = (sizeDescInput?.value || '').trim();

        if (editId) {
          const idx = sizesList.findIndex(x => x.id === editId);
          if (idx !== -1) {
            sizesList[idx] = {
              ...sizesList[idx],
              category_slug: catSlug,
              name: sizeName,
              width: widthVal || undefined,
              height: heightVal || undefined,
              description: descVal
            };
            showToast(`Ukuran "${sizeName}" berhasil diperbarui.`);
          }
        } else {
          const newId = `size-${Date.now()}`;
          sizesList.push({
            id: newId,
            category_slug: catSlug,
            name: sizeName,
            width: widthVal || undefined,
            height: heightVal || undefined,
            description: descVal
          });
          showToast(`Ukuran "${sizeName}" berhasil ditambahkan.`);
        }

        sizeModal.classList.add('hidden');
        await persistSizes();

        // Automatically select newly created size in active form
        const prodSizeSelectEl = document.getElementById('prod-size');
        if (prodSizeSelectEl) prodSizeSelectEl.value = sizeName;
        const editSizeSelectEl = document.getElementById('edit-prod-size');
        if (editSizeSelectEl && !document.getElementById('edit-modal')?.classList.contains('hidden')) {
          editSizeSelectEl.value = sizeName;
        }
      });

      // Initial sizes setup
      updateSizeBadges();
      renderSizesCards();
      updateSizeDropdowns();

      // Live Price Preview Formatting
      const priceInput = document.getElementById('prod-price');
      const pricePreview = document.getElementById('price-preview');
      priceInput.addEventListener('input', () => {
        const val = Number(priceInput.value) || 0;
        pricePreview.textContent = new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', maximumFractionDigits: 0 }).format(val);
      });

      const editPriceInput = document.getElementById('edit-prod-price');
      const editPricePreview = document.getElementById('edit-price-preview');
      editPriceInput?.addEventListener('input', () => {
        const val = Number(editPriceInput.value) || 0;
        editPricePreview.textContent = new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', maximumFractionDigits: 0 }).format(val);
      });

      // Add Photo File Input Handler
      const imageFileInput = document.getElementById('prod-image-file');
      const previewContainer = document.getElementById('image-preview-container');
      const imagePreviewGallery = document.getElementById('image-preview-gallery');
      const uploadPrompt = document.getElementById('upload-prompt');
      const origSizeLabel = document.getElementById('orig-size-label');
      const compSizeLabel = document.getElementById('comp-size-label');
      const addProductShapeInput = document.getElementById('prod-card-shape');
      const addHoverPreviewEnabled = document.getElementById('prod-hover-preview-enabled');
      const addHoverPreviewIndex = document.getElementById('prod-hover-preview-index');
      let addGalleryItems = [];
      let lastProductShape = addProductShapeInput.value;

      function updateHoverPreviewControls(checkbox, select, imageCount, selectedIndex = '') {
        const availableIndexes = Array.from({ length: Math.max(0, Math.min(3, imageCount) - 1) }, (_, index) => index + 2);
        select.replaceChildren(...availableIndexes.map((index) => {
          const option = document.createElement('option');
          option.value = String(index);
          option.textContent = `Foto ${index}`;
          return option;
        }));
        checkbox.disabled = availableIndexes.length === 0;
        if (checkbox.disabled) checkbox.checked = false;
        select.disabled = checkbox.disabled || !checkbox.checked;
        if (availableIndexes.includes(Number(selectedIndex))) {
          select.value = String(selectedIndex);
        } else if (availableIndexes.length > 0) {
          select.value = String(availableIndexes[0]);
        }
      }

      function renderGalleryItems(container, items, canRemove = false) {
        container.replaceChildren(...items.map((item, index) => {
          const wrapper = document.createElement('div');
          wrapper.className = 'relative overflow-hidden rounded-lg border border-slate-200 bg-white';
          const image = document.createElement('img');
          image.src = item.previewUrl || item.url;
          image.alt = `Foto produk ${index + 1}`;
          image.className = 'aspect-square w-full object-cover';
          wrapper.append(image);

          const label = document.createElement('span');
          label.className = 'block truncate px-1.5 py-1 text-center text-[10px] font-semibold text-slate-600';
          label.textContent = index === 0 ? 'Foto utama' : `Foto ${index + 1}`;
          wrapper.append(label);

          if (canRemove) {
            const removeButton = document.createElement('button');
            removeButton.type = 'button';
            removeButton.dataset.galleryRemove = String(index);
            removeButton.setAttribute('aria-label', `Hapus foto ${index + 1}`);
            removeButton.className = 'absolute right-1 top-1 flex h-6 w-6 items-center justify-center rounded-full bg-white/95 text-sm font-bold text-rose-600 shadow';
            removeButton.textContent = '×';
            wrapper.append(removeButton);
          }
          return wrapper;
        }));
      }

      function revokeGalleryPreviews(items) {
        items.forEach((item) => {
          if (item.previewUrl?.startsWith('blob:')) URL.revokeObjectURL(item.previewUrl);
        });
      }

      function updateAddGalleryPreview() {
        renderGalleryItems(imagePreviewGallery, addGalleryItems, true);
        const hasImages = addGalleryItems.length > 0;
        uploadPrompt.classList.toggle('hidden', hasImages);
        previewContainer.classList.toggle('hidden', !hasImages);
        origSizeLabel.textContent = `${(addGalleryItems.reduce((sum, item) => sum + item.sourceFile.size, 0) / 1024).toFixed(0)} KB`;
        compSizeLabel.textContent = `${(addGalleryItems.reduce((sum, item) => sum + item.blob.size, 0) / 1024).toFixed(0)} KB total (WebP)`;
        updateHoverPreviewControls(addHoverPreviewEnabled, addHoverPreviewIndex, addGalleryItems.length, addHoverPreviewIndex.value);
      }

      imagePreviewGallery.addEventListener('click', (event) => {
        const button = event.target.closest('[data-gallery-remove]');
        if (!button) return;
        const index = Number(button.dataset.galleryRemove);
        const [removed] = addGalleryItems.splice(index, 1);
        if (removed?.previewUrl) URL.revokeObjectURL(removed.previewUrl);
        updateAddGalleryPreview();
      });

      addHoverPreviewEnabled.addEventListener('change', () => {
        addHoverPreviewIndex.disabled = !addHoverPreviewEnabled.checked;
      });

      async function cropProductImage(file, shape, isEdit = false) {
        return openImageCrop(file, {
          aspect: shape === 'square' ? 1 : 4 / 5,
          title: `Atur area foto produk${isEdit ? ' (edit)' : ''}`,
          maxDimension: 1200,
        });
      }

      imageFileInput.addEventListener('change', async (e) => {
        const files = Array.from(e.target.files || []);
        if (!files.length) return;
        if (files.length > 3) {
          showToast('Pilih maksimal 3 foto produk.', 'error');
          imageFileInput.value = '';
          return;
        }

        try {
          const nextItems = [];
          for (const file of files) {
            const blob = await cropProductImage(file, addProductShapeInput.value);
            if (!blob) {
              revokeGalleryPreviews(nextItems);
              imageFileInput.value = '';
              return;
            }
            nextItems.push({ sourceFile: file, blob, previewUrl: URL.createObjectURL(blob) });
          }
          revokeGalleryPreviews(addGalleryItems);
          addGalleryItems = nextItems;
          updateAddGalleryPreview();
          lastProductShape = addProductShapeInput.value;
        } catch (err) {
          showToast(err.message || 'Gagal memproses gambar.', 'error');
        } finally {
          imageFileInput.value = '';
        }
      });

      addProductShapeInput.addEventListener('change', async () => {
        if (addGalleryItems.length === 0) {
          lastProductShape = addProductShapeInput.value;
          return;
        }
        try {
          const nextItems = [];
          for (const item of addGalleryItems) {
            const blob = await cropProductImage(item.sourceFile, addProductShapeInput.value);
            if (!blob) {
              addProductShapeInput.value = lastProductShape;
              revokeGalleryPreviews(nextItems);
              return;
            }
            nextItems.push({ sourceFile: item.sourceFile, blob, previewUrl: URL.createObjectURL(blob) });
          }
          revokeGalleryPreviews(addGalleryItems);
          addGalleryItems = nextItems;
          updateAddGalleryPreview();
          lastProductShape = addProductShapeInput.value;
        } catch (err) {
          addProductShapeInput.value = lastProductShape;
          showToast(err.message || 'Gagal memperbarui potongan foto.', 'error');
        }
      });

      // Edit Photo File Input Handler
      const editImageFileInput = document.getElementById('edit-prod-image-file');
      const editProductGallery = document.getElementById('edit-product-gallery');
      const editImageNote = document.getElementById('edit-image-note');
      const editProductShapeInput = document.getElementById('edit-prod-card-shape');
      const editHoverPreviewEnabled = document.getElementById('edit-hover-preview-enabled');
      const editHoverPreviewIndex = document.getElementById('edit-hover-preview-index');
      let editGalleryItems = [];
      let lastEditProductShape = editProductShapeInput.value;

      function updateEditGallery(selectedIndex = editHoverPreviewIndex.value) {
        renderGalleryItems(editProductGallery, editGalleryItems, true);
        updateHoverPreviewControls(editHoverPreviewEnabled, editHoverPreviewIndex, editGalleryItems.length, selectedIndex);
        editImageNote.textContent = `${editGalleryItems.length}/3 foto. Hapus foto untuk mengganti urutan foto utama.`;
      }

      editProductGallery.addEventListener('click', (event) => {
        const button = event.target.closest('[data-gallery-remove]');
        if (!button) return;
        const index = Number(button.dataset.galleryRemove);
        if (editGalleryItems.length <= 1) {
          showToast('Produk harus memiliki minimal satu foto.', 'error');
          return;
        }
        const [removed] = editGalleryItems.splice(index, 1);
        if (removed.previewUrl?.startsWith('blob:')) URL.revokeObjectURL(removed.previewUrl);
        updateEditGallery();
      });

      editHoverPreviewEnabled.addEventListener('change', () => {
        editHoverPreviewIndex.disabled = !editHoverPreviewEnabled.checked;
      });

      editImageFileInput?.addEventListener('change', async (e) => {
        const files = Array.from(e.target.files || []);
        if (!files.length) return;
        if (editGalleryItems.length + files.length > 3) {
          showToast(`Produk maksimal memiliki 3 foto. Slot tersedia: ${3 - editGalleryItems.length}.`, 'error');
          editImageFileInput.value = '';
          return;
        }

        try {
          const nextItems = [];
          for (const file of files) {
            const blob = await cropProductImage(file, editProductShapeInput.value, true);
            if (!blob) {
              revokeGalleryPreviews(nextItems);
              return;
            }
            nextItems.push({ sourceFile: file, blob, previewUrl: URL.createObjectURL(blob) });
          }
          editGalleryItems.push(...nextItems);
          updateEditGallery();
          lastEditProductShape = editProductShapeInput.value;
        } catch (err) {
          showToast(err.message || 'Gagal memproses gambar baru.', 'error');
        } finally {
          editImageFileInput.value = '';
        }
      });

      editProductShapeInput.addEventListener('change', async () => {
        if (!editGalleryItems.some((item) => item.sourceFile)) {
          lastEditProductShape = editProductShapeInput.value;
          return;
        }
        try {
          const nextItems = [];
          for (const item of editGalleryItems) {
            if (!item.sourceFile) {
              nextItems.push(item);
              continue;
            }
            const blob = await cropProductImage(item.sourceFile, editProductShapeInput.value, true);
            if (!blob) {
              editProductShapeInput.value = lastEditProductShape;
              revokeGalleryPreviews(nextItems.filter((nextItem) => nextItem.sourceFile));
              return;
            }
            nextItems.push({ sourceFile: item.sourceFile, blob, previewUrl: URL.createObjectURL(blob) });
          }
          revokeGalleryPreviews(editGalleryItems.filter((item) => item.sourceFile));
          editGalleryItems = nextItems;
          updateEditGallery();
          lastEditProductShape = editProductShapeInput.value;
        } catch (err) {
          editProductShapeInput.value = lastEditProductShape;
          showToast(err.message || 'Gagal memperbarui potongan foto.', 'error');
        }
      });

      // Refresh Button Handler
      const refreshBtn = document.getElementById('refresh-btn');
      refreshBtn?.addEventListener('click', async () => {
        refreshBtn.textContent = 'Memuat...';
        await loadAllProducts();
        refreshBtn.textContent = 'Muat Ulang';
        showToast('Data diperbarui.');
      });

      // Load Products from Supabase
      async function loadAllProducts() {
        const grid = document.getElementById('catalog-products-grid');
        const tabCountBadge = document.getElementById('tab-count-badge');

        try {
          const { data: products, error } = await supabase
            .from('products')
            .select('*')
            .order('created_at', { ascending: false });

          if (error) throw error;

          // Check for categories configuration record
          const configRow = (products || []).find(p => p.slug === '_categories_config_');
          if (configRow && configRow.description) {
            try {
              const cloudCats = JSON.parse(configRow.description);
              if (Array.isArray(cloudCats) && cloudCats.length > 0) {
                const existingSlugs = new Set(cloudCats.map(c => c && c.slug));
                (DEFAULT_CATEGORIES || []).forEach(dc => {
                  if (!existingSlugs.has(dc.slug)) cloudCats.push(dc);
                });
                categoriesList = cloudCats;
                localStorage.setItem('zaloma_admin_categories_v4', JSON.stringify(categoriesList));
                updateCategoryDropdowns();
                renderCategoriesCards();
                updateCategoryBadges();
              } else if (categoriesList.length > 0) {
                persistCategories();
              }
            } catch (e) {}
          } else if (categoriesList.length > 0) {
            persistCategories();
          }

          // Check for cities configuration record
          const citiesConfigRow = (products || []).find(p => p.slug === '_cities_config_');
          if (citiesConfigRow && citiesConfigRow.description) {
            try {
              const cloudCities = JSON.parse(citiesConfigRow.description);
              if (!Array.isArray(cloudCities)) throw new Error('Daftar kota Supabase bukan array.');
              citiesList = cloudCities;
            } catch (err) {
              console.warn('Gagal membaca konfigurasi kota Supabase:', err);
              citiesList = [];
            }
          } else {
            citiesList = [];
          }
          localStorage.setItem('zaloma_admin_cities_v2', JSON.stringify(citiesList));
          localStorage.setItem('zaloma_admin_cities_v1', JSON.stringify(citiesList));
          updateCityDropdowns();
          renderCitiesCards();
          updateCityBadges();

          // Check for sizes configuration record
          const sizesConfigRow = (products || []).find(p => p.slug === '_sizes_config_');
          if (sizesConfigRow && sizesConfigRow.description) {
            try {
              const cloudSizes = JSON.parse(sizesConfigRow.description);
              if (Array.isArray(cloudSizes) && cloudSizes.length > 0) {
                const existingKeys = new Set(cloudSizes.map(s => `${s.category_slug}::${s.name}`));
                DEFAULT_SIZES.forEach(ds => {
                  const key = `${ds.category_slug}::${ds.name}`;
                  if (!existingKeys.has(key)) cloudSizes.push(ds);
                });
                sizesList = cloudSizes;
                localStorage.setItem('zaloma_admin_sizes_v2', JSON.stringify(sizesList));
                updateSizeBadges();
                renderSizesCards(currentSizeFilterCat);
                updateSizeDropdowns();
              } else if (sizesList.length > 0) {
                persistSizes();
              }
            } catch (e) {}
          } else if (sizesList.length > 0) {
            persistSizes();
          }

          // Filter out internal system rows
          allProductsList = (products || []).filter(p => !p.slug.startsWith('_'));
          if (tabCountBadge) tabCountBadge.textContent = allProductsList.length;

          renderFilteredCatalog();

        } catch (err) {
          grid.innerHTML = `
            <div class="col-span-full py-12 text-center text-rose-600 bg-rose-50 border border-rose-200 rounded-xl p-4 text-xs">
              Gagal mengambil data dari Supabase: ${err.message}
            </div>
          `;
        }
      }

      // Pagination Settings
      const ADMIN_PER_PAGE = 16;
      let adminCurrentPage = 1;

      // Filter & Search Controls
      const searchInput = document.getElementById('search-filter-input');
      const clearSearchBtn = document.getElementById('clear-search-btn');
      const categorySelect = document.getElementById('category-filter-select');
      const sortSelect = document.getElementById('sort-select');

      searchInput.addEventListener('input', () => {
        if (clearSearchBtn) {
          if (searchInput.value.trim()) clearSearchBtn.classList.remove('hidden');
          else clearSearchBtn.classList.add('hidden');
        }
        renderFilteredCatalog(true);
      });

      clearSearchBtn?.addEventListener('click', () => {
        searchInput.value = '';
        clearSearchBtn.classList.add('hidden');
        renderFilteredCatalog(true);
      });

      sortSelect.addEventListener('change', () => renderFilteredCatalog(true));

      // Render Catalog Grid
      function renderFilteredCatalog(resetPage = false) {
        if (resetPage) adminCurrentPage = 1;

        const grid = document.getElementById('catalog-products-grid');
        const pagContainer = document.getElementById('admin-pagination-container');
        const pagStartEl = document.getElementById('admin-pag-start');
        const pagEndEl = document.getElementById('admin-pag-end');
        const pagTotalEl = document.getElementById('admin-pag-total');

        const query = searchInput.value.toLowerCase().trim();
        const cat = categorySelect.value;
        const subcatSelect = document.getElementById('subcategory-filter-select');
        const subcat = subcatSelect ? subcatSelect.value : 'all';
        const sort = sortSelect.value;

        let filtered = allProductsList.filter(p => {
          let matchCat = cat === 'all';
          if (!matchCat) {
            const parentSlug = p.category_slug ? p.category_slug.split('--')[0] : '';
            const catObj = categoriesList.find(c => c.slug === cat);
            const catName = catObj ? catObj.name : '';
            matchCat = parentSlug === cat || p.category_slug === cat || (catName && p.category_name && p.category_name.startsWith(catName));
          }

          let matchSub = subcat === 'all';
          if (!matchSub && matchCat) {
            const catObj = categoriesList.find(c => c.slug === cat);
            const subObj = catObj ? (catObj.subcategories || []).find(s => s.slug === subcat) : null;
            const subName = subObj ? subObj.name : '';
            matchSub = (p.category_slug && p.category_slug.includes('--' + subcat)) || 
                       (subName && p.category_name && p.category_name.includes(' • ' + subName));
          }

          const matchQuery = !query || p.name.toLowerCase().includes(query);
          return matchCat && matchSub && matchQuery;
        });

        // Sorting
        filtered.sort((a, b) => {
          if (sort === 'price-asc') return Number(a.price_from) - Number(b.price_from);
          if (sort === 'price-desc') return Number(b.price_from) - Number(a.price_from);
          if (sort === 'name-asc') return a.name.localeCompare(b.name);
          return new Date(b.created_at).getTime() - new Date(a.created_at).getTime();
        });

        const totalFiltered = filtered.length;
        const totalPages = Math.ceil(totalFiltered / ADMIN_PER_PAGE) || 1;
        if (adminCurrentPage > totalPages) adminCurrentPage = totalPages;

        if (totalFiltered === 0) {
          grid.innerHTML = `
            <div class="col-span-full py-16 text-center text-slate-400 bg-white rounded-xl border border-dashed border-slate-200 p-6 text-xs">
              Tidak ada produk yang cocok dengan pencarian.
            </div>
          `;
          if (pagContainer) pagContainer.classList.add('hidden');
          return;
        }

        if (pagContainer) pagContainer.classList.remove('hidden');

        const startIdx = (adminCurrentPage - 1) * ADMIN_PER_PAGE;
        const endIdx = Math.min(startIdx + ADMIN_PER_PAGE, totalFiltered);
        const paginated = filtered.slice(startIdx, endIdx);

        if (pagStartEl) pagStartEl.textContent = startIdx + 1;
        if (pagEndEl) pagEndEl.textContent = endIdx;
        if (pagTotalEl) pagTotalEl.textContent = totalFiltered;

        grid.innerHTML = paginated.map(p => {
          const detailUrl = `/produk/${p.slug}/`;
          const isFeatured = Boolean(p.featured);
          const sizeMatch = (p.description || '').match(/^\[Ukuran:\s*([^\]]+)\]/);
          const sizeBadge = sizeMatch ? `<span class="inline-flex items-center gap-1 text-[10px] font-semibold text-emerald-700 bg-emerald-50 border border-emerald-200/60 px-1.5 py-0.5 rounded shrink-0" title="Ukuran: ${sizeMatch[1]}">📏 ${sizeMatch[1]}</span>` : '';

          return `
            <div class="bg-white border border-slate-200 rounded-xl overflow-hidden shadow-2xs hover:border-slate-300 transition-all flex flex-col justify-between group">
              
              <!-- Image frame -->
              <div class="relative aspect-4/3 bg-slate-100 overflow-hidden">
                <img src="${p.image}" alt="${p.name}" loading="lazy" class="w-full h-full object-cover" />
                <span class="absolute top-2 left-2 bg-primary/90 text-white text-[10px] font-medium px-2 py-0.5 rounded backdrop-blur-xs shadow-2xs">
                  ${p.category_name}
                </span>
                ${isFeatured ? '<span class="absolute top-2 right-2 bg-amber-500 text-white text-[10px] font-semibold px-1.5 py-0.5 rounded shadow-2xs">Unggulan</span>' : ''}
              </div>

              <!-- Content -->
              <div class="p-3 flex-1 flex flex-col justify-between">
                <div>
                  <h3 class="font-semibold text-slate-900 text-xs leading-snug line-clamp-2 hover:text-primary transition-colors">
                    <a href="${detailUrl}" target="_blank">${p.name}</a>
                  </h3>
                  <div class="flex items-center justify-between gap-1 mt-1 flex-wrap">
                    <p class="font-bold text-primary text-sm">${p.price_label}</p>
                    <div class="flex items-center gap-1 flex-wrap">
                      ${sizeBadge}
                      ${p.city ? `<span class="text-[10px] text-slate-500 bg-slate-100 px-1.5 py-0.5 rounded truncate max-w-[130px]" title="${p.city}">📍 ${p.city}</span>` : ''}
                    </div>
                  </div>
                </div>

                <!-- Action Row -->
                <div class="pt-2.5 mt-2.5 border-t border-slate-100 flex items-center justify-between gap-1 text-xs">
                  <button 
                    type="button" 
                    data-id="${p.id}" 
                    data-featured="${isFeatured}" 
                    class="quick-toggle-featured text-[11px] font-medium text-slate-500 hover:text-primary cursor-pointer"
                  >
                    ${isFeatured ? 'Lepas Unggulan' : '+ Unggulan'}
                  </button>

                  <div class="flex items-center gap-1">
                    <button 
                      type="button" 
                      data-id="${p.id}" 
                      class="edit-prod-btn text-[11px] font-medium text-slate-700 hover:text-primary hover:bg-accent-bg/60 bg-slate-100 px-2 py-1 rounded transition-colors cursor-pointer"
                    >
                      Edit
                    </button>
                    <button 
                      type="button" 
                      data-id="${p.id}" 
                      data-name="${p.name}" 
                      class="delete-prod-btn text-[11px] font-medium text-rose-600 hover:text-rose-700 bg-rose-50 hover:bg-rose-100 px-2 py-1 rounded transition-colors cursor-pointer"
                    >
                      Hapus
                    </button>
                  </div>
                </div>

              </div>
            </div>
          `;
        }).join('');

        renderAdminPaginationControls(totalPages);
        attachActionListeners();
      }

      function renderAdminPaginationControls(totalPages) {
        const pagControls = document.getElementById('admin-pag-controls');
        if (!pagControls) return;

        if (totalPages <= 1) {
          pagControls.innerHTML = '';
          return;
        }

        let html = `
          <button 
            type="button" 
            class="admin-prev-btn inline-flex items-center justify-center w-7 h-7 rounded border border-slate-200 text-xs font-medium transition-all ${adminCurrentPage === 1 ? 'opacity-30 cursor-not-allowed bg-slate-50' : 'cursor-pointer hover:bg-slate-50 text-slate-700'}"
            ${adminCurrentPage === 1 ? 'disabled' : ''}
          >
            ‹
          </button>
        `;

        for (let p = 1; p <= totalPages; p++) {
          if (p === 1 || p === totalPages || (p >= adminCurrentPage - 1 && p <= adminCurrentPage + 1)) {
            const isActive = p === adminCurrentPage;
            html += `
              <button 
                type="button" 
                data-page="${p}" 
                class="admin-page-btn inline-flex items-center justify-center w-7 h-7 rounded text-xs font-medium cursor-pointer transition-all ${isActive ? 'bg-primary text-white shadow-2xs' : 'border border-slate-200 text-slate-700 hover:text-primary hover:border-primary/40 hover:bg-slate-50'}"
              >
                ${p}
              </button>
            `;
          } else if (p === adminCurrentPage - 2 || p === adminCurrentPage + 2) {
            html += `<span class="px-0.5 text-slate-400 text-xs">...</span>`;
          }
        }

        html += `
          <button 
            type="button" 
            class="admin-next-btn inline-flex items-center justify-center w-7 h-7 rounded border border-slate-200 text-xs font-medium transition-all ${adminCurrentPage === totalPages ? 'opacity-30 cursor-not-allowed bg-slate-50' : 'cursor-pointer hover:bg-slate-50 text-slate-700'}"
            ${adminCurrentPage === totalPages ? 'disabled' : ''}
          >
            ›
          </button>
        `;

        pagControls.innerHTML = html;

        pagControls.querySelectorAll('.admin-page-btn').forEach(btn => {
          btn.addEventListener('click', () => {
            const p = Number(btn.getAttribute('data-page'));
            if (p && p !== adminCurrentPage) {
              adminCurrentPage = p;
              renderFilteredCatalog(false);
              document.getElementById('catalog-products-grid')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
            }
          });
        });

        pagControls.querySelector('.admin-prev-btn')?.addEventListener('click', () => {
          if (adminCurrentPage > 1) {
            adminCurrentPage--;
            renderFilteredCatalog(false);
            document.getElementById('catalog-products-grid')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
          }
        });

        pagControls.querySelector('.admin-next-btn')?.addEventListener('click', () => {
          if (adminCurrentPage < totalPages) {
            adminCurrentPage++;
            renderFilteredCatalog(false);
            document.getElementById('catalog-products-grid')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
          }
        });
      }

      function getProductDescriptionFields(description) {
        const value = description || '';
        const size = value.match(/^\[Ukuran:\s*([^\]]+)\]/im)?.[1]?.trim() || '';
        const cardShape = value.match(/^\[Bentuk Kartu:\s*(portrait|square|arch)\]/im)?.[1] || 'portrait';
        const cleanDescription = value
          .replace(/^(?:\[(?:Ukuran|Bentuk Kartu):[^\]]+\]\s*\r?\n?)+/i, '')
          .trim();
        return { size, cardShape, cleanDescription };
      }

      function formatProductDescription(description, size, cardShape) {
        const cleanDescription = getProductDescriptionFields(description).cleanDescription;
        const metadata = [
          `[Bentuk Kartu: ${cardShape}]`,
          size ? `[Ukuran: ${size}]` : '',
        ].filter(Boolean);
        return [metadata.join('\n'), cleanDescription].filter(Boolean).join('\n\n');
      }

      function attachActionListeners() {
        // Toggle Featured Listener
        document.querySelectorAll('.quick-toggle-featured').forEach(btn => {
          btn.addEventListener('click', async () => {
            const id = btn.getAttribute('data-id');
            const currentFeatured = btn.getAttribute('data-featured') === 'true';
            const newFeatured = !currentFeatured;

            btn.disabled = true;

            try {
              const { error } = await supabase
                .from('products')
                .update({ featured: newFeatured })
                .eq('id', id);

              if (error) throw error;

              const p = allProductsList.find(x => x.id === id);
              if (p) p.featured = newFeatured;

              renderFilteredCatalog(false);
              showToast(newFeatured ? 'Produk dijadikan unggulan.' : 'Produk dilepas dari unggulan.');
            } catch (err) {
              showToast('Gagal mengubah status: ' + err.message, 'error');
              btn.disabled = false;
            }
          });
        });

        // Delete Button Listener (Opens Modal)
        document.querySelectorAll('.delete-prod-btn').forEach(btn => {
          btn.addEventListener('click', () => {
            const id = btn.getAttribute('data-id');
            const name = btn.getAttribute('data-name');
            pendingDeleteId = id;

            const modalNameEl = document.getElementById('delete-modal-product-name');
            if (modalNameEl) modalNameEl.textContent = `"${name}"`;

            document.getElementById('delete-modal').classList.remove('hidden');
          });
        });

        // Edit Button Listener (Opens Modal)
        document.querySelectorAll('.edit-prod-btn').forEach(btn => {
          btn.addEventListener('click', () => {
            const id = btn.getAttribute('data-id');
            const p = allProductsList.find(x => x.id === id);
            if (!p) return;

            revokeGalleryPreviews(editGalleryItems.filter((item) => item.sourceFile));
            editGalleryItems = [...new Set([p.image, ...(Array.isArray(p.images) ? p.images : [])])]
              .filter((url) => typeof url === 'string' && url.trim())
              .slice(0, 3)
              .map((url) => ({ url, sourceFile: null, blob: null, previewUrl: url }));
            editImageFileInput.value = '';
            document.getElementById('edit-prod-id').value = p.id;
            document.getElementById('edit-prod-current-image').value = p.image;
            editHoverPreviewEnabled.checked = Boolean(p.hover_preview_index);
            updateEditGallery(String(p.hover_preview_index || ''));
            document.getElementById('edit-prod-name').value = p.name;
            document.getElementById('edit-prod-price').value = p.price_from;
            document.getElementById('edit-prod-time').value = p.processing_time || '3 - 5 Jam';
            // Parse size and clean description
            const descriptionFields = getProductDescriptionFields(p.description);
            const currentSize = descriptionFields.size;
            document.getElementById('edit-prod-desc').value = descriptionFields.cleanDescription;
            document.getElementById('edit-prod-card-shape').value = descriptionFields.cardShape;
            lastEditProductShape = descriptionFields.cardShape;
            document.getElementById('edit-prod-featured').checked = Boolean(p.featured);

            // Parse category and subcategory
            const parentCatSlug = p.category_slug ? p.category_slug.split('--')[0] : '';
            let currentSubcatSlug = p.category_slug && p.category_slug.includes('--') ? p.category_slug.split('--')[1] : '';
            let currentSubcatName = '';
            if (p.category_name && p.category_name.includes(' • ')) {
              currentSubcatName = p.category_name.split(' • ')[1].trim();
            }

            const catSelect = document.getElementById('edit-prod-category');
            const subcatWrapper = document.getElementById('edit-prod-subcategory-wrapper');
            const subcatSelect = document.getElementById('edit-prod-subcategory');

            // Find matching category
            const cat = categoriesList.find(c => c.slug === parentCatSlug || c.slug === p.category_slug || (p.category_name && p.category_name.startsWith(c.name)));
            if (cat && catSelect) {
              catSelect.value = cat.slug;
              if (cat.subcategories && cat.subcategories.length > 0) {
                subcatSelect.innerHTML = '<option value="">Pilih Subkategori (Opsional)...</option>' +
                  cat.subcategories.map(s => `<option value="${s.slug}" data-name="${s.name}">${s.name}</option>`).join('');
                subcatWrapper.classList.remove('hidden');

                if (currentSubcatSlug) {
                  subcatSelect.value = currentSubcatSlug;
                } else if (currentSubcatName) {
                  const matchingSub = cat.subcategories.find(s => s.name.toLowerCase() === currentSubcatName.toLowerCase());
                  if (matchingSub) subcatSelect.value = matchingSub.slug;
                }
              } else {
                subcatSelect.innerHTML = '<option value="">Pilih Subkategori...</option>';
                subcatWrapper.classList.add('hidden');
              }
            }

            // Set size dropdown in edit modal
            const targetCatSlug = cat ? cat.slug : parentCatSlug;
            if (typeof updateSizeDropdownForCategory === 'function') {
              updateSizeDropdownForCategory(targetCatSlug, 'edit-prod-size');
            }
            const editSizeSelectEl = document.getElementById('edit-prod-size');
            if (editSizeSelectEl) {
              if (currentSize) {
                const exists = Array.from(editSizeSelectEl.options).some(o => o.value === currentSize);
                if (!exists) {
                  const opt = document.createElement('option');
                  opt.value = currentSize;
                  opt.textContent = `📏 ${currentSize}`;
                  editSizeSelectEl.appendChild(opt);
                }
                editSizeSelectEl.value = currentSize;
              } else {
                editSizeSelectEl.value = '';
              }
            }

            const editThumb = document.getElementById('edit-image-thumbnail');
            if (editThumb) editThumb.src = p.image;

            const editNote = document.getElementById('edit-image-note');
            if (editNote) {
              editNote.textContent = 'Kosongkan jika tidak diganti.';
              editNote.className = 'text-[10px] text-slate-400 truncate';
            }

            const editPricePreview = document.getElementById('edit-price-preview');
            if (editPricePreview && p.price_from) {
              editPricePreview.textContent = new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', maximumFractionDigits: 0 }).format(p.price_from);
            }

            // Set city in edit modal
            const editCitySelectEl = document.getElementById('edit-prod-city');
            if (editCitySelectEl) {
              const currentCity = p.city || 'Malang Raya (Kota Malang, Kab. Malang, Kota Batu)';
              const exists = Array.from(editCitySelectEl.options).some(o => o.value === currentCity);
              if (!exists && currentCity) {
                const opt = document.createElement('option');
                opt.value = currentCity;
                opt.textContent = `📍 ${currentCity}`;
                editCitySelectEl.appendChild(opt);
              }
              editCitySelectEl.value = currentCity;
            }

            document.getElementById('edit-modal').classList.remove('hidden');
          });
        });
      }

      // Delete Modal Actions
      const deleteModal = document.getElementById('delete-modal');
      const cancelDeleteBtn = document.getElementById('cancel-delete-btn');
      const confirmDeleteBtn = document.getElementById('confirm-delete-btn');
      const deleteBtnText = document.getElementById('delete-btn-text');
      const deleteSpinner = document.getElementById('delete-spinner');

      cancelDeleteBtn?.addEventListener('click', () => {
        deleteModal.classList.add('hidden');
        pendingDeleteId = null;
      });

      confirmDeleteBtn?.addEventListener('click', async () => {
        if (!pendingDeleteId) return;

        confirmDeleteBtn.disabled = true;
        deleteBtnText.textContent = 'Menghapus...';
        deleteSpinner.classList.remove('hidden');

        try {
          let productToDelete = allProductsList.find(product => product.id === pendingDeleteId);
          if (!productToDelete) {
            const { data, error: lookupError } = await supabase
              .from('products')
              .select('id, image, images')
              .eq('id', pendingDeleteId)
              .maybeSingle();
            if (lookupError) throw lookupError;
            productToDelete = data;
          }
          if (!productToDelete) throw new Error('Produk tidak ditemukan.');

          const { error } = await supabase.from('products').delete().eq('id', pendingDeleteId);
          if (error) throw error;

          deleteModal.classList.add('hidden');
          try {
            await removeUnreferencedProductImages([
              productToDelete.image,
              ...(Array.isArray(productToDelete.images) ? productToDelete.images : [])
            ]);
            showToast('Produk dan foto yang tidak dipakai berhasil dihapus.');
          } catch (cleanupError) {
            console.error('[Zaloma Admin] Produk terhapus, tetapi foto Storage gagal dibersihkan:', cleanupError);
            showToast('Produk terhapus, tetapi foto lama belum berhasil dibersihkan dari penyimpanan.', 'warning');
          }
          loadAllProducts();
        } catch (err) {
          console.error('[Zaloma Admin] Gagal menghapus produk:', err);
          showToast('Gagal menghapus produk. Periksa koneksi dan izin Supabase.', 'error');
        } finally {
          confirmDeleteBtn.disabled = false;
          deleteBtnText.textContent = 'Hapus';
          deleteSpinner.classList.add('hidden');
          pendingDeleteId = null;
        }
      });

      // Edit Modal Actions
      const editModal = document.getElementById('edit-modal');
      const closeModalBtn = document.getElementById('close-modal-btn');
      const cancelEditBtn = document.getElementById('cancel-edit-btn');
      const editForm = document.getElementById('edit-product-form');
      const saveEditBtn = document.getElementById('save-edit-btn');
      const saveBtnText = document.getElementById('save-btn-text');
      const saveSpinner = document.getElementById('save-spinner');

      closeModalBtn.addEventListener('click', () => editModal.classList.add('hidden'));
      cancelEditBtn.addEventListener('click', () => editModal.classList.add('hidden'));

      editForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        const id = document.getElementById('edit-prod-id').value;
        const name = document.getElementById('edit-prod-name').value.trim();
        const catSelect = document.getElementById('edit-prod-category');
        const categorySlug = catSelect.value;
        const catObj = categoriesList.find(c => c.slug === categorySlug);
        const categoryName = catObj ? catObj.name : (catSelect.options[catSelect.selectedIndex]?.getAttribute('data-name') || categorySlug);

        const subcatSelect = document.getElementById('edit-prod-subcategory');
        const subcatSlug = subcatSelect ? subcatSelect.value : '';
        const subcatObj = subcatSlug && catObj ? (catObj.subcategories || []).find(s => s.slug === subcatSlug) : null;
        const subcatName = subcatObj ? subcatObj.name : '';

        let finalCategoryName = categoryName;
        let finalCategorySlug = categorySlug;
        if (subcatName) {
          finalCategoryName = `${categoryName} • ${subcatName}`;
          finalCategorySlug = `${categorySlug}--${subcatSlug}`;
        }

        const price_from = Number(document.getElementById('edit-prod-price').value);
        const price_label = new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', maximumFractionDigits: 0 }).format(price_from);
        const processing_time = document.getElementById('edit-prod-time').value.trim();
        const editCitySelect = document.getElementById('edit-prod-city');
        let finalCity = editCitySelect?.value || 'Malang Raya (Kota Malang, Kab. Malang, Kota Batu)';
        if (finalCity === '__ADD_NEW_CITY__') finalCity = 'Malang Raya (Kota Malang, Kab. Malang, Kota Batu)';
        const editSizeSelect = document.getElementById('edit-prod-size');
        let selectedSize = editSizeSelect ? editSizeSelect.value.trim() : '';
        if (selectedSize === '__ADD_NEW_SIZE__') selectedSize = '';
        const cardShape = document.getElementById('edit-prod-card-shape').value;
        const description = formatProductDescription(
          document.getElementById('edit-prod-desc').value.trim(),
          selectedSize,
          cardShape,
        );
        const featured = document.getElementById('edit-prod-featured').checked;
        if (editGalleryItems.length === 0 || editGalleryItems.length > 3) {
          showToast('Produk harus memiliki 1 sampai 3 foto.', 'error');
          return;
        }

        saveEditBtn.disabled = true;
        saveBtnText.textContent = 'Menyimpan...';
        saveSpinner.classList.remove('hidden');

        const uploadedGalleryUrls = [];
        try {
          const currentProduct = allProductsList.find(x => x.id === id);
          const previousGalleryUrls = [
            currentProduct?.image || document.getElementById('edit-prod-current-image').value,
            ...(Array.isArray(currentProduct?.images) ? currentProduct.images : [])
          ];
          const slug = currentProduct ? currentProduct.slug : `prod-${Date.now()}`;
          const finalGalleryUrls = [];
          for (const [index, item] of editGalleryItems.entries()) {
            if (item.sourceFile && item.blob) {
              saveBtnText.textContent = `Upload foto ${index + 1}/${editGalleryItems.length}...`;
              const uploadedImage = await uploadProductImageToR2(slug, item.blob);
              finalGalleryUrls.push(uploadedImage.url);
              uploadedGalleryUrls.push(uploadedImage.url);
            } else {
              finalGalleryUrls.push(item.url);
            }
          }

          saveBtnText.textContent = 'Menyimpan data...';
          const { error } = await supabase
            .from('products')
            .update({
              name,
              category_slug: finalCategorySlug,
              category_name: finalCategoryName,
              price_from,
              price_label,
              processing_time,
              city: finalCity,
              description,
              featured,
              image: finalGalleryUrls[0],
              images: finalGalleryUrls.slice(1),
              hover_preview_index: editHoverPreviewEnabled.checked
                ? Number(editHoverPreviewIndex.value)
                : null
            })
            .eq('id', id);

          if (error) throw error;

          let cleanupFailed = false;
          try {
            await removeUnreferencedProductImages(previousGalleryUrls);
          } catch (cleanupError) {
            cleanupFailed = true;
            console.error('[Zaloma Admin] Produk diperbarui, tetapi foto lama gagal dibersihkan:', cleanupError);
          }

          editModal.classList.add('hidden');
          showToast(cleanupFailed
            ? 'Produk diperbarui, tetapi foto lama belum berhasil dibersihkan dari penyimpanan.'
            : 'Produk dan foto lama yang tidak dipakai berhasil diperbarui.', cleanupFailed ? 'warning' : 'success');
          loadAllProducts();
        } catch (err) {
          console.error('[Zaloma Admin] Gagal menyimpan produk:', err);
          try {
            await removeUnreferencedProductImages(uploadedGalleryUrls);
          } catch (cleanupError) {
            console.error('[Zaloma Admin] Gagal membersihkan foto yang terunggah tetapi tidak tersimpan:', cleanupError);
          }
          showToast(err instanceof Error ? err.message : 'Gagal menyimpan produk.', 'error');
        } finally {
          saveEditBtn.disabled = false;
          saveBtnText.textContent = 'Simpan';
          saveSpinner.classList.add('hidden');
        }
      });

      // Add Product Form Handler
      const addForm = document.getElementById('add-product-form');
      const submitBtn = document.getElementById('submit-btn');
      const btnText = document.getElementById('btn-text');
      const btnSpinner = document.getElementById('btn-spinner');

      addForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        if (addGalleryItems.length === 0 || addGalleryItems.length > 3) {
          showToast('Pilih minimal 1 dan maksimal 3 foto produk.', 'error');
          return;
        }

        const name = document.getElementById('prod-name').value.trim();
        const categorySelect = document.getElementById('prod-category');
        const categorySlug = categorySelect.value;
        const catObj = categoriesList.find(c => c.slug === categorySlug);
        const categoryName = catObj ? catObj.name : (categorySelect.options[categorySelect.selectedIndex]?.getAttribute('data-name') || categorySlug);

        const subcatSelect = document.getElementById('prod-subcategory');
        const subcatSlug = subcatSelect ? subcatSelect.value : '';
        const subcatObj = subcatSlug && catObj ? (catObj.subcategories || []).find(s => s.slug === subcatSlug) : null;
        const subcatName = subcatObj ? subcatObj.name : '';

        let finalCategoryName = categoryName;
        let finalCategorySlug = categorySlug;
        if (subcatName) {
          finalCategoryName = `${categoryName} • ${subcatName}`;
          finalCategorySlug = `${categorySlug}--${subcatSlug}`;
        }

        const priceFrom = Number(document.getElementById('prod-price').value);
        const priceLabel = new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', maximumFractionDigits: 0 }).format(priceFrom);
        const processingTime = document.getElementById('prod-time').value.trim() || '3 - 5 Jam';
        const citySelect = document.getElementById('prod-city');
        let finalCity = citySelect?.value || 'Malang Raya (Kota Malang, Kab. Malang, Kota Batu)';
        if (finalCity === '__ADD_NEW_CITY__') finalCity = 'Malang Raya (Kota Malang, Kab. Malang, Kota Batu)';
        const addSizeSelect = document.getElementById('prod-size');
        let selectedSize = addSizeSelect ? addSizeSelect.value.trim() : '';
        if (selectedSize === '__ADD_NEW_SIZE__') selectedSize = '';
        const cardShape = document.getElementById('prod-card-shape').value;
        const description = formatProductDescription(
          document.getElementById('prod-desc').value.trim(),
          selectedSize,
          cardShape,
        );
        const featured = document.getElementById('prod-featured').checked;
        
        const slugBase = name.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '');
        const slug = `${slugBase}-${Date.now().toString().slice(-4)}`;

        submitBtn.disabled = true;
        btnText.textContent = 'Mengupload & menyimpan...';
        btnSpinner.classList.remove('hidden');

        const uploadedGalleryUrls = [];
        try {
          const galleryUrls = [];
          for (const [index, item] of addGalleryItems.entries()) {
            btnText.textContent = `Upload foto ${index + 1}/${addGalleryItems.length}...`;
            const uploadedImage = await uploadProductImageToR2(slug, item.blob);
            galleryUrls.push(uploadedImage.url);
            uploadedGalleryUrls.push(uploadedImage.url);
          }

          const { error: insertError } = await supabase.from('products').insert([{
            name,
            slug,
            category_slug: finalCategorySlug,
            category_name: finalCategoryName,
            price_from: priceFrom,
            price_label: priceLabel,
            image: galleryUrls[0],
            images: galleryUrls.slice(1),
            hover_preview_index: addHoverPreviewEnabled.checked
              ? Number(addHoverPreviewIndex.value)
              : null,
            description,
            featured,
            processing_time: processingTime,
            city: finalCity
          }]);

          if (insertError) throw new Error('Simpan database gagal: ' + insertError.message);

          showToast(`Produk "${name}" berhasil ditambahkan.`);
          addForm.reset();
          imageFileInput.value = '';
          lastProductShape = addProductShapeInput.value;
          updateCityDropdowns();
          if (typeof updateSizeDropdowns === 'function') updateSizeDropdowns();
          revokeGalleryPreviews(addGalleryItems);
          addGalleryItems = [];
          pricePreview.textContent = 'Rp 0';
          updateAddGalleryPreview();
          addHoverPreviewEnabled.checked = false;
          addHoverPreviewIndex.disabled = true;

          tabBtnCatalog.click();
          loadAllProducts();

        } catch (err) {
          console.error('[Zaloma Admin] Gagal menambahkan produk:', err);
          try {
            await removeUnreferencedProductImages(uploadedGalleryUrls);
          } catch (cleanupError) {
            console.error('[Zaloma Admin] Gagal membersihkan foto produk yang gagal disimpan:', cleanupError);
          }
          showToast(err instanceof Error ? err.message : 'Gagal menambahkan produk.', 'error');
        } finally {
          submitBtn.disabled = false;
          btnText.textContent = 'Simpan Produk';
          btnSpinner.classList.add('hidden');
        }
      });
    </script>

    <style>
      @keyframes fadeIn {
        from { opacity: 0; transform: translateY(3px); }
        to { opacity: 1; transform: translateY(0); }
      }

      @keyframes modalPop {
        from { opacity: 0; transform: scale(0.97); }
        to { opacity: 1; transform: scale(1); }
      }

      @keyframes toastIn {
        from { opacity: 0; transform: translateY(-8px); }
        to { opacity: 1; transform: translateY(0); }
      }

      .animate-fade-in {
        animation: fadeIn 0.18s ease-out forwards;
      }

      .animate-modal-pop {
        animation: modalPop 0.15s ease-out forwards;
      }

      .animate-toast-in {
        animation: toastIn 0.18s ease-out forwards;
      }
    
      /* Custom Dropdown Polish */
      .custom-dropdown-root {
        position: relative;
        width: 100%;
      }
      .custom-dropdown-menu {
        scrollbar-width: thin;
        scrollbar-color: #cbd5e1 transparent;
      }
      .custom-dropdown-menu::-webkit-scrollbar {
        width: 6px;
      }
      .custom-dropdown-menu::-webkit-scrollbar-track {
        background: transparent;
      }
      .custom-dropdown-menu::-webkit-scrollbar-thumb {
        background: #cbd5e1;
        border-radius: 9999px;
      }

      .admin-tabs {
        scrollbar-width: none;
        -webkit-overflow-scrolling: touch;
        scroll-padding-inline: 0.75rem;
      }

      .admin-tabs::-webkit-scrollbar {
        display: none;
      }

      .admin-main > section {
        min-width: 0;
      }

      .admin-main input:not([type="checkbox"]):not([type="radio"]):not([type="file"]),
      .admin-main select,
      .admin-main textarea {
        max-width: 100%;
      }

      .admin-main input:not([type="checkbox"]):not([type="radio"]):not([type="file"]):focus,
      .admin-main select:focus,
      .admin-main textarea:focus {
        outline: none;
        border-color: #893144;
        box-shadow: 0 0 0 3px rgba(137, 49, 68, 0.11);
      }

      .admin-main button:focus-visible,
      .admin-nav button:focus-visible,
      #login-gate button:focus-visible {
        outline: 3px solid rgba(142, 95, 43, 0.4);
        outline-offset: 2px;
      }

      #catalog-products-grid > * {
        min-width: 0;
      }

      #catalog-products-grid > div:not(.col-span-full) {
        border-color: #e7e5e4;
        border-radius: 1rem;
        box-shadow: 0 2px 8px rgba(41, 37, 36, 0.035);
      }

      #catalog-products-grid > div:not(.col-span-full):hover {
        border-color: rgba(137, 49, 68, 0.25);
        box-shadow: 0 12px 28px rgba(41, 37, 36, 0.09);
        transform: translateY(-2px);
      }

      #admin-pagination-container {
        border-radius: 1rem;
      }

      #admin-pag-controls {
        max-width: 100%;
        overflow-x: auto;
        padding: 2px;
      }

      #admin-pag-controls button {
        min-width: 2.5rem;
        min-height: 2.5rem;
      }

      @media (min-width: 768px) {
        .admin-tabs {
          gap: 0.5rem;
        }
      }

      @media (max-width: 639px) {
        #admin-pagination-container {
          align-items: stretch;
        }

        #admin-pag-controls {
          justify-content: center;
        }

        #add-product-form {
          padding-bottom: env(safe-area-inset-bottom);
        }
      }

      @media (prefers-reduced-motion: reduce) {
        .admin-page *,
        .admin-page *::before,
        .admin-page *::after {
          scroll-behavior: auto !important;
          animation-duration: 0.01ms !important;
          animation-iteration-count: 1 !important;
          transition-duration: 0.01ms !important;
        }
      }

    </style>
  </body>
</html>
