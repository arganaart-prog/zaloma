              <span class="absolute left-1/2 top-1 h-1 w-8 -translate-x-1/2 rounded-full bg-white/90"></span>
              <span class="absolute bottom-1 left-1/2 h-1 w-8 -translate-x-1/2 rounded-full bg-white/90"></span>
              <span class="absolute left-1 top-1/2 h-8 w-1 -translate-y-1/2 rounded-full bg-white/90"></span>
              <span class="absolute right-1 top-1/2 h-8 w-1 -translate-y-1/2 rounded-full bg-white/90"></span>
