      });

      // Client-side Image Compression Helper
      function compressImage(file, maxDim = 1200, quality = 0.82) {
        return new Promise((resolve, reject) => {
          const img = new Image();
          const reader = new FileReader();

          reader.onload = (e) => { img.src = e.target.result; };
          reader.onerror = reject;

          img.onload = () => {
            let width = img.width;
            let height = img.height;

            if (width > height && width > maxDim) {
              height = Math.round((height * maxDim) / width);
              width = maxDim;
            } else if (height > maxDim) {
              width = Math.round((width * maxDim) / height);
              height = maxDim;
            }

            const canvas = document.createElement('canvas');
            canvas.width = width;
            canvas.height = height;
            const ctx = canvas.getContext('2d');
            ctx.drawImage(img, 0, 0, width, height);

            canvas.toBlob((blob) => {
              if (blob) resolve(blob);
              else reject(new Error('Gagal mengompres gambar'));
            }, 'image/webp', quality);
          };
          reader.readAsDataURL(file);
        });
      }

      // Add Photo File Input Handler
      const imageFileInput = document.getElementById('prod-image-file');
      const imagePreview = document.getElementById('image-preview');
      const previewContainer = document.getElementById('image-preview-container');
      const uploadPrompt = document.getElementById('upload-prompt');
      const origSizeLabel = document.getElementById('orig-size-label');
      const compSizeLabel = document.getElementById('comp-size-label');
      let processedImageBlob = null;

      imageFileInput.addEventListener('change', async (e) => {
        const file = e.target.files[0];
        if (!file) return;

        origSizeLabel.textContent = `${(file.size / 1024).toFixed(0)} KB`;
        try {
          const blob = await compressImage(file);
          processedImageBlob = blob;
          compSizeLabel.textContent = `${(blob.size / 1024).toFixed(0)} KB (WebP)`;
          imagePreview.src = URL.createObjectURL(blob);
          uploadPrompt.classList.add('hidden');
          previewContainer.classList.remove('hidden');
        } catch (err) {
          showToast('Gagal memproses gambar.', 'error');
        }
      });

      // Edit Photo File Input Handler
      const editImageFileInput = document.getElementById('edit-prod-image-file');
      const editImageThumbnail = document.getElementById('edit-image-thumbnail');
      const editImageNote = document.getElementById('edit-image-note');
      let editNewImageBlob = null;

      editImageFileInput?.addEventListener('change', async (e) => {
        const file = e.target.files[0];
        if (!file) return;

        try {
          const blob = await compressImage(file);
          editNewImageBlob = blob;
          editImageThumbnail.src = URL.createObjectURL(blob);
          editImageNote.textContent = `Foto baru: ${(blob.size / 1024).toFixed(0)} KB (WebP)`;
