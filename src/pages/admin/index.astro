        try {
          // If a file was uploaded, send to Supabase Storage
          if (citySelectedImageBlob) {
            saveBtnText.textContent = 'Mengupload foto...';
            const safeSlug = name.toLowerCase().replace(/[^a-z0-9]/g, '-').replace(/-+/g, '-').replace(/^-|-$/g, '') || 'city';
            const fileName = `cities/${safeSlug}-${Date.now()}.webp`;

            const { error: uploadError } = await supabase.storage
              .from(SUPABASE_BUCKET)
              .upload(fileName, citySelectedImageBlob, { contentType: 'image/webp', upsert: true });

            if (uploadError) {
              console.warn('Upload image city notice:', uploadError.message);
              showToast('Upload foto ke storage gagal, menyimpan nama kota: ' + uploadError.message, 'warning');
            } else {
              const { data: publicUrlData } = supabase.storage.from(SUPABASE_BUCKET).getPublicUrl(fileName);
              if (publicUrlData && publicUrlData.publicUrl) {
                finalImageUrl = publicUrlData.publicUrl;
              }
            }
          }

          const cityRecord = {
            name,
            province_name: selectedProvinceName,
            description: desc,
            image: finalImageUrl || (editIdx >= 0 && citiesList[editIdx]?.image ? citiesList[editIdx].image : '')
          };

          if (editIdx >= 0 && editIdx < citiesList.length) {
            citiesList[editIdx] = cityRecord;
            showToast(`Wilayah "${name}" berhasil diperbarui.`);
          } else {
            const exists = citiesList.some(c => (typeof c === 'string' ? c : c.name).toLowerCase() === name.toLowerCase());
