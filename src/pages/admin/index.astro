    <!-- ================= DELETE CATEGORY MODAL ================= -->
    <div id="delete-category-modal" class="hidden fixed inset-0 z-50 bg-black/40 backdrop-blur-xs flex items-center justify-center p-4 animate-fade-in">
      <div class="bg-white rounded-2xl max-w-xs w-full p-5 shadow-xl border border-slate-200 text-center space-y-3 animate-modal-pop">
        <h3 class="text-sm font-bold text-slate-900">Hapus Kategori?</h3>
        <p id="delete-category-name" class="text-xs text-slate-600 line-clamp-2 font-medium"></p>
        <p class="text-[11px] text-slate-400">Seluruh subkategori di dalamnya juga akan terhapus.</p>
        
        <div class="flex items-center gap-2 pt-2">
          <button type="button" id="cancel-delete-category-btn" class="flex-1 px-3 py-1.5 rounded-lg text-xs font-semibold text-slate-600 bg-slate-100 hover:bg-slate-200 cursor-pointer">Batal</button>
          <button type="button" id="confirm-delete-category-btn" class="flex-1 bg-rose-600 hover:bg-rose-700 text-white font-semibold py-1.5 px-3 rounded-lg text-xs transition-all active:scale-95 flex items-center justify-center gap-1 cursor-pointer">
            Hapus
          </button>
