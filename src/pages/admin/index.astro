    <script define:vars={{ SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_BUCKET, DEFAULT_CATEGORIES }}>
      // Initialize Supabase Client
      const supabase = window.supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY);

      // Auth UI Elements
      const loginGate = document.getElementById('login-gate');
      const adminDashboard = document.getElementById('admin-dashboard');
      const loginForm = document.getElementById('login-form');
      const emailInput = document.getElementById('admin-email-input');
      const passwordInput = document.getElementById('admin-password-input');
      const loginError = document.getElementById('login-error');
      const loginBtn = document.getElementById('login-btn');
      const loginBtnText = document.getElementById('login-btn-text');
      const loginSpinner = document.getElementById('login-spinner');
      const logoutBtn = document.getElementById('logout-btn');
      const userEmailDisplay = document.getElementById('user-email-display');

      let allProductsList = [];
      let pendingDeleteId = null;

      // Toast Notification Helper
      function showToast(message, type = 'success') {
        const container = document.getElementById('toast-container');
        if (!container) return;

        const toast = document.createElement('div');
        const isSuccess = type === 'success';
        const isError = type === 'error';
        const bgClass = isSuccess ? 'bg-slate-900 text-white' : isError ? 'bg-rose-700 text-white' : 'bg-slate-800 text-white';

        toast.className = `pointer-events-auto flex items-center justify-between gap-3 px-3.5 py-2.5 rounded-xl shadow-lg text-xs font-medium ${bgClass} animate-toast-in`;
        toast.innerHTML = `
          <span>${message}</span>
          <button type="button" class="text-white/60 hover:text-white text-xs cursor-pointer ml-1">✕</button>
        `;

        toast.querySelector('button')?.addEventListener('click', () => {
          toast.remove();
        });

        container.appendChild(toast);

        setTimeout(() => {
          if (toast.isConnected) toast.remove();
        }, 3000);
      }

      // Supabase Auth State Listener
      supabase.auth.onAuthStateChange((event, session) => {
        if (session && session.user) {
          loginGate.classList.add('hidden');
          adminDashboard.classList.remove('hidden');
          if (userEmailDisplay) userEmailDisplay.textContent = session.user.email;
          loadAllProducts();
        } else {
          loginGate.classList.remove('hidden');
          adminDashboard.classList.add('hidden');
        }
      });

      // Login Handler
      loginForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        const email = emailInput.value.trim();
        const password = passwordInput.value;

        loginBtn.disabled = true;
        loginBtnText.textContent = 'Memverifikasi...';
        loginSpinner.classList.remove('hidden');
        loginError.classList.add('hidden');

        try {
          const { data, error } = await supabase.auth.signInWithPassword({ email, password });
          if (error) throw error;
          showToast('Berhasil masuk.');
        } catch (err) {
          loginError.textContent = err.message === 'Invalid login credentials'
            ? 'Email atau password salah.'
            : `Gagal login: ${err.message}`;
          loginError.classList.remove('hidden');
        } finally {
          loginBtn.disabled = false;
          loginBtnText.textContent = 'Masuk';
          loginSpinner.classList.add('hidden');
        }
      });

      // Logout Handler
      logoutBtn.addEventListener('click', async () => {
        await supabase.auth.signOut();
        showToast('Anda telah keluar.', 'info');
      });

      // Tab Switching
      const tabBtnCatalog = document.getElementById('tab-btn-catalog');
      const tabBtnAdd = document.getElementById('tab-btn-add');
      const tabBtnCategories = document.getElementById('tab-btn-categories');
      const tabCatalog = document.getElementById('tab-catalog');
      const tabAdd = document.getElementById('tab-add');
      const tabCategories = document.getElementById('tab-categories');

      function switchTab(activeTab) {
        const tabs = [
          { btn: tabBtnCatalog, pane: tabCatalog, isCatalog: true },
          { btn: tabBtnAdd, pane: tabAdd },
          { btn: tabBtnCategories, pane: tabCategories }
        ];

        tabs.forEach(t => {
          if (!t.btn || !t.pane) return;
          if (t.btn === activeTab) {
            t.btn.className = `tab-btn active px-3 py-1.5 rounded-md text-xs font-semibold bg-primary text-white transition-all cursor-pointer shadow-2xs flex items-center gap-1.5`;
            t.pane.classList.remove('hidden');
          } else {
            t.btn.className = `tab-btn px-3 py-1.5 rounded-md text-xs font-semibold text-slate-600 hover:text-primary hover:bg-accent-bg/50 transition-all cursor-pointer flex items-center gap-1.5`;
            t.pane.classList.add('hidden');
          }
        });
      }

      tabBtnCatalog?.addEventListener('click', () => switchTab(tabBtnCatalog));
      tabBtnAdd?.addEventListener('click', () => switchTab(tabBtnAdd));
      tabBtnCategories?.addEventListener('click', () => {
        switchTab(tabBtnCategories);
        renderCategoriesCards();
      });

      // Categories State Management (Clean initial state as requested)
      let categoriesList = [];
      try {
        const cached = localStorage.getItem('zaloma_admin_categories_v2');
        if (cached !== null) {
          categoriesList = JSON.parse(cached);
        } else {
          // Clear legacy cache to remove all initial categories
          localStorage.removeItem('zaloma_admin_categories');
          localStorage.setItem('zaloma_admin_categories_v2', JSON.stringify([]));
          categoriesList = [];
        }
      } catch (e) {
        categoriesList = [];
      }

      function updateCategoryBadges() {
        const badge = document.getElementById('tab-cat-badge');
        if (badge) badge.textContent = categoriesList.length;
      }

      function toSlug(str) {
        return (str || '').toLowerCase()
          .replace(/[^\w\s-]/g, '')
          .trim()
          .replace(/\s+/g, '-');
      }

      // Persist categories to localStorage and Supabase Cloud
      async function persistCategories() {
        try {
          localStorage.setItem('zaloma_admin_categories_v2', JSON.stringify(categoriesList));
          localStorage.setItem('zaloma_admin_categories', JSON.stringify(categoriesList));
          updateCategoryDropdowns();
          renderCategoriesCards();
          updateCategoryBadges();

          await supabase.from('products').upsert({
            slug: '_categories_config_',
            name: 'System Categories Config',
            category_slug: '_system_',
            category_name: 'System',
            price_from: 0,
            price_label: 'Rp 0',
            image: 'https://zalomaflorist.com/favicon.ico',
            description: JSON.stringify(categoriesList),
            featured: false,
            city: 'Malang'
          }, { onConflict: 'slug' });
        } catch (err) {
          console.warn('Sync categories notice:', err);
        }
      }

      // Populate Category Dropdowns
      function updateCategoryDropdowns() {
        const catFilter = document.getElementById('category-filter-select');
        const prodCat = document.getElementById('prod-category');
        const editCat = document.getElementById('edit-prod-category');

        const prevFilterVal = catFilter ? catFilter.value : 'all';
        const prevProdVal = prodCat ? prodCat.value : '';
        const prevEditVal = editCat ? editCat.value : '';

        if (catFilter) {
          catFilter.innerHTML = '<option value="all">Semua Kategori</option>' +
            categoriesList.map(c => `<option value="${c.slug}">${c.name}</option>`).join('');
          if (categoriesList.some(c => c.slug === prevFilterVal)) {
            catFilter.value = prevFilterVal;
          } else {
            catFilter.value = 'all';
          }
        }

        if (prodCat) {
          prodCat.innerHTML = '<option value="" disabled selected>Pilih Kategori...</option>' +
            categoriesList.map(c => `<option value="${c.slug}" data-name="${c.name}">${c.name}</option>`).join('');
          if (prevProdVal && categoriesList.some(c => c.slug === prevProdVal)) {
            prodCat.value = prevProdVal;
          }
        }

        if (editCat) {
          editCat.innerHTML = '<option value="" disabled selected>Pilih Kategori...</option>' +
            categoriesList.map(c => `<option value="${c.slug}" data-name="${c.name}">${c.name}</option>`).join('');
          if (prevEditVal && categoriesList.some(c => c.slug === prevEditVal)) {
            editCat.value = prevEditVal;
          }
        }

        updateCategoryBadges();
      }

      // Dynamic Subcategory Select for Add Form
      const prodCategorySelect = document.getElementById('prod-category');
      const prodSubcatWrapper = document.getElementById('prod-subcategory-wrapper');
      const prodSubcatSelect = document.getElementById('prod-subcategory');

      prodCategorySelect?.addEventListener('change', () => {
        const selectedSlug = prodCategorySelect.value;
        const cat = categoriesList.find(c => c.slug === selectedSlug);
        if (cat && cat.subcategories && cat.subcategories.length > 0) {
          prodSubcatSelect.innerHTML = '<option value="">Pilih Subkategori (Opsional)...</option>' +
            cat.subcategories.map(s => `<option value="${s.slug}" data-name="${s.name}">${s.name}</option>`).join('');
          prodSubcatWrapper.classList.remove('hidden');
        } else {
          prodSubcatSelect.innerHTML = '<option value="">Pilih Subkategori...</option>';
          prodSubcatWrapper.classList.add('hidden');
        }
      });

      // Dynamic Subcategory Select for Edit Modal
      const editCategorySelect = document.getElementById('edit-prod-category');
      const editSubcatWrapper = document.getElementById('edit-prod-subcategory-wrapper');
      const editSubcatSelect = document.getElementById('edit-prod-subcategory');

      editCategorySelect?.addEventListener('change', () => {
        const selectedSlug = editCategorySelect.value;
        const cat = categoriesList.find(c => c.slug === selectedSlug);
        if (cat && cat.subcategories && cat.subcategories.length > 0) {
          editSubcatSelect.innerHTML = '<option value="">Pilih Subkategori (Opsional)...</option>' +
            cat.subcategories.map(s => `<option value="${s.slug}" data-name="${s.name}">${s.name}</option>`).join('');
          editSubcatWrapper.classList.remove('hidden');
        } else {
          editSubcatSelect.innerHTML = '<option value="">Pilih Subkategori...</option>';
          editSubcatWrapper.classList.add('hidden');
        }
      });

      // Dynamic Subcategory Filter for Catalog List
      const categoryFilterSelect = document.getElementById('category-filter-select');
      const subcategoryFilterSelect = document.getElementById('subcategory-filter-select');

      categoryFilterSelect?.addEventListener('change', () => {
        const selectedSlug = categoryFilterSelect.value;
        if (selectedSlug !== 'all') {
          const cat = categoriesList.find(c => c.slug === selectedSlug);
          if (cat && cat.subcategories && cat.subcategories.length > 0) {
            subcategoryFilterSelect.innerHTML = '<option value="all">Semua Subkategori</option>' +
              cat.subcategories.map(s => `<option value="${s.slug}">${s.name}</option>`).join('');
            subcategoryFilterSelect.classList.remove('hidden');
          } else {
            subcategoryFilterSelect.classList.add('hidden');
            subcategoryFilterSelect.value = 'all';
          }
        } else {
          subcategoryFilterSelect.classList.add('hidden');
          subcategoryFilterSelect.value = 'all';
        }
        renderFilteredCatalog(true);
      });

      subcategoryFilterSelect?.addEventListener('change', () => renderFilteredCatalog(true));

      // Category Cards Rendering
      function renderCategoriesCards() {
        const container = document.getElementById('categories-cards-grid');
        if (!container) return;

        if (categoriesList.length === 0) {
          container.innerHTML = `
            <div class="col-span-full py-14 text-center bg-white rounded-2xl border border-dashed border-slate-200 p-8 space-y-3">
              <div class="w-12 h-12 rounded-2xl bg-accent-bg text-primary font-serif font-bold text-xl flex items-center justify-center mx-auto shadow-xs">
                +
              </div>
              <h3 class="text-sm font-bold text-slate-800">Belum Ada Kategori</h3>
              <p class="text-xs text-slate-500 max-w-sm mx-auto">Seluruh kategori telah dikosongkan. Klik tombol di bawah untuk menambah kategori baru dan subkategorinya.</p>
              <button 
                type="button" 
                id="open-add-category-empty-btn" 
                class="bg-primary hover:bg-primary-dark text-white font-semibold py-2 px-4 rounded-lg text-xs transition-all active:scale-95 shadow-sm cursor-pointer inline-flex items-center gap-1.5"
              >
                + Tambah Kategori Baru
              </button>
            </div>
          `;
          document.getElementById('open-add-category-empty-btn')?.addEventListener('click', () => {
            openAddCategoryBtn?.click();
          });
          return;
        }

        container.innerHTML = categoriesList.map(cat => {
          const subcats = cat.subcategories || [];
          return `
            <div class="bg-white border border-slate-200 rounded-xl p-4 shadow-2xs hover:border-slate-300 transition-all flex flex-col justify-between space-y-3">
              <div>
                <div class="flex items-start justify-between gap-2">
                  <div>
                    <h3 class="font-bold text-slate-900 text-sm flex items-center gap-1.5">
                      <span>${cat.name}</span>
                      <span class="text-[10px] font-medium px-2 py-0.5 rounded-full bg-slate-100 text-slate-600 font-mono">${cat.slug}</span>
                    </h3>
                    ${cat.description ? `<p class="text-xs text-slate-500 mt-1 line-clamp-1">${cat.description}</p>` : ''}
                  </div>
                  <div class="flex items-center gap-1">
                    <button 
                      type="button" 
                      data-id="${cat.id || cat.slug}" 
                      data-name="${cat.name}" 
                      class="delete-category-btn text-[11px] font-medium text-rose-600 hover:text-rose-700 bg-rose-50 hover:bg-rose-100 px-2 py-1 rounded transition-colors cursor-pointer"
                      title="Hapus Kategori"
                    >
                      Hapus
                    </button>
                  </div>
                </div>

                <!-- Subcategories Chips Section -->
                <div class="mt-3 pt-3 border-t border-slate-100">
                  <div class="flex items-center justify-between mb-2">
                    <span class="text-[11px] font-semibold text-slate-700">Subkategori (${subcats.length}):</span>
                    <button 
                      type="button" 
                      data-cat-id="${cat.id || cat.slug}" 
                      data-cat-name="${cat.name}" 
                      class="open-add-subcat-btn text-[11px] font-semibold text-primary hover:text-primary-dark cursor-pointer flex items-center gap-1"
                    >
                      + Subkategori
                    </button>
                  </div>

                  <div class="flex flex-wrap gap-1.5 min-h-[28px]">
                    ${subcats.length > 0 ? subcats.map(sub => `
                      <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md text-[11px] bg-accent-bg text-primary border border-soft-cream font-medium">
                        <span>${sub.name}</span>
                        <button 
                          type="button" 
                          data-cat-id="${cat.id || cat.slug}" 
                          data-sub-slug="${sub.slug}" 
                          data-sub-name="${sub.name}" 
                          class="delete-subcat-btn text-primary/60 hover:text-rose-600 cursor-pointer font-bold leading-none"
                          title="Hapus Subkategori"
                        >
                          ✕
                        </button>
                      </span>
                    `).join('') : `
                      <span class="text-[11px] text-slate-400 italic">Belum ada subkategori (klik "+ Subkategori" untuk menambah).</span>
                    `}
                  </div>
                </div>
              </div>
            </div>
          `;
        }).join('');

        attachCategoryListeners();
      }

      // Category Action Listeners
      let pendingDeleteCatId = null;
      const categoryModal = document.getElementById('category-modal');
      const openAddCategoryBtn = document.getElementById('open-add-category-btn');
      const closeCategoryModalBtn = document.getElementById('close-category-modal-btn');
      const cancelCategoryBtn = document.getElementById('cancel-category-btn');
      const categoryForm = document.getElementById('category-form');
      const categoryNameInput = document.getElementById('category-name-input');
      const categorySlugInput = document.getElementById('category-slug-input');
      const categoryDescInput = document.getElementById('category-desc-input');
      const modalAddSubcatRowBtn = document.getElementById('modal-add-subcat-row-btn');
      const modalSubcategoriesList = document.getElementById('modal-subcategories-list');

      // Helper to append a dynamic subcategory row inside category modal
      function appendSubcatRow(initialName = '', initialSlug = '') {
        if (!modalSubcategoriesList) return;
        const row = document.createElement('div');
        row.className = 'modal-subcat-row flex items-center gap-2 animate-fade-in bg-slate-50 p-2 rounded-lg border border-slate-200';
        row.innerHTML = `
          <div class="flex-1">
            <input 
              type="text" 
              class="modal-subcat-name-input w-full px-2.5 py-1.5 rounded-md border border-slate-300 text-xs focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary/20 transition-all bg-white" 
              placeholder="Nama Subkategori (misal: Duka Cita)" 
              value="${initialName}"
              required 
            />
          </div>
          <div class="w-28">
            <input 
              type="text" 
              class="modal-subcat-slug-input w-full px-2 py-1.5 rounded-md border border-slate-300 text-[11px] font-mono focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary/20 transition-all bg-white" 
              placeholder="slug" 
              value="${initialSlug}"
            />
          </div>
          <button 
            type="button" 
            class="modal-subcat-remove-btn text-slate-400 hover:text-rose-600 p-1 text-sm font-bold cursor-pointer transition-colors"
            title="Hapus baris subkategori"
          >
            ✕
          </button>
        `;

        const nameInp = row.querySelector('.modal-subcat-name-input');
        const slugInp = row.querySelector('.modal-subcat-slug-input');
        const removeBtn = row.querySelector('.modal-subcat-remove-btn');

        nameInp?.addEventListener('input', () => {
          slugInp.value = toSlug(nameInp.value);
        });

        removeBtn?.addEventListener('click', () => {
          row.remove();
        });

        modalSubcategoriesList.appendChild(row);
        nameInp?.focus();
      }

      modalAddSubcatRowBtn?.addEventListener('click', () => {
        appendSubcatRow();
      });

      openAddCategoryBtn?.addEventListener('click', () => {
        categoryForm.reset();
        document.getElementById('category-edit-id').value = '';
        if (modalSubcategoriesList) modalSubcategoriesList.innerHTML = '';
        categoryModal.classList.remove('hidden');
        categoryNameInput.focus();
      });

      closeCategoryModalBtn?.addEventListener('click', () => categoryModal.classList.add('hidden'));
      cancelCategoryBtn?.addEventListener('click', () => categoryModal.classList.add('hidden'));

      categoryNameInput?.addEventListener('input', () => {
        categorySlugInput.value = toSlug(categoryNameInput.value);
      });

      categoryForm?.addEventListener('submit', async (e) => {
        e.preventDefault();
        const name = categoryNameInput.value.trim();
        let slug = categorySlugInput.value.trim() || toSlug(name);
        const desc = categoryDescInput.value.trim();

        if (!name) return;

        // Check if slug exists
        const existingIdx = categoriesList.findIndex(c => c.slug === slug);
        if (existingIdx !== -1) {
          slug = `${slug}-${Date.now().toString().slice(-4)}`;
        }

        // Collect all subcategories from dynamic input rows
        const subcategories = [];
        const rows = modalSubcategoriesList?.querySelectorAll('.modal-subcat-row') || [];
        rows.forEach(row => {
          const nameInput = row.querySelector('.modal-subcat-name-input');
          const slugInput = row.querySelector('.modal-subcat-slug-input');
          const sName = nameInput ? nameInput.value.trim() : '';
          let sSlug = slugInput ? slugInput.value.trim() : '';
          if (!sSlug) sSlug = toSlug(sName);

          if (sName) {
            subcategories.push({
              id: sSlug,
              name: sName,
              slug: sSlug
            });
          }
        });

        const newCat = {
          id: slug,
          name,
          slug,
          description: desc,
          subcategories: subcategories
        };

        categoriesList.push(newCat);
        await persistCategories();
        categoryModal.classList.add('hidden');
        showToast(`Kategori "${name}" berhasil ditambahkan${subcategories.length > 0 ? ` dengan ${subcategories.length} subkategori` : ''}.`);
      });

      // Subcategory Modal & Handlers
      const subcategoryModal = document.getElementById('subcategory-modal');
      const closeSubcatModalBtn = document.getElementById('close-subcat-modal-btn');
      const cancelSubcatBtn = document.getElementById('cancel-subcat-btn');
      const subcategoryForm = document.getElementById('subcategory-form');
      const subcatParentIdInput = document.getElementById('subcat-parent-category-id');
      const subcatParentLabel = document.getElementById('subcat-parent-label');
      const subcatNameInput = document.getElementById('subcat-name-input');
      const subcatSlugInput = document.getElementById('subcat-slug-input');

      closeSubcatModalBtn?.addEventListener('click', () => subcategoryModal.classList.add('hidden'));
      cancelSubcatBtn?.addEventListener('click', () => subcategoryModal.classList.add('hidden'));

      subcatNameInput?.addEventListener('input', () => {
        subcatSlugInput.value = toSlug(subcatNameInput.value);
      });

      subcategoryForm?.addEventListener('submit', async (e) => {
        e.preventDefault();
        const parentId = subcatParentIdInput.value;
        const name = subcatNameInput.value.trim();
        let slug = subcatSlugInput.value.trim() || toSlug(name);

        if (!name || !parentId) return;

        const parentCat = categoriesList.find(c => (c.id || c.slug) === parentId);
        if (!parentCat) {
          showToast('Kategori induk tidak ditemukan.', 'error');
          return;
        }

        if (!parentCat.subcategories) parentCat.subcategories = [];

        // Check duplicate
        if (parentCat.subcategories.some(s => s.slug === slug)) {
          slug = `${slug}-${Date.now().toString().slice(-4)}`;
        }

        parentCat.subcategories.push({
          id: slug,
          name,
          slug
        });

        await persistCategories();
        subcategoryModal.classList.add('hidden');
        showToast(`Subkategori "${name}" berhasil ditambahkan ke ${parentCat.name}.`);
      });

      // Delete Category Modal & Handlers
      const deleteCatModal = document.getElementById('delete-category-modal');
      const cancelDeleteCatBtn = document.getElementById('cancel-delete-category-btn');
      const confirmDeleteCatBtn = document.getElementById('confirm-delete-category-btn');
      const deleteCatNameLabel = document.getElementById('delete-category-name');

      cancelDeleteCatBtn?.addEventListener('click', () => {
        deleteCatModal.classList.add('hidden');
        pendingDeleteCatId = null;
      });

      confirmDeleteCatBtn?.addEventListener('click', async () => {
        if (!pendingDeleteCatId) return;

        const cat = categoriesList.find(c => (c.id || c.slug) === pendingDeleteCatId);
        const name = cat ? cat.name : '';

        categoriesList = categoriesList.filter(c => (c.id || c.slug) !== pendingDeleteCatId);
        await persistCategories();

        deleteCatModal.classList.add('hidden');
        pendingDeleteCatId = null;
        showToast(`Kategori "${name}" berhasil dihapus.`);
      });

      function attachCategoryListeners() {
        // Open Add Subcategory Button
        document.querySelectorAll('.open-add-subcat-btn').forEach(btn => {
          btn.addEventListener('click', () => {
            const catId = btn.getAttribute('data-cat-id');
            const catName = btn.getAttribute('data-cat-name');
            subcatParentIdInput.value = catId;
            subcatParentLabel.textContent = catName;
            subcategoryForm.reset();
            subcategoryModal.classList.remove('hidden');
            subcatNameInput.focus();
          });
        });

        // Delete Subcategory Button
        document.querySelectorAll('.delete-subcat-btn').forEach(btn => {
          btn.addEventListener('click', async (e) => {
            e.stopPropagation();
            const catId = btn.getAttribute('data-cat-id');
            const subSlug = btn.getAttribute('data-sub-slug');
            const subName = btn.getAttribute('data-sub-name');

            const parentCat = categoriesList.find(c => (c.id || c.slug) === catId);
            if (!parentCat || !parentCat.subcategories) return;

            parentCat.subcategories = parentCat.subcategories.filter(s => s.slug !== subSlug);
            await persistCategories();
            showToast(`Subkategori "${subName}" dihapus.`);
          });
        });

        // Delete Category Button
        document.querySelectorAll('.delete-category-btn').forEach(btn => {
          btn.addEventListener('click', () => {
            const id = btn.getAttribute('data-id');
            const name = btn.getAttribute('data-name');
            pendingDeleteCatId = id;
            if (deleteCatNameLabel) deleteCatNameLabel.textContent = `"${name}"`;
            deleteCatModal.classList.remove('hidden');
          });
        });
      }

      // Initial categories setup
      updateCategoryDropdowns();
      renderCategoriesCards();

      // Live Price Preview Formatting
      const priceInput = document.getElementById('prod-price');
      const pricePreview = document.getElementById('price-preview');
      priceInput.addEventListener('input', () => {
        const val = Number(priceInput.value) || 0;
        pricePreview.textContent = new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', maximumFractionDigits: 0 }).format(val);
      });

      const editPriceInput = document.getElementById('edit-prod-price');
      const editPricePreview = document.getElementById('edit-price-preview');
      editPriceInput?.addEventListener('input', () => {
        const val = Number(editPriceInput.value) || 0;
        editPricePreview.textContent = new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', maximumFractionDigits: 0 }).format(val);
      });

      // Client-side Image Compression Helper
      function compressImage(file, maxDim = 1200, quality = 0.82) {
        return new Promise((resolve, reject) => {
          const img = new Image();
          const reader = new FileReader();

          reader.onload = (e) => { img.src = e.target.result; };
          reader.onerror = reject;

          img.onload = () => {
            let width = img.width;
            let height = img.height;

            if (width > height && width > maxDim) {
              height = Math.round((height * maxDim) / width);
              width = maxDim;
            } else if (height > maxDim) {
              width = Math.round((width * maxDim) / height);
              height = maxDim;
            }

            const canvas = document.createElement('canvas');
            canvas.width = width;
            canvas.height = height;
            const ctx = canvas.getContext('2d');
            ctx.drawImage(img, 0, 0, width, height);

            canvas.toBlob((blob) => {
              if (blob) resolve(blob);
              else reject(new Error('Gagal mengompres gambar'));
            }, 'image/webp', quality);
          };
          reader.readAsDataURL(file);
        });
      }

      // Add Photo File Input Handler
      const imageFileInput = document.getElementById('prod-image-file');
      const imagePreview = document.getElementById('image-preview');
      const previewContainer = document.getElementById('image-preview-container');
      const uploadPrompt = document.getElementById('upload-prompt');
      const origSizeLabel = document.getElementById('orig-size-label');
      const compSizeLabel = document.getElementById('comp-size-label');
      let processedImageBlob = null;

      imageFileInput.addEventListener('change', async (e) => {
        const file = e.target.files[0];
        if (!file) return;

        origSizeLabel.textContent = `${(file.size / 1024).toFixed(0)} KB`;
        try {
          const blob = await compressImage(file);
          processedImageBlob = blob;
          compSizeLabel.textContent = `${(blob.size / 1024).toFixed(0)} KB (WebP)`;
          imagePreview.src = URL.createObjectURL(blob);
          uploadPrompt.classList.add('hidden');
          previewContainer.classList.remove('hidden');
        } catch (err) {
          showToast('Gagal memproses gambar.', 'error');
        }
      });

      // Edit Photo File Input Handler
      const editImageFileInput = document.getElementById('edit-prod-image-file');
      const editImageThumbnail = document.getElementById('edit-image-thumbnail');
      const editImageNote = document.getElementById('edit-image-note');
      let editNewImageBlob = null;

      editImageFileInput?.addEventListener('change', async (e) => {
        const file = e.target.files[0];
        if (!file) return;

        try {
          const blob = await compressImage(file);
          editNewImageBlob = blob;
          editImageThumbnail.src = URL.createObjectURL(blob);
          editImageNote.textContent = `Foto baru: ${(blob.size / 1024).toFixed(0)} KB (WebP)`;
          editImageNote.className = 'text-[10px] text-emerald-600 font-semibold truncate';
        } catch (err) {
          showToast('Gagal memproses gambar baru.', 'error');
        }
      });

      // Refresh Button Handler
      const refreshBtn = document.getElementById('refresh-btn');
      refreshBtn?.addEventListener('click', async () => {
        refreshBtn.textContent = 'Memuat...';
        await loadAllProducts();
        refreshBtn.textContent = 'Muat Ulang';
        showToast('Data diperbarui.');
      });

      // Load Products from Supabase
      async function loadAllProducts() {
        const grid = document.getElementById('catalog-products-grid');
        const tabCountBadge = document.getElementById('tab-count-badge');

        try {
          const { data: products, error } = await supabase
            .from('products')
            .select('*')
            .order('created_at', { ascending: false });

          if (error) throw error;

          // Check for categories configuration record
          const configRow = (products || []).find(p => p.slug === '_categories_config_');
          if (configRow && configRow.description) {
            try {
              const cloudCats = JSON.parse(configRow.description);
              if (Array.isArray(cloudCats)) {
                categoriesList = cloudCats;
                localStorage.setItem('zaloma_admin_categories_v2', JSON.stringify(categoriesList));
                localStorage.setItem('zaloma_admin_categories', JSON.stringify(categoriesList));
                updateCategoryDropdowns();
                renderCategoriesCards();
                updateCategoryBadges();
              }
            } catch (e) {}
          }

          // Filter out internal system rows
          allProductsList = (products || []).filter(p => !p.slug.startsWith('_'));
          if (tabCountBadge) tabCountBadge.textContent = allProductsList.length;

          renderFilteredCatalog();

        } catch (err) {
          grid.innerHTML = `
            <div class="col-span-full py-12 text-center text-rose-600 bg-rose-50 border border-rose-200 rounded-xl p-4 text-xs">
              Gagal mengambil data dari Supabase: ${err.message}
            </div>
          `;
        }
      }

      // Pagination Settings
      const ADMIN_PER_PAGE = 16;
      let adminCurrentPage = 1;

      // Filter & Search Controls
      const searchInput = document.getElementById('search-filter-input');
      const clearSearchBtn = document.getElementById('clear-search-btn');
      const categorySelect = document.getElementById('category-filter-select');
      const sortSelect = document.getElementById('sort-select');

      searchInput.addEventListener('input', () => {
        if (clearSearchBtn) {
          if (searchInput.value.trim()) clearSearchBtn.classList.remove('hidden');
          else clearSearchBtn.classList.add('hidden');
        }
        renderFilteredCatalog(true);
      });

      clearSearchBtn?.addEventListener('click', () => {
        searchInput.value = '';
        clearSearchBtn.classList.add('hidden');
        renderFilteredCatalog(true);
      });

      sortSelect.addEventListener('change', () => renderFilteredCatalog(true));

      // Render Catalog Grid
      function renderFilteredCatalog(resetPage = false) {
        if (resetPage) adminCurrentPage = 1;

        const grid = document.getElementById('catalog-products-grid');
        const pagContainer = document.getElementById('admin-pagination-container');
        const pagStartEl = document.getElementById('admin-pag-start');
        const pagEndEl = document.getElementById('admin-pag-end');
        const pagTotalEl = document.getElementById('admin-pag-total');

        const query = searchInput.value.toLowerCase().trim();
        const cat = categorySelect.value;
        const subcatSelect = document.getElementById('subcategory-filter-select');
        const subcat = subcatSelect ? subcatSelect.value : 'all';
        const sort = sortSelect.value;

        let filtered = allProductsList.filter(p => {
          let matchCat = cat === 'all';
          if (!matchCat) {
            const parentSlug = p.category_slug ? p.category_slug.split('--')[0] : '';
            const catObj = categoriesList.find(c => c.slug === cat);
            const catName = catObj ? catObj.name : '';
            matchCat = parentSlug === cat || p.category_slug === cat || (catName && p.category_name && p.category_name.startsWith(catName));
          }

          let matchSub = subcat === 'all';
          if (!matchSub && matchCat) {
            const catObj = categoriesList.find(c => c.slug === cat);
            const subObj = catObj ? (catObj.subcategories || []).find(s => s.slug === subcat) : null;
            const subName = subObj ? subObj.name : '';
            matchSub = (p.category_slug && p.category_slug.includes('--' + subcat)) || 
                       (subName && p.category_name && p.category_name.includes(' • ' + subName));
          }

          const matchQuery = !query || p.name.toLowerCase().includes(query);
          return matchCat && matchSub && matchQuery;
        });

        // Sorting
        filtered.sort((a, b) => {
          if (sort === 'price-asc') return Number(a.price_from) - Number(b.price_from);
          if (sort === 'price-desc') return Number(b.price_from) - Number(a.price_from);
          if (sort === 'name-asc') return a.name.localeCompare(b.name);
          return new Date(b.created_at).getTime() - new Date(a.created_at).getTime();
        });

        const totalFiltered = filtered.length;
        const totalPages = Math.ceil(totalFiltered / ADMIN_PER_PAGE) || 1;
        if (adminCurrentPage > totalPages) adminCurrentPage = totalPages;

        if (totalFiltered === 0) {
          grid.innerHTML = `
            <div class="col-span-full py-16 text-center text-slate-400 bg-white rounded-xl border border-dashed border-slate-200 p-6 text-xs">
              Tidak ada produk yang cocok dengan pencarian.
            </div>
          `;
          if (pagContainer) pagContainer.classList.add('hidden');
          return;
        }

        if (pagContainer) pagContainer.classList.remove('hidden');

        const startIdx = (adminCurrentPage - 1) * ADMIN_PER_PAGE;
        const endIdx = Math.min(startIdx + ADMIN_PER_PAGE, totalFiltered);
        const paginated = filtered.slice(startIdx, endIdx);

        if (pagStartEl) pagStartEl.textContent = startIdx + 1;
        if (pagEndEl) pagEndEl.textContent = endIdx;
        if (pagTotalEl) pagTotalEl.textContent = totalFiltered;

        grid.innerHTML = paginated.map(p => {
          const detailUrl = `/produk/${p.slug}/`;
          const isFeatured = Boolean(p.featured);

          return `
            <div class="bg-white border border-slate-200 rounded-xl overflow-hidden shadow-2xs hover:border-slate-300 transition-all flex flex-col justify-between group">
              
              <!-- Image frame -->
              <div class="relative aspect-4/3 bg-slate-100 overflow-hidden">
                <img src="${p.image}" alt="${p.name}" loading="lazy" class="w-full h-full object-cover" />
                <span class="absolute top-2 left-2 bg-primary/90 text-white text-[10px] font-medium px-2 py-0.5 rounded backdrop-blur-xs shadow-2xs">
                  ${p.category_name}
                </span>
                ${isFeatured ? '<span class="absolute top-2 right-2 bg-amber-500 text-white text-[10px] font-semibold px-1.5 py-0.5 rounded shadow-2xs">Unggulan</span>' : ''}
              </div>

              <!-- Content -->
              <div class="p-3 flex-1 flex flex-col justify-between">
                <div>
                  <h3 class="font-semibold text-slate-900 text-xs leading-snug line-clamp-2 hover:text-primary transition-colors">
                    <a href="${detailUrl}" target="_blank">${p.name}</a>
                  </h3>
                  <p class="font-bold text-primary text-sm mt-1">${p.price_label}</p>
                </div>

                <!-- Action Row -->
                <div class="pt-2.5 mt-2.5 border-t border-slate-100 flex items-center justify-between gap-1 text-xs">
                  <button 
                    type="button" 
                    data-id="${p.id}" 
                    data-featured="${isFeatured}" 
                    class="quick-toggle-featured text-[11px] font-medium text-slate-500 hover:text-primary cursor-pointer"
                  >
                    ${isFeatured ? 'Lepas Unggulan' : '+ Unggulan'}
                  </button>

                  <div class="flex items-center gap-1">
                    <button 
                      type="button" 
                      data-id="${p.id}" 
                      class="edit-prod-btn text-[11px] font-medium text-slate-700 hover:text-primary hover:bg-accent-bg/60 bg-slate-100 px-2 py-1 rounded transition-colors cursor-pointer"
                    >
                      Edit
                    </button>
                    <button 
                      type="button" 
                      data-id="${p.id}" 
                      data-name="${p.name}" 
                      class="delete-prod-btn text-[11px] font-medium text-rose-600 hover:text-rose-700 bg-rose-50 hover:bg-rose-100 px-2 py-1 rounded transition-colors cursor-pointer"
                    >
                      Hapus
                    </button>
                  </div>
                </div>

              </div>
            </div>
          `;
        }).join('');

        renderAdminPaginationControls(totalPages);
        attachActionListeners();
      }

      function renderAdminPaginationControls(totalPages) {
        const pagControls = document.getElementById('admin-pag-controls');
        if (!pagControls) return;

        if (totalPages <= 1) {
          pagControls.innerHTML = '';
          return;
        }

        let html = `
          <button 
            type="button" 
            class="admin-prev-btn inline-flex items-center justify-center w-7 h-7 rounded border border-slate-200 text-xs font-medium transition-all ${adminCurrentPage === 1 ? 'opacity-30 cursor-not-allowed bg-slate-50' : 'cursor-pointer hover:bg-slate-50 text-slate-700'}"
            ${adminCurrentPage === 1 ? 'disabled' : ''}
          >
            ‹
          </button>
        `;

        for (let p = 1; p <= totalPages; p++) {
          if (p === 1 || p === totalPages || (p >= adminCurrentPage - 1 && p <= adminCurrentPage + 1)) {
            const isActive = p === adminCurrentPage;
            html += `
              <button 
                type="button" 
                data-page="${p}" 
                class="admin-page-btn inline-flex items-center justify-center w-7 h-7 rounded text-xs font-medium cursor-pointer transition-all ${isActive ? 'bg-primary text-white shadow-2xs' : 'border border-slate-200 text-slate-700 hover:text-primary hover:border-primary/40 hover:bg-slate-50'}"
              >
                ${p}
              </button>
            `;
          } else if (p === adminCurrentPage - 2 || p === adminCurrentPage + 2) {
            html += `<span class="px-0.5 text-slate-400 text-xs">...</span>`;
          }
        }

        html += `
          <button 
            type="button" 
            class="admin-next-btn inline-flex items-center justify-center w-7 h-7 rounded border border-slate-200 text-xs font-medium transition-all ${adminCurrentPage === totalPages ? 'opacity-30 cursor-not-allowed bg-slate-50' : 'cursor-pointer hover:bg-slate-50 text-slate-700'}"
            ${adminCurrentPage === totalPages ? 'disabled' : ''}
          >
            ›
          </button>
        `;

        pagControls.innerHTML = html;

        pagControls.querySelectorAll('.admin-page-btn').forEach(btn => {
          btn.addEventListener('click', () => {
            const p = Number(btn.getAttribute('data-page'));
            if (p && p !== adminCurrentPage) {
              adminCurrentPage = p;
              renderFilteredCatalog(false);
              document.getElementById('catalog-products-grid')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
            }
          });
        });

        pagControls.querySelector('.admin-prev-btn')?.addEventListener('click', () => {
          if (adminCurrentPage > 1) {
            adminCurrentPage--;
            renderFilteredCatalog(false);
            document.getElementById('catalog-products-grid')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
          }
        });

        pagControls.querySelector('.admin-next-btn')?.addEventListener('click', () => {
          if (adminCurrentPage < totalPages) {
            adminCurrentPage++;
            renderFilteredCatalog(false);
            document.getElementById('catalog-products-grid')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
          }
        });
      }

      function attachActionListeners() {
        // Toggle Featured Listener
        document.querySelectorAll('.quick-toggle-featured').forEach(btn => {
          btn.addEventListener('click', async () => {
            const id = btn.getAttribute('data-id');
            const currentFeatured = btn.getAttribute('data-featured') === 'true';
            const newFeatured = !currentFeatured;

            btn.disabled = true;

            try {
              const { error } = await supabase
                .from('products')
                .update({ featured: newFeatured })
                .eq('id', id);

              if (error) throw error;

              const p = allProductsList.find(x => x.id === id);
              if (p) p.featured = newFeatured;

              renderFilteredCatalog(false);
              showToast(newFeatured ? 'Produk dijadikan unggulan.' : 'Produk dilepas dari unggulan.');
            } catch (err) {
              showToast('Gagal mengubah status: ' + err.message, 'error');
              btn.disabled = false;
            }
          });
        });

        // Delete Button Listener (Opens Modal)
        document.querySelectorAll('.delete-prod-btn').forEach(btn => {
          btn.addEventListener('click', () => {
            const id = btn.getAttribute('data-id');
            const name = btn.getAttribute('data-name');
            pendingDeleteId = id;

            const modalNameEl = document.getElementById('delete-modal-product-name');
            if (modalNameEl) modalNameEl.textContent = `"${name}"`;

            document.getElementById('delete-modal').classList.remove('hidden');
          });
        });

        // Edit Button Listener (Opens Modal)
        document.querySelectorAll('.edit-prod-btn').forEach(btn => {
          btn.addEventListener('click', () => {
            const id = btn.getAttribute('data-id');
            const p = allProductsList.find(x => x.id === id);
            if (!p) return;

            editNewImageBlob = null;
            document.getElementById('edit-prod-id').value = p.id;
            document.getElementById('edit-prod-current-image').value = p.image;
            document.getElementById('edit-prod-name').value = p.name;
            document.getElementById('edit-prod-price').value = p.price_from;
            document.getElementById('edit-prod-time').value = p.processing_time || '3 - 5 Jam';
            document.getElementById('edit-prod-desc').value = p.description || '';
            document.getElementById('edit-prod-featured').checked = Boolean(p.featured);

            // Parse category and subcategory
            const parentCatSlug = p.category_slug ? p.category_slug.split('--')[0] : '';
            let currentSubcatSlug = p.category_slug && p.category_slug.includes('--') ? p.category_slug.split('--')[1] : '';
            let currentSubcatName = '';
            if (p.category_name && p.category_name.includes(' • ')) {
              currentSubcatName = p.category_name.split(' • ')[1].trim();
            }

            const catSelect = document.getElementById('edit-prod-category');
            const subcatWrapper = document.getElementById('edit-prod-subcategory-wrapper');
            const subcatSelect = document.getElementById('edit-prod-subcategory');

            // Find matching category
            const cat = categoriesList.find(c => c.slug === parentCatSlug || c.slug === p.category_slug || (p.category_name && p.category_name.startsWith(c.name)));
            if (cat && catSelect) {
              catSelect.value = cat.slug;
              if (cat.subcategories && cat.subcategories.length > 0) {
                subcatSelect.innerHTML = '<option value="">Pilih Subkategori (Opsional)...</option>' +
                  cat.subcategories.map(s => `<option value="${s.slug}" data-name="${s.name}">${s.name}</option>`).join('');
                subcatWrapper.classList.remove('hidden');

                if (currentSubcatSlug) {
                  subcatSelect.value = currentSubcatSlug;
                } else if (currentSubcatName) {
                  const matchingSub = cat.subcategories.find(s => s.name.toLowerCase() === currentSubcatName.toLowerCase());
                  if (matchingSub) subcatSelect.value = matchingSub.slug;
                }
              } else {
                subcatSelect.innerHTML = '<option value="">Pilih Subkategori...</option>';
                subcatWrapper.classList.add('hidden');
              }
            }

            const editThumb = document.getElementById('edit-image-thumbnail');
            if (editThumb) editThumb.src = p.image;

            const editNote = document.getElementById('edit-image-note');
            if (editNote) {
              editNote.textContent = 'Kosongkan jika tidak diganti.';
              editNote.className = 'text-[10px] text-slate-400 truncate';
            }

            const editPricePreview = document.getElementById('edit-price-preview');
            if (editPricePreview && p.price_from) {
              editPricePreview.textContent = new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', maximumFractionDigits: 0 }).format(p.price_from);
            }

            document.getElementById('edit-modal').classList.remove('hidden');
          });
        });
      }

      // Delete Modal Actions
      const deleteModal = document.getElementById('delete-modal');
      const cancelDeleteBtn = document.getElementById('cancel-delete-btn');
      const confirmDeleteBtn = document.getElementById('confirm-delete-btn');
      const deleteBtnText = document.getElementById('delete-btn-text');
      const deleteSpinner = document.getElementById('delete-spinner');

      cancelDeleteBtn?.addEventListener('click', () => {
        deleteModal.classList.add('hidden');
        pendingDeleteId = null;
      });

      confirmDeleteBtn?.addEventListener('click', async () => {
        if (!pendingDeleteId) return;

        confirmDeleteBtn.disabled = true;
        deleteBtnText.textContent = 'Menghapus...';
        deleteSpinner.classList.remove('hidden');

        try {
          const { error } = await supabase.from('products').delete().eq('id', pendingDeleteId);
          if (error) throw error;

          deleteModal.classList.add('hidden');
          showToast('Produk berhasil dihapus.');
          loadAllProducts();
        } catch (err) {
          showToast('Gagal menghapus: ' + err.message, 'error');
        } finally {
          confirmDeleteBtn.disabled = false;
          deleteBtnText.textContent = 'Hapus';
          deleteSpinner.classList.add('hidden');
          pendingDeleteId = null;
        }
      });

      // Edit Modal Actions
      const editModal = document.getElementById('edit-modal');
      const closeModalBtn = document.getElementById('close-modal-btn');
      const cancelEditBtn = document.getElementById('cancel-edit-btn');
      const editForm = document.getElementById('edit-product-form');
      const saveEditBtn = document.getElementById('save-edit-btn');
      const saveBtnText = document.getElementById('save-btn-text');
      const saveSpinner = document.getElementById('save-spinner');

      closeModalBtn.addEventListener('click', () => editModal.classList.add('hidden'));
      cancelEditBtn.addEventListener('click', () => editModal.classList.add('hidden'));

      editForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        const id = document.getElementById('edit-prod-id').value;
        const name = document.getElementById('edit-prod-name').value.trim();
        const catSelect = document.getElementById('edit-prod-category');
        const categorySlug = catSelect.value;
        const catObj = categoriesList.find(c => c.slug === categorySlug);
        const categoryName = catObj ? catObj.name : (catSelect.options[catSelect.selectedIndex]?.getAttribute('data-name') || categorySlug);

        const subcatSelect = document.getElementById('edit-prod-subcategory');
        const subcatSlug = subcatSelect ? subcatSelect.value : '';
        const subcatObj = subcatSlug && catObj ? (catObj.subcategories || []).find(s => s.slug === subcatSlug) : null;
        const subcatName = subcatObj ? subcatObj.name : '';

        let finalCategoryName = categoryName;
        let finalCategorySlug = categorySlug;
        if (subcatName) {
          finalCategoryName = `${categoryName} • ${subcatName}`;
          finalCategorySlug = `${categorySlug}--${subcatSlug}`;
        }

        const price_from = Number(document.getElementById('edit-prod-price').value);
        const price_label = new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', maximumFractionDigits: 0 }).format(price_from);
        const processing_time = document.getElementById('edit-prod-time').value.trim();
        const description = document.getElementById('edit-prod-desc').value.trim();
        const featured = document.getElementById('edit-prod-featured').checked;
        let imageUrl = document.getElementById('edit-prod-current-image').value;

        saveEditBtn.disabled = true;
        saveBtnText.textContent = 'Menyimpan...';
        saveSpinner.classList.remove('hidden');

        try {
          if (editNewImageBlob) {
            saveBtnText.textContent = 'Upload foto...';
            const p = allProductsList.find(x => x.id === id);
            const slug = p ? p.slug : `prod-${Date.now()}`;
            const fileName = `${slug}-${Date.now()}.webp`;

            const { error: uploadError } = await supabase.storage
              .from(SUPABASE_BUCKET)
              .upload(fileName, editNewImageBlob, { contentType: 'image/webp', upsert: true });

            if (uploadError) throw new Error('Upload foto gagal: ' + uploadError.message);

            const { data: publicUrlData } = supabase.storage.from(SUPABASE_BUCKET).getPublicUrl(fileName);
            imageUrl = publicUrlData.publicUrl;
          }

          saveBtnText.textContent = 'Menyimpan data...';
          const { error } = await supabase
            .from('products')
            .update({
              name,
              category_slug: finalCategorySlug,
              category_name: finalCategoryName,
              price_from,
              price_label,
              processing_time,
              description,
              featured,
              image: imageUrl
            })
            .eq('id', id);

          if (error) throw error;

          editModal.classList.add('hidden');
          showToast('Produk berhasil diperbarui.');
          loadAllProducts();
        } catch (err) {
          showToast('Gagal menyimpan: ' + err.message, 'error');
        } finally {
          saveEditBtn.disabled = false;
          saveBtnText.textContent = 'Simpan';
          saveSpinner.classList.add('hidden');
        }
      });

      // Add Product Form Handler
      const addForm = document.getElementById('add-product-form');
      const submitBtn = document.getElementById('submit-btn');
      const btnText = document.getElementById('btn-text');
      const btnSpinner = document.getElementById('btn-spinner');

      addForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        if (!processedImageBlob) {
          showToast('Silakan pilih foto produk terlebih dahulu.', 'error');
          return;
        }

        const name = document.getElementById('prod-name').value.trim();
        const categorySelect = document.getElementById('prod-category');
        const categorySlug = categorySelect.value;
        const catObj = categoriesList.find(c => c.slug === categorySlug);
        const categoryName = catObj ? catObj.name : (categorySelect.options[categorySelect.selectedIndex]?.getAttribute('data-name') || categorySlug);

        const subcatSelect = document.getElementById('prod-subcategory');
        const subcatSlug = subcatSelect ? subcatSelect.value : '';
        const subcatObj = subcatSlug && catObj ? (catObj.subcategories || []).find(s => s.slug === subcatSlug) : null;
        const subcatName = subcatObj ? subcatObj.name : '';

        let finalCategoryName = categoryName;
        let finalCategorySlug = categorySlug;
        if (subcatName) {
          finalCategoryName = `${categoryName} • ${subcatName}`;
          finalCategorySlug = `${categorySlug}--${subcatSlug}`;
        }

        const priceFrom = Number(document.getElementById('prod-price').value);
        const priceLabel = new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', maximumFractionDigits: 0 }).format(priceFrom);
        const processingTime = document.getElementById('prod-time').value.trim() || '3 - 5 Jam';
        const description = document.getElementById('prod-desc').value.trim();
        const featured = document.getElementById('prod-featured').checked;
        
        const slugBase = name.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '');
        const slug = `${slugBase}-${Date.now().toString().slice(-4)}`;

        submitBtn.disabled = true;
        btnText.textContent = 'Mengupload & menyimpan...';
        btnSpinner.classList.remove('hidden');

        try {
          const fileName = `${slug}-${Date.now()}.webp`;

          const { error: uploadError } = await supabase.storage
            .from(SUPABASE_BUCKET)
            .upload(fileName, processedImageBlob, { contentType: 'image/webp', upsert: true });

          if (uploadError) throw new Error('Upload foto gagal: ' + uploadError.message);

          const { data: publicUrlData } = supabase.storage.from(SUPABASE_BUCKET).getPublicUrl(fileName);

          const { error: insertError } = await supabase.from('products').insert([{
            name,
            slug,
            category_slug: finalCategorySlug,
            category_name: finalCategoryName,
            price_from: priceFrom,
            price_label: priceLabel,
            image: publicUrlData.publicUrl,
            description,
            featured,
            processing_time: processingTime,
            city: 'Malang'
          }]);

          if (insertError) throw new Error('Simpan database gagal: ' + insertError.message);

          showToast(`Produk "${name}" berhasil ditambahkan.`);
          addForm.reset();
          processedImageBlob = null;
          pricePreview.textContent = 'Rp 0';
          uploadPrompt.classList.remove('hidden');
          previewContainer.classList.add('hidden');

          tabBtnCatalog.click();
          loadAllProducts();

        } catch (err) {
          showToast('Error: ' + err.message, 'error');
        } finally {
          submitBtn.disabled = false;
          btnText.textContent = 'Simpan Produk';
          btnSpinner.classList.add('hidden');
        }
      });
    </script>

    <style>
      @keyframes fadeIn {
        from { opacity: 0; transform: translateY(3px); }
        to { opacity: 1; transform: translateY(0); }
      }

      @keyframes modalPop {
        from { opacity: 0; transform: scale(0.97); }
        to { opacity: 1; transform: scale(1); }
      }

      @keyframes toastIn {
        from { opacity: 0; transform: translateY(-8px); }
        to { opacity: 1; transform: translateY(0); }
      }

      .animate-fade-in {
        animation: fadeIn 0.18s ease-out forwards;
      }

      .animate-modal-pop {
        animation: modalPop 0.15s ease-out forwards;
      }

      .animate-toast-in {
        animation: toastIn 0.18s ease-out forwards;
      }
    </style>
  </body>
</html>
