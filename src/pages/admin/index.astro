---
import '../../styles/global.css';
import { CATEGORIES } from '../../data/products';
import { SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_BUCKET } from '../../data/supabaseConfig';
import { withBase } from '../../utils/paths';

const title = "Admin — Zaloma Florist";
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/x-icon" href={withBase('/favicon.ico')} />
    <script is:inline src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
  </head>
  <body class="bg-slate-100/70 text-slate-800 font-sans antialiased min-h-screen flex flex-col">

    <!-- Toast Notification Container -->
    <div id="toast-container" class="fixed top-4 right-4 z-50 flex flex-col gap-2 pointer-events-none" aria-live="polite"></div>

    <!-- ================= LOGIN SCREEN ================= -->
    <div id="login-gate" class="flex-1 flex items-center justify-center p-4">
      <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-8 w-full max-w-sm animate-fade-in">
        <div class="mb-6">
          <h1 class="text-xl font-bold text-slate-900 tracking-tight">Admin Zaloma Florist</h1>
          <p class="text-xs text-slate-500 mt-1">Masuk untuk mengelola produk toko.</p>
        </div>

        <form id="login-form" class="space-y-4">
          <div>
            <label for="admin-email-input" class="block text-xs font-semibold text-slate-700 mb-1">Email</label>
            <input 
              type="email" 
              id="admin-email-input" 
              placeholder="nama@gmail.com" 
              class="w-full px-3.5 py-2.5 rounded-lg border border-slate-300 focus:outline-none focus:border-slate-800 focus:ring-1 focus:ring-slate-800 transition-all text-sm"
              required
              autocomplete="email"
            />
          </div>
          <div>
            <label for="admin-password-input" class="block text-xs font-semibold text-slate-700 mb-1">Password</label>
            <input 
              type="password" 
              id="admin-password-input" 
              placeholder="••••••••" 
              class="w-full px-3.5 py-2.5 rounded-lg border border-slate-300 focus:outline-none focus:border-slate-800 focus:ring-1 focus:ring-slate-800 transition-all text-sm"
              required
              autocomplete="current-password"
            />
            <p id="login-error" class="text-xs text-rose-600 mt-2 font-medium hidden animate-fade-in"></p>
          </div>
          <button 
            type="submit" 
            id="login-btn"
            class="w-full bg-slate-900 hover:bg-slate-800 text-white font-semibold py-2.5 px-4 rounded-lg transition-all duration-150 cursor-pointer text-sm flex items-center justify-center gap-2 active:scale-[0.98]"
          >
            <span id="login-btn-text">Masuk</span>
            <svg id="login-spinner" class="w-4 h-4 animate-spin hidden" fill="none" viewBox="0 0 24 24">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
            </svg>
          </button>
        </form>
      </div>
    </div>

    <!-- ================= MAIN ADMIN APP ================= -->
    <div id="admin-dashboard" class="hidden flex-1 flex flex-col">

      <!-- Minimal Navbar (No customer headers, no marketing slogans) -->
      <nav class="bg-white border-b border-slate-200 sticky top-0 z-30">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 flex items-center justify-between h-14">
          
          <!-- Left: Brand & Tabs -->
          <div class="flex items-center gap-6">
            <span class="font-bold text-slate-900 text-sm tracking-tight flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
              Zaloma Admin
            </span>

            <div class="flex items-center gap-1 border-l border-slate-200 pl-4 sm:pl-6">
              <button 
                type="button" 
                id="tab-btn-catalog" 
                class="tab-btn active px-3 py-1.5 rounded-md text-xs font-semibold bg-slate-900 text-white transition-all cursor-pointer flex items-center gap-1.5"
              >
                <span>Produk</span>
                <span id="tab-count-badge" class="px-1.5 py-0.2 rounded-full text-[10px] font-bold bg-white/20 text-white">0</span>
              </button>
              <button 
                type="button" 
                id="tab-btn-add" 
                class="tab-btn px-3 py-1.5 rounded-md text-xs font-semibold text-slate-600 hover:text-slate-900 hover:bg-slate-100 transition-all cursor-pointer"
              >
                + Tambah Produk
              </button>
            </div>
          </div>

          <!-- Right: User Email & Actions -->
          <div class="flex items-center gap-3">
            <a 
              href="/katalog/" 
              target="_blank" 
              class="text-xs font-medium text-slate-500 hover:text-slate-900 transition-colors hidden sm:inline-block"
            >
              Lihat Website ↗
            </a>
            <span id="user-email-display" class="text-xs text-slate-400 hidden md:inline-block max-w-[180px] truncate"></span>
            <button 
              id="logout-btn" 
              type="button" 
              class="text-xs font-semibold text-rose-600 hover:text-rose-700 hover:bg-rose-50 px-2.5 py-1.5 rounded-md transition-colors cursor-pointer"
            >
              Keluar
            </button>
          </div>

        </div>
      </nav>

      <!-- Content Area -->
      <main class="flex-1 max-w-7xl w-full mx-auto p-4 sm:p-6 space-y-4">

        <!-- ================= TAB 1: DAFTAR PRODUK ================= -->
        <section id="tab-catalog" class="space-y-4 animate-fade-in">
          
          <!-- Filter & Search Toolbar -->
          <div class="bg-white p-3 rounded-xl border border-slate-200 flex flex-col sm:flex-row gap-2.5 items-stretch sm:items-center justify-between">
            <div class="relative flex-1">
              <input 
                type="text" 
                id="search-filter-input" 
                placeholder="Cari nama produk..." 
                class="w-full pl-3 pr-8 py-1.5 rounded-lg border border-slate-200 text-xs focus:outline-none focus:border-slate-800 transition-all"
              />
              <button 
                type="button" 
                id="clear-search-btn" 
                class="hidden absolute right-2.5 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-600 text-xs font-bold cursor-pointer"
              >
                ✕
              </button>
            </div>

            <div class="flex items-center gap-2">
              <select 
                id="category-filter-select" 
                class="px-2.5 py-1.5 rounded-lg border border-slate-200 text-xs bg-white text-slate-700 focus:outline-none focus:border-slate-800 transition-all cursor-pointer"
              >
                <option value="all">Semua Kategori</option>
                {CATEGORIES.map(cat => (
                  <option value={cat.slug}>{cat.name}</option>
                ))}
              </select>

              <select 
                id="sort-select" 
                class="px-2.5 py-1.5 rounded-lg border border-slate-200 text-xs bg-white text-slate-700 focus:outline-none focus:border-slate-800 transition-all cursor-pointer"
              >
                <option value="newest">Terbaru</option>
                <option value="price-asc">Harga Terendah</option>
                <option value="price-desc">Harga Tertinggi</option>
                <option value="name-asc">Nama A-Z</option>
              </select>

              <button 
                type="button" 
                id="refresh-btn" 
                title="Muat ulang data" 
                class="px-2.5 py-1.5 rounded-lg border border-slate-200 text-slate-600 hover:text-slate-900 hover:bg-slate-50 text-xs font-semibold transition-all cursor-pointer active:scale-95"
              >
                Muat Ulang
              </button>
            </div>
          </div>

          <!-- Products Grid -->
          <div id="catalog-products-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-3.5">
            <div class="col-span-full py-16 text-center text-slate-400 text-xs">
              <svg class="w-6 h-6 animate-spin mx-auto text-slate-400 mb-2" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
              </svg>
              Memuat data produk...
            </div>
          </div>

          <!-- Pagination Container -->
          <div id="admin-pagination-container" class="bg-white p-3 rounded-xl border border-slate-200 flex flex-col sm:flex-row items-center justify-between gap-2.5 text-xs">
            <p id="admin-pag-info" class="text-slate-500 font-medium">
              Menampilkan <span id="admin-pag-start" class="font-bold text-slate-800">0</span> - <span id="admin-pag-end" class="font-bold text-slate-800">0</span> dari <span id="admin-pag-total" class="font-bold text-slate-800">0</span> produk
            </p>
            <div class="flex items-center gap-1" id="admin-pag-controls"></div>
          </div>
        </section>

        <!-- ================= TAB 2: TAMBAH PRODUK ================= -->
        <section id="tab-add" class="hidden animate-fade-in max-w-2xl mx-auto">
          <div class="bg-white rounded-2xl p-5 sm:p-6 border border-slate-200 shadow-xs">
            <div class="mb-5 pb-3 border-b border-slate-100">
              <h2 class="text-base font-bold text-slate-900">Tambah Produk Baru</h2>
              <p class="text-xs text-slate-500 mt-0.5">Produk akan langsung tampil di website.</p>
            </div>

            <form id="add-product-form" class="space-y-4">
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                
                <div class="sm:col-span-2">
                  <label for="prod-name" class="block text-xs font-semibold text-slate-700 mb-1">
                    Nama Produk <span class="text-rose-500">*</span>
                  </label>
                  <input 
                    type="text" 
                    id="prod-name" 
                    required 
                    placeholder="Contoh: Bunga Papan Wedding 2x1.5m"
                    class="w-full px-3 py-2 rounded-lg border border-slate-300 text-xs focus:outline-none focus:border-slate-800 transition-all"
                  />
                </div>

                <div>
                  <label for="prod-category" class="block text-xs font-semibold text-slate-700 mb-1">
                    Kategori <span class="text-rose-500">*</span>
                  </label>
                  <select 
                    id="prod-category" 
                    required
                    class="w-full px-3 py-2 rounded-lg border border-slate-300 text-xs focus:outline-none focus:border-slate-800 transition-all bg-white cursor-pointer"
                  >
                    <option value="" disabled selected>Pilih Kategori...</option>
                    {CATEGORIES.map(cat => (
                      <option value={cat.slug} data-name={cat.name}>{cat.name}</option>
                    ))}
                  </select>
                </div>

                <div>
                  <label for="prod-price" class="block text-xs font-semibold text-slate-700 mb-1">
                    Harga (Rp) <span class="text-rose-500">*</span>
                  </label>
                  <input 
                    type="number" 
                    id="prod-price" 
                    required 
                    min="10000" 
                    step="5000"
                    placeholder="450000"
                    class="w-full px-3 py-2 rounded-lg border border-slate-300 text-xs font-mono focus:outline-none focus:border-slate-800 transition-all"
                  />
                  <p id="price-preview" class="text-[11px] font-semibold text-slate-600 mt-1">Rp 0</p>
                </div>

                <div class="sm:col-span-2">
                  <label for="prod-time" class="block text-xs font-semibold text-slate-700 mb-1">
                    Estimasi Pengerjaan
                  </label>
                  <input 
                    type="text" 
                    id="prod-time" 
                    value="3 - 5 Jam" 
                    placeholder="Contoh: 3 - 5 Jam"
                    class="w-full px-3 py-2 rounded-lg border border-slate-300 text-xs focus:outline-none focus:border-slate-800 transition-all"
                  />
                </div>

              </div>

              <!-- Upload Foto -->
              <div>
                <label class="block text-xs font-semibold text-slate-700 mb-1">
                  Foto Produk <span class="text-rose-500">*</span>
                </label>
                
                <div class="border border-dashed border-slate-300 hover:border-slate-400 rounded-xl p-4 text-center bg-slate-50 transition-all relative cursor-pointer" id="dropzone">
                  <input 
                    type="file" 
                    id="prod-image-file" 
                    accept="image/*" 
                    required
                    class="absolute inset-0 w-full h-full opacity-0 cursor-pointer z-10"
                  />
                  
                  <div id="upload-prompt" class="space-y-1 py-3">
                    <p class="text-xs font-semibold text-slate-700">Pilih Foto atau Potret dari Kamera</p>
                    <p class="text-[11px] text-slate-400">Otomatis dikompres ke WebP ringan sebelum diupload.</p>
                  </div>

                  <div id="image-preview-container" class="hidden space-y-2 animate-fade-in">
                    <img id="image-preview" src="" alt="Preview" class="max-h-48 mx-auto rounded-lg object-contain border border-slate-200 bg-white" />
                    <div class="flex items-center justify-center gap-2 text-[11px]">
                      <span id="orig-size-label" class="text-slate-400">0 KB</span>
                      <span class="text-slate-300">→</span>
                      <span id="comp-size-label" class="font-semibold text-emerald-600">0 KB (WebP)</span>
                    </div>
                  </div>
                </div>
              </div>

              <!-- Deskripsi -->
              <div>
                <label for="prod-desc" class="block text-xs font-semibold text-slate-700 mb-1">
                  Deskripsi Singkat (Opsional)
                </label>
                <textarea 
                  id="prod-desc" 
                  rows="2" 
                  placeholder="Keterangan singkat produk..."
                  class="w-full px-3 py-2 rounded-lg border border-slate-300 text-xs focus:outline-none focus:border-slate-800 transition-all resize-y"
                ></textarea>
              </div>

              <!-- Featured Checkbox -->
              <div class="flex items-center gap-2 pt-1">
                <input 
                  type="checkbox" 
                  id="prod-featured" 
                  class="w-4 h-4 rounded text-slate-900 border-slate-300 cursor-pointer"
                />
                <label for="prod-featured" class="text-xs text-slate-700 cursor-pointer font-medium">
                  Tampilkan sebagai produk unggulan di beranda
                </label>
              </div>

              <div class="pt-3 border-t border-slate-100 flex items-center justify-end">
                <button 
                  type="submit" 
                  id="submit-btn" 
                  class="bg-slate-900 hover:bg-slate-800 text-white font-semibold py-2 px-5 rounded-lg transition-all duration-150 cursor-pointer text-xs active:scale-95 flex items-center gap-1.5"
                >
                  <span id="btn-text">Simpan Produk</span>
                  <svg id="btn-spinner" class="w-3.5 h-3.5 animate-spin hidden" fill="none" viewBox="0 0 24 24">
                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
                  </svg>
                </button>
              </div>
            </form>
          </div>
        </section>

      </main>

    </div>

    <!-- ================= EDIT MODAL ================= -->
    <div id="edit-modal" class="hidden fixed inset-0 z-50 bg-black/40 backdrop-blur-xs flex items-center justify-center p-4 animate-fade-in">
      <div class="bg-white rounded-2xl max-w-md w-full p-5 sm:p-6 shadow-xl border border-slate-200 space-y-4 animate-modal-pop">
        <div class="flex items-center justify-between pb-3 border-b border-slate-100">
          <h3 class="text-sm font-bold text-slate-900">Edit Produk</h3>
          <button id="close-modal-btn" type="button" class="text-slate-400 hover:text-slate-600 text-sm font-bold cursor-pointer">✕</button>
        </div>

        <form id="edit-product-form" class="space-y-3">
          <input type="hidden" id="edit-prod-id" />
          <input type="hidden" id="edit-prod-current-image" />

          <div>
            <label class="block text-xs font-semibold text-slate-700 mb-1">Nama Produk</label>
            <input type="text" id="edit-prod-name" required class="w-full px-3 py-1.5 rounded-lg border border-slate-300 text-xs focus:outline-none focus:border-slate-800 transition-all" />
          </div>

          <div class="grid grid-cols-2 gap-3">
            <div>
              <label class="block text-xs font-semibold text-slate-700 mb-1">Kategori</label>
              <select id="edit-prod-category" required class="w-full px-2.5 py-1.5 rounded-lg border border-slate-300 text-xs bg-white focus:outline-none focus:border-slate-800 transition-all cursor-pointer">
                {CATEGORIES.map(cat => (
                  <option value={cat.slug} data-name={cat.name}>{cat.name}</option>
                ))}
              </select>
            </div>
            <div>
              <label class="block text-xs font-semibold text-slate-700 mb-1">Harga (Rp)</label>
              <input type="number" id="edit-prod-price" required step="5000" class="w-full px-2.5 py-1.5 rounded-lg border border-slate-300 text-xs font-mono focus:outline-none focus:border-slate-800 transition-all" />
              <p id="edit-price-preview" class="text-[10px] font-semibold text-slate-500 mt-0.5 truncate"></p>
            </div>
          </div>

          <div>
            <label class="block text-xs font-semibold text-slate-700 mb-1">Foto</label>
            <div class="flex items-center gap-2.5 p-2 rounded-lg border border-slate-200 bg-slate-50">
              <img id="edit-image-thumbnail" src="" alt="Thumb" class="w-10 h-10 rounded object-cover border border-slate-200 bg-white shrink-0" />
              <div class="flex-1 min-w-0">
                <label for="edit-prod-image-file" class="text-[11px] font-semibold text-slate-700 hover:text-slate-900 cursor-pointer underline">
                  Ganti Foto
                  <input type="file" id="edit-prod-image-file" accept="image/*" class="hidden" />
                </label>
                <p id="edit-image-note" class="text-[10px] text-slate-400 truncate">Kosongkan jika tidak diganti.</p>
              </div>
            </div>
          </div>

          <div>
            <label class="block text-xs font-semibold text-slate-700 mb-1">Estimasi Pengerjaan</label>
            <input type="text" id="edit-prod-time" class="w-full px-3 py-1.5 rounded-lg border border-slate-300 text-xs focus:outline-none focus:border-slate-800 transition-all" />
          </div>

          <div>
            <label class="block text-xs font-semibold text-slate-700 mb-1">Deskripsi</label>
            <textarea id="edit-prod-desc" rows="2" class="w-full px-3 py-1.5 rounded-lg border border-slate-300 text-xs focus:outline-none focus:border-slate-800 transition-all resize-y"></textarea>
          </div>

          <div class="flex items-center gap-2 pt-1">
            <input type="checkbox" id="edit-prod-featured" class="w-4 h-4 rounded text-slate-900 border-slate-300 cursor-pointer" />
            <label for="edit-prod-featured" class="text-xs text-slate-700 cursor-pointer font-medium">Produk unggulan beranda</label>
          </div>

          <div class="pt-3 border-t border-slate-100 flex items-center justify-end gap-2">
            <button type="button" id="cancel-edit-btn" class="px-3 py-1.5 rounded-lg text-xs font-semibold text-slate-500 hover:bg-slate-100 cursor-pointer">Batal</button>
            <button type="submit" id="save-edit-btn" class="bg-slate-900 hover:bg-slate-800 text-white font-semibold py-1.5 px-4 rounded-lg text-xs transition-all active:scale-95 flex items-center gap-1.5 cursor-pointer">
              <span id="save-btn-text">Simpan</span>
              <svg id="save-spinner" class="w-3.5 h-3.5 animate-spin hidden" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
              </svg>
            </button>
          </div>
        </form>
      </div>
    </div>

    <!-- ================= DELETE MODAL ================= -->
    <div id="delete-modal" class="hidden fixed inset-0 z-50 bg-black/40 backdrop-blur-xs flex items-center justify-center p-4 animate-fade-in">
      <div class="bg-white rounded-2xl max-w-xs w-full p-5 shadow-xl border border-slate-200 text-center space-y-3 animate-modal-pop">
        <h3 class="text-sm font-bold text-slate-900">Hapus Produk?</h3>
        <p id="delete-modal-product-name" class="text-xs text-slate-600 line-clamp-2 font-medium"></p>
        <p class="text-[11px] text-slate-400">Produk akan dihapus permanen dari website.</p>
        
        <div class="flex items-center gap-2 pt-2">
          <button type="button" id="cancel-delete-btn" class="flex-1 px-3 py-1.5 rounded-lg text-xs font-semibold text-slate-600 bg-slate-100 hover:bg-slate-200 cursor-pointer">Batal</button>
          <button type="button" id="confirm-delete-btn" class="flex-1 bg-rose-600 hover:bg-rose-700 text-white font-semibold py-1.5 px-3 rounded-lg text-xs transition-all active:scale-95 flex items-center justify-center gap-1 cursor-pointer">
            <span id="delete-btn-text">Hapus</span>
            <svg id="delete-spinner" class="w-3.5 h-3.5 animate-spin hidden" fill="none" viewBox="0 0 24 24">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
            </svg>
          </button>
        </div>
      </div>
    </div>

    <script define:vars={{ SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_BUCKET }}>
      // Initialize Supabase Client
      const supabase = window.supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY);

      // Auth UI Elements
      const loginGate = document.getElementById('login-gate');
      const adminDashboard = document.getElementById('admin-dashboard');
      const loginForm = document.getElementById('login-form');
      const emailInput = document.getElementById('admin-email-input');
      const passwordInput = document.getElementById('admin-password-input');
      const loginError = document.getElementById('login-error');
      const loginBtn = document.getElementById('login-btn');
      const loginBtnText = document.getElementById('login-btn-text');
      const loginSpinner = document.getElementById('login-spinner');
      const logoutBtn = document.getElementById('logout-btn');
      const userEmailDisplay = document.getElementById('user-email-display');

      let allProductsList = [];
      let pendingDeleteId = null;

      // Toast Notification Helper
      function showToast(message, type = 'success') {
        const container = document.getElementById('toast-container');
        if (!container) return;

        const toast = document.createElement('div');
        const isSuccess = type === 'success';
        const isError = type === 'error';
        const bgClass = isSuccess ? 'bg-slate-900 text-white' : isError ? 'bg-rose-700 text-white' : 'bg-slate-800 text-white';

        toast.className = `pointer-events-auto flex items-center justify-between gap-3 px-3.5 py-2.5 rounded-xl shadow-lg text-xs font-medium ${bgClass} animate-toast-in`;
        toast.innerHTML = `
          <span>${message}</span>
          <button type="button" class="text-white/60 hover:text-white text-xs cursor-pointer ml-1">✕</button>
        `;

        toast.querySelector('button')?.addEventListener('click', () => {
          toast.remove();
        });

        container.appendChild(toast);

        setTimeout(() => {
          if (toast.isConnected) toast.remove();
        }, 3000);
      }

      // Supabase Auth State Listener
      supabase.auth.onAuthStateChange((event, session) => {
        if (session && session.user) {
          loginGate.classList.add('hidden');
          adminDashboard.classList.remove('hidden');
