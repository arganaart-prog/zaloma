---
import Layout from '../../layouts/Layout.astro';
import { CATEGORIES, PRODUCTS } from '../../data/products';
import { SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_BUCKET } from '../../data/supabaseConfig';
import { WHATSAPP_NUMBER } from '../../data/constants';

const title = "Pusat Kontrol & Dashboard Produk — Zaloma Florist";
const description = "Dashboard kelola seluruh katalog produk Zaloma Florist Malang.";

// Minimal default products payload for migration
const INITIAL_PRODUCTS = PRODUCTS.map(p => ({
  name: p.name,
  slug: p.slug,
  category_slug: p.categorySlug,
  category_name: p.categoryName,
  price_from: p.priceFrom,
  price_label: p.priceLabel,
  image: p.image.startsWith('http') ? p.image : `https://zalomaflorist.com${p.image}`,
  description: p.description || '',
  featured: p.featured || false,
  processing_time: p.processingTime || '3 - 5 Jam',
  city: p.city || 'Malang'
}));
---

<Layout title={title} description={description} robots="noindex, nofollow" showTestimonials={false}>
  <!-- Supabase JS SDK via CDN -->
  <script is:inline src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>

  <div class="min-h-screen bg-slate-50/70 py-6 px-3 sm:px-6 lg:px-8 font-sans">
    <div class="max-w-6xl mx-auto">

      <!-- ================= LOGIN SCREEN ================= -->
      <div id="login-gate" class="bg-white rounded-2xl shadow-xl border border-soft-cream p-6 sm:p-10 max-w-md mx-auto text-center my-12">
        <div class="w-16 h-16 rounded-2xl bg-accent-bg text-primary flex items-center justify-center mx-auto mb-4 border border-soft-cream shadow-xs">
          <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
          </svg>
        </div>
        <h1 class="font-serif text-2xl font-bold text-slate-800">Admin Zaloma Florist</h1>
        <p class="text-xs sm:text-sm text-slate-500 mt-1 mb-6">Pusat kontrol dan manajemen seluruh produk toko bunga.</p>

        <form id="login-form" class="space-y-4 text-left">
          <div>
            <label for="admin-email-input" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">Email Admin</label>
            <input 
              type="email" 
              id="admin-email-input" 
              placeholder="nama@gmail.com" 
              class="w-full px-4 py-3 rounded-xl border border-slate-300 focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all text-sm"
              required
              autocomplete="email"
            />
          </div>
          <div>
            <label for="admin-password-input" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">Password</label>
            <input 
              type="password" 
              id="admin-password-input" 
              placeholder="••••••••" 
              class="w-full px-4 py-3 rounded-xl border border-slate-300 focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all text-sm"
              required
              autocomplete="current-password"
            />
            <p id="login-error" class="text-xs text-rose-600 mt-2 font-semibold hidden"></p>
          </div>
          <button 
            type="submit" 
            id="login-btn"
            class="w-full bg-primary hover:bg-primary-dark text-white font-bold py-3.5 px-6 rounded-xl shadow-md hover:shadow-lg transition-all duration-200 cursor-pointer text-sm flex items-center justify-center gap-2"
          >
            <span id="login-btn-text">Masuk ke Dashboard</span>
            <svg id="login-spinner" class="w-4 h-4 animate-spin hidden" fill="none" viewBox="0 0 24 24">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
            </svg>
          </button>
        </form>
        <p class="text-[11px] text-slate-400 mt-6 flex items-center justify-center gap-1.5">
          <svg class="w-3.5 h-3.5 text-emerald-600 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M2.166 4.999A11.954 11.954 0 0010 1.944 11.954 11.954 0 0017.834 5c.11.65.166 1.32.166 2.001 0 5.225-3.34 9.67-8 11.317C5.34 16.67 2 12.225 2 7c0-.682.057-1.35.166-2.001zm11.541 3.708a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" /></svg>
          Diproteksi Supabase Enterprise Authentication
        </p>
      </div>

      <!-- ================= MAIN DASHBOARD ================= -->
      <div id="admin-dashboard" class="hidden space-y-6">

        <!-- Top Navigation Bar -->
        <header class="bg-white rounded-2xl p-4 sm:p-6 border border-soft-cream/80 shadow-xs flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-primary text-white flex items-center justify-center font-serif font-bold text-lg shadow-xs">
              Z
            </div>
            <div>
              <div class="flex items-center gap-2">
                <h1 class="font-serif text-xl sm:text-2xl font-bold text-slate-800">Dashboard Toko Bunga</h1>
                <span class="inline-flex items-center gap-1 text-[10px] font-bold uppercase tracking-wider text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded-full border border-emerald-200">
                  <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span> Cloud Aktif
                </span>
              </div>
              <p class="text-xs text-slate-500">Kelola harga, foto, kategori, dan stok semua produk Zaloma Florist.</p>
            </div>
          </div>

          <div class="flex items-center gap-2 w-full md:w-auto">
            <span id="user-email-display" class="text-xs font-semibold text-slate-600 bg-slate-100 px-3 py-2 rounded-xl hidden sm:inline-block"></span>
            <a 
              href="/katalog/" 
              target="_blank" 
              class="flex-1 md:flex-initial inline-flex items-center justify-center gap-1.5 px-3.5 py-2 text-xs font-semibold rounded-xl border border-slate-200 text-slate-700 hover:bg-slate-50 transition-colors"
            >
              Lihat Website ↗
            </a>
            <button 
              id="logout-btn" 
              type="button" 
              class="px-3.5 py-2 text-xs font-semibold rounded-xl bg-slate-100 text-slate-600 hover:bg-rose-50 hover:text-rose-600 transition-colors cursor-pointer"
            >
              Keluar
            </button>
          </div>
        </header>

        <!-- Stats Overview Cards -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 sm:gap-4">
          <div class="bg-white p-4 rounded-xl border border-slate-200/80 shadow-2xs">
            <span class="text-[11px] font-bold text-slate-400 uppercase tracking-wider block">Total Produk</span>
            <p id="stat-total" class="font-serif text-2xl font-bold text-slate-800 mt-1">0</p>
          </div>
          <div class="bg-white p-4 rounded-xl border border-slate-200/80 shadow-2xs">
            <span class="text-[11px] font-bold text-slate-400 uppercase tracking-wider block">Produk Populer</span>
            <p id="stat-featured" class="font-serif text-2xl font-bold text-primary mt-1">0</p>
          </div>
          <div class="bg-white p-4 rounded-xl border border-slate-200/80 shadow-2xs">
            <span class="text-[11px] font-bold text-slate-400 uppercase tracking-wider block">Kategori Aktif</span>
            <p id="stat-categories" class="font-serif text-2xl font-bold text-secondary-dark mt-1">{CATEGORIES.length}</p>
          </div>
          <div class="bg-white p-4 rounded-xl border border-slate-200/80 shadow-2xs">
            <span class="text-[11px] font-bold text-slate-400 uppercase tracking-wider block">Penyimpanan Cloud</span>
            <p class="font-serif text-sm font-bold text-emerald-600 mt-2.5 flex items-center gap-1">
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" /></svg>
              Tersambung
            </p>
          </div>
        </div>

        <!-- Migration Banner (Appears if Supabase has 0 products) -->
        <div id="migration-banner" class="hidden bg-gradient-to-r from-amber-50 to-orange-50 border border-amber-200 rounded-2xl p-5 shadow-xs">
          <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
            <div class="flex items-start gap-3">
              <span class="text-2xl">💡</span>
              <div>
                <h3 class="font-bold text-slate-800 text-sm sm:text-base">Impor Semua Produk Bawaan ({INITIAL_PRODUCTS.length} Produk) ke Cloud?</h3>
                <p class="text-xs text-slate-600 mt-0.5">Database Supabase Anda masih kosong. Klik tombol di kanan untuk memasukkan seluruh produk katalog bawaan ke database agar semuanya bisa langsung Anda atur dan edit dari HP.</p>
              </div>
            </div>
            <button 
              id="import-defaults-btn" 
              type="button" 
              class="w-full sm:w-auto shrink-0 bg-primary hover:bg-primary-dark text-white font-bold py-2.5 px-5 rounded-xl text-xs shadow-sm transition-all cursor-pointer flex items-center justify-center gap-2"
            >
              <span id="import-btn-text">Impor Semua Produk Sekarang</span>
              <svg id="import-spinner" class="w-4 h-4 animate-spin hidden" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
              </svg>
            </button>
          </div>
        </div>

        <!-- Navigation Tabs -->
        <div class="flex items-center gap-2 border-b border-slate-200">
          <button 
            type="button" 
            id="tab-btn-catalog" 
            class="tab-btn active px-4 py-3 text-xs sm:text-sm font-bold border-b-2 border-primary text-primary transition-colors cursor-pointer"
          >
            📋 Semua Produk Toko
          </button>
          <button 
            type="button" 
            id="tab-btn-add" 
            class="tab-btn px-4 py-3 text-xs sm:text-sm font-bold border-b-2 border-transparent text-slate-500 hover:text-slate-800 transition-colors cursor-pointer"
          >
            ➕ Tambah Produk Baru
          </button>
        </div>

        <!-- ================= TAB 1: SEMUA PRODUK ================= -->
        <section id="tab-catalog" class="space-y-4">
          
          <!-- Search & Filter Controls -->
          <div class="bg-white p-4 rounded-xl border border-slate-200/80 shadow-2xs flex flex-col md:flex-row gap-3 items-stretch md:items-center justify-between">
            <div class="relative flex-1">
              <svg class="w-4 h-4 text-slate-400 absolute left-3.5 top-1/2 -translate-y-1/2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
              </svg>
              <input 
                type="text" 
                id="search-filter-input" 
                placeholder="Cari produk berdasarkan nama..." 
                class="w-full pl-10 pr-4 py-2.5 rounded-xl border border-slate-200 text-xs sm:text-sm focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary/20"
              />
            </div>

            <div class="flex items-center gap-2">
              <select 
                id="category-filter-select" 
                class="px-3 py-2.5 rounded-xl border border-slate-200 text-xs sm:text-sm bg-white text-slate-700 focus:outline-none focus:border-primary"
              >
                <option value="all">Semua Kategori</option>
                {CATEGORIES.map(cat => (
                  <option value={cat.slug}>{cat.name}</option>
                ))}
              </select>

              <select 
                id="sort-select" 
                class="px-3 py-2.5 rounded-xl border border-slate-200 text-xs sm:text-sm bg-white text-slate-700 focus:outline-none focus:border-primary"
              >
                <option value="newest">Terbaru</option>
                <option value="price-asc">Harga Terendah</option>
                <option value="price-desc">Harga Tertinggi</option>
                <option value="name-asc">Nama (A - Z)</option>
              </select>
            </div>
          </div>

          <!-- Product Grid -->
          <div id="catalog-products-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
            <div class="col-span-full py-16 text-center text-slate-400 text-sm">
              <svg class="w-8 h-8 animate-spin mx-auto text-primary mb-3" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
              </svg>
              Memuat data produk...
            </div>
          </div>

          <!-- Admin Pagination Container -->
          <div id="admin-pagination-container" class="bg-white p-4 rounded-xl border border-slate-200/80 shadow-2xs flex flex-col sm:flex-row items-center justify-between gap-3">
            <p id="admin-pag-info" class="text-xs text-slate-500 font-medium">
              Menampilkan <span id="admin-pag-start" class="font-bold text-slate-700">0</span> - <span id="admin-pag-end" class="font-bold text-slate-700">0</span> dari <span id="admin-pag-total" class="font-bold text-slate-700">0</span> produk
            </p>
            <div class="flex items-center gap-1.5" id="admin-pag-controls">
              <!-- Rendered by JS -->
            </div>
          </div>
        </section>

        <!-- ================= TAB 2: TAMBAH PRODUK BARU ================= -->
        <section id="tab-add" class="hidden">
          <div class="bg-white rounded-2xl p-6 sm:p-8 border border-soft-cream shadow-xs">
            <div class="mb-6 pb-4 border-b border-slate-100">
              <h2 class="font-serif text-xl font-bold text-slate-800">Tambah Produk Baru</h2>
              <p class="text-xs text-slate-500 mt-0.5">Produk baru akan langsung tampil di website dan katalog seketika.</p>
            </div>

            <form id="add-product-form" class="space-y-6">
              <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                
                <!-- Nama Produk -->
                <div class="space-y-1.5">
                  <label for="prod-name" class="block text-xs font-bold uppercase tracking-wider text-slate-700">
                    Nama Produk <span class="text-rose-500">*</span>
                  </label>
                  <input 
                    type="text" 
                    id="prod-name" 
                    required 
                    placeholder="Contoh: Bunga Papan Wedding Mewah 2x1.5m"
                    class="w-full px-4 py-3 rounded-xl border border-slate-200 text-sm focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all"
                  />
                </div>

                <!-- Kategori -->
                <div class="space-y-1.5">
                  <label for="prod-category" class="block text-xs font-bold uppercase tracking-wider text-slate-700">
                    Kategori <span class="text-rose-500">*</span>
                  </label>
                  <select 
                    id="prod-category" 
                    required
                    class="w-full px-4 py-3 rounded-xl border border-slate-200 text-sm focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all bg-white"
                  >
                    <option value="" disabled selected>Pilih Kategori...</option>
                    {CATEGORIES.map(cat => (
                      <option value={cat.slug} data-name={cat.name}>{cat.name}</option>
                    ))}
                  </select>
                </div>

                <!-- Harga -->
                <div class="space-y-1.5">
                  <label for="prod-price" class="block text-xs font-bold uppercase tracking-wider text-slate-700">
                    Harga (Rupiah) <span class="text-rose-500">*</span>
                  </label>
                  <div class="relative">
                    <span class="absolute left-4 top-1/2 -translate-y-1/2 text-sm font-bold text-slate-400">Rp</span>
                    <input 
                      type="number" 
                      id="prod-price" 
                      required 
                      min="10000" 
                      step="5000"
                      placeholder="450000"
                      class="w-full pl-12 pr-4 py-3 rounded-xl border border-slate-200 text-sm font-semibold focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all font-mono"
                    />
                  </div>
                  <p id="price-preview" class="text-[11px] font-bold text-primary mt-1">Format: Rp 0</p>
                </div>

                <!-- Estimasi Waktu -->
                <div class="space-y-1.5">
                  <label for="prod-time" class="block text-xs font-bold uppercase tracking-wider text-slate-700">
                    Estimasi Pengerjaan
                  </label>
                  <input 
                    type="text" 
                    id="prod-time" 
                    value="3 - 5 Jam" 
                    placeholder="Contoh: 3 - 5 Jam"
                    class="w-full px-4 py-3 rounded-xl border border-slate-200 text-sm focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all"
                  />
                </div>

              </div>

              <!-- Upload Foto dengan Auto Compress -->
              <div class="space-y-2">
                <label class="block text-xs font-bold uppercase tracking-wider text-slate-700">
                  Foto Produk <span class="text-rose-500">*</span>
                </label>
                
                <div class="border-2 border-dashed border-slate-300 hover:border-primary rounded-2xl p-6 text-center bg-slate-50/60 transition-colors relative cursor-pointer" id="dropzone">
                  <input 
                    type="file" 
                    id="prod-image-file" 
                    accept="image/*" 
                    required
                    class="absolute inset-0 w-full h-full opacity-0 cursor-pointer z-10"
                  />
                  
                  <div id="upload-prompt" class="space-y-2">
                    <div class="w-12 h-12 rounded-full bg-accent-bg text-primary flex items-center justify-center mx-auto border border-soft-cream">
                      <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z" />
                        <path stroke-linecap="round" stroke-linejoin="round" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z" />
                      </svg>
                    </div>
                    <p class="text-sm font-bold text-slate-700">Pilih Foto atau Potret dari Kamera HP</p>
                    <p class="text-xs text-slate-400">Otomatis dikompres ke format WebP ringan (~150 KB) sebelum diupload.</p>
                  </div>

                  <!-- Preview Gambar -->
                  <div id="image-preview-container" class="hidden space-y-3">
                    <img id="image-preview" src="" alt="Preview Foto" class="max-h-64 mx-auto rounded-xl object-contain shadow-sm border border-slate-200" />
                    <div class="flex items-center justify-center gap-3 text-xs">
                      <span id="orig-size-label" class="text-slate-400">Asli: 0 KB</span>
                      <span class="text-slate-300">→</span>
                      <span id="comp-size-label" class="font-bold text-emerald-600 bg-emerald-50 px-2 py-0.5 rounded-full">Kompres: 0 KB</span>
                    </div>
                    <p class="text-[11px] text-slate-400">Ketuk gambar untuk mengganti foto</p>
                  </div>

                </div>
              </div>

              <!-- Deskripsi Produk -->
              <div class="space-y-1.5">
                <label for="prod-desc" class="block text-xs font-bold uppercase tracking-wider text-slate-700">
                  Deskripsi Singkat (Opsional)
                </label>
                <textarea 
                  id="prod-desc" 
                  rows="2" 
                  placeholder="Rangkaian bunga segar berkualitas tinggi. Difoto sebelum dikirim ke lokasi, gratis ongkir Kota Malang."
                  class="w-full px-4 py-3 rounded-xl border border-slate-200 text-sm focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all resize-y"
                ></textarea>
              </div>

              <!-- Featured Checkbox -->
              <div class="flex items-center gap-2 pt-1">
                <input 
                  type="checkbox" 
                  id="prod-featured" 
                  class="w-4 h-4 rounded text-primary focus:ring-primary border-slate-300 cursor-pointer"
                />
                <label for="prod-featured" class="text-xs font-semibold text-slate-700 cursor-pointer">
                  Tandai sebagai Produk Terpopuler / Unggulan
                </label>
              </div>

              <!-- Submit Button -->
              <div class="pt-4 border-t border-slate-100 flex items-center justify-end gap-3">
                <button 
                  type="submit" 
                  id="submit-btn" 
                  class="w-full sm:w-auto inline-flex items-center justify-center gap-2 bg-primary hover:bg-primary-dark text-white font-bold py-3.5 px-8 rounded-xl shadow-md hover:shadow-lg transition-all duration-200 cursor-pointer text-sm"
                >
                  <span id="btn-text">Simpan &amp; Publikasikan Produk</span>
                  <svg id="btn-spinner" class="w-4 h-4 animate-spin hidden" fill="none" viewBox="0 0 24 24">
                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
                  </svg>
                </button>
              </div>

              <div id="form-alert" class="hidden p-4 rounded-xl text-sm font-medium"></div>
            </form>
          </div>
        </section>

      </div>

    </div>
  </div>

  <!-- ================= EDIT PRODUCT MODAL ================= -->
  <div id="edit-modal" class="hidden fixed inset-0 z-50 bg-black/60 backdrop-blur-xs flex items-center justify-center p-4 overflow-y-auto">
    <div class="bg-white rounded-2xl max-w-lg w-full p-6 sm:p-8 shadow-2xl border border-slate-200 my-8 space-y-5">
      <div class="flex items-center justify-between pb-3 border-b border-slate-100">
        <h3 class="font-serif text-lg font-bold text-slate-800">Edit Produk</h3>
        <button id="close-modal-btn" type="button" class="text-slate-400 hover:text-slate-600 text-xl font-bold cursor-pointer">✕</button>
      </div>

      <form id="edit-product-form" class="space-y-4">
        <input type="hidden" id="edit-prod-id" />

        <div>
          <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">Nama Produk</label>
          <input type="text" id="edit-prod-name" required class="w-full px-3 py-2.5 rounded-xl border border-slate-200 text-sm focus:outline-none focus:border-primary" />
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">Kategori</label>
            <select id="edit-prod-category" required class="w-full px-3 py-2.5 rounded-xl border border-slate-200 text-xs sm:text-sm bg-white focus:outline-none focus:border-primary">
              {CATEGORIES.map(cat => (
                <option value={cat.slug} data-name={cat.name}>{cat.name}</option>
              ))}
            </select>
          </div>
          <div>
            <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">Harga (Rp)</label>
            <input type="number" id="edit-prod-price" required step="5000" class="w-full px-3 py-2.5 rounded-xl border border-slate-200 text-sm font-semibold font-mono focus:outline-none focus:border-primary" />
          </div>
        </div>

        <div>
          <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">Estimasi Pengerjaan</label>
          <input type="text" id="edit-prod-time" class="w-full px-3 py-2.5 rounded-xl border border-slate-200 text-sm focus:outline-none focus:border-primary" />
        </div>

        <div>
          <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">Deskripsi</label>
          <textarea id="edit-prod-desc" rows="2" class="w-full px-3 py-2 rounded-xl border border-slate-200 text-xs sm:text-sm focus:outline-none focus:border-primary"></textarea>
        </div>

        <div class="flex items-center gap-2">
          <input type="checkbox" id="edit-prod-featured" class="w-4 h-4 rounded text-primary focus:ring-primary border-slate-300 cursor-pointer" />
          <label for="edit-prod-featured" class="text-xs font-semibold text-slate-700 cursor-pointer">Produk Populer / Unggulan</label>
        </div>

        <div class="pt-4 border-t border-slate-100 flex items-center justify-end gap-2">
          <button type="button" id="cancel-edit-btn" class="px-4 py-2.5 rounded-xl text-xs font-semibold text-slate-600 hover:bg-slate-100 cursor-pointer">Batal</button>
          <button type="submit" id="save-edit-btn" class="bg-primary hover:bg-primary-dark text-white font-bold py-2.5 px-6 rounded-xl text-xs shadow-md cursor-pointer">Simpan Perubahan</button>
        </div>
      </form>
    </div>
  </div>

</Layout>

<script define:vars={{ SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_BUCKET, WHATSAPP_NUMBER, INITIAL_PRODUCTS }}>
  // Initialize Supabase Client
  const supabase = window.supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY);

  // Auth UI Elements
  const loginGate = document.getElementById('login-gate');
  const adminDashboard = document.getElementById('admin-dashboard');
  const loginForm = document.getElementById('login-form');
  const emailInput = document.getElementById('admin-email-input');
  const passwordInput = document.getElementById('admin-password-input');
  const loginError = document.getElementById('login-error');
  const loginBtn = document.getElementById('login-btn');
  const loginBtnText = document.getElementById('login-btn-text');
  const loginSpinner = document.getElementById('login-spinner');
  const logoutBtn = document.getElementById('logout-btn');
  const userEmailDisplay = document.getElementById('user-email-display');

  let allProductsList = [];

  // Listen to Supabase Auth State (Auto-login & persistent session)
  supabase.auth.onAuthStateChange((event, session) => {
    if (session && session.user) {
      loginGate.classList.add('hidden');
      adminDashboard.classList.remove('hidden');
      if (userEmailDisplay) {
        userEmailDisplay.textContent = `👤 ${session.user.email}`;
      }
      loadAllProducts();
    } else {
      loginGate.classList.remove('hidden');
      adminDashboard.classList.add('hidden');
    }
  });

  // Login with Supabase Auth
  loginForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    const email = emailInput.value.trim();
    const password = passwordInput.value;

    loginBtn.disabled = true;
    loginBtnText.textContent = 'Memverifikasi...';
    loginSpinner.classList.remove('hidden');
    loginError.classList.add('hidden');

    try {
      const { data, error } = await supabase.auth.signInWithPassword({
        email,
        password
      });

      if (error) throw error;
      // onAuthStateChange handles UI switch automatically
    } catch (err) {
      console.error(err);
      loginError.textContent = err.message === 'Invalid login credentials'
        ? 'Email atau password salah. Pastikan password sudah benar.'
        : `Gagal login: ${err.message}`;
      loginError.classList.remove('hidden');
    } finally {
      loginBtn.disabled = false;
      loginBtnText.textContent = 'Masuk ke Dashboard';
      loginSpinner.classList.add('hidden');
    }
  });

  // Logout
  logoutBtn.addEventListener('click', async () => {
    logoutBtn.disabled = true;
    logoutBtn.textContent = 'Keluar...';
    await supabase.auth.signOut();
    logoutBtn.disabled = false;
    logoutBtn.textContent = 'Keluar';
  });

  // Tab Switching
  const tabBtnCatalog = document.getElementById('tab-btn-catalog');
  const tabBtnAdd = document.getElementById('tab-btn-add');
  const tabCatalog = document.getElementById('tab-catalog');
  const tabAdd = document.getElementById('tab-add');

  tabBtnCatalog.addEventListener('click', () => {
    tabBtnCatalog.classList.add('border-primary', 'text-primary');
    tabBtnCatalog.classList.remove('border-transparent', 'text-slate-500');
    tabBtnAdd.classList.remove('border-primary', 'text-primary');
    tabBtnAdd.classList.add('border-transparent', 'text-slate-500');
    tabCatalog.classList.remove('hidden');
    tabAdd.classList.add('hidden');
  });

  tabBtnAdd.addEventListener('click', () => {
    tabBtnAdd.classList.add('border-primary', 'text-primary');
    tabBtnAdd.classList.remove('border-transparent', 'text-slate-500');
    tabBtnCatalog.classList.remove('border-primary', 'text-primary');
    tabBtnCatalog.classList.add('border-transparent', 'text-slate-500');
    tabAdd.classList.remove('hidden');
    tabCatalog.classList.add('hidden');
  });

  // Price formatting helper
  const priceInput = document.getElementById('prod-price');
  const pricePreview = document.getElementById('price-preview');
  priceInput.addEventListener('input', () => {
    const val = Number(priceInput.value) || 0;
    pricePreview.textContent = 'Format: ' + new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', maximumFractionDigits: 0 }).format(val);
  });

  // Client-side Canvas Image Compression
  const imageFileInput = document.getElementById('prod-image-file');
  const imagePreview = document.getElementById('image-preview');
  const previewContainer = document.getElementById('image-preview-container');
  const uploadPrompt = document.getElementById('upload-prompt');
  const origSizeLabel = document.getElementById('orig-size-label');
  const compSizeLabel = document.getElementById('comp-size-label');
  let processedImageBlob = null;

  imageFileInput.addEventListener('change', async (e) => {
    const file = e.target.files[0];
    if (!file) return;

    origSizeLabel.textContent = `Asli: ${(file.size / 1024).toFixed(0)} KB`;
    const img = new Image();
    const reader = new FileReader();

    reader.onload = (re) => { img.src = re.target.result; };
    img.onload = () => {
      const maxDim = 1200;
      let width = img.width;
      let height = img.height;

      if (width > height && width > maxDim) {
        height = Math.round((height * maxDim) / width);
        width = maxDim;
      } else if (height > maxDim) {
        width = Math.round((width * maxDim) / height);
        height = maxDim;
      }

      const canvas = document.createElement('canvas');
      canvas.width = width;
      canvas.height = height;
      const ctx = canvas.getContext('2d');
      ctx.drawImage(img, 0, 0, width, height);

      canvas.toBlob((blob) => {
        processedImageBlob = blob;
        compSizeLabel.textContent = `Kompres: ${(blob.size / 1024).toFixed(0)} KB`;
        imagePreview.src = URL.createObjectURL(blob);
        uploadPrompt.classList.add('hidden');
        previewContainer.classList.remove('hidden');
      }, 'image/webp', 0.82);
    };
    reader.readAsDataURL(file);
  });

  // Load All Products from Supabase
  async function loadAllProducts() {
    const grid = document.getElementById('catalog-products-grid');
    const statTotal = document.getElementById('stat-total');
    const statFeatured = document.getElementById('stat-featured');
    const migrationBanner = document.getElementById('migration-banner');

    try {
      const { data: products, error } = await supabase
        .from('products')
        .select('*')
        .order('created_at', { ascending: false });

      if (error) throw error;

      allProductsList = products || [];

      // Check if migration is needed
      if (allProductsList.length === 0) {
        migrationBanner.classList.remove('hidden');
      } else {
        migrationBanner.classList.add('hidden');
      }

      // Update Stats
      statTotal.textContent = allProductsList.length;
      statFeatured.textContent = allProductsList.filter(p => p.featured).length;

      renderFilteredCatalog();

    } catch (err) {
      console.error(err);
      grid.innerHTML = `
        <div class="col-span-full py-12 text-center text-rose-600 bg-rose-50 border border-rose-200 rounded-xl p-4 text-xs">
          Gagal mengambil data dari Supabase: ${err.message}. Pastikan koneksi internet aktif.
        </div>
      `;
    }
  }

  // Admin Pagination Settings
  const ADMIN_PER_PAGE = 12;
  let adminCurrentPage = 1;

  // Filter & Render Catalog Cards
  const searchInput = document.getElementById('search-filter-input');
  const categorySelect = document.getElementById('category-filter-select');
  const sortSelect = document.getElementById('sort-select');

  searchInput.addEventListener('input', () => renderFilteredCatalog(true));
  categorySelect.addEventListener('change', () => renderFilteredCatalog(true));
  sortSelect.addEventListener('change', () => renderFilteredCatalog(true));

  function renderFilteredCatalog(resetPage = false) {
    if (resetPage) adminCurrentPage = 1;

    const grid = document.getElementById('catalog-products-grid');
    const pagContainer = document.getElementById('admin-pagination-container');
    const pagStartEl = document.getElementById('admin-pag-start');
    const pagEndEl = document.getElementById('admin-pag-end');
    const pagTotalEl = document.getElementById('admin-pag-total');

    const query = searchInput.value.toLowerCase().trim();
    const cat = categorySelect.value;
    const sort = sortSelect.value;

    let filtered = allProductsList.filter(p => {
      const matchCat = cat === 'all' || p.category_slug === cat;
      const matchQuery = !query || p.name.toLowerCase().includes(query) || (p.description && p.description.toLowerCase().includes(query));
      return matchCat && matchQuery;
    });

    // Sorting
    filtered.sort((a, b) => {
      if (sort === 'price-asc') return Number(a.price_from) - Number(b.price_from);
      if (sort === 'price-desc') return Number(b.price_from) - Number(a.price_from);
      if (sort === 'name-asc') return a.name.localeCompare(b.name);
      return new Date(b.created_at).getTime() - new Date(a.created_at).getTime();
    });

    const totalFiltered = filtered.length;
    const totalPages = Math.ceil(totalFiltered / ADMIN_PER_PAGE) || 1;
    if (adminCurrentPage > totalPages) adminCurrentPage = totalPages;

    if (totalFiltered === 0) {
      grid.innerHTML = `
        <div class="col-span-full py-16 text-center text-slate-400 bg-white rounded-xl border border-dashed border-slate-200">
          <p class="font-serif font-bold text-base text-slate-700">Tidak ada produk yang cocok</p>
          <p class="text-xs text-slate-500 mt-1">Coba ubah kata kunci pencarian atau ganti pilihan kategori.</p>
        </div>
      `;
      if (pagContainer) pagContainer.classList.add('hidden');
      return;
    }

    if (pagContainer) pagContainer.classList.remove('hidden');

    const startIdx = (adminCurrentPage - 1) * ADMIN_PER_PAGE;
    const endIdx = Math.min(startIdx + ADMIN_PER_PAGE, totalFiltered);
    const paginated = filtered.slice(startIdx, endIdx);

    if (pagStartEl) pagStartEl.textContent = startIdx + 1;
    if (pagEndEl) pagEndEl.textContent = endIdx;
    if (pagTotalEl) pagTotalEl.textContent = totalFiltered;

    grid.innerHTML = paginated.map(p => `
      <div class="bg-white border border-slate-200/90 rounded-2xl overflow-hidden shadow-2xs hover:shadow-md hover:border-primary/40 transition-all flex flex-col justify-between group">
        <div class="relative aspect-4/3 bg-slate-100 overflow-hidden">
          <img src="${p.image}" alt="${p.name}" loading="lazy" class="w-full h-full object-cover group-hover:scale-102 transition-transform duration-300" />
          <span class="absolute top-2.5 left-2.5 bg-black/60 text-white text-[10px] font-bold px-2.5 py-0.5 rounded-full backdrop-blur-xs">
            ${p.category_name}
          </span>
          ${p.featured ? '<span class="absolute top-2.5 right-2.5 bg-amber-500 text-white text-[10px] font-bold px-2 py-0.5 rounded shadow-xs">Unggulan</span>' : ''}
        </div>

        <div class="p-4 sm:p-5 flex-1 flex flex-col justify-between">
          <div>
            <h3 class="font-serif font-bold text-slate-800 text-sm sm:text-base leading-snug line-clamp-2">${p.name}</h3>
            <p class="font-sans font-extrabold text-primary text-base sm:text-lg mt-1.5">${p.price_label}</p>
            ${p.description ? `<p class="text-xs text-slate-500 line-clamp-2 mt-1.5">${p.description}</p>` : ''}
          </div>

          <div class="pt-3.5 mt-3.5 border-t border-slate-100 flex items-center justify-between gap-2">
            <a 
              href="https://wa.me/${WHATSAPP_NUMBER}?text=Halo%20Zaloma%20Florist,%20saya%20tertarik%20dengan%20${encodeURIComponent(p.name)}" 
              target="_blank" 
              class="text-[11px] font-bold text-emerald-700 hover:text-emerald-800 flex items-center gap-1"
            >
              Tes WA ↗
            </a>

            <div class="flex items-center gap-1.5">
              <button 
                type="button" 
                data-id="${p.id}" 
                class="edit-prod-btn text-[11px] font-bold text-slate-700 hover:text-primary bg-slate-100 hover:bg-primary/10 px-3 py-1.5 rounded-lg transition-colors cursor-pointer"
              >
                ✏️ Edit
              </button>
              <button 
                type="button" 
                data-id="${p.id}" 
                data-name="${p.name}" 
                class="delete-prod-btn text-[11px] font-bold text-rose-600 hover:text-rose-800 bg-rose-50 hover:bg-rose-100 px-3 py-1.5 rounded-lg transition-colors cursor-pointer"
              >
                Hapus
              </button>
            </div>
          </div>
        </div>
      </div>
    `).join('');

    renderAdminPaginationControls(totalPages);
    attachActionListeners();
  }

  function renderAdminPaginationControls(totalPages) {
    const pagControls = document.getElementById('admin-pag-controls');
    if (!pagControls) return;

    if (totalPages <= 1) {
      pagControls.innerHTML = '';
      return;
    }

    let html = `
      <button 
        type="button" 
        class="admin-prev-btn inline-flex items-center justify-center w-8 h-8 rounded-lg border border-slate-200 text-xs font-bold transition-all ${adminCurrentPage === 1 ? 'opacity-40 cursor-not-allowed bg-slate-50 text-slate-300' : 'cursor-pointer hover:border-primary hover:text-primary text-slate-700 bg-white shadow-2xs'}"
        ${adminCurrentPage === 1 ? 'disabled' : ''}
        aria-label="Halaman Sebelumnya"
      >
        ‹
      </button>
    `;

    for (let p = 1; p <= totalPages; p++) {
      if (p === 1 || p === totalPages || (p >= adminCurrentPage - 1 && p <= adminCurrentPage + 1)) {
        const isActive = p === adminCurrentPage;
        html += `
          <button 
            type="button" 
            data-page="${p}" 
            class="admin-page-btn inline-flex items-center justify-center w-8 h-8 rounded-lg text-xs font-bold transition-all cursor-pointer ${isActive ? 'bg-primary text-white shadow-xs' : 'border border-slate-200 text-slate-700 bg-white hover:border-primary hover:text-primary shadow-2xs'}"
          >
            ${p}
          </button>
        `;
      } else if (p === adminCurrentPage - 2 || p === adminCurrentPage + 2) {
        html += `<span class="px-1 text-slate-400 text-xs font-bold">...</span>`;
      }
    }

    html += `
      <button 
        type="button" 
        class="admin-next-btn inline-flex items-center justify-center w-8 h-8 rounded-lg border border-slate-200 text-xs font-bold transition-all ${adminCurrentPage === totalPages ? 'opacity-40 cursor-not-allowed bg-slate-50 text-slate-300' : 'cursor-pointer hover:border-primary hover:text-primary text-slate-700 bg-white shadow-2xs'}"
        ${adminCurrentPage === totalPages ? 'disabled' : ''}
        aria-label="Halaman Selanjutnya"
      >
        ›
      </button>
    `;

    pagControls.innerHTML = html;

    pagControls.querySelectorAll('.admin-page-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const p = Number(btn.getAttribute('data-page'));
        if (p && p !== adminCurrentPage) {
          adminCurrentPage = p;
          renderFilteredCatalog(false);
          document.getElementById('catalog-products-grid')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      });
    });

    pagControls.querySelector('.admin-prev-btn')?.addEventListener('click', () => {
      if (adminCurrentPage > 1) {
        adminCurrentPage--;
        renderFilteredCatalog(false);
        document.getElementById('catalog-products-grid')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    });

    pagControls.querySelector('.admin-next-btn')?.addEventListener('click', () => {
      if (adminCurrentPage < totalPages) {
        adminCurrentPage++;
        renderFilteredCatalog(false);
        document.getElementById('catalog-products-grid')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    });
  }

  function attachActionListeners() {
    // Delete Button Listener
    document.querySelectorAll('.delete-prod-btn').forEach(btn => {
      btn.addEventListener('click', async () => {
        const id = btn.getAttribute('data-id');
        const name = btn.getAttribute('data-name');
        if (!confirm(`Apakah Anda yakin ingin menghapus "${name}"?`)) return;

        btn.textContent = '...';
        btn.disabled = true;

        try {
          const { error } = await supabase.from('products').delete().eq('id', id);
          if (error) throw error;
          loadAllProducts();
        } catch (err) {
          alert('Gagal menghapus: ' + err.message);
          btn.textContent = 'Hapus';
          btn.disabled = false;
        }
      });
    });

    // Edit Button Listener
    document.querySelectorAll('.edit-prod-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const id = btn.getAttribute('data-id');
        const p = allProductsList.find(x => x.id === id);
        if (!p) return;

        document.getElementById('edit-prod-id').value = p.id;
        document.getElementById('edit-prod-name').value = p.name;
        document.getElementById('edit-prod-category').value = p.category_slug;
        document.getElementById('edit-prod-price').value = p.price_from;
        document.getElementById('edit-prod-time').value = p.processing_time || '3 - 5 Jam';
        document.getElementById('edit-prod-desc').value = p.description || '';
        document.getElementById('edit-prod-featured').checked = p.featured;

        document.getElementById('edit-modal').classList.remove('hidden');
      });
    });
  }

  // Edit Modal Actions
  const editModal = document.getElementById('edit-modal');
  const closeModalBtn = document.getElementById('close-modal-btn');
  const cancelEditBtn = document.getElementById('cancel-edit-btn');
  const editForm = document.getElementById('edit-product-form');

  closeModalBtn.addEventListener('click', () => editModal.classList.add('hidden'));
  cancelEditBtn.addEventListener('click', () => editModal.classList.add('hidden'));

  editForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    const id = document.getElementById('edit-prod-id').value;
    const name = document.getElementById('edit-prod-name').value.trim();
    const catSelect = document.getElementById('edit-prod-category');
    const category_slug = catSelect.value;
    const category_name = catSelect.options[catSelect.selectedIndex].getAttribute('data-name');
    const price_from = Number(document.getElementById('edit-prod-price').value);
    const price_label = new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', maximumFractionDigits: 0 }).format(price_from);
    const processing_time = document.getElementById('edit-prod-time').value.trim();
    const description = document.getElementById('edit-prod-desc').value.trim();
    const featured = document.getElementById('edit-prod-featured').checked;

    const saveBtn = document.getElementById('save-edit-btn');
    saveBtn.textContent = 'Menyimpan...';
    saveBtn.disabled = true;

    try {
      const { error } = await supabase
        .from('products')
        .update({
          name,
          category_slug,
          category_name,
          price_from,
          price_label,
          processing_time,
          description,
          featured
        })
        .eq('id', id);

      if (error) throw error;

      editModal.classList.add('hidden');
      loadAllProducts();
    } catch (err) {
      alert('Gagal mengupdate produk: ' + err.message);
    } finally {
      saveBtn.textContent = 'Simpan Perubahan';
      saveBtn.disabled = false;
    }
  });

  // Import Default Products Batch Action
  const importBtn = document.getElementById('import-defaults-btn');
  const importBtnText = document.getElementById('import-btn-text');
  const importSpinner = document.getElementById('import-spinner');

  importBtn?.addEventListener('click', async () => {
    if (!confirm(`Impor ${INITIAL_PRODUCTS.length} produk katalog sekarang ke database cloud?`)) return;

    importBtn.disabled = true;
    importBtnText.textContent = `Mengimpor ${INITIAL_PRODUCTS.length} Produk...`;
    importSpinner.classList.remove('hidden');

    try {
      const { error } = await supabase.from('products').upsert(INITIAL_PRODUCTS, { onConflict: 'slug' });
      if (error) throw error;
      alert(`Sukses! ${INITIAL_PRODUCTS.length} produk berhasil diimpor ke database Supabase.`);
      loadAllProducts();
    } catch (err) {
      alert('Gagal mengimpor: ' + err.message);
    } finally {
      importBtn.disabled = false;
      importBtnText.textContent = 'Impor Semua Produk Sekarang';
      importSpinner.classList.add('hidden');
    }
  });

  // Add Product Form
  const addForm = document.getElementById('add-product-form');
  const submitBtn = document.getElementById('submit-btn');
  const btnText = document.getElementById('btn-text');
  const btnSpinner = document.getElementById('btn-spinner');
  const formAlert = document.getElementById('form-alert');

  addForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!processedImageBlob) {
      alert('Silakan pilih atau potret foto produk terlebih dahulu.');
      return;
    }

    const name = document.getElementById('prod-name').value.trim();
    const categorySelect = document.getElementById('prod-category');
    const categorySlug = categorySelect.value;
    const categoryName = categorySelect.options[categorySelect.selectedIndex].getAttribute('data-name');
    const priceFrom = Number(document.getElementById('prod-price').value);
    const priceLabel = new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', maximumFractionDigits: 0 }).format(priceFrom);
    const processingTime = document.getElementById('prod-time').value.trim() || '3 - 5 Jam';
    const description = document.getElementById('prod-desc').value.trim();
    const featured = document.getElementById('prod-featured').checked;
    
    const slugBase = name.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '');
    const slug = `${slugBase}-${Date.now().toString().slice(-4)}`;

    submitBtn.disabled = true;
    btnText.textContent = 'Mengompres Foto & Menyimpan...';
    btnSpinner.classList.remove('hidden');
    formAlert.classList.add('hidden');

    try {
      const fileName = `${slug}-${Date.now()}.webp`;

      const { error: uploadError } = await supabase.storage
        .from(SUPABASE_BUCKET)
        .upload(fileName, processedImageBlob, { contentType: 'image/webp', upsert: true });

      if (uploadError) throw new Error('Upload foto gagal: ' + uploadError.message);

      const { data: publicUrlData } = supabase.storage.from(SUPABASE_BUCKET).getPublicUrl(fileName);

      const { error: insertError } = await supabase.from('products').insert([{
        name,
        slug,
        category_slug: categorySlug,
        category_name: categoryName,
        price_from: priceFrom,
        price_label: priceLabel,
        image: publicUrlData.publicUrl,
        description,
        featured,
        processing_time: processingTime,
        city: 'Malang'
      }]);

      if (insertError) throw new Error('Simpan database gagal: ' + insertError.message);

      alert(`Berhasil! Produk "${name}" berhasil ditambahkan.`);
      addForm.reset();
      processedImageBlob = null;
      pricePreview.textContent = 'Format: Rp 0';
      uploadPrompt.classList.remove('hidden');
      previewContainer.classList.add('hidden');

      // Switch back to catalog tab
      tabBtnCatalog.click();
      loadAllProducts();

    } catch (err) {
      alert('Error: ' + err.message);
    } finally {
      submitBtn.disabled = false;
      btnText.textContent = 'Simpan & Publikasikan Produk';
      btnSpinner.classList.add('hidden');
    }
  });

  // Check auth on load
  checkAuth();
</script>
