      const promoBannerModal = document.getElementById('promo-banner-modal');
      const promoBannerForm = document.getElementById('promo-banner-form');
      const promoBannerGrid = document.getElementById('promo-banners-grid');
      const promoBannerDesktopInput = document.getElementById('promo-banner-desktop-file');
      const promoBannerMobileInput = document.getElementById('promo-banner-mobile-file');
      const promoBannerCityFilter = document.getElementById('promo-banner-city-filter');
      const promoBannerCitySelect = document.getElementById('promo-banner-city');

      function getPromoCitySlug(city) {
        if (typeof city !== 'string' && city?.slug) return city.slug;
        const name = typeof city === 'string' ? city : city?.name || '';
        const clean = name.trim().toLowerCase();
        if (clean.includes('malang raya')) return 'malang-raya';
        if (clean === 'kota malang') return 'kota-malang';
        if (clean === 'kota batu') return 'kota-batu';
        if (clean === 'kabupaten malang' || clean === 'kab. malang') return 'kabupaten-malang';
        if (clean.includes('mana saja') || clean.includes('seluruh indonesia')) return 'bisa-dikirim-ke-mana-saja';
        return clean.replace(/[^\w\s-]/g, '').replace(/\s+/g, '-').replace(/--+/g, '-').replace(/^-|-$/g, '');
      }

      function syncPromoCityOptions() {
        const currentFilter = promoBannerCityFilter.value;
        const currentTarget = promoBannerCitySelect.value;
        const cityOptions = new Map();
        (citiesList || []).forEach(city => {
          const name = typeof city === 'string' ? city : city?.name;
          const slug = getPromoCitySlug(city);
          if (slug && name) cityOptions.set(slug, name);
        });
        promoBanners.forEach(banner => {
          if (banner.citySlug && !cityOptions.has(banner.citySlug)) {
            cityOptions.set(banner.citySlug, `${banner.citySlug} (kota tidak terdaftar)`);
          }
        });

        promoBannerCitySelect.replaceChildren(new Option('Promo umum (semua kota)', ''));
        promoBannerCityFilter.replaceChildren(
          new Option('Semua kota dan promo umum', '__all__'),
          new Option('Promo umum', ''),
        );
        cityOptions.forEach((name, slug) => {
          promoBannerCitySelect.add(new Option(name, slug));
          promoBannerCityFilter.add(new Option(`Promo kota: ${name}`, slug));
        });
        if ([...promoBannerCityFilter.options].some(option => option.value === currentFilter)) {
          promoBannerCityFilter.value = currentFilter;
        } else {
          promoBannerCityFilter.value = '__all__';
        }
        if ([...promoBannerCitySelect.options].some(option => option.value === currentTarget)) {
          promoBannerCitySelect.value = currentTarget;
        }
      }

      async function loadPromoBanners() {
        try {
          const { data, error } = await supabase.from('products')
            .select('id, description')
            .eq('slug', PROMO_BANNERS_CONFIG_SLUG)
            .maybeSingle();
          if (error) throw error;
          if (!data) {
            promoBanners = DEFAULT_PROMO_BANNERS;
          } else {
            const parsed = JSON.parse(data.description || '[]');
            if (!Array.isArray(parsed)) throw new Error('Format konfigurasi banner promo tidak valid.');
            const validBanners = parsed.filter(banner =>
              banner && typeof banner.id === 'string'
              && typeof banner.headline === 'string'
              && (typeof banner.desktopImage === 'string' || typeof banner.mobileImage === 'string')
              && (banner.desktopImage || banner.mobileImage)
            );
            if (validBanners.length > 0) {
              promoBanners = validBanners;
            } else {
              promoBanners = DEFAULT_PROMO_BANNERS;
              showToast('Konfigurasi banner kosong atau tidak valid; banner bawaan ditampilkan.', 'error');
            }
          }
          renderPromoBanners();
        } catch (error) {
          console.error('[Zaloma Admin] Failed to load promo banners:', error);
          showToast('Gagal memuat banner promo: ' + (error.message || error), 'error');
        }
      }

      function renderPromoBanners() {
        if (!promoBannerGrid) return;
        syncPromoCityOptions();
        const badge = document.getElementById('tab-banner-badge');
        if (badge) badge.textContent = String(promoBanners.length);
        promoBannerGrid.replaceChildren();

        const visibleBanners = promoBannerCityFilter.value === '__all__'
          ? promoBanners
          : promoBanners.filter(banner => (banner.citySlug || '') === promoBannerCityFilter.value);
        if (!visibleBanners.length) {
          const empty = document.createElement('p');
          empty.className = 'col-span-full rounded-xl border border-dashed border-slate-300 bg-white p-8 text-center text-sm text-slate-500';
          empty.textContent = 'Belum ada banner promo untuk pilihan ini. Klik “Tambah Banner” untuk membuatnya.';
          promoBannerGrid.appendChild(empty);
        }

        visibleBanners.forEach((banner, index) => {
          const card = document.createElement('article');
          card.className = 'overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm';
          const image = document.createElement('img');
          image.src = banner.desktopImage || banner.mobileImage;
          image.alt = banner.alt || banner.headline;
          image.className = 'h-40 w-full bg-slate-100 object-cover';
          card.appendChild(image);

          const content = document.createElement('div');
          content.className = 'space-y-3 p-4';
          const title = document.createElement('h3');
          title.className = 'font-bold text-slate-900';
          title.textContent = banner.headline;
          content.appendChild(title);
          const cityLabel = banner.citySlug
            ? ([...promoBannerCitySelect.options].find(option => option.value === banner.citySlug)?.textContent || banner.citySlug)
            : 'Promo umum · semua kota';
          const audience = document.createElement('p');
          audience.className = 'text-xs font-semibold text-primary';
          audience.textContent = cityLabel;
          content.appendChild(audience);
          const status = document.createElement('p');
          status.className = 'text-xs text-slate-500';
          status.textContent = `Desktop: ${banner.desktopImage ? 'aktif' : 'tidak ditampilkan'} · Mobile: ${banner.mobileImage ? 'aktif' : 'tidak ditampilkan'}`;
          content.appendChild(status);

          const actions = document.createElement('div');
          actions.className = 'flex gap-2';
          const editButton = document.createElement('button');
          editButton.type = 'button';
          editButton.className = 'min-h-10 flex-1 rounded-lg border border-slate-200 px-3 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-50';
          editButton.textContent = 'Edit';
          editButton.addEventListener('click', () => openPromoBannerModal(banner));
          actions.appendChild(editButton);

          const deleteButton = document.createElement('button');
          deleteButton.type = 'button';
          deleteButton.className = 'min-h-10 rounded-lg border border-rose-100 px-3 py-2 text-sm font-semibold text-rose-600 hover:bg-rose-50 disabled:cursor-not-allowed disabled:opacity-40';
          deleteButton.textContent = 'Hapus';
          const isLastGlobalBanner = !banner.citySlug
            && promoBanners.filter(item => !item.citySlug).length <= 1;
          deleteButton.disabled = isLastGlobalBanner;
          deleteButton.title = deleteButton.disabled ? 'Minimal satu banner promo umum harus tersedia' : 'Hapus banner promo';
          deleteButton.addEventListener('click', () => deletePromoBanner(banner.id));
          actions.appendChild(deleteButton);

          content.appendChild(actions);
          card.appendChild(content);
          promoBannerGrid.appendChild(card);
        });
      }

      function setPromoImagePreview(device, src) {
        const preview = document.getElementById(`promo-banner-${device}-preview`);
        if (!(preview instanceof HTMLImageElement)) return;
        if (preview.src.startsWith('blob:')) URL.revokeObjectURL(preview.src);
        if (src) {
          preview.src = src;
          preview.classList.remove('hidden');
        } else {
          preview.removeAttribute('src');
          preview.classList.add('hidden');
        }
      }

      function openPromoBannerModal(banner = null) {
        promoBannerForm.reset();
        syncPromoCityOptions();
        promoBannerDesktopFile = null;
        promoBannerMobileFile = null;
        promoBannerRemoveDesktop = false;
        promoBannerRemoveMobile = false;
        document.getElementById('promo-banner-edit-id').value = banner?.id || '';
        promoBannerCitySelect.value = banner?.citySlug || (
          !banner && promoBannerCityFilter.value !== '__all__' ? promoBannerCityFilter.value : ''
        );
        document.getElementById('promo-banner-modal-title').innerHTML = `<span class="w-2.5 h-2.5 rounded-full bg-primary"></span>${banner ? ' Edit Banner Promo' : ' Tambah Banner Promo'}`;
        document.getElementById('promo-banner-headline').value = banner?.headline || '';
        document.getElementById('promo-banner-badge').value = banner?.badge || '';
        document.getElementById('promo-banner-description').value = banner?.description || '';
        document.getElementById('promo-banner-cta1-label').value = banner?.ctaPrimaryLabel || '';
        document.getElementById('promo-banner-cta1-href').value = banner?.ctaPrimaryHref || '';
        document.getElementById('promo-banner-cta2-label').value = banner?.ctaSecondaryLabel || '';
        document.getElementById('promo-banner-cta2-href').value = banner?.ctaSecondaryHref || '';
        setPromoImagePreview('desktop', banner?.desktopImage || '');
        setPromoImagePreview('mobile', banner?.mobileImage || '');
        document.getElementById('promo-banner-desktop-remove-wrap').classList.toggle('hidden', !banner?.desktopImage);
        document.getElementById('promo-banner-mobile-remove-wrap').classList.toggle('hidden', !banner?.mobileImage);
        document.getElementById('promo-banner-image-note').textContent = banner
          ? 'Pilih file untuk mengganti gambar yang ada. Versi gambar yang tidak diganti tetap digunakan.'
          : 'Unggah minimal satu versi gambar. Versi desktop/mobile yang kosong tidak akan ditampilkan pada perangkat tersebut.';
        promoBannerModal.classList.remove('hidden');
      }

      function closePromoBannerModal() {
        promoBannerModal.classList.add('hidden');
        promoBannerForm.reset();
        promoBannerDesktopFile = null;
        promoBannerMobileFile = null;
        promoBannerRemoveDesktop = false;
        promoBannerRemoveMobile = false;
        setPromoImagePreview('desktop', '');
        setPromoImagePreview('mobile', '');
      }

      function bindPromoImageInput(input, device) {
        input?.addEventListener('change', async () => {
          const file = input.files?.[0] || null;
          if (file && (!['image/jpeg', 'image/png', 'image/webp'].includes(file.type) || file.size > 8 * 1024 * 1024)) {
            showToast('Pilih gambar JPG, PNG, atau WebP dengan ukuran maksimal 8 MB.', 'error');
            input.value = '';
            const currentBanner = promoBanners.find(banner =>
              banner.id === document.getElementById('promo-banner-edit-id').value,
            );
            const savedImage = device === 'desktop'
              ? currentBanner?.desktopImage
              : currentBanner?.mobileImage;
            if (device === 'desktop') promoBannerDesktopFile = null;
            else promoBannerMobileFile = null;
            setPromoImagePreview(device, savedImage || '');
            return;
          }
          if (!file) return;
          try {
            const blob = await openImageCrop(file, {
              aspect: device === 'desktop' ? 2 : 1080 / 776,
              title: `Atur area gambar banner ${device === 'desktop' ? 'desktop' : 'mobile'}`,
              maxDimension: 1600,
            });
            if (!blob) {
              input.value = '';
              return;
            }
            if (device === 'desktop') promoBannerDesktopFile = blob;
            else promoBannerMobileFile = blob;
            setPromoImagePreview(device, URL.createObjectURL(blob));
          } catch (error) {
            input.value = '';
            showToast(error.message || 'Gagal memproses gambar banner.', 'error');
          }
        });
      }

      bindPromoImageInput(promoBannerDesktopInput, 'desktop');
      bindPromoImageInput(promoBannerMobileInput, 'mobile');
      document.getElementById('promo-banner-desktop-remove')?.addEventListener('change', (event) => {
        promoBannerRemoveDesktop = event.target.checked;
      });
      document.getElementById('promo-banner-mobile-remove')?.addEventListener('change', (event) => {
        promoBannerRemoveMobile = event.target.checked;
      });
      document.getElementById('open-add-banner-btn')?.addEventListener('click', () => openPromoBannerModal());
      document.getElementById('close-promo-banner-modal-btn')?.addEventListener('click', closePromoBannerModal);
      document.getElementById('cancel-promo-banner-btn')?.addEventListener('click', closePromoBannerModal);

      function validPromoHref(value) {
        const href = value.trim();
        if (!href) return '';
        if (href.startsWith('/') && !href.startsWith('//')) return href;
        try {
          const url = new URL(href);
          return url.protocol === 'https:' || url.protocol === 'http:' ? href : '';
        } catch {
          return '';
        }
      }

      async function uploadPromoImage(file, bannerId, device) {
        const path = `promo-banners/${bannerId}-${device}-${Date.now()}.webp`;
        const { error } = await supabase.storage.from(SUPABASE_BUCKET).upload(path, file, {
          contentType: 'image/webp',
          upsert: false,
        });
        if (error) throw error;
        const { data } = supabase.storage.from(SUPABASE_BUCKET).getPublicUrl(path);
        if (!data?.publicUrl) throw new Error(`URL gambar ${device} gagal dibuat.`);
        return data.publicUrl;
      }

      async function persistPromoBanners(banners) {
        if (!banners.length) throw new Error('Minimal satu banner promo harus tersedia.');
        const payload = {
          slug: PROMO_BANNERS_CONFIG_SLUG,
          name: 'System Promo Banners Config',
          category_slug: '_system_',
          category_name: 'System',
          price_from: 0,
          price_label: 'Rp 0',
          image: 'https://zalomaflorist.com/favicon.ico',
          description: JSON.stringify(banners),
          featured: false,
          city: 'Malang',
        };
        const { data: existing, error: lookupError } = await supabase.from('products')
          .select('id').eq('slug', PROMO_BANNERS_CONFIG_SLUG).maybeSingle();
        if (lookupError) throw lookupError;
        const result = existing?.id
          ? await supabase.from('products').update(payload).eq('id', existing.id)
          : await supabase.from('products').insert([payload]);
        if (result.error) throw result.error;
      }

      promoBannerForm?.addEventListener('submit', async (event) => {
        event.preventDefault();
        const editId = document.getElementById('promo-banner-edit-id').value;
        const existing = promoBanners.find(banner => banner.id === editId);
        if (!existing && !promoBannerDesktopFile && !promoBannerMobileFile) {
          showToast('Unggah minimal satu gambar desktop atau mobile.', 'error');
          return;
        }

        const headline = document.getElementById('promo-banner-headline').value.trim();
        if (!headline) {
          showToast('Judul banner wajib diisi.', 'error');
          return;
        }
        const cta1Label = document.getElementById('promo-banner-cta1-label').value.trim();
        const cta1HrefRaw = document.getElementById('promo-banner-cta1-href').value.trim();
        const cta2Label = document.getElementById('promo-banner-cta2-label').value.trim();
        const cta2HrefRaw = document.getElementById('promo-banner-cta2-href').value.trim();
        const cta1Href = validPromoHref(cta1HrefRaw);
        const cta2Href = validPromoHref(cta2HrefRaw);
        if ((cta1Label || cta1HrefRaw) && (!cta1Label || !cta1Href)) {
          showToast('Tombol promo 1 perlu teks dan URL http(s) atau link internal yang valid.', 'error');
          return;
        }
        if ((cta2Label || cta2HrefRaw) && (!cta2Label || !cta2Href)) {
          showToast('Tombol promo 2 perlu teks dan URL http(s) atau link internal yang valid.', 'error');
          return;
        }

        const id = editId || `promo-${crypto.randomUUID()}`;
        const saveButton = document.getElementById('save-promo-banner-btn');
        saveButton.disabled = true;
        saveButton.textContent = 'Menyimpan...';
        try {
          let desktopImage = promoBannerRemoveDesktop ? '' : (existing?.desktopImage || '');
          let mobileImage = promoBannerRemoveMobile ? '' : (existing?.mobileImage || '');
          if (promoBannerDesktopFile) desktopImage = await uploadPromoImage(promoBannerDesktopFile, id, 'desktop');
          if (promoBannerMobileFile) mobileImage = await uploadPromoImage(promoBannerMobileFile, id, 'mobile');
          if (!desktopImage && !mobileImage) throw new Error('Banner harus memiliki gambar desktop atau mobile.');

          const nextBanner = {
            id,
            citySlug: promoBannerCitySelect.value || undefined,
            badge: document.getElementById('promo-banner-badge').value.trim(),
            headline,
            description: document.getElementById('promo-banner-description').value.trim(),
            desktopImage,
            mobileImage,
            alt: headline,
            ctaPrimaryLabel: cta1Label,
            ctaPrimaryHref: cta1Href,
            ctaPrimaryExternal: Boolean(cta1Href && !cta1Href.startsWith('/')),
            ctaSecondaryLabel: cta2Label,
            ctaSecondaryHref: cta2Href,
            ctaSecondaryExternal: Boolean(cta2Href && !cta2Href.startsWith('/')),
          };
          const nextBanners = existing
            ? promoBanners.map(banner => banner.id === id ? nextBanner : banner)
            : [...promoBanners, nextBanner];
          if (!nextBanners.some(banner => !banner.citySlug)) {
            throw new Error('Minimal satu banner promo umum untuk semua kota harus tersedia.');
          }
          await persistPromoBanners(nextBanners);
          promoBanners = nextBanners;
          renderPromoBanners();
          closePromoBannerModal();
          showToast(existing ? 'Banner promo berhasil diperbarui.' : 'Banner promo berhasil ditambahkan.');
        } catch (error) {
          console.error('[Zaloma Admin] Failed to save promo banner:', error);
          showToast('Gagal menyimpan banner: ' + (error.message || error), 'error');
        } finally {
          saveButton.disabled = false;
          saveButton.textContent = 'Simpan Banner';
        }
      });

      async function deletePromoBanner(id) {
        const banner = promoBanners.find(item => item.id === id);
        if (banner && !banner.citySlug && promoBanners.filter(item => !item.citySlug).length <= 1) {
          showToast('Minimal satu banner promo umum untuk semua kota harus tersedia.', 'error');
          return;
        }
        if (!banner || !window.confirm(`Hapus banner "${banner.headline}"?`)) return;
        const nextBanners = promoBanners.filter(item => item.id !== id);
        try {
          await persistPromoBanners(nextBanners);
          promoBanners = nextBanners;
          renderPromoBanners();
          showToast('Banner promo berhasil dihapus.');
        } catch (error) {
          console.error('[Zaloma Admin] Failed to delete promo banner:', error);
          showToast('Gagal menghapus banner: ' + (error.message || error), 'error');
        }

        promoBannerCityFilter?.addEventListener('change', renderPromoBanners);
      }

      // ================= ARTICLE CMS =================
      const articleModal = document.getElementById('article-modal');
      const articleForm = document.getElementById('article-form');
      const articleGrid = document.getElementById('articles-admin-grid');
      const articleImageInput = document.getElementById('article-image-file');
      const articleImagePreview = document.getElementById('article-image-preview');
      const articleImageNote = document.getElementById('article-image-note');
      const articleSearchInput = document.getElementById('article-admin-search');
      const articleStatusFilter = document.getElementById('article-admin-status');
      let articles = Array.isArray(DEFAULT_ARTICLES) ? [...DEFAULT_ARTICLES] : [];
      let articlesConfigLoaded = false;
      let articleImageBlob = null;
      let articleImagePreviewUrl = '';

      function articleContentText(content) {
        if (typeof content === 'string') return content;
        if (!content || typeof content !== 'object') return '';
        const paragraphs = [];
        if (content.lead) paragraphs.push(content.lead);
        (content.sections || []).forEach(section => {
          if (section.heading) paragraphs.push(section.heading);
          (section.body || []).forEach(paragraph => paragraphs.push(paragraph));
          if (section.tip) paragraphs.push(`Tips Zaloma Florist: ${section.tip}`);
        });
        if (content.conclusion) paragraphs.push(content.conclusion);
        return paragraphs.join('\n\n');
      }

      function renderArticles() {
        if (!articleGrid) return;
        articleGrid.replaceChildren();
        const badge = document.getElementById('tab-article-badge');
        if (badge) badge.textContent = String(articles.length);

        const publishedCount = articles.filter(article => article.published !== false).length;
        const draftCount = articles.length - publishedCount;
        document.getElementById('article-total-count').textContent = String(articles.length);
        document.getElementById('article-published-count').textContent = String(publishedCount);
        document.getElementById('article-draft-count').textContent = String(draftCount);

        const query = articleSearchInput.value.trim().toLocaleLowerCase('id');
        const status = articleStatusFilter.value;
        const visibleArticles = articles.filter(article => {
          const isPublished = article.published !== false;
          const searchable = `${article.title || ''} ${article.slug || ''} ${article.category || ''} ${article.author || ''}`
            .toLocaleLowerCase('id');
          return (!query || searchable.includes(query))
            && (status === 'all' || (status === 'published' && isPublished) || (status === 'draft' && !isPublished));
        });

        if (!visibleArticles.length) {
          const empty = document.createElement('p');
          empty.className = 'rounded-xl border border-dashed border-slate-300 bg-white p-8 text-center text-sm text-slate-500';
          empty.textContent = articles.length
            ? 'Tidak ada artikel yang sesuai dengan pencarian atau filter ini.'
            : 'Belum ada artikel. Mulai tulis artikel pertama untuk blog Zaloma.';
          articleGrid.append(empty);
          return;
        }

        visibleArticles.forEach(article => {
          const card = document.createElement('article');
          card.className = 'overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm sm:flex';
          const image = document.createElement('img');
          image.className = 'aspect-video w-full bg-slate-100 object-cover sm:aspect-square sm:w-40';
          image.src = article.image || '';
          image.alt = article.title || 'Gambar artikel';
          image.loading = 'lazy';
          const body = document.createElement('div');
          body.className = 'flex min-w-0 flex-1 flex-col p-4';
          const category = document.createElement('p');
          category.className = 'text-xs font-bold uppercase tracking-wide text-primary';
          category.textContent = article.category || 'Artikel';
          const publicationStatus = document.createElement('span');
          const isPublished = article.published !== false;
          publicationStatus.className = `inline-flex w-fit rounded-full px-2.5 py-1 text-[10px] font-bold uppercase tracking-wide ${
            isPublished ? 'bg-emerald-50 text-emerald-700' : 'bg-amber-50 text-amber-700'
          }`;
          publicationStatus.textContent = isPublished ? 'Terbit' : 'Draft';
          const heading = document.createElement('h3');
          heading.className = 'mt-1 line-clamp-2 font-semibold text-slate-900';
          heading.textContent = article.title || 'Tanpa judul';
          const meta = document.createElement('p');
          meta.className = 'mt-1 text-xs text-slate-500';
          meta.textContent = `${article.author || 'Tim Zaloma Florist'} · ${article.date || ''}`;
          const slug = document.createElement('p');
          slug.className = 'mt-1 truncate text-xs text-slate-400';
          slug.textContent = `/${article.slug || ''}`;
          const actions = document.createElement('div');
          actions.className = 'mt-auto flex flex-wrap gap-2 pt-4';
          const editButton = document.createElement('button');
          editButton.type = 'button';
          editButton.className = 'min-h-9 rounded-lg border border-slate-200 px-3 text-xs font-semibold text-slate-700 hover:bg-slate-50';
          editButton.textContent = 'Edit';
          editButton.addEventListener('click', () => openArticleModal(article));
          const deleteButton = document.createElement('button');
          deleteButton.type = 'button';
          deleteButton.className = 'min-h-9 rounded-lg border border-rose-200 px-3 text-xs font-semibold text-rose-600 hover:bg-rose-50';
          deleteButton.textContent = 'Hapus';
          deleteButton.addEventListener('click', () => deleteArticle(article.id));
          actions.append(editButton, deleteButton);
          body.append(category, publicationStatus, heading, meta, slug, actions);
          card.append(image, body);
          articleGrid.append(card);
        });
      }

      articleSearchInput?.addEventListener('input', renderArticles);
      articleStatusFilter?.addEventListener('change', renderArticles);

      async function loadArticlesConfig() {
        if (articlesConfigLoaded) {
          renderArticles();
          return;
        }
        renderArticles();
        try {
          const { data, error } = await supabase.from('products')
            .select('description').eq('slug', ARTICLES_CONFIG_SLUG).maybeSingle();
          if (error) throw error;
          if (data?.description) {
            const parsed = JSON.parse(data.description);
            if (!Array.isArray(parsed) || parsed.some(article =>
              !article || typeof article.id !== 'string' || typeof article.slug !== 'string'
              || typeof article.title !== 'string'
              || (article.published !== undefined && typeof article.published !== 'boolean')
              || !(typeof article.content === 'string' || (
                article.content && typeof article.content === 'object'
                && typeof article.content.lead === 'string'
                && Array.isArray(article.content.sections)
              ))
            )) {
              throw new Error('Data artikel di Supabase tidak valid.');
            }
            articles = parsed;
          }
          articlesConfigLoaded = true;
          renderArticles();
        } catch (error) {
          console.error('[Zaloma Admin] Failed to load articles:', error);
          showToast('Gagal memuat artikel: ' + (error.message || error), 'error');
        }
      }

      function setArticleImagePreview(src, note) {
        if (articleImagePreviewUrl) URL.revokeObjectURL(articleImagePreviewUrl);
        articleImagePreviewUrl = '';
        if (articleImagePreview) {
          if (src) {
            articleImagePreview.src = src;
            articleImagePreview.classList.remove('hidden');
          } else {
            articleImagePreview.removeAttribute('src');
            articleImagePreview.classList.add('hidden');
          }
        }
        if (articleImageNote) articleImageNote.textContent = note;
      }

      function openArticleModal(article = null) {
        if (!articleForm || !articleModal) return;
        articleForm.reset();
        articleImageBlob = null;
        const editing = Boolean(article);
        document.getElementById('article-edit-id').value = article?.id || '';
        document.getElementById('article-modal-title').lastChild.textContent = editing ? ' Edit Artikel' : ' Tambah Artikel';
        document.getElementById('article-title').value = article?.title || '';
        document.getElementById('article-slug').value = article?.slug || '';
        document.getElementById('article-slug').dataset.manual = editing ? 'true' : 'false';
        document.getElementById('article-category').value = article?.category || '';
        document.getElementById('article-excerpt').value = article?.excerpt || '';
        document.getElementById('article-author').value = article?.author || 'Tim Zaloma Florist';
        document.getElementById('article-date').value = article?.isoDate || new Date().toISOString().slice(0, 10);
        document.getElementById('article-published').value = article?.published === false ? 'draft' : 'published';
        document.getElementById('article-content').value = articleContentText(article?.content);
        setArticleImagePreview(article?.image || '', article?.image ? 'Gambar saat ini akan digunakan jika tidak diganti.' : 'Belum ada gambar. Pilih file untuk mengunggah.');
        if (articleImageInput) articleImageInput.value = '';
        articleModal.classList.remove('hidden');
      }

      function closeArticleModal() {
        articleModal?.classList.add('hidden');
        articleImageBlob = null;
        if (articleImageInput) articleImageInput.value = '';
        setArticleImagePreview('', 'Belum ada gambar. Pilih file untuk mengunggah.');
      }

      document.getElementById('open-add-article-btn')?.addEventListener('click', () => openArticleModal());
      document.getElementById('close-article-modal-btn')?.addEventListener('click', closeArticleModal);
      document.getElementById('cancel-article-btn')?.addEventListener('click', closeArticleModal);
      articleModal?.addEventListener('click', event => {
        if (event.target === articleModal) closeArticleModal();
      });

      document.getElementById('article-title')?.addEventListener('input', event => {
        const slugInput = document.getElementById('article-slug');
        if (slugInput.dataset.manual === 'true' || slugInput.value) return;
        slugInput.value = event.target.value
          .normalize('NFD').replace(/[\u0300-\u036f]/g, '')
          .toLowerCase().trim().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
      });
      document.getElementById('article-slug')?.addEventListener('input', event => {
        event.target.dataset.manual = 'true';
      });

      articleImageInput?.addEventListener('change', async () => {
        const file = articleImageInput.files?.[0];
        if (!file) return;
        if (file.size > 8 * 1024 * 1024) {
          showToast('Ukuran gambar artikel maksimal 8 MB.', 'error');
          articleImageInput.value = '';
          return;
        }
        try {
          const cropped = await openImageCrop(file, { aspect: 16 / 9, title: 'Pilih area gambar artikel (16:9)', maxDimension: 1200 });
          if (!cropped) {
            articleImageInput.value = '';
            return;
          }
          articleImageBlob = cropped;
          if (articleImagePreviewUrl) URL.revokeObjectURL(articleImagePreviewUrl);
          articleImagePreviewUrl = URL.createObjectURL(cropped);
          if (articleImagePreview) {
            articleImagePreview.src = articleImagePreviewUrl;
            articleImagePreview.classList.remove('hidden');
          }
          if (articleImageNote) articleImageNote.textContent = 'Area pratinjau ini yang akan disimpan.';
        } catch (error) {
          console.error('[Zaloma Admin] Failed to crop article image:', error);
          showToast('Gagal memproses gambar artikel: ' + (error.message || error), 'error');
          articleImageInput.value = '';
        }
      });

      async function persistArticles(nextArticles) {
        const payload = {
          slug: ARTICLES_CONFIG_SLUG,
          name: 'System Articles Config',
          category_slug: '_system_',
          category_name: 'System',
          price_from: 0,
          price_label: 'Rp 0',
          image: 'https://zalomaflorist.com/favicon.ico',
          description: JSON.stringify(nextArticles),
          featured: false,
          city: 'Malang',
        };
        const { data: existing, error: lookupError } = await supabase.from('products')
          .select('id').eq('slug', ARTICLES_CONFIG_SLUG).maybeSingle();
        if (lookupError) throw lookupError;
        const result = existing?.id
          ? await supabase.from('products').update(payload).eq('id', existing.id)
          : await supabase.from('products').insert([payload]);
        if (result.error) throw result.error;
      }

      async function uploadArticleImage(blob, articleId) {
        const path = `articles/${articleId}-${Date.now()}.webp`;
        const { error } = await supabase.storage.from(SUPABASE_BUCKET).upload(path, blob, {
          contentType: 'image/webp',
          upsert: false,
        });
        if (error) throw error;
        const { data } = supabase.storage.from(SUPABASE_BUCKET).getPublicUrl(path);
        if (!data?.publicUrl) throw new Error('URL gambar artikel gagal dibuat.');
        return data.publicUrl;
      }

      articleForm?.addEventListener('submit', async event => {
        event.preventDefault();
        const editId = document.getElementById('article-edit-id').value;
        const existing = articles.find(article => article.id === editId);
        const title = document.getElementById('article-title').value.trim();
        const slug = document.getElementById('article-slug').value.trim().toLowerCase();
        const category = document.getElementById('article-category').value.trim();
        const excerpt = document.getElementById('article-excerpt').value.trim();
        const author = document.getElementById('article-author').value.trim();
        const isoDate = document.getElementById('article-date').value;
        const published = document.getElementById('article-published').value === 'published';
        const content = document.getElementById('article-content').value.trim();
        const slugPattern = /^[a-z0-9]+(?:-[a-z0-9]+)*$/;
        if (!slugPattern.test(slug)) {
          showToast('Slug hanya boleh berisi huruf kecil, angka, dan tanda hubung.', 'error');
          return;
        }
        if (articles.some(article => article.slug === slug && article.id !== editId)) {
          showToast('Slug tersebut sudah digunakan artikel lain.', 'error');
          return;
        }
        if (!existing && !articleImageBlob) {
          showToast('Pilih dan potong gambar utama artikel terlebih dahulu.', 'error');
          return;
        }

        const saveButton = document.getElementById('save-article-btn');
        saveButton.disabled = true;
        saveButton.textContent = 'Menyimpan...';
        try {
          const id = editId || `article-${crypto.randomUUID()}`;
          const image = articleImageBlob
            ? await uploadArticleImage(articleImageBlob, id)
            : existing.image;
          const publishedDate = new Date(`${isoDate}T12:00:00`);
          const nextArticle = {
            ...existing,
            id,
            slug,
            title,
            category,
            excerpt,
            author,
            published,
            authorRole: existing?.authorRole || 'Kontributor Zaloma Florist',
            isoDate,
            date: publishedDate.toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' }),
            image,
            content,
            tags: existing?.tags || [],
          };
          const nextArticles = existing
            ? articles.map(article => article.id === id ? nextArticle : article)
            : [nextArticle, ...articles];
          await persistArticles(nextArticles);
          articles = nextArticles;
          articlesConfigLoaded = true;
          renderArticles();
          closeArticleModal();
          showToast(existing ? 'Artikel berhasil diperbarui.' : 'Artikel berhasil ditambahkan.');
        } catch (error) {
          console.error('[Zaloma Admin] Failed to save article:', error);
          showToast('Gagal menyimpan artikel: ' + (error.message || error), 'error');
        } finally {
          saveButton.disabled = false;
          saveButton.textContent = 'Simpan Artikel';
        }
      });

      async function deleteArticle(id) {
        const article = articles.find(item => item.id === id);
        if (!article || !window.confirm(`Hapus artikel "${article.title}"?`)) return;
        const nextArticles = articles.filter(item => item.id !== id);
        try {
          await persistArticles(nextArticles);
          articles = nextArticles;
          articlesConfigLoaded = true;
          renderArticles();
          showToast('Artikel berhasil dihapus.');
        } catch (error) {
          console.error('[Zaloma Admin] Failed to delete article:', error);
          showToast('Gagal menghapus artikel: ' + (error.message || error), 'error');
        }
      }

      // Helper to safely persist system configuration rows without onConflict failure
      async function saveSystemConfig(slugVal, nameVal, jsonString) {
        try {
          const payload = {
            slug: slugVal,
            name: nameVal,
            category_slug: '_system_',
            category_name: 'System',
            price_from: 0,
            price_label: 'Rp 0',
            image: 'https://zalomaflorist.com/favicon.ico',
            description: jsonString,
            featured: false,
            city: 'Malang'
          };

          const { data: existing } = await supabase
            .from('products')
            .select('id')
            .eq('slug', slugVal)
            .maybeSingle();

          if (existing && existing.id) {
            await supabase.from('products').update(payload).eq('id', existing.id);
          } else {
            await supabase.from('products').insert([payload]);
          }
        } catch (err) {
          console.warn(`Sync system config notice (${slugVal}):`, err);
        }
      }

      // Categories State Management (v4)
      let categoriesList = [];
      try {
        const cached = localStorage.getItem('zaloma_admin_categories_v4') || localStorage.getItem('zaloma_admin_categories_v3');
        if (cached !== null) {
          categoriesList = JSON.parse(cached);
          if (!Array.isArray(categoriesList)) categoriesList = [];
        }
      } catch (e) {
        categoriesList = [];
      }

      // Always guarantee all 7 default categories are present
      const existingCatSlugs = new Set((categoriesList || []).map(c => c && c.slug));
      (DEFAULT_CATEGORIES || []).forEach(dc => {
        if (!existingCatSlugs.has(dc.slug)) categoriesList.push(dc);
      });
      localStorage.setItem('zaloma_admin_categories_v4', JSON.stringify(categoriesList));

      function updateCategoryBadges() {
        const badge = document.getElementById('tab-cat-badge');
        if (badge) badge.textContent = categoriesList.length;
      }

      function toSlug(str) {
        return (str || '').toLowerCase()
          .replace(/[^\w\s-]/g, '')
          .trim()
          .replace(/\s+/g, '-');
      }

      // Persist categories to localStorage and Supabase Cloud
      async function persistCategories() {
        try {
          localStorage.setItem('zaloma_admin_categories_v4', JSON.stringify(categoriesList));
          localStorage.setItem('zaloma_admin_categories_v3', JSON.stringify(categoriesList));
          updateCategoryDropdowns();
          renderCategoriesCards();
          updateCategoryBadges();
          await saveSystemConfig('_categories_config_', 'System Categories Config', JSON.stringify(categoriesList));
        } catch (err) {
          console.warn('Sync categories notice:', err);
        }
      }

      // Populate Category Dropdowns
      function updateCategoryDropdowns() {
        const catFilter = document.getElementById('category-filter-select');
        const prodCat = document.getElementById('prod-category');
        const editCat = document.getElementById('edit-prod-category');

        const prevFilterVal = catFilter ? catFilter.value : 'all';
        const prevProdVal = prodCat ? prodCat.value : '';
        const prevEditVal = editCat ? editCat.value : '';

        const combinedCats = [];
        const seenSlugs = new Set();
        (categoriesList || []).forEach(c => {
          if (c && c.slug && !seenSlugs.has(c.slug)) {
            seenSlugs.add(c.slug);
            combinedCats.push(c);
          }
        });
        (DEFAULT_CATEGORIES || []).forEach(c => {
          if (c && c.slug && !seenSlugs.has(c.slug)) {
            seenSlugs.add(c.slug);
            combinedCats.push(c);
          }
        });

        if (catFilter) {
          catFilter.innerHTML = '<option value="all">Semua Kategori</option>' +
            combinedCats.map(c => `<option value="${c.slug}">${c.name}</option>`).join('');
          if (combinedCats.some(c => c.slug === prevFilterVal)) {
            catFilter.value = prevFilterVal;
          } else {
            catFilter.value = 'all';
          }
        }

        if (prodCat) {
          prodCat.innerHTML = '<option value="" disabled selected>Pilih Kategori...</option>' +
            combinedCats.map(c => `<option value="${c.slug}" data-name="${c.name}">${c.name}</option>`).join('');
          if (prevProdVal && combinedCats.some(c => c.slug === prevProdVal)) {
            prodCat.value = prevProdVal;
          }
        }

        if (editCat) {
          editCat.innerHTML = '<option value="" disabled selected>Pilih Kategori...</option>' +
            combinedCats.map(c => `<option value="${c.slug}" data-name="${c.name}">${c.name}</option>`).join('');
          if (prevEditVal && combinedCats.some(c => c.slug === prevEditVal)) {
            editCat.value = prevEditVal;
          }
        }

        updateCategoryBadges();
        syncCustomDropdown('prod-category');
        syncCustomDropdown('edit-prod-category');
      }

      // Dynamic Subcategory Select for Add Form
      const prodCategorySelect = document.getElementById('prod-category');
      const prodSubcatWrapper = document.getElementById('prod-subcategory-wrapper');
      const prodSubcatSelect = document.getElementById('prod-subcategory');

      prodCategorySelect?.addEventListener('change', () => {
        const selectedSlug = prodCategorySelect.value;
        const cat = (categoriesList || []).find(c => c.slug === selectedSlug) || (DEFAULT_CATEGORIES || []).find(c => c.slug === selectedSlug);
        if (cat && cat.subcategories && cat.subcategories.length > 0) {
          prodSubcatSelect.innerHTML = '<option value="">Pilih Subkategori (Opsional)...</option>' +
            cat.subcategories.map(s => `<option value="${s.slug}" data-name="${s.name}">${s.name}</option>`).join('');
          prodSubcatWrapper.classList.remove('hidden');
        } else {
          prodSubcatSelect.innerHTML = '<option value="">Pilih Subkategori...</option>';
          prodSubcatWrapper.classList.add('hidden');
        }
        if (typeof updateSizeDropdownForCategory === 'function') {
          updateSizeDropdownForCategory(selectedSlug, 'prod-size');
        }
      });

      // Dynamic Subcategory Select for Edit Modal
      const editCategorySelect = document.getElementById('edit-prod-category');
      const editSubcatWrapper = document.getElementById('edit-prod-subcategory-wrapper');
      const editSubcatSelect = document.getElementById('edit-prod-subcategory');

      editCategorySelect?.addEventListener('change', () => {
        const selectedSlug = editCategorySelect.value;
        const cat = (categoriesList || []).find(c => c.slug === selectedSlug) || (DEFAULT_CATEGORIES || []).find(c => c.slug === selectedSlug);
        if (cat && cat.subcategories && cat.subcategories.length > 0) {
          editSubcatSelect.innerHTML = '<option value="">Pilih Subkategori (Opsional)...</option>' +
            cat.subcategories.map(s => `<option value="${s.slug}" data-name="${s.name}">${s.name}</option>`).join('');
          editSubcatWrapper.classList.remove('hidden');
        } else {
          editSubcatSelect.innerHTML = '<option value="">Pilih Subkategori...</option>';
          editSubcatWrapper.classList.add('hidden');
        }
        if (typeof updateSizeDropdownForCategory === 'function') {
          updateSizeDropdownForCategory(selectedSlug, 'edit-prod-size');
        }
      });

      // Dynamic Subcategory Filter for Catalog List
      const categoryFilterSelect = document.getElementById('category-filter-select');
      const subcategoryFilterSelect = document.getElementById('subcategory-filter-select');

      categoryFilterSelect?.addEventListener('change', () => {
        const selectedSlug = categoryFilterSelect.value;
        if (selectedSlug !== 'all') {
          const cat = categoriesList.find(c => c.slug === selectedSlug);
          if (cat && cat.subcategories && cat.subcategories.length > 0) {
            subcategoryFilterSelect.innerHTML = '<option value="all">Semua Subkategori</option>' +
              cat.subcategories.map(s => `<option value="${s.slug}">${s.name}</option>`).join('');
            subcategoryFilterSelect.classList.remove('hidden');
          } else {
            subcategoryFilterSelect.classList.add('hidden');
            subcategoryFilterSelect.value = 'all';
          }
        } else {
          subcategoryFilterSelect.classList.add('hidden');
          subcategoryFilterSelect.value = 'all';
        }
        renderFilteredCatalog(true);
      });

      // Quick Manage City Buttons
      document.getElementById('quick-manage-city-btn')?.addEventListener('click', () => {
        switchTab(tabBtnCities);
        renderCitiesCards();
      });
      document.getElementById('edit-quick-manage-city-btn')?.addEventListener('click', () => {
        document.getElementById('edit-modal')?.classList.add('hidden');
        switchTab(tabBtnCities);
        renderCitiesCards();
      });

      subcategoryFilterSelect?.addEventListener('change', () => renderFilteredCatalog(true));

      // Category Cards Rendering
      function renderCategoriesCards() {
        const container = document.getElementById('categories-cards-grid');
        if (!container) return;

        if (categoriesList.length === 0) {
          container.innerHTML = `
            <div class="col-span-full py-14 text-center bg-white rounded-2xl border border-dashed border-slate-200 p-8 space-y-3">
              <div class="w-12 h-12 rounded-2xl bg-accent-bg text-primary font-serif font-bold text-xl flex items-center justify-center mx-auto shadow-xs">
                +
              </div>
              <h3 class="text-sm font-bold text-slate-800">Belum Ada Kategori</h3>
              <p class="text-xs text-slate-500 max-w-sm mx-auto">Seluruh kategori telah dikosongkan. Klik tombol di bawah untuk menambah kategori baru dan subkategorinya.</p>
              <button 
                type="button" 
                id="open-add-category-empty-btn" 
                class="bg-primary hover:bg-primary-dark text-white font-semibold py-2 px-4 rounded-lg text-xs transition-all active:scale-95 shadow-sm cursor-pointer inline-flex items-center gap-1.5"
              >
                + Tambah Kategori Baru
              </button>
            </div>
          `;
          document.getElementById('open-add-category-empty-btn')?.addEventListener('click', () => {
            openAddCategoryBtn?.click();
          });
          return;
        }

        container.innerHTML = categoriesList.map(cat => {
          const subcats = cat.subcategories || [];
          return `
            <div class="bg-white border border-slate-200 rounded-xl p-4 shadow-2xs hover:border-slate-300 transition-all flex flex-col justify-between space-y-3">
              <div>
                <div class="flex items-start justify-between gap-2">
                  <div>
                    <h3 class="font-bold text-slate-900 text-sm flex items-center gap-1.5">
                      <span>${cat.name}</span>
                      <span class="text-[10px] font-medium px-2 py-0.5 rounded-full bg-slate-100 text-slate-600 font-mono">${cat.slug}</span>
                    </h3>
                    ${cat.description ? `<p class="text-xs text-slate-500 mt-1 line-clamp-1">${cat.description}</p>` : ''}
                  </div>
                  <div class="flex items-center gap-1">
                    <button 
                      type="button" 
                      data-id="${cat.id || cat.slug}" 
                      data-name="${cat.name}" 
                      class="delete-category-btn text-[11px] font-medium text-rose-600 hover:text-rose-700 bg-rose-50 hover:bg-rose-100 px-2 py-1 rounded transition-colors cursor-pointer"
                      title="Hapus Kategori"
                    >
                      Hapus
                    </button>
                  </div>
                </div>

                <!-- Subcategories Chips Section -->
                <div class="mt-3 pt-3 border-t border-slate-100">
                  <div class="flex items-center justify-between mb-2">
                    <span class="text-[11px] font-semibold text-slate-700">Subkategori (${subcats.length}):</span>
                    <button 
                      type="button" 
                      data-cat-id="${cat.id || cat.slug}" 
                      data-cat-name="${cat.name}" 
                      class="open-add-subcat-btn text-[11px] font-semibold text-primary hover:text-primary-dark cursor-pointer flex items-center gap-1"
                    >
                      + Subkategori
                    </button>
                  </div>

                  <div class="flex flex-wrap gap-1.5 min-h-[28px]">
                    ${subcats.length > 0 ? subcats.map(sub => `
                      <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md text-[11px] bg-accent-bg text-primary border border-soft-cream font-medium">
                        <span>${sub.name}</span>
                        <button 
                          type="button" 
                          data-cat-id="${cat.id || cat.slug}" 
                          data-sub-slug="${sub.slug}" 
                          data-sub-name="${sub.name}" 
                          class="delete-subcat-btn text-primary/60 hover:text-rose-600 cursor-pointer font-bold leading-none"
                          title="Hapus Subkategori"
                        >
                          ✕
                        </button>
                      </span>
                    `).join('') : `
                      <span class="text-[11px] text-slate-400 italic">Belum ada subkategori (klik "+ Subkategori" untuk menambah).</span>
                    `}
                  </div>
                </div>
              </div>
            </div>
          `;
        }).join('');

        attachCategoryListeners();
      }

      // Category Action Listeners
      let pendingDeleteCatId = null;
      const categoryModal = document.getElementById('category-modal');
      const openAddCategoryBtn = document.getElementById('open-add-category-btn');
      const closeCategoryModalBtn = document.getElementById('close-category-modal-btn');
      const cancelCategoryBtn = document.getElementById('cancel-category-btn');
      const categoryForm = document.getElementById('category-form');
      const categoryNameInput = document.getElementById('category-name-input');
      const categorySlugInput = document.getElementById('category-slug-input');
      const categoryDescInput = document.getElementById('category-desc-input');
      const modalAddSubcatRowBtn = document.getElementById('modal-add-subcat-row-btn');
      const modalSubcategoriesList = document.getElementById('modal-subcategories-list');

      // Helper to append a dynamic subcategory row inside category modal
      function appendSubcatRow(initialName = '', initialSlug = '') {
        if (!modalSubcategoriesList) return;
        const row = document.createElement('div');
        row.className = 'modal-subcat-row flex items-center gap-2 animate-fade-in bg-slate-50 p-2 rounded-lg border border-slate-200';
        row.innerHTML = `
          <div class="flex-1">
            <input 
              type="text" 
              class="modal-subcat-name-input w-full px-2.5 py-1.5 rounded-md border border-slate-300 text-xs focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary/20 transition-all bg-white" 
              placeholder="Nama Subkategori (misal: Duka Cita)" 
              value="${initialName}"
              required 
            />
          </div>
          <div class="w-28">
            <input 
              type="text" 
              class="modal-subcat-slug-input w-full px-2 py-1.5 rounded-md border border-slate-300 text-[11px] font-mono focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary/20 transition-all bg-white" 
              placeholder="slug" 
              value="${initialSlug}"
            />
          </div>
          <button 
            type="button" 
            class="modal-subcat-remove-btn text-slate-400 hover:text-rose-600 p-1 text-sm font-bold cursor-pointer transition-colors"
            title="Hapus baris subkategori"
          >
            ✕
          </button>
        `;

        const nameInp = row.querySelector('.modal-subcat-name-input');
        const slugInp = row.querySelector('.modal-subcat-slug-input');
        const removeBtn = row.querySelector('.modal-subcat-remove-btn');

        nameInp?.addEventListener('input', () => {
          slugInp.value = toSlug(nameInp.value);
        });

        removeBtn?.addEventListener('click', () => {
          row.remove();
        });

        modalSubcategoriesList.appendChild(row);
        nameInp?.focus();
      }

      modalAddSubcatRowBtn?.addEventListener('click', () => {
        appendSubcatRow();
      });

      openAddCategoryBtn?.addEventListener('click', () => {
        categoryForm.reset();
        document.getElementById('category-edit-id').value = '';
        if (modalSubcategoriesList) modalSubcategoriesList.innerHTML = '';
        categoryModal.classList.remove('hidden');
        categoryNameInput.focus();
      });

      closeCategoryModalBtn?.addEventListener('click', () => categoryModal.classList.add('hidden'));
      cancelCategoryBtn?.addEventListener('click', () => categoryModal.classList.add('hidden'));

      categoryNameInput?.addEventListener('input', () => {
        categorySlugInput.value = toSlug(categoryNameInput.value);
      });

      categoryForm?.addEventListener('submit', async (e) => {
        e.preventDefault();
        const name = categoryNameInput.value.trim();
        let slug = categorySlugInput.value.trim() || toSlug(name);
        const desc = categoryDescInput.value.trim();

        if (!name) return;

        // Check if slug exists
        const existingIdx = categoriesList.findIndex(c => c.slug === slug);
        if (existingIdx !== -1) {
          slug = `${slug}-${Date.now().toString().slice(-4)}`;
        }

        // Collect all subcategories from dynamic input rows
        const subcategories = [];
        const rows = modalSubcategoriesList?.querySelectorAll('.modal-subcat-row') || [];
        rows.forEach(row => {
          const nameInput = row.querySelector('.modal-subcat-name-input');
          const slugInput = row.querySelector('.modal-subcat-slug-input');
          const sName = nameInput ? nameInput.value.trim() : '';
          let sSlug = slugInput ? slugInput.value.trim() : '';
          if (!sSlug) sSlug = toSlug(sName);

          if (sName) {
            subcategories.push({
              id: sSlug,
              name: sName,
              slug: sSlug
            });
          }
        });

        const newCat = {
          id: slug,
          name,
          slug,
          description: desc,
          subcategories: subcategories
        };

        categoriesList.push(newCat);
        await persistCategories();
        categoryModal.classList.add('hidden');
        showToast(`Kategori "${name}" berhasil ditambahkan${subcategories.length > 0 ? ` dengan ${subcategories.length} subkategori` : ''}.`);
      });

      // Subcategory Modal & Handlers
      const subcategoryModal = document.getElementById('subcategory-modal');
      const closeSubcatModalBtn = document.getElementById('close-subcat-modal-btn');
      const cancelSubcatBtn = document.getElementById('cancel-subcat-btn');
      const subcategoryForm = document.getElementById('subcategory-form');
      const subcatParentIdInput = document.getElementById('subcat-parent-category-id');
      const subcatParentLabel = document.getElementById('subcat-parent-label');
      const subcatNameInput = document.getElementById('subcat-name-input');
      const subcatSlugInput = document.getElementById('subcat-slug-input');

      closeSubcatModalBtn?.addEventListener('click', () => subcategoryModal.classList.add('hidden'));
      cancelSubcatBtn?.addEventListener('click', () => subcategoryModal.classList.add('hidden'));

      subcatNameInput?.addEventListener('input', () => {
        subcatSlugInput.value = toSlug(subcatNameInput.value);
      });

      subcategoryForm?.addEventListener('submit', async (e) => {
        e.preventDefault();
        const parentId = subcatParentIdInput.value;
        const name = subcatNameInput.value.trim();
        let slug = subcatSlugInput.value.trim() || toSlug(name);

        if (!name || !parentId) return;

        const parentCat = categoriesList.find(c => (c.id || c.slug) === parentId);
        if (!parentCat) {
          showToast('Kategori induk tidak ditemukan.', 'error');
          return;
        }

        if (!parentCat.subcategories) parentCat.subcategories = [];

        // Check duplicate
        if (parentCat.subcategories.some(s => s.slug === slug)) {
          slug = `${slug}-${Date.now().toString().slice(-4)}`;
        }

        parentCat.subcategories.push({
          id: slug,
          name,
          slug
        });

        await persistCategories();
        subcategoryModal.classList.add('hidden');
        showToast(`Subkategori "${name}" berhasil ditambahkan ke ${parentCat.name}.`);
      });

      // Delete Category Modal & Handlers
      const deleteCatModal = document.getElementById('delete-category-modal');
      const cancelDeleteCatBtn = document.getElementById('cancel-delete-category-btn');
      const confirmDeleteCatBtn = document.getElementById('confirm-delete-category-btn');
      const deleteCatNameLabel = document.getElementById('delete-category-name');

      cancelDeleteCatBtn?.addEventListener('click', () => {
        deleteCatModal.classList.add('hidden');
        pendingDeleteCatId = null;
      });

      confirmDeleteCatBtn?.addEventListener('click', async () => {
        if (!pendingDeleteCatId) return;

        const cat = categoriesList.find(c => (c.id || c.slug) === pendingDeleteCatId);
        const name = cat ? cat.name : '';

        categoriesList = categoriesList.filter(c => (c.id || c.slug) !== pendingDeleteCatId);
        await persistCategories();

        deleteCatModal.classList.add('hidden');
        pendingDeleteCatId = null;
        showToast(`Kategori "${name}" berhasil dihapus.`);
      });

      function attachCategoryListeners() {
        // Open Add Subcategory Button
        document.querySelectorAll('.open-add-subcat-btn').forEach(btn => {
          btn.addEventListener('click', () => {
            const catId = btn.getAttribute('data-cat-id');
            const catName = btn.getAttribute('data-cat-name');
            subcatParentIdInput.value = catId;
            subcatParentLabel.textContent = catName;
            subcategoryForm.reset();
            subcategoryModal.classList.remove('hidden');
            subcatNameInput.focus();
          });
        });

        // Delete Subcategory Button
        document.querySelectorAll('.delete-subcat-btn').forEach(btn => {
          btn.addEventListener('click', async (e) => {
            e.stopPropagation();
            const catId = btn.getAttribute('data-cat-id');
            const subSlug = btn.getAttribute('data-sub-slug');
            const subName = btn.getAttribute('data-sub-name');

            const parentCat = categoriesList.find(c => (c.id || c.slug) === catId);
            if (!parentCat || !parentCat.subcategories) return;

            parentCat.subcategories = parentCat.subcategories.filter(s => s.slug !== subSlug);
            await persistCategories();
            showToast(`Subkategori "${subName}" dihapus.`);
          });
        });

        // Delete Category Button
        document.querySelectorAll('.delete-category-btn').forEach(btn => {
          btn.addEventListener('click', () => {
            const id = btn.getAttribute('data-id');
            const name = btn.getAttribute('data-name');
            pendingDeleteCatId = id;
            if (deleteCatNameLabel) deleteCatNameLabel.textContent = `"${name}"`;
            deleteCatModal.classList.remove('hidden');
          });
        });
      }

      // Initial categories setup
      updateCategoryDropdowns();
      renderCategoriesCards();

      // ================= CITIES STATE MANAGEMENT =================
      let citiesList = [];

      function updateCityBadges() {
        const badge = document.getElementById('tab-city-badge');
        if (badge) badge.textContent = citiesList.length;
      }

      async function persistCities() {
        try {
          localStorage.setItem('zaloma_admin_cities_v2', JSON.stringify(citiesList));
          localStorage.setItem('zaloma_admin_cities_v1', JSON.stringify(citiesList));
          updateCityDropdowns();
          renderCitiesCards();
          updateCityBadges();
          await saveSystemConfig('_cities_config_', 'System Cities Config', JSON.stringify(citiesList));
        } catch (err) {
          console.warn('Sync cities notice:', err);
        }
      }

      function updateCityDropdowns() {
        const prodCity = document.getElementById('prod-city');
        const editCity = document.getElementById('edit-prod-city');

        const prevProdCity = prodCity ? prodCity.value : '';
        const prevEditCity = editCity ? editCity.value : '';

        const optionsHtml = citiesList.map(c => {
          const val = typeof c === 'string' ? c : c.name;
          const isWorldwide = val.includes('Mana Saja');
          const icon = isWorldwide ? '🌍 ' : '📍 ';
          return `<option value="${val}">${icon}${val}</option>`;
        }).join('');

        const fullOptions = '<option value="" disabled selected>Pilih Wilayah / Kota Pengiriman...</option>' +
          '<option value="__ADD_NEW_CITY__" class="font-semibold text-primary">➕ + Tambah Kota Pengiriman Baru...</option>' +
          optionsHtml;

        if (prodCity) {
          prodCity.innerHTML = fullOptions;
          if (prevProdCity && citiesList.some(c => (typeof c === 'string' ? c : c.name) === prevProdCity)) {
            prodCity.value = prevProdCity;
          } else if (citiesList.length > 0) {
            prodCity.value = typeof citiesList[0] === 'string' ? citiesList[0] : citiesList[0].name;
          }
        }

        if (editCity) {
          editCity.innerHTML = fullOptions;
          if (prevEditCity && citiesList.some(c => (typeof c === 'string' ? c : c.name) === prevEditCity)) {
            editCity.value = prevEditCity;
          }
        }

        updateCityBadges();
        syncCustomDropdown('prod-city');
        syncCustomDropdown('edit-prod-city');
      }

      let citySelectedImageBlob = null;

      function renderCitiesCards() {
        const grid = document.getElementById('cities-cards-grid');
        if (!grid) return;

        if (citiesList.length === 0) {
          grid.innerHTML = `
            <div class="col-span-full py-12 text-center text-slate-400 bg-white rounded-xl border border-dashed border-slate-200 p-6 text-xs">
              Belum ada wilayah/kota pengiriman. Klik "+ Tambah Kota" untuk menambahkan.
            </div>
          `;
          return;
        }

        grid.innerHTML = citiesList.map((c, idx) => {
          const name = typeof c === 'string' ? c : c.name;
          const desc = typeof c === 'string' ? '' : (c.description || '');
          const provinceName = typeof c === 'object' ? (c.province_name || '') : '';
          const img = typeof c === 'object' && (c.image || c.image_url) ? (c.image || c.image_url) : '';
          const isWorldwide = name.includes('Mana Saja');

          return `
            <div class="bg-white rounded-xl border border-slate-200 shadow-2xs hover:border-slate-300 transition-all flex flex-col justify-between group overflow-hidden">
              ${img ? `
                <div class="relative h-24 w-full bg-slate-100 overflow-hidden">
                  <img src="${img}" alt="${name}" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" />
                  <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent"></div>
                  <span class="absolute bottom-2 left-2.5 text-[10px] font-bold text-white uppercase tracking-wider bg-black/40 backdrop-blur-xs px-2 py-0.5 rounded">
                    ${isWorldwide ? '🌍 Global' : '📍 Kota'}
                  </span>
                </div>
              ` : `
                <div class="h-10 bg-slate-50 border-b border-slate-100 px-3 flex items-center justify-between">
                  <span class="text-xs font-bold text-slate-500">${isWorldwide ? '🌍 Nasional' : '📍 Kota Tujuan'}</span>
                  <span class="text-[10px] text-slate-400 italic">Tanpa foto</span>
                </div>
              `}

              <div class="p-3.5">
                <div class="flex items-center gap-2">
                  ${!img ? `
                    <span class="w-6 h-6 rounded-lg ${isWorldwide ? 'bg-sky-50 text-sky-600' : 'bg-rose-50 text-primary'} flex items-center justify-center text-xs shrink-0">
                      ${isWorldwide ? '🌍' : '📍'}
                    </span>
                  ` : ''}
                  <h4 class="font-bold text-slate-800 text-xs leading-snug truncate" title="${name}">
                    ${name}
                  </h4>
                </div>
                ${provinceName ? `<p class="text-[10px] text-slate-400 mt-1 truncate">${provinceName}</p>` : ''}
                ${desc ? `<p class="text-[11px] text-slate-500 mt-1 line-clamp-2 leading-relaxed">${desc}</p>` : '<p class="text-[10px] text-slate-400 mt-1 italic">Tersedia untuk pengiriman produk</p>'}
              </div>

              <div class="px-3.5 pb-3 pt-2 border-t border-slate-100 flex items-center justify-between text-[11px]">
                <span class="text-[10px] text-slate-400 font-medium">${img ? '✓ Foto Ada' : 'Foto Default'}</span>
                <div class="flex items-center gap-1">
                  <button type="button" data-index="${idx}" class="edit-city-btn px-2.5 py-1 rounded text-slate-600 hover:text-primary hover:bg-slate-100 font-semibold cursor-pointer transition-colors">
                    Edit
                  </button>
                  <button type="button" data-index="${idx}" class="delete-city-btn px-2.5 py-1 rounded text-rose-600 hover:text-rose-700 hover:bg-rose-50 font-semibold cursor-pointer transition-colors">
                    Hapus
                  </button>
                </div>
              </div>
            </div>
          `;
        }).join('');

        // Attach action listeners for cities
        grid.querySelectorAll('.edit-city-btn').forEach(btn => {
          btn.addEventListener('click', async () => {
            const idx = Number(btn.getAttribute('data-index'));
            const c = citiesList[idx];
            if (!c) return;
            const name = typeof c === 'string' ? c : c.name;
            const desc = typeof c === 'string' ? '' : (c.description || '');
            const provinceName = typeof c === 'object' ? (c.province_name || '') : '';
            const img = typeof c === 'object' && (c.image || c.image_url) ? (c.image || c.image_url) : '';

            document.getElementById('city-edit-index').value = idx;
            document.getElementById('city-modal-title').innerHTML = '<span class="w-2 h-2 rounded-full bg-primary"></span> Edit Wilayah / Kota';
            document.getElementById('city-desc-input').value = desc;
            document.getElementById('city-image-url-input').value = img;
            
            citySelectedImageBlob = null;
            document.getElementById('city-image-file').value = '';

            const previewState = document.getElementById('city-image-preview-state');
            const emptyState = document.getElementById('city-image-empty-state');
            const previewImg = document.getElementById('city-image-preview');
            const removeBtn = document.getElementById('remove-city-image-btn');

            if (img) {
              previewImg.src = img;
              previewState.classList.remove('hidden');
              emptyState.classList.add('hidden');
              removeBtn.classList.remove('hidden');
            } else {
              previewState.classList.add('hidden');
              emptyState.classList.remove('hidden');
              removeBtn.classList.add('hidden');
            }

            document.getElementById('city-modal').classList.remove('hidden');
            await prepareCityWilayahForm({ provinceName, cityName: name });
            document.getElementById('city-province-select')?.focus();
          });
        });

        grid.querySelectorAll('.delete-city-btn').forEach(btn => {
          btn.addEventListener('click', async () => {
            const idx = Number(btn.getAttribute('data-index'));
            const c = citiesList[idx];
            if (!c) return;
            const name = typeof c === 'string' ? c : c.name;

            if (confirm(`Hapus wilayah/kota "${name}" dari pilihan?`)) {
              citiesList.splice(idx, 1);
              await persistCities();
              showToast(`Wilayah "${name}" berhasil dihapus.`);
            }
          });
        });
      }

      // City Modal Handlers
      const cityModal = document.getElementById('city-modal');
      const openAddCityBtn = document.getElementById('open-add-city-btn');
      const closeCityModalBtn = document.getElementById('close-city-modal-btn');
      const cancelCityBtn = document.getElementById('cancel-city-btn');
      const cityForm = document.getElementById('city-form');
      const cityImageFileInput = document.getElementById('city-image-file');
      const cityImageUrlInput = document.getElementById('city-image-url-input');
      const cityRemoveImageBtn = document.getElementById('remove-city-image-btn');
      const cityPreviewState = document.getElementById('city-image-preview-state');
      const cityEmptyState = document.getElementById('city-image-empty-state');
      const cityPreviewImg = document.getElementById('city-image-preview');
      const cityProvinceSelect = document.getElementById('city-province-select');
      const cityRegencySearch = document.getElementById('city-regency-search');
      const cityRegencySelect = document.getElementById('city-regency-select');
      const cityRegencyHint = document.getElementById('city-regency-hint');

      const WILAYAH_API_BASE = 'https://www.emsifa.com/api-wilayah-indonesia/api';
      let wilayahProvincesCache = null;
      const wilayahRegenciesCache = {};
      let currentRegencyOptions = [];

      function formatWilayahName(name) {
        return String(name || '')
          .toLowerCase()
          .replace(/\b\w/g, (ch) => ch.toUpperCase());
      }

      function normalizeWilayahKey(name) {
        return String(name || '')
          .toLowerCase()
          .replace(/\bkabupaten\b/g, 'kab')
          .replace(/\bkota\b/g, 'kota')
          .replace(/[^a-z0-9]+/g, ' ')
          .trim();
      }

      async function fetchWilayahProvinces() {
        if (wilayahProvincesCache) return wilayahProvincesCache;
        const res = await fetch(`${WILAYAH_API_BASE}/provinces.json`);
        if (!res.ok) throw new Error('Gagal memuat daftar provinsi');
        const data = await res.json();
        wilayahProvincesCache = (data || []).map((p) => ({
          id: String(p.id),
          name: formatWilayahName(p.name)
        }));
        return wilayahProvincesCache;
      }

      async function fetchWilayahRegencies(provinceId) {
        const key = String(provinceId);
        if (wilayahRegenciesCache[key]) return wilayahRegenciesCache[key];
        const res = await fetch(`${WILAYAH_API_BASE}/regencies/${key}.json`);
        if (!res.ok) throw new Error('Gagal memuat daftar kota');
        const data = await res.json();
        wilayahRegenciesCache[key] = (data || []).map((r) => ({
          id: String(r.id),
          name: formatWilayahName(r.name)
        }));
        return wilayahRegenciesCache[key];
      }

      function renderRegencyOptions(list, selectedName = '', emptyLabel = 'Pilih kota...') {
        if (!cityRegencySelect) return;
        const options = [`<option value="" disabled ${selectedName ? '' : 'selected'}>${emptyLabel}</option>`];
        list.forEach((item) => {
          const selected = selectedName && normalizeWilayahKey(item.name) === normalizeWilayahKey(selectedName) ? 'selected' : '';
          options.push(`<option value="${item.name.replace(/"/g, '&quot;')}" ${selected}>${item.name}</option>`);
        });

        if (selectedName && !list.some((item) => normalizeWilayahKey(item.name) === normalizeWilayahKey(selectedName))) {
          options.push(`<option value="${selectedName.replace(/"/g, '&quot;')}" selected>${selectedName} (tersimpan)</option>`);
        }

        cityRegencySelect.innerHTML = options.join('');
      }

      function filterAndRenderRegencies(query = '', selectedName = '') {
        const q = String(query || '').trim().toLowerCase();
        const filtered = !q
          ? currentRegencyOptions
          : currentRegencyOptions.filter((item) => item.name.toLowerCase().includes(q));
        renderRegencyOptions(
          filtered,
          selectedName,
          filtered.length ? 'Pilih kota...' : 'Tidak ada kota yang cocok'
        );
        if (cityRegencyHint) {
          cityRegencyHint.textContent = q
            ? `${filtered.length} kota cocok dengan pencarian.`
            : `${currentRegencyOptions.length} kota tersedia. Ketik untuk mencari.`;
        }
      }

      async function populateProvinceSelect(selectedProvinceName = '') {
        if (!cityProvinceSelect) return null;
        try {
          const provinces = await fetchWilayahProvinces();
          let matchedId = '';
          provinces.forEach((p) => {
            if (selectedProvinceName && normalizeWilayahKey(p.name) === normalizeWilayahKey(selectedProvinceName)) {
              matchedId = p.id;
            }
          });
          const options = [
            `<option value="" disabled ${matchedId ? '' : 'selected'}>Pilih Provinsi...</option>`,
            ...provinces.map((p) => {
              const selected = matchedId === p.id ? 'selected' : '';
              return `<option value="${p.id}" data-name="${p.name.replace(/"/g, '&quot;')}" ${selected}>${p.name}</option>`;
            })
          ];
          cityProvinceSelect.innerHTML = options.join('');
          if (matchedId) cityProvinceSelect.value = matchedId;
          return matchedId || null;
        } catch (err) {
          cityProvinceSelect.innerHTML = '<option value="" disabled selected>Gagal memuat provinsi</option>';
          showToast(err.message || 'Gagal memuat daftar provinsi', 'error');
          return null;
        }
      }

      async function loadRegenciesForProvince(provinceId, { selectedCityName = '', searchQuery = '' } = {}) {
        if (!cityRegencySelect || !cityRegencySearch) return;
        if (!provinceId) {
          currentRegencyOptions = [];
          cityRegencySearch.value = '';
          cityRegencySearch.disabled = true;
          cityRegencySelect.disabled = true;
          cityRegencySelect.innerHTML = '<option value="" disabled selected>Pilih provinsi terlebih dahulu</option>';
          if (cityRegencyHint) cityRegencyHint.textContent = 'Pilih provinsi dulu, lalu cari atau pilih kota.';
          return;
        }

        cityRegencySearch.disabled = true;
        cityRegencySelect.disabled = true;
        cityRegencySelect.innerHTML = '<option value="" disabled selected>Memuat daftar kota...</option>';
        if (cityRegencyHint) cityRegencyHint.textContent = 'Memuat daftar kota...';

        try {
          currentRegencyOptions = await fetchWilayahRegencies(provinceId);
          cityRegencySearch.disabled = false;
          cityRegencySelect.disabled = false;
          cityRegencySearch.value = searchQuery || '';
          filterAndRenderRegencies(cityRegencySearch.value, selectedCityName);
        } catch (err) {
          currentRegencyOptions = [];
          cityRegencySearch.disabled = true;
          cityRegencySelect.disabled = true;
          cityRegencySelect.innerHTML = '<option value="" disabled selected>Gagal memuat kota</option>';
          if (cityRegencyHint) cityRegencyHint.textContent = 'Gagal memuat daftar kota. Coba lagi.';
          showToast(err.message || 'Gagal memuat daftar kota', 'error');
        }
      }

      async function prepareCityWilayahForm({ provinceName = '', cityName = '' } = {}) {
        const matchedProvinceId = await populateProvinceSelect(provinceName);
        if (matchedProvinceId) {
          await loadRegenciesForProvince(matchedProvinceId, { selectedCityName: cityName });
        } else {
          await loadRegenciesForProvince('', {});
          if (cityName) {
            // Kota lama tanpa mapping provinsi: tampilkan sebagai opsi tersimpan sementara
            cityRegencySelect.disabled = false;
            cityRegencySearch.disabled = true;
            renderRegencyOptions([], cityName, 'Pilih kota...');
            if (cityRegencyHint) {
              cityRegencyHint.textContent = 'Pilih ulang provinsi agar daftar kota lengkap tersedia.';
            }
          }
        }
      }

      function resetCityImageUpload() {
        citySelectedImageBlob = null;
        if (cityImageFileInput) cityImageFileInput.value = '';
        if (cityImageUrlInput) cityImageUrlInput.value = '';
        if (cityPreviewState) cityPreviewState.classList.add('hidden');
        if (cityEmptyState) cityEmptyState.classList.remove('hidden');
        if (cityRemoveImageBtn) cityRemoveImageBtn.classList.add('hidden');
      }

      // Handle file selection for city image
      cityImageFileInput?.addEventListener('change', async (e) => {
        const file = e.target.files && e.target.files[0];
        if (!file) return;

        if (!file.type.startsWith('image/')) {
          showToast('File harus berupa format gambar (JPG/PNG/WebP)', 'error');
          cityImageFileInput.value = '';
          return;
        }

        try {
          const blob = await openImageCrop(file, {
            aspect: 372 / 232,
            title: 'Atur area gambar kota',
            maxDimension: 1200,
          });
          if (!blob) {
            cityImageFileInput.value = '';
            return;
          }
          if (cityPreviewImg.src.startsWith('blob:')) URL.revokeObjectURL(cityPreviewImg.src);
          citySelectedImageBlob = blob;
          cityPreviewImg.src = URL.createObjectURL(blob);
          cityPreviewState.classList.remove('hidden');
          cityEmptyState.classList.add('hidden');
          cityRemoveImageBtn.classList.remove('hidden');
          cityImageUrlInput.value = '';
        } catch (error) {
          cityImageFileInput.value = '';
          showToast(error.message || 'Gagal memproses gambar kota.', 'error');
        }
      });

      // Handle direct URL paste
      cityImageUrlInput?.addEventListener('input', () => {
        const url = cityImageUrlInput.value.trim();
