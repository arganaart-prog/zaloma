    <script define:vars={{ SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_BUCKET, R2_IMAGE_API_URL, DEFAULT_PROMO_BANNERS, PROMO_BANNERS_CONFIG_SLUG, DEFAULT_ARTICLES: ARTICLES, ARTICLES_CONFIG_SLUG }}>
      // Initialize Supabase Client
      const supabase = window.supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY);

      // Default categories fallback
      const DEFAULT_CATEGORIES = [
        { slug: 'bunga-papan', name: 'Bunga Papan', subcategories: [] },
        { slug: 'bunga-papan-semi-styrofoam', name: 'Bunga Papan Semi Styrofoam', subcategories: [] },
        { slug: 'bouquet', name: 'Bouquet', subcategories: [] },
        { slug: 'standing-flower', name: 'Standing Flower', subcategories: [] },
        { slug: 'bunga-meja', name: 'Bunga Meja', subcategories: [] },
        { slug: 'tabulampot', name: 'Tabulampot', subcategories: [] },
        { slug: 'paper-flower', name: 'Paper Flower', subcategories: [] }
      ];

      // ==========================================
      // BULLETPROOF CUSTOM DROPDOWN COMPONENT
      // Replaces native OS popups with in-page floating dropdown menus
      // ==========================================
      function initCustomDropdown(selectId) {
        const select = document.getElementById(selectId);
        if (!select) return;

        let root = select.nextElementSibling;
        if (root && root.classList && root.classList.contains('custom-dropdown-root')) {
          syncCustomDropdown(selectId);
          return;
        }

        // Hide native select visually, keep in DOM for forms/validation
        select.style.position = 'absolute';
        select.style.opacity = '0';
        select.style.pointerEvents = 'none';
        select.style.width = '1px';
        select.style.height = '1px';
        select.tabIndex = -1;

        root = document.createElement('div');
        root.className = 'custom-dropdown-root relative w-full';
        root.setAttribute('data-target-id', selectId);

        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'custom-dropdown-btn w-full flex items-center justify-between px-3 py-2 rounded-lg border border-slate-300 text-xs bg-white text-slate-800 text-left hover:border-primary/60 focus:outline-none focus:ring-1 focus:ring-primary/20 transition-all cursor-pointer shadow-2xs select-none';

        const label = document.createElement('span');
        label.className = 'custom-dropdown-label truncate font-medium text-slate-800';

        const arrow = document.createElement('span');
        arrow.className = 'dropdown-arrow ml-2 text-slate-400 shrink-0 text-[10px] transition-transform duration-200';
        arrow.textContent = '▼';

        btn.appendChild(label);
        btn.appendChild(arrow);

        const menu = document.createElement('div');
        menu.className = 'custom-dropdown-menu hidden absolute top-[calc(100%+4px)] left-0 right-0 bg-white border border-slate-200 rounded-xl shadow-xl z-50 max-h-60 overflow-y-auto p-1.5 space-y-0.5 animate-modal-pop';
        menu.style.boxShadow = '0 10px 25px -5px rgba(0, 0, 0, 0.15), 0 8px 10px -6px rgba(0, 0, 0, 0.1)';

        root.appendChild(btn);
        root.appendChild(menu);

        select.parentNode.insertBefore(root, select.nextSibling);

        btn.addEventListener('click', (e) => {
          e.preventDefault();
          e.stopPropagation();
          const isHidden = menu.classList.contains('hidden');
          document.querySelectorAll('.custom-dropdown-menu').forEach(m => m.classList.add('hidden'));
          document.querySelectorAll('.dropdown-arrow').forEach(a => a.style.transform = 'rotate(0deg)');
          document.querySelectorAll('.custom-dropdown-btn').forEach(b => b.classList.remove('border-primary', 'ring-1', 'ring-primary/20'));

          if (isHidden) {
            renderItems();
            menu.classList.remove('hidden');
            arrow.style.transform = 'rotate(180deg)';
            btn.classList.add('border-primary', 'ring-1', 'ring-primary/20');
          }
        });

        function renderItems() {
          menu.innerHTML = '';
          const children = Array.from(select.children);
          if (children.length === 0) {
            menu.innerHTML = '<div class="px-3 py-2 text-xs text-slate-400 text-center">Tidak ada pilihan</div>';
            return;
          }

          children.forEach(child => {
            if (child.tagName === 'OPTGROUP') {
              const grp = document.createElement('div');
              grp.className = 'px-2.5 py-1 text-[11px] font-bold text-slate-500 bg-slate-50 rounded-md mt-1 flex items-center gap-1.5 border-l-2 border-primary';
              grp.textContent = child.label;
              menu.appendChild(grp);
              Array.from(child.children).forEach(opt => {
                menu.appendChild(buildOptionBtn(opt));
              });
            } else if (child.tagName === 'OPTION') {
              menu.appendChild(buildOptionBtn(child));
            }
          });
        }

        function buildOptionBtn(opt) {
          const b = document.createElement('button');
          b.type = 'button';
          const isAction = opt.value.startsWith('__ADD_NEW_');
          const isSelected = select.value === opt.value;

          let cls = 'w-full text-left px-3 py-2 rounded-lg text-xs transition-colors flex items-center justify-between cursor-pointer select-none ';
          if (isAction) {
            cls += 'font-semibold text-primary bg-primary/5 hover:bg-primary/10 border border-primary/20 my-1 ';
          } else if (isSelected) {
            cls += 'font-bold text-primary bg-primary/10 ';
          } else {
            cls += 'text-slate-700 hover:bg-slate-100 hover:text-slate-900 ';
          }
          b.className = cls;

          const t = document.createElement('span');
          t.className = 'truncate';
          t.textContent = opt.textContent;
          b.appendChild(t);

          if (isSelected && !isAction && opt.value) {
            const c = document.createElement('span');
            c.className = 'text-primary font-bold ml-2 shrink-0 text-xs';
            c.textContent = '✓';
            b.appendChild(c);
          }

          b.addEventListener('click', (e) => {
            e.preventDefault();
            e.stopPropagation();
            select.value = opt.value;
            select.dispatchEvent(new Event('change', { bubbles: true }));
            select.dispatchEvent(new Event('input', { bubbles: true }));
            syncTriggerLabel();
            menu.classList.add('hidden');
            arrow.style.transform = 'rotate(0deg)';
            btn.classList.remove('border-primary', 'ring-1', 'ring-primary/20');
          });

          return b;
        }

        function syncTriggerLabel() {
          const selectedOpt = select.options[select.selectedIndex];
          if (selectedOpt && selectedOpt.value) {
            label.textContent = selectedOpt.textContent;
            label.className = 'custom-dropdown-label truncate font-medium text-slate-800';
          } else if (selectedOpt) {
            label.textContent = selectedOpt.textContent;
            label.className = 'custom-dropdown-label truncate font-normal text-slate-400';
          } else {
            label.textContent = 'Pilih...';
            label.className = 'custom-dropdown-label truncate font-normal text-slate-400';
          }
        }

        syncTriggerLabel();
        select.addEventListener('change', syncTriggerLabel);
      }

      function syncCustomDropdown(selectId) {
        const select = document.getElementById(selectId);
        if (!select) return;
        let root = select.nextElementSibling;
        if (!root || !root.classList || !root.classList.contains('custom-dropdown-root')) {
          initCustomDropdown(selectId);
          return;
        }
        const label = root.querySelector('.custom-dropdown-label');
        const selectedOpt = select.options[select.selectedIndex];
        if (label) {
          if (selectedOpt && selectedOpt.value) {
            label.textContent = selectedOpt.textContent;
            label.className = 'custom-dropdown-label truncate font-medium text-slate-800';
          } else if (selectedOpt) {
            label.textContent = selectedOpt.textContent;
            label.className = 'custom-dropdown-label truncate font-normal text-slate-400';
          } else {
            label.textContent = 'Pilih...';
            label.className = 'custom-dropdown-label truncate font-normal text-slate-400';
          }
        }
      }

      // Close all custom dropdown menus on click outside
      document.addEventListener('click', (e) => {
        if (!e.target.closest('.custom-dropdown-root')) {
          document.querySelectorAll('.custom-dropdown-menu').forEach(m => m.classList.add('hidden'));
          document.querySelectorAll('.dropdown-arrow').forEach(a => a.style.transform = 'rotate(0deg)');
          document.querySelectorAll('.custom-dropdown-btn').forEach(b => b.classList.remove('border-primary', 'ring-1', 'ring-primary/20'));
        }
      });


      // Auth UI Elements
      const loginGate = document.getElementById('login-gate');
      const adminDashboard = document.getElementById('admin-dashboard');
      const loginForm = document.getElementById('login-form');
      const emailInput = document.getElementById('admin-email-input');
      const passwordInput = document.getElementById('admin-password-input');
      const loginError = document.getElementById('login-error');
      const loginBtn = document.getElementById('login-btn');
      const loginBtnText = document.getElementById('login-btn-text');
      const loginSpinner = document.getElementById('login-spinner');
      const logoutBtn = document.getElementById('logout-btn');
      const userEmailDisplay = document.getElementById('user-email-display');

      let allProductsList = [];
      let pendingDeleteId = null;
      function getProductImageRef(imageUrl) {
        if (typeof imageUrl !== 'string' || !imageUrl.trim()) return null;
        if (!/^https?:\/\//i.test(imageUrl.trim())) return null;
        try {
          const image = new URL(imageUrl);
          const projectUrl = new URL(SUPABASE_URL);
          const supabasePrefix = `/storage/v1/object/public/${SUPABASE_BUCKET}/`;
          const r2Prefix = '/products/';
          let provider;
          let path;

          if (image.origin === projectUrl.origin && image.pathname.startsWith(supabasePrefix)) {
            provider = 'supabase';
            path = decodeURIComponent(image.pathname.slice(supabasePrefix.length));
          } else if (image.hostname === 'cdn.zalomaflorist.com' && image.pathname.startsWith(r2Prefix)) {
            provider = 'r2';
            path = decodeURIComponent(image.pathname.slice(1));
          } else {
            return null;
          }

          if (!path || path.split('/').some(segment => !segment || segment === '.' || segment === '..')) return null;
          return { provider, path, key: `${provider}:${path}` };
        } catch (error) {
          console.warn('[Zaloma Admin] URL foto penyimpanan tidak valid:', error);
          return null;
        }
      }

      async function getR2ImageAccessToken() {
        const { data, error } = await supabase.auth.getSession();
        if (error) throw new Error(`Gagal memeriksa sesi admin: ${error.message}`);
        const accessToken = data.session?.access_token;
        if (!accessToken) throw new Error('Sesi admin berakhir. Silakan masuk kembali.');
        return accessToken;
      }

      async function uploadProductImageToR2(slug, blob) {
        const formData = new FormData();
        formData.append('slug', slug);
        formData.append('file', blob, 'product.webp');
        const response = await fetch(`${R2_IMAGE_API_URL}/upload`, {
          method: 'POST',
          headers: { Authorization: `Bearer ${await getR2ImageAccessToken()}` },
          body: formData,
        });
        const result = await response.json().catch(() => ({}));
        if (!response.ok) throw new Error(result.error || `Upload R2 gagal (${response.status}).`);
        if (typeof result.url !== 'string' || typeof result.key !== 'string') {
          throw new Error('Respons upload R2 tidak valid.');
        }
        return result;
      }

      async function deleteProductImagesFromR2(keys) {
        if (!keys.length) return;
        const response = await fetch(`${R2_IMAGE_API_URL}/objects`, {
          method: 'DELETE',
          headers: {
            Authorization: `Bearer ${await getR2ImageAccessToken()}`,
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({ keys }),
        });
        const result = await response.json().catch(() => ({}));
        if (!response.ok) throw new Error(result.error || `Penghapusan R2 gagal (${response.status}).`);
      }

      async function removeUnreferencedProductImages(imageUrls) {
        const candidates = [...new Map(
          (imageUrls || [])
            .map(getProductImageRef)
            .filter(Boolean)
            .map(ref => [ref.key, ref])
        ).values()];
        if (candidates.length === 0) return;

        const { data: products, error: lookupError } = await supabase
          .from('products')
          .select('image, images');
        if (lookupError) throw lookupError;

        const referencedPaths = new Set();
        (products || []).forEach(product => {
          [product.image, ...(Array.isArray(product.images) ? product.images : [])]
            .map(getProductImageRef)
            .filter(Boolean)
            .forEach(ref => referencedPaths.add(ref.key));
        });

        const orphanedImages = candidates.filter(ref => !referencedPaths.has(ref.key));
        if (orphanedImages.length === 0) return;

        const supabasePaths = orphanedImages.filter(ref => ref.provider === 'supabase').map(ref => ref.path);
        if (supabasePaths.length) {
          const { error: removeError } = await supabase.storage.from(SUPABASE_BUCKET).remove(supabasePaths);
          if (removeError) throw removeError;
        }

        const r2Paths = orphanedImages.filter(ref => ref.provider === 'r2').map(ref => ref.path);
        if (r2Paths.length) await deleteProductImagesFromR2(r2Paths);
      }

      let promoBanners = DEFAULT_PROMO_BANNERS;
      let promoBannerDesktopFile = null;
      let promoBannerMobileFile = null;
      let promoBannerRemoveDesktop = false;
      let promoBannerRemoveMobile = false;
      const imageCropModal = document.getElementById('image-crop-modal');
      const imageCropViewport = document.getElementById('image-crop-viewport');
      const imageCropSource = document.getElementById('image-crop-source');
      const imageCropSelection = document.getElementById('image-crop-selection');
      const imageCropZoom = document.getElementById('image-crop-zoom');
      let activeCrop = null;

      function renderCropSelection(center = false) {
        if (!activeCrop) return;
        const { width, height, aspect } = activeCrop;
        const zoom = Number(imageCropZoom.value);
        const selection = aspect >= width / height
          ? { width: width / zoom, height: width / zoom / aspect }
          : { height: height / zoom, width: height / zoom * aspect };
        const maxLeft = width - selection.width;
        const maxTop = height - selection.height;
        const left = center ? maxLeft / 2 : Math.max(0, Math.min(maxLeft, activeCrop.left));
        const top = center ? maxTop / 2 : Math.max(0, Math.min(maxTop, activeCrop.top));
        activeCrop = { ...activeCrop, left, top, selectionWidth: selection.width, selectionHeight: selection.height };

        imageCropSelection.style.left = `${left}px`;
        imageCropSelection.style.top = `${top}px`;
        imageCropSelection.style.width = `${selection.width}px`;
        imageCropSelection.style.height = `${selection.height}px`;

        const masks = [
          ['image-crop-mask-top', { width, height: top }],
          ['image-crop-mask-bottom', { width, height: height - top - selection.height, top: top + selection.height }],
          ['image-crop-mask-left', { width: left, height: selection.height, top }],
          ['image-crop-mask-right', { width: width - left - selection.width, height: selection.height, left: left + selection.width, top }],
        ];
        masks.forEach(([id, style]) => Object.assign(document.getElementById(id).style, {
          left: `${style.left || 0}px`,
          top: `${style.top || 0}px`,
          width: `${style.width}px`,
          height: `${style.height}px`,
        }));
        document.getElementById('image-crop-zoom-label').textContent = `${zoom.toFixed(zoom % 1 ? 1 : 0)}×`;
      }

      function finishImageCrop(blob) {
        if (!activeCrop) return;
        const { resolve, objectUrl } = activeCrop;
        activeCrop = null;
        imageCropModal.classList.add('hidden');
        imageCropSource.removeAttribute('src');
        URL.revokeObjectURL(objectUrl);
        resolve(blob);
      }

      function openImageCrop(file, { aspect, title, maxDimension = 1200 }) {
        if (!file || !file.type.startsWith('image/')) {
          return Promise.reject(new Error('File harus berupa gambar.'));
        }
        return new Promise((resolve, reject) => {
          const objectUrl = URL.createObjectURL(file);
          const image = new Image();
          image.onerror = () => {
            URL.revokeObjectURL(objectUrl);
            imageCropModal.classList.add('hidden');
            reject(new Error('Gambar tidak dapat dibuka.'));
          };
          image.onload = () => {
            const maxWidth = Math.min(920, imageCropViewport.parentElement.clientWidth - 16);
            const maxHeight = Math.min(560, window.innerHeight * 0.58);
            const scale = Math.min(maxWidth / image.naturalWidth, maxHeight / image.naturalHeight);
            const width = image.naturalWidth * scale;
            const height = image.naturalHeight * scale;
            imageCropViewport.style.width = `${width}px`;
            imageCropViewport.style.height = `${height}px`;
            imageCropSource.style.width = `${width}px`;
            imageCropSource.style.height = `${height}px`;
            imageCropSource.src = objectUrl;
            document.getElementById('image-crop-title').textContent = title;
            imageCropZoom.value = '1';
            activeCrop = { resolve, reject, objectUrl, image, scale, width, height, aspect, maxDimension, left: 0, top: 0 };
            renderCropSelection(true);
          };
          imageCropModal.classList.remove('hidden');
          image.src = objectUrl;
        });
      }

      imageCropZoom.addEventListener('input', () => renderCropSelection(true));
      document.getElementById('image-crop-cancel').addEventListener('click', () => finishImageCrop(null));
      imageCropModal.addEventListener('click', (event) => {
        if (event.target === imageCropModal) finishImageCrop(null);
      });
      document.getElementById('image-crop-confirm').addEventListener('click', () => {
        if (!activeCrop) return;
        const { image, scale, left, top, selectionWidth, selectionHeight, aspect, maxDimension } = activeCrop;
        const sourceX = left / scale;
        const sourceY = top / scale;
        const sourceWidth = selectionWidth / scale;
        const sourceHeight = selectionHeight / scale;
        const outputWidth = aspect >= 1 ? maxDimension : Math.round(maxDimension * aspect);
        const outputHeight = aspect < 1 ? maxDimension : Math.round(maxDimension / aspect);
        const canvas = document.createElement('canvas');
        canvas.width = outputWidth;
        canvas.height = outputHeight;
        const context = canvas.getContext('2d');
        if (!context) {
          showToast('Browser tidak dapat memproses gambar ini.', 'error');
          return;
        }
        context.drawImage(image, sourceX, sourceY, sourceWidth, sourceHeight, 0, 0, outputWidth, outputHeight);
        canvas.toBlob((blob) => {
          if (blob) finishImageCrop(blob);
          else showToast('Gagal menyiapkan hasil potongan gambar.', 'error');
        }, 'image/webp', 0.91);
      });
      imageCropSelection.addEventListener('pointerdown', (event) => {
        if (!activeCrop) return;
        event.preventDefault();
        imageCropSelection.setPointerCapture(event.pointerId);
        activeCrop.drag = { x: event.clientX, y: event.clientY, left: activeCrop.left, top: activeCrop.top };
      });
      imageCropSelection.addEventListener('pointermove', (event) => {
        if (!activeCrop?.drag) return;
        activeCrop.left = activeCrop.drag.left + event.clientX - activeCrop.drag.x;
        activeCrop.top = activeCrop.drag.top + event.clientY - activeCrop.drag.y;
        renderCropSelection();
      });
      imageCropSelection.addEventListener('pointerup', () => {
        if (activeCrop) activeCrop.drag = null;
      });

      // Toast Notification Helper
      function showToast(message, type = 'success') {
        const container = document.getElementById('toast-container');
        if (!container) return;

        const toast = document.createElement('div');
        const isSuccess = type === 'success';
        const isError = type === 'error';
        const bgClass = isSuccess ? 'bg-slate-900 text-white' : isError ? 'bg-rose-700 text-white' : 'bg-slate-800 text-white';

        toast.className = `pointer-events-auto flex items-center justify-between gap-3 px-4 py-3 rounded-xl shadow-lg text-sm font-medium ${bgClass} animate-toast-in min-w-[280px]`;
        toast.innerHTML = `
          <span>${message}</span>
          <button type="button" class="text-white/60 hover:text-white text-sm cursor-pointer ml-2 min-w-[24px] min-h-[24px] flex items-center justify-center">✕</button>
        `;

        toast.querySelector('button')?.addEventListener('click', () => {
          toast.remove();
        });

        container.appendChild(toast);

        setTimeout(() => {
          if (toast.isConnected) toast.remove();
        }, 3000);
      }

