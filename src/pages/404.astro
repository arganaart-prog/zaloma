---
import Layout from '../layouts/Layout.astro';
import { WHATSAPP_NUMBER } from '../data/constants';
import { SUPABASE_URL, SUPABASE_ANON_KEY } from '../data/supabaseConfig';
import { withBase } from '../utils/paths';

Astro.response.status = 404;

const title = 'Halaman Tidak Ditemukan - Zaloma Florist';
const description = 'Halaman yang Anda cari tidak tersedia di Zaloma Florist. Kembali ke katalog toko bunga Malang atau hubungi admin WhatsApp.';
const whatsappUrl = `https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent('Halo Zaloma Florist, saya membuka halaman yang tidak ditemukan. Bisa bantu arahkan ke halaman yang tepat?')}`;
---

<Layout title={title} description={description} robots="noindex, follow" showTestimonials={false}>
  <!-- Supabase JS SDK for dynamic product fallback -->
  <script is:inline src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>

  <!-- Container jika URL ternyata adalah produk dinamis baru -->
  <div id="dynamic-product-view" class="hidden max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 min-h-[60vh]">
    <div id="dynamic-product-spinner" class="py-24 text-center">
      <svg class="w-10 h-10 animate-spin text-primary mx-auto mb-3" fill="none" viewBox="0 0 24 24">
        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
      </svg>
      <p class="text-sm font-semibold text-slate-500">Memuat detail produk...</p>
    </div>
    <div id="dynamic-product-content" class="hidden"></div>
  </div>

  <div class="e404-root" id="e404-container">

    <!-- Left column: editorial content -->
    <div class="e404-left">

      <!-- Ambient number - decorative, not semantic -->
      <div class="e404-num" aria-hidden="true">404</div>

      <div class="e404-content">
        <p class="e404-eyebrow">Halaman tidak ditemukan</p>
        <h1 class="e404-title">
          Tampaknya bunga ini<br />sudah dipindah ke tempat lain.
        </h1>
        <p class="e404-body">
          Alamat tautan yang Anda tuju mungkin sudah berubah atau halaman sedang diperbarui. Silakan kembali ke katalog untuk melihat pilihan karangan bunga yang tersedia.
        </p>

        <!-- Primary actions -->
        <div class="e404-actions">
          <a href={withBase('/katalog/')} class="e404-btn e404-btn--primary" id="e404-katalog-btn">
            Lihat Katalog
          </a>
          <a href={withBase('/')} class="e404-btn e404-btn--ghost" id="e404-home-btn">
            Kembali ke Beranda
          </a>
        </div>

        <!-- Quick nav -->
        <nav class="e404-nav" aria-label="Navigasi cepat dari halaman 404">
          <p class="e404-nav-label">Atau langsung ke:</p>
          <ul class="e404-nav-list">
            <li>
              <a href={withBase('/kategori/hand-bouquet-malang/')} class="e404-nav-link">
                Hand Bouquet
                <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8h10M9 4l4 4-4 4"/></svg>
              </a>
            </li>
            <li>
              <a href={withBase('/kategori/bunga-papan-malang/')} class="e404-nav-link">
                Bunga Papan
                <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8h10M9 4l4 4-4 4"/></svg>
              </a>
            </li>
            <li>
              <a href={withBase('/kategori/standing-flower-malang/')} class="e404-nav-link">
                Standing Flower
                <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8h10M9 4l4 4-4 4"/></svg>
              </a>
            </li>
            <li>
              <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="e404-nav-link e404-nav-link--wa">
                Tanya via WhatsApp
                <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8h10M9 4l4 4-4 4"/></svg>
              </a>
            </li>
          </ul>
        </nav>
      </div>
    </div>

    <!-- Right column: botanical visual -->
    <div class="e404-right" aria-hidden="true">
      <div class="e404-visual">
        <!-- Layered circles -->
        <div class="e404-circle e404-circle--outer"></div>
        <div class="e404-circle e404-circle--mid"></div>
        <div class="e404-circle e404-circle--inner"></div>
        <!-- Botanical SVG illustration -->
        <svg class="e404-botanical" viewBox="0 0 200 260" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <!-- stem -->
          <path d="M100 240 C100 200 100 170 100 130" stroke="#8aab6e" stroke-width="2.5" stroke-linecap="round"/>
          <!-- left branch -->
          <path d="M100 185 C85 175 70 165 55 160" stroke="#8aab6e" stroke-width="2" stroke-linecap="round"/>
          <path d="M55 160 C60 152 68 148 75 150 C70 158 62 162 55 160Z" fill="#b5c9a0" opacity="0.8"/>
          <!-- right branch -->
          <path d="M100 170 C115 158 130 150 148 148" stroke="#8aab6e" stroke-width="2" stroke-linecap="round"/>
          <path d="M148 148 C145 138 138 134 130 137 C134 145 141 150 148 148Z" fill="#b5c9a0" opacity="0.8"/>
          <!-- main flower petals -->
          <ellipse cx="100" cy="100" rx="18" ry="26" fill="#e8b4b8" opacity="0.85" transform="rotate(-25 100 100)"/>
          <ellipse cx="100" cy="100" rx="18" ry="26" fill="#e8b4b8" opacity="0.85" transform="rotate(25 100 100)"/>
          <ellipse cx="100" cy="100" rx="18" ry="26" fill="#d4919a" opacity="0.75" transform="rotate(70 100 100)"/>
          <ellipse cx="100" cy="100" rx="18" ry="26" fill="#d4919a" opacity="0.75" transform="rotate(-70 100 100)"/>
          <ellipse cx="100" cy="100" rx="18" ry="26" fill="#e8b4b8" opacity="0.7" transform="rotate(0 100 100)"/>
          <!-- flower centre -->
          <circle cx="100" cy="100" r="14" fill="#f5e6c8"/>
          <circle cx="100" cy="100" r="9" fill="#e8c98a"/>
          <circle cx="100" cy="100" r="5" fill="#c8a060"/>
          <!-- small accent flower left -->
          <circle cx="62" cy="88" r="10" fill="#c8ddb5" opacity="0.6"/>
          <circle cx="62" cy="88" r="6" fill="#a8c49a" opacity="0.8"/>
          <circle cx="62" cy="88" r="3" fill="#8aab6e"/>
          <!-- small accent flower right -->
          <circle cx="140" cy="82" r="8" fill="#f0cdd5" opacity="0.7"/>
          <circle cx="140" cy="82" r="5" fill="#e0aab5" opacity="0.85"/>
          <circle cx="140" cy="82" r="2.5" fill="#c4808e"/>
          <!-- floating dots -->
          <circle cx="72" cy="60" r="3" fill="#d4919a" opacity="0.4"/>
          <circle cx="135" cy="65" r="2" fill="#8aab6e" opacity="0.5"/>
          <circle cx="120" cy="115" r="2.5" fill="#e8c98a" opacity="0.45"/>
          <circle cx="78" cy="118" r="2" fill="#c8ddb5" opacity="0.55"/>
        </svg>
      </div>
    </div>

  </div>

  <script define:vars={{ SUPABASE_URL, SUPABASE_ANON_KEY, WHATSAPP_NUMBER }}>
    async function checkDynamicProductRoute() {
      const pathname = window.location.pathname;
      const match = pathname.match(/\/produk\/([^\/]+)/);
      if (!match || !match[1] || match[1] === 'detail') return;

      const slug = match[1];
      const e404Container = document.getElementById('e404-container');
      const dynamicView = document.getElementById('dynamic-product-view');
      const spinner = document.getElementById('dynamic-product-spinner');
      const content = document.getElementById('dynamic-product-content');

      if (e404Container) e404Container.classList.add('hidden');
      if (dynamicView) dynamicView.classList.remove('hidden');

      try {
        if (!window.supabase) return;
        const client = window.supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY);
        const { data: p, error } = await client
          .from('products')
          .select('*')
          .eq('slug', slug)
          .maybeSingle();

        if (error || !p) {
          if (dynamicView) dynamicView.classList.add('hidden');
          if (e404Container) e404Container.classList.remove('hidden');
          return;
        }

        document.title = `${p.name} - Zaloma Florist Malang`;

        const waText = encodeURIComponent(`Halo Zaloma Florist, saya ingin pesan ${p.name} (${p.price_label}). Mohon info ketersediaan dan format pemesanannya.`);
        const waUrl = `https://wa.me/${WHATSAPP_NUMBER}?text=${waText}`;

        if (content) {
          content.innerHTML = `
            <nav aria-label="Breadcrumb" class="mb-6">
              <ol class="flex items-center space-x-2 text-xs font-semibold text-slate-500 flex-wrap">
                <li><a href="/" class="hover:text-primary transition-colors">Beranda</a></li>
                <li class="text-slate-300">/</li>
                <li><a href="/katalog/" class="hover:text-primary transition-colors">Katalog</a></li>
                <li class="text-slate-300">/</li>
                <li><a href="/kategori/${p.category_slug}/" class="hover:text-primary transition-colors">${p.category_name || 'Kategori'}</a></li>
                <li class="text-slate-300">/</li>
                <li class="text-slate-800 font-bold">${p.name}</li>
              </ol>
            </nav>

            <div class="bg-white rounded-2xl sm:rounded-3xl border border-soft-cream/80 overflow-hidden shadow-xs">
              <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 p-5 sm:p-8 lg:p-12">
                <div class="lg:col-span-6 flex flex-col gap-6">
                  <div class="relative aspect-square rounded-2xl overflow-hidden bg-clean-ivory border border-soft-cream/60">
                    <img src="${p.image}" alt="${p.name}" class="w-full h-full object-cover object-top" />
                    ${p.featured ? '<div class="absolute top-4 left-4"><span class="bg-secondary text-primary-dark text-xs uppercase tracking-wider font-bold px-3 py-1.5 rounded-full shadow-sm">Populer &amp; Terlaris</span></div>' : ''}
                  </div>
                  <div class="grid grid-cols-3 gap-3 p-4 rounded-xl bg-accent-bg/60 border border-soft-cream/60 text-center">
                    <div>
                      <span class="block text-primary font-bold text-xs sm:text-sm">3 - 5 Jam</span>
                      <span class="text-[11px] text-slate-500">Pengerjaan</span>
                    </div>
                    <div class="border-x border-soft-cream/80">
                      <span class="block text-primary font-bold text-xs sm:text-sm">Difoto</span>
                      <span class="text-[11px] text-slate-500">Sebelum Kirim</span>
                    </div>
                    <div>
                      <span class="block text-primary font-bold text-xs sm:text-sm">Gratis Ongkir</span>
                      <span class="text-[11px] text-slate-500">Malang Kota</span>
                    </div>
                  </div>
                </div>

                <div class="lg:col-span-6 flex flex-col justify-between space-y-6">
                  <div class="space-y-4">
                    <div class="flex items-center gap-2 flex-wrap">
                      <a href="/kategori/${p.category_slug}/" class="inline-block text-xs font-semibold text-secondary uppercase tracking-wider bg-accent-bg px-2.5 py-1 rounded-md border border-soft-cream">
                        ${p.category_name || 'Kategori'}
                      </a>
                      <span class="text-xs text-slate-400">&bull;</span>
                      <span class="text-xs font-medium text-slate-500">Toko Bunga Malang</span>
                    </div>
                    <h1 class="font-serif text-2xl sm:text-3xl lg:text-4xl font-bold text-slate-900 leading-tight">
                      ${p.name}
                    </h1>
                    <div class="p-4 sm:p-5 rounded-2xl bg-gradient-to-br from-clean-ivory to-accent-bg border border-soft-cream">
                      <span class="text-xs font-semibold uppercase tracking-wider text-slate-500 block mb-1">Estimasi Harga</span>
                      <div class="flex items-baseline gap-3">
                        <span class="font-sans text-3xl sm:text-4xl font-extrabold text-primary">${p.price_label}</span>
                        <span class="text-xs text-slate-500 font-medium">(Bisa kustom sesuai budget)</span>
                      </div>
                    </div>
                    <div class="pt-2">
                      <h2 class="text-sm font-bold text-slate-800 uppercase tracking-wider mb-2">Deskripsi Produk</h2>
                      <p class="text-slate-600 text-sm sm:text-base leading-relaxed">${p.description || 'Pilihan karangan bunga berkualitas dari Zaloma Florist Malang.'}</p>
                    </div>
                  </div>

                  <div class="pt-4 border-t border-soft-cream/80 space-y-3">
                    <a href="${waUrl}" target="_blank" rel="noopener noreferrer" class="w-full inline-flex items-center justify-center gap-2 px-6 py-4 bg-[#25D366] hover:bg-[#20bd5a] text-white font-bold text-base rounded-xl shadow-md hover:shadow-lg transition-all text-center">
                      <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24"><path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.711 2.598 2.669-.699c.969.54 1.838.847 2.791.848 3.18 0 5.767-2.587 5.768-5.766.001-3.18-2.585-5.834-5.768-5.834zm3.377 8.243c-.147.411-.75.76-1.042.812-.292.052-.663.097-2.072-.49-1.409-.587-2.327-2.016-2.398-2.112-.07-.095-.572-.76-.572-1.45 0-.69.362-1.029.49-1.173.129-.144.281-.18.375-.18.094 0 .188.001.27.006.086.005.201-.033.315.241.114.275.39 1.025.424 1.107.034.082.057.178.002.288-.055.11-.082.179-.164.275-.082.096-.173.214-.247.288-.082.083-.168.172-.072.337.096.165.427.705.916 1.141.63.562 1.161.736 1.326.818.165.082.261.069.358-.041.096-.11.413-.48.523-.645.11-.165.22-.138.371-.082.151.055.955.45 1.12.533.165.082.275.124.316.192.041.069.041.399-.106.81zM12.012 2.002C6.488 2.002 2 6.49 2 12.014c0 1.942.553 3.755 1.517 5.289L2 22l4.821-1.488A9.97 9.97 0 0 0 12.012 22C17.535 22 22 17.51 22 12.014c0-5.524-4.465-10.012-9.988-10.012z"/></svg>
                      Pesan Sekarang via WhatsApp
                    </a>
                    <p class="text-center text-xs text-slate-400">Respons cepat 24 jam &bull; Konsultasi gratis</p>
                  </div>
                </div>
              </div>
            </div>
          `;
          if (spinner) spinner.classList.add('hidden');
          content.classList.remove('hidden');
        }

      } catch (e) {
        if (dynamicView) dynamicView.classList.add('hidden');
        if (e404Container) e404Container.classList.remove('hidden');
      }
    }

    checkDynamicProductRoute();
  </script>

</Layout>

<style>
  /* --------------------------------------------------------------------------`n        Page root: full-viewport two-column`n   -------------------------------------------------------------------------- */
  .e404-root {
    min-height: calc(100dvh - 80px);
    display: grid;
    grid-template-columns: 1fr 1fr;
    background: #f7f3ed;
  }

  /* --------------------------------------------------------------------------`n        Left column`n   -------------------------------------------------------------------------- */
  .e404-left {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 5rem 4rem 5rem 6%;
    overflow: hidden;
    border-right: 1px solid #F6E3E1;
  }

  /* Ghost 404 number behind content */
  .e404-num {
    position: absolute;
    top: -0.1em;
    left: -0.08em;
    font-family: var(--font-serif, Georgia, serif);
    font-size: clamp(10rem, 22vw, 18rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.06em;
    color: transparent;
    -webkit-text-stroke: 1.5px rgba(138, 171, 110, 0.18);
    pointer-events: none;
    user-select: none;
    z-index: 0;
  }

  .e404-content {
    position: relative;
    z-index: 1;
    max-width: 520px;
  }

  .e404-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #9aab88;
    margin-bottom: 1.25rem;
  }

  .e404-eyebrow::before {
    content: '';
    display: inline-block;
    width: 20px;
    height: 1.5px;
    background: currentColor;
    flex-shrink: 0;
  }

  .e404-title {
    font-family: var(--font-serif, Georgia, serif);
    font-size: clamp(1.8rem, 3.2vw, 2.75rem);
    font-weight: 700;
    line-height: 1.18;
    letter-spacing: -0.025em;
    color: #2E0C15;
    margin: 0 0 1.1rem;
  }

  .e404-body {
    font-size: 0.9rem;
    line-height: 1.75;
    color: #64748b;
    margin-bottom: 2.25rem;
    max-width: 440px;
  }

  /* -- Actions -- */
  .e404-actions {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-bottom: 2.75rem;
  }

  .e404-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    border-radius: 6px;
    padding: 0.65rem 1.5rem;
    text-decoration: none;
    transition: background 0.18s ease, color 0.18s ease, transform 0.18s ease;
  }

  .e404-btn--primary {
    background: #3d4e36;
    color: #fff;
    box-shadow: 0 2px 10px rgba(61, 78, 54, 0.22);
  }

  .e404-btn--primary:hover {
    background: #2c3a27;
    transform: translateY(-1px);
  }

  .e404-btn--ghost {
    background: transparent;
    color: #3d4e36;
    border: 1.5px solid #c4baa8;
  }

  .e404-btn--ghost:hover {
    border-color: #3d4e36;
    background: rgba(61, 78, 54, 0.05);
  }

  /* -- Quick nav -- */
  .e404-nav {
    border-top: 1px solid #ddd4c0;
    padding-top: 1.5rem;
  }

  .e404-nav-label {
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #b0a690;
    margin-bottom: 0.85rem;
  }

  .e404-nav-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .e404-nav-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.65rem 0;
    font-size: 0.855rem;
    font-weight: 600;
    color: #3d4e36;
    text-decoration: none;
    border-bottom: 1px solid #ece6d8;
    transition: color 0.15s ease, padding-left 0.15s ease;
  }

  .e404-nav-link:last-child {
    border-bottom: none;
  }

  .e404-nav-link:hover {
    color: #2E0C15;
    padding-left: 4px;
  }

  .e404-nav-link svg {
    width: 14px;
    height: 14px;
    flex-shrink: 0;
    opacity: 0.5;
    transition: transform 0.15s ease, opacity 0.15s ease;
  }

  .e404-nav-link:hover svg {
    opacity: 1;
    transform: translateX(2px);
  }

  .e404-nav-link--wa {
    color: #1a6a3a;
  }

  /* --------------------------------------------------------------------------`n        Right column: botanical visual`n   -------------------------------------------------------------------------- */
  .e404-right {
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, #FAF0F1 0%, #F6E3E1 100%);
    padding: 3rem;
  }

  .e404-visual {
    position: relative;
    width: min(400px, 80%);
    aspect-ratio: 1 / 1;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* Layered circles */
  .e404-circle {
    position: absolute;
    border-radius: 50%;
  }

  .e404-circle--outer {
    inset: 0;
    border: 1.5px solid rgba(138, 171, 110, 0.16);
    background: rgba(245, 240, 230, 0.5);
  }

  .e404-circle--mid {
    inset: 12%;
    border: 1px solid rgba(138, 171, 110, 0.12);
    background: rgba(250, 246, 240, 0.6);
  }

  .e404-circle--inner {
    inset: 26%;
    background: rgba(255, 252, 248, 0.9);
    border: 1px solid rgba(210, 195, 172, 0.3);
  }

  .e404-botanical {
    position: relative;
    z-index: 1;
    width: 52%;
    height: auto;
    filter: drop-shadow(0 8px 24px rgba(60, 50, 30, 0.12));
  }

  /* --------------------------------------------------------------------------`n        Responsive`n   -------------------------------------------------------------------------- */
  @media (max-width: 900px) {
    .e404-root {
      grid-template-columns: 1fr;
      min-height: auto;
    }

    .e404-right {
      display: none; /* hide illustration on smaller screens */
    }

    .e404-left {
      border-right: none;
      border-bottom: 1px solid #F6E3E1;
      padding: 4rem 1.5rem 4rem;
      align-items: flex-start;
    }

    .e404-num {
      font-size: clamp(8rem, 30vw, 12rem);
    }
  }

  @media (max-width: 480px) {
    .e404-left {
      padding: 3rem 1.25rem 3.5rem;
    }

    .e404-actions {
      flex-direction: column;
    }

    .e404-btn {
      justify-content: center;
    }
  }
</style>
