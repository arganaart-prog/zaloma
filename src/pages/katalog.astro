---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { CATEGORIES, PRODUCTS } from '../data/products';
import { getProductDisplayName } from '../utils/productHelpers';
import { SUPABASE_URL, SUPABASE_ANON_KEY } from '../data/supabaseConfig';
import { WHATSAPP_NUMBER } from '../data/constants';

// SEO Meta
const title = "Katalog Karangan Bunga Zaloma Florist — Toko Bunga Malang";
const description = "Bunga papan, hand bouquet, standing flower, dan tanaman ucapan di Malang. Pengerjaan 3 jam, difoto sebelum dikirim. Pilih model dan pesan via WhatsApp.";
---

<Layout title={title} description={description}>
  <!-- Supabase SDK for loading live cloud products -->
  <script is:inline src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    
    <!-- Breadcrumb -->
    <Breadcrumb items={[{ label: 'Katalog Produk' }]} />

    <!-- Page Header -->
    <div class="text-center max-w-2xl mx-auto mt-6 mb-12">
      <h1 class="font-serif text-3xl sm:text-4xl font-bold text-slate-800">Katalog Karangan Bunga &amp; Tanaman Malang</h1>
      <p class="text-slate-500 text-sm mt-3 leading-relaxed">
        Pilihan karangan bunga papan, buket, standing flower, bunga meja, dan tanaman ucapan. Pilih model yang Anda butuhkan dan konfirmasikan via WhatsApp; pesanan selalu kami fotokan sebelum diantar ke lokasi.
      </p>
    </div>

    <!-- Filter Buttons (Client-side interactivity) -->
    <div class="flex flex-wrap justify-center gap-2 mb-10" id="filter-container">
      <button 
        type="button"
        data-filter="all"
        class="filter-btn px-4 py-2 text-xs font-semibold rounded-full border border-primary bg-primary text-white transition-colors duration-200 cursor-pointer shadow-xs"
      >
        Semua Kategori
      </button>
      
      {CATEGORIES.map(category => (
        <button
          type="button"
          data-filter={category.slug}
          class="filter-btn px-4 py-2 text-xs font-semibold rounded-full border border-soft-cream bg-white text-slate-600 hover:border-primary hover:text-primary transition-colors duration-200 cursor-pointer shadow-xs"
        >
          {category.name}
        </button>
      ))}
    </div>

    <!-- Products Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8" id="products-grid">
      {PRODUCTS.map((product, index) => (
        <div 
          class="product-item-wrapper" 
          data-category={product.categorySlug}
          data-name={getProductDisplayName(product).toLowerCase()}
          data-description={product.description.toLowerCase()}
        >
          <ProductCard product={product} priority={index < 3} />
        </div>
      ))}
    </div>
    
    <!-- Empty State -->
    <div id="empty-state" class="hidden text-center py-20 space-y-4">
      <svg class="h-16 w-16 text-slate-300 mx-auto" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 15a4.5 4.5 0 004.5 4.5H18a3.75 3.75 0 001.332-7.257 3 3 0 115.314-3.078 5.625 5.625 0 01-5.6 5.6H6.75A4.5 4.5 0 002.25 15z" />
      </svg>
      <h3 class="font-serif font-bold text-lg text-slate-700">Produk Tidak Ditemukan</h3>
      <p class="text-sm text-slate-500 max-w-sm mx-auto">Tidak ada produk yang cocok dengan kata kunci pencarian. Silakan coba kata kunci lain seperti &ldquo;duka cita&rdquo;, &ldquo;wedding&rdquo;, atau pilih salah satu kategori di atas.</p>
    </div>

  </div>
</Layout>

<script define:vars={{ SUPABASE_URL, SUPABASE_ANON_KEY, WHATSAPP_NUMBER }}>
  // Filter & Search Logic
  const buttons = document.querySelectorAll('.filter-btn');
  const emptyState = document.getElementById('empty-state');

  // Read URL query parameters
  const urlParams = new URLSearchParams(window.location.search);
  const searchParam = (urlParams.get('search') || '').toLowerCase().slice(0, 80);

  // Store active filters state
  let currentCategory = 'all';
  let currentSearch = searchParam;

  // Sync navbar search fields and listen for live input
  const searchInputs = document.querySelectorAll('.search-input-field');
  searchInputs.forEach(input => {
    if (input instanceof HTMLInputElement) {
      input.value = currentSearch;

      input.addEventListener('input', (e) => {
        const target = e.target;
        currentSearch = target.value.toLowerCase().slice(0, 80);
        
        // Sync all other search inputs
        searchInputs.forEach(otherInput => {
          if (otherInput !== target && otherInput instanceof HTMLInputElement) {
            otherInput.value = target.value;
          }
        });

        // Update URL query string without reloading page
        const newUrl = new URL(window.location.href);
        if (currentSearch) {
          newUrl.searchParams.set('search', currentSearch);
        } else {
          newUrl.searchParams.delete('search');
        }
        window.history.replaceState({}, '', newUrl.toString());

        applyFilters();
      });
    }
  });

  // Intercept search forms to prevent full reload on katalog page
  const searchForms = document.querySelectorAll('form[action$="/katalog/"]');
  searchForms.forEach(form => {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      applyFilters();
    });
  });

  function applyFilters() {
    let visibleCount = 0;
    // Query dynamically so both static and newly injected cloud products are filtered
    const currentItems = document.querySelectorAll('.product-item-wrapper');

    currentItems.forEach(item => {
      if (!(item instanceof HTMLElement)) return;

      const itemCategory = item.getAttribute('data-category') || '';
      const itemName = item.getAttribute('data-name') || '';
      const itemDesc = item.getAttribute('data-description') || '';

      const matchesCategory = currentCategory === 'all' || itemCategory === currentCategory;
      const matchesSearch = currentSearch === '' || 
                            itemName.includes(currentSearch) || 
                            itemDesc.includes(currentSearch);

      if (matchesCategory && matchesSearch) {
        item.classList.remove('hidden');
        visibleCount++;
      } else {
        item.classList.add('hidden');
      }
    });

    // Show empty state if no matching products
    if (emptyState) {
      if (visibleCount === 0) {
        emptyState.classList.remove('hidden');
      } else {
        emptyState.classList.add('hidden');
      }
    }
  }

  // Initial Run
  applyFilters();

  // Category filter buttons click handlers
  buttons.forEach(button => {
    button.addEventListener('click', () => {
      // 1. Update button styling
      buttons.forEach(btn => {
        btn.classList.remove('bg-primary', 'text-white', 'border-primary');
        btn.classList.add('bg-white', 'text-slate-600', 'border-soft-cream');
      });
      button.classList.remove('bg-white', 'text-slate-600', 'border-soft-cream');
      button.classList.add('bg-primary', 'text-white', 'border-primary');

      // 2. Set new category filter
      currentCategory = button.getAttribute('data-filter') || 'all';

      // 3. Apply changes
      applyFilters();
    });
  });

  // Fetch live products from Supabase Cloud
  async function loadCloudProducts() {
    try {
      if (!window.supabase) return;
      const client = window.supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY);

      const { data: cloudProducts, error } = await client
        .from('products')
        .select('*')
        .order('created_at', { ascending: false });

      if (error || !cloudProducts || cloudProducts.length === 0) return;

      const grid = document.getElementById('products-grid');
      if (!grid) return;

      // Insert cloud products at the top of the grid
      cloudProducts.forEach((p) => {
        const waMsg = `Halo Zaloma Florist, saya ingin pesan ${p.name} (${p.price_label}).`;
        const waUrl = `https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent(waMsg)}`;

        const wrapper = document.createElement('div');
        wrapper.className = 'product-item-wrapper';
        wrapper.setAttribute('data-category', p.category_slug);
        wrapper.setAttribute('data-name', (p.name || '').toLowerCase());
        wrapper.setAttribute('data-description', (p.description || '').toLowerCase());

        wrapper.innerHTML = `
          <article class="product-card-shell group relative h-full overflow-hidden rounded-[14px] border border-soft-cream/70 bg-white shadow-[0_1px_4px_rgba(15,23,42,0.03)] hover-gold-grow">
            <a href="${waUrl}" target="_blank" rel="noopener noreferrer" class="flex h-full flex-col no-underline">
              <div class="image-load-shell relative -mx-px -mt-px aspect-[20/19] overflow-hidden bg-clean-ivory">
                <img
                  src="${p.image}"
                  alt="Foto ${p.name} Florist Malang"
                  loading="lazy"
                  decoding="async"
                  class="relative z-0 block h-full w-full object-cover object-top transition-transform duration-700 ease-out group-hover:scale-[1.012]"
                />
                ${p.featured ? '<span class="absolute top-2.5 left-2.5 z-10 rounded-sm bg-secondary px-2 py-0.5 text-[9px] font-bold uppercase tracking-wider text-primary-dark shadow-xs">Populer</span>' : ''}
                <div class="pointer-events-none absolute inset-x-0 bottom-0 z-10 h-20 bg-gradient-to-t from-primary-dark/35 via-primary-dark/5 to-transparent"></div>
                <span class="absolute bottom-3 right-3 z-10 inline-flex h-9 w-9 items-center justify-center rounded-full bg-white/95 text-primary shadow-[0_2px_8px_rgba(15,23,42,0.08)] transition-all duration-200 group-hover:bg-primary group-hover:text-white" aria-hidden="true">
                  <svg width="16" height="16" class="h-4 w-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.4">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M7 17L17 7M9 7h8v8" />
                  </svg>
                </span>
              </div>

              <div class="flex min-h-[190px] sm:min-h-[200px] flex-col justify-between p-4.5 sm:p-5">
                <div>
                  <p class="line-clamp-1 text-[10px] font-bold uppercase tracking-[0.18em] text-secondary-dark">${p.category_name}</p>
                  <h3 class="mt-1.5 font-serif font-bold leading-snug text-slate-800 line-clamp-2 transition-colors duration-200 group-hover:text-primary text-base sm:text-lg">
                    ${p.name}
                  </h3>
                </div>

                <div class="pt-3 sm:pt-4">
                  <div class="rounded-md border border-soft-cream/70 bg-accent-bg/70 p-2.5 sm:p-3">
                    <p class="text-[10px] font-bold uppercase tracking-[0.18em] text-secondary-dark">Harga</p>
                    <div class="mt-1.5 flex items-end justify-between gap-2.5 sm:gap-3">
                      <p class="font-sans text-lg sm:text-xl font-extrabold leading-none text-primary">${p.price_label}</p>
                      <span class="inline-flex shrink-0 items-center gap-1.5 rounded-full bg-primary px-3 py-1.5 sm:px-3.5 sm:py-2 text-[11px] font-bold text-white shadow-xs transition-colors duration-200 group-hover:bg-primary-dark">
                        Pesan WA
                        <svg width="14" height="14" class="h-3.5 w-3.5 shrink-0 transition-transform duration-200 group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.6" aria-hidden="true">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                        </svg>
                      </span>
                    </div>
                  </div>
                </div>
              </div>
            </a>
          </article>
        `;

        grid.prepend(wrapper);
      });

      // Update filtering to account for new cards
      applyFilters();

    } catch (err) {
      console.warn('Gagal memuat produk cloud:', err);
    }
  }

  loadCloudProducts();
</script>


