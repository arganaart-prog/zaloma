---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { CATEGORIES, PRODUCTS } from '../data/products';
import { getProductDisplayName } from '../utils/productHelpers';
import { SUPABASE_URL, SUPABASE_ANON_KEY } from '../data/supabaseConfig';
import { WHATSAPP_NUMBER } from '../data/constants';

// SEO Meta
const title = "Katalog Karangan Bunga Zaloma Florist — Toko Bunga Malang";
const description = "Bunga papan, hand bouquet, standing flower, dan tanaman ucapan di Malang. Pengerjaan 3 jam, difoto sebelum dikirim. Pilih model dan pesan via WhatsApp.";

const INITIAL_SLUGS = PRODUCTS.map(p => p.slug);
---

<Layout title={title} description={description}>
  <!-- Supabase SDK for loading live cloud products -->
  <script is:inline src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    
    <!-- Breadcrumb -->
    <Breadcrumb items={[{ label: 'Katalog Produk' }]} />

    <!-- Page Header -->
    <div class="text-center max-w-2xl mx-auto mt-6 mb-12">
      <h1 class="font-serif text-3xl sm:text-4xl font-bold text-slate-800">Katalog Karangan Bunga &amp; Tanaman Malang</h1>
      <p class="text-slate-500 text-sm mt-3 leading-relaxed">
        Pilihan karangan bunga papan, buket, standing flower, bunga meja, dan tanaman ucapan. Pilih model yang Anda butuhkan dan konfirmasikan via WhatsApp; pesanan selalu kami fotokan sebelum diantar ke lokasi.
      </p>
    </div>

    <!-- Filter Buttons (Client-side interactivity) -->
    <div class="flex flex-wrap justify-center gap-2 mb-10" id="filter-container">
      <button 
        type="button"
        data-filter="all"
        class="filter-btn px-4 py-2 text-xs font-semibold rounded-full border border-primary bg-primary text-white transition-colors duration-200 cursor-pointer shadow-xs"
      >
        Semua Kategori
      </button>
      
      {CATEGORIES.map(category => (
        <button
          type="button"
          data-filter={category.slug}
          class="filter-btn px-4 py-2 text-xs font-semibold rounded-full border border-soft-cream bg-white text-slate-600 hover:border-primary hover:text-primary transition-colors duration-200 cursor-pointer shadow-xs"
        >
          {category.name}
        </button>
      ))}
    </div>

    <!-- Products Grid (100% Live dari Supabase) -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8" id="products-grid">
      <div class="col-span-full py-24 text-center" id="catalog-loading">
        <svg class="w-10 h-10 animate-spin text-primary mx-auto mb-3" fill="none" viewBox="0 0 24 24">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
        </svg>
        <p class="text-sm font-semibold text-slate-500">Memuat seluruh katalog produk...</p>
      </div>
    </div>

    <!-- Pagination Container -->
    <div id="pagination-container" class="mt-14 flex flex-col sm:flex-row items-center justify-between gap-4 border-t border-soft-cream/80 pt-6">
      <p id="pagination-info" class="text-xs text-slate-500 font-medium">
        Menampilkan <span id="pag-start" class="font-bold text-slate-700">0</span> - <span id="pag-end" class="font-bold text-slate-700">0</span> dari <span id="pag-total" class="font-bold text-slate-700">0</span> produk
      </p>
      <div class="flex items-center gap-1.5" id="pagination-controls">
        <!-- Rendered by JS -->
      </div>
    </div>
    
    <!-- Empty State -->
    <div id="empty-state" class="hidden text-center py-20 space-y-4">
      <svg class="h-16 w-16 text-slate-300 mx-auto" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 15a4.5 4.5 0 004.5 4.5H18a3.75 3.75 0 001.332-7.257 3 3 0 115.314-3.078 5.625 5.625 0 01-5.6 5.6H6.75A4.5 4.5 0 002.25 15z" />
      </svg>
      <h3 class="font-serif font-bold text-lg text-slate-700">Produk Tidak Ditemukan</h3>
      <p class="text-sm text-slate-500 max-w-sm mx-auto">Tidak ada produk yang cocok dengan kata kunci pencarian. Silakan coba kata kunci lain seperti &ldquo;duka cita&rdquo;, &ldquo;wedding&rdquo;, atau pilih salah satu kategori di atas.</p>
    </div>

  </div>
</Layout>

<script define:vars={{ SUPABASE_URL, SUPABASE_ANON_KEY, WHATSAPP_NUMBER, INITIAL_SLUGS }}>
  // Filter & Search Logic
  const buttons = document.querySelectorAll('.filter-btn');
  const emptyState = document.getElementById('empty-state');
  const initialSlugs = new Set(INITIAL_SLUGS || []);

  // Read URL query parameters
  const urlParams = new URLSearchParams(window.location.search);
  const searchParam = (urlParams.get('search') || '').toLowerCase().slice(0, 80);

  // Store active filters state
  let currentCategory = 'all';
  let currentSearch = searchParam;

  // Pagination Settings
  const ITEMS_PER_PAGE = 12;
  let currentPage = 1;

  const paginationContainer = document.getElementById('pagination-container');
  const pagStartEl = document.getElementById('pag-start');
  const pagEndEl = document.getElementById('pag-end');
  const pagTotalEl = document.getElementById('pag-total');
  const pagControls = document.getElementById('pagination-controls');

  // Sync navbar search fields and listen for live input
  const searchInputs = document.querySelectorAll('.search-input-field');
  searchInputs.forEach(input => {
    if (input instanceof HTMLInputElement) {
      input.value = currentSearch;

      input.addEventListener('input', (e) => {
        const target = e.target;
        currentSearch = target.value.toLowerCase().slice(0, 80);
        
        // Sync all other search inputs
        searchInputs.forEach(otherInput => {
          if (otherInput !== target && otherInput instanceof HTMLInputElement) {
            otherInput.value = target.value;
          }
        });

        // Update URL query string without reloading page
        const newUrl = new URL(window.location.href);
        if (currentSearch) {
          newUrl.searchParams.set('search', currentSearch);
        } else {
          newUrl.searchParams.delete('search');
        }
        window.history.replaceState({}, '', newUrl.toString());

        applyFilters(true);
      });
    }
  });

  // Intercept search forms to prevent full reload on katalog page
  const searchForms = document.querySelectorAll('form[action$="/katalog/"]');
  searchForms.forEach(form => {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      applyFilters(true);
    });
  });

  function applyFilters(resetPage = false) {
    if (resetPage) currentPage = 1;

    const currentItems = document.querySelectorAll('.product-item-wrapper');
    const matchedItems = [];

    currentItems.forEach(item => {
      if (!(item instanceof HTMLElement)) return;

      const itemCategory = item.getAttribute('data-category') || '';
      const itemName = item.getAttribute('data-name') || '';
      const itemDesc = item.getAttribute('data-description') || '';

      const matchesCategory = currentCategory === 'all' || itemCategory === currentCategory;
      const matchesSearch = currentSearch === '' || 
                            itemName.includes(currentSearch) || 
                            itemDesc.includes(currentSearch);

      if (matchesCategory && matchesSearch) {
        matchedItems.push(item);
      } else {
        item.classList.add('hidden');
      }
    });

    const totalMatched = matchedItems.length;
    const totalPages = Math.ceil(totalMatched / ITEMS_PER_PAGE) || 1;
    if (currentPage > totalPages) currentPage = totalPages;

    // Show only the slice of products for the active page
    matchedItems.forEach((item, idx) => {
      const pageIndex = Math.floor(idx / ITEMS_PER_PAGE) + 1;
      if (pageIndex === currentPage) {
        item.classList.remove('hidden');
      } else {
        item.classList.add('hidden');
      }
    });

    // Handle Empty State & Pagination controls
    if (totalMatched === 0) {
      if (emptyState) emptyState.classList.remove('hidden');
      if (paginationContainer) paginationContainer.classList.add('hidden');
    } else {
      if (emptyState) emptyState.classList.add('hidden');
      if (paginationContainer) paginationContainer.classList.remove('hidden');

      const startIdx = (currentPage - 1) * ITEMS_PER_PAGE + 1;
      const endIdx = Math.min(currentPage * ITEMS_PER_PAGE, totalMatched);
      if (pagStartEl) pagStartEl.textContent = startIdx;
      if (pagEndEl) pagEndEl.textContent = endIdx;
      if (pagTotalEl) pagTotalEl.textContent = totalMatched;

      renderPaginationControls(totalPages);
    }
  }

  function renderPaginationControls(totalPages) {
    if (!pagControls) return;

    if (totalPages <= 1) {
      pagControls.innerHTML = '';
      return;
    }

    let html = `
      <button 
        type="button" 
        class="pag-nav-btn prev-btn inline-flex items-center justify-center w-8 h-8 rounded-lg border border-slate-200 text-xs font-bold transition-all ${currentPage === 1 ? 'opacity-40 cursor-not-allowed bg-slate-50 text-slate-300' : 'cursor-pointer hover:border-primary hover:text-primary text-slate-700 bg-white shadow-2xs'}"
        ${currentPage === 1 ? 'disabled' : ''}
        aria-label="Halaman Sebelumnya"
      >
        ‹
      </button>
    `;

    for (let p = 1; p <= totalPages; p++) {
      if (p === 1 || p === totalPages || (p >= currentPage - 1 && p <= currentPage + 1)) {
        const isActive = p === currentPage;
        html += `
          <button 
            type="button" 
            data-page="${p}" 
            class="pag-num-btn inline-flex items-center justify-center w-8 h-8 rounded-lg text-xs font-bold transition-all cursor-pointer ${isActive ? 'bg-primary text-white shadow-xs' : 'border border-slate-200 text-slate-700 bg-white hover:border-primary hover:text-primary shadow-2xs'}"
          >
            ${p}
          </button>
        `;
      } else if (p === currentPage - 2 || p === currentPage + 2) {
        html += `<span class="px-1 text-slate-400 text-xs font-bold">...</span>`;
      }
    }

    html += `
      <button 
        type="button" 
        class="pag-nav-btn next-btn inline-flex items-center justify-center w-8 h-8 rounded-lg border border-slate-200 text-xs font-bold transition-all ${currentPage === totalPages ? 'opacity-40 cursor-not-allowed bg-slate-50 text-slate-300' : 'cursor-pointer hover:border-primary hover:text-primary text-slate-700 bg-white shadow-2xs'}"
        ${currentPage === totalPages ? 'disabled' : ''}
        aria-label="Halaman Selanjutnya"
      >
        ›
      </button>
    `;

    pagControls.innerHTML = html;

    // Attach pagination button handlers
    pagControls.querySelectorAll('.pag-num-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const targetPage = Number(btn.getAttribute('data-page'));
        if (targetPage && targetPage !== currentPage) {
          currentPage = targetPage;
          applyFilters(false);
          document.getElementById('products-grid')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      });
    });

    pagControls.querySelector('.prev-btn')?.addEventListener('click', () => {
      if (currentPage > 1) {
        currentPage--;
        applyFilters(false);
        document.getElementById('products-grid')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    });

    pagControls.querySelector('.next-btn')?.addEventListener('click', () => {
      if (currentPage < totalPages) {
        currentPage++;
        applyFilters(false);
        document.getElementById('products-grid')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    });
  }

  // Initial Run
  applyFilters();

  // Category filter buttons click handlers
  buttons.forEach(button => {
    button.addEventListener('click', () => {
      // 1. Update button styling
      buttons.forEach(btn => {
        btn.classList.remove('bg-primary', 'text-white', 'border-primary');
        btn.classList.add('bg-white', 'text-slate-600', 'border-soft-cream');
      });
      button.classList.remove('bg-white', 'text-slate-600', 'border-soft-cream');
      button.classList.add('bg-primary', 'text-white', 'border-primary');

      // 2. Set new category filter
      currentCategory = button.getAttribute('data-filter') || 'all';

      // 3. Apply changes and reset to page 1
      applyFilters(true);
    });
  });

  // Fetch live products from Supabase Cloud
  async function loadCloudProducts() {
    try {
      if (!window.supabase) {
        console.warn('[Zaloma Florist] Supabase JS SDK belum siap.');
        return;
      }
      const client = window.supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY);

      const { data: cloudProducts, error } = await client
        .from('products')
        .select('*')
        .order('created_at', { ascending: false });

      if (error) {
        console.error('[Zaloma Supabase Error]:', error.message || error);
        console.warn('[Zaloma Info] Pastikan RLS (Row Level Security) tabel "products" di Supabase mengizinkan SELECT untuk publik (anon).');
        return;
      }

      // Jika di Supabase belum ada data (0 produk), tetap tampilkan katalog default bawaan
      if (!cloudProducts || cloudProducts.length === 0) {
        console.info('[Zaloma] Tabel Supabase masih kosong. Menampilkan katalog lokal bawaan.');
        return;
      }

      const grid = document.getElementById('products-grid');
      if (!grid) return;

      // Bersihkan kartu bawaan dan jadikan data Supabase sebagai Single Source of Truth
      // Setiap produk yang dihapus di Supabase otomatis HILANG dari website,
      // produk baru seketika MUNCUL, dan editan harga/nama langsung TERUPDATE.
      grid.innerHTML = '';

      cloudProducts.forEach((p, index) => {
        const isStatic = initialSlugs.has(p.slug);
        const productUrl = isStatic 
          ? `/produk/${p.slug}/` 
          : `https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent(`Halo Zaloma Florist, saya ingin pesan ${p.name} (${p.price_label}).`)}`;
        const buttonLabel = isStatic ? 'Detail' : 'Pesan WA';
        const targetAttr = isStatic ? '' : 'target="_blank" rel="noopener noreferrer"';

        const wrapper = document.createElement('div');
        wrapper.className = 'product-item-wrapper';
        wrapper.setAttribute('data-category', p.category_slug || '');
        wrapper.setAttribute('data-name', (p.name || '').toLowerCase());
        wrapper.setAttribute('data-description', (p.description || '').toLowerCase());

        wrapper.innerHTML = `
          <article class="product-card-shell group relative h-full overflow-hidden rounded-[14px] border border-soft-cream/70 bg-white shadow-[0_1px_4px_rgba(15,23,42,0.03)] hover-gold-grow">
            <a href="${productUrl}" ${targetAttr} class="flex h-full flex-col no-underline">
              <div class="image-load-shell relative -mx-px -mt-px aspect-[20/19] overflow-hidden bg-clean-ivory">
                <img
                  src="${p.image}"
                  alt="Foto ${p.name} Florist Malang"
                  loading="${index < 3 ? 'eager' : 'lazy'}"
                  decoding="async"
                  class="relative z-0 block h-full w-full object-cover object-top transition-transform duration-700 ease-out group-hover:scale-[1.012]"
                />
                ${p.featured ? '<span class="absolute top-2.5 left-2.5 z-10 rounded-sm bg-secondary px-2 py-0.5 text-[9px] font-bold uppercase tracking-wider text-primary-dark shadow-xs">Populer</span>' : ''}
                <div class="pointer-events-none absolute inset-x-0 bottom-0 z-10 h-20 bg-gradient-to-t from-primary-dark/35 via-primary-dark/5 to-transparent"></div>
                <span class="absolute bottom-3 right-3 z-10 inline-flex h-9 w-9 items-center justify-center rounded-full bg-white/95 text-primary shadow-[0_2px_8px_rgba(15,23,42,0.08)] transition-all duration-200 group-hover:bg-primary group-hover:text-white" aria-hidden="true">
                  <svg width="16" height="16" class="h-4 w-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.4">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M7 17L17 7M9 7h8v8" />
                  </svg>
                </span>
              </div>

              <div class="flex min-h-[190px] sm:min-h-[200px] flex-col justify-between p-4.5 sm:p-5">
                <div>
                  <p class="line-clamp-1 text-[10px] font-bold uppercase tracking-[0.18em] text-secondary-dark">${p.category_name || ''}</p>
                  <h3 class="mt-1.5 font-serif font-bold leading-snug text-slate-800 line-clamp-2 transition-colors duration-200 group-hover:text-primary text-base sm:text-lg">
                    ${p.name}
                  </h3>
                </div>

                <div class="pt-3 sm:pt-4">
                  <div class="rounded-md border border-soft-cream/70 bg-accent-bg/70 p-2.5 sm:p-3">
                    <p class="text-[10px] font-bold uppercase tracking-[0.18em] text-secondary-dark">Harga</p>
                    <div class="mt-1.5 flex items-end justify-between gap-2.5 sm:gap-3">
                      <p class="font-sans text-lg sm:text-xl font-extrabold leading-none text-primary">${p.price_label}</p>
                      <span class="inline-flex shrink-0 items-center gap-1.5 rounded-full bg-primary px-3 py-1.5 sm:px-3.5 sm:py-2 text-[11px] font-bold text-white shadow-xs transition-colors duration-200 group-hover:bg-primary-dark">
                        ${buttonLabel}
                        <svg width="14" height="14" class="h-3.5 w-3.5 shrink-0 transition-transform duration-200 group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.6" aria-hidden="true">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                        </svg>
                      </span>
                    </div>
                  </div>
                </div>
              </div>
            </a>
          </article>
        `;

        grid.appendChild(wrapper);
      });

      // Terapkan ulang filter & paginasi untuk produk live
      applyFilters(true);

    } catch (err) {
      console.warn('Gagal memuat produk cloud:', err);
    }
  }

  loadCloudProducts();
</script>


