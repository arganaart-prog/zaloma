---
import '../styles/global.css';
import SEOHead from '../components/SEOHead.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import Testimonials from '../components/Testimonials.astro';
import CustomerGallery from '../components/CustomerGallery.astro';
import FloatingWhatsApp from '../components/FloatingWhatsApp.astro';
import SeoInfoStrip from '../components/SeoInfoStrip.astro';
import { withBase } from '../utils/paths';
import { SITE_DOMAIN, WHATSAPP_NUMBER, INSTAGRAM_URL } from '../data/constants';
import { SUPABASE_ANON_KEY, SUPABASE_URL } from '../data/supabaseConfig';

interface Props {
  title: string;
  description: string;
  keywords?: string;
  image?: string;
  type?: 'website' | 'product';
  schema?: Record<string, any>;
  robots?: string;
  canonical?: string;
  showTestimonials?: boolean;
}

const { title, description, keywords, image, type = 'website', schema, robots, canonical, showTestimonials = true } = Astro.props;

// Default business schema; location landing pages provide their own local SEO.
const defaultSchema = {
  "@context": "https://schema.org",
  "@type": "Florist",
  "name": "Zaloma Florist",
  "alternateName": ["Zaloma Florist", "Toko Bunga Profesional Zaloma Florist"],
  "description": "Zaloma Florist adalah toko bunga profesional untuk bunga papan, standing flower, hand bouquet, dan rangkaian bunga segar dengan layanan cepat.",
  "slogan": "Florist Profesional dan Terbaik untuk Setiap Momen",
  "image": `${SITE_DOMAIN}/images/logo/zaloma-logo.webp`,
  "logo": `${SITE_DOMAIN}/favicon-192.png`,
  "@id": `${SITE_DOMAIN}/#florist`,
  "url": SITE_DOMAIN,
  "telephone": `+${WHATSAPP_NUMBER}`,
  "priceRange": "Rp 250.000 - Rp 1.500.000",
  "areaServed": [
    { "@type": "City", "name": "Kota Malang" },
    { "@type": "AdministrativeArea", "name": "Kabupaten Malang" },
    { "@type": "City", "name": "Kota Batu" }
  ],
  "keywords": "Zaloma Florist, florist profesional, toko bunga terpercaya, bunga papan, standing flower, hand bouquet, rangkaian bunga segar",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Kota Malang, Jawa Timur",
    "addressLocality": "Malang",
    "addressRegion": "Jawa Timur",
    "postalCode": "65100",
    "addressCountry": "ID"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": -7.96662,
    "longitude": 112.63263
  },
  "openingHoursSpecification": {
    "@type": "OpeningHoursSpecification",
    "dayOfWeek": [
      "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"
    ],
    "opens": "00:00",
    "closes": "23:59"
  },
  "sameAs": [
    INSTAGRAM_URL
  ],
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Katalog bunga profesional dan terbaik Zaloma Florist",
    "itemListElement": [
      { "@type": "OfferCatalog", "name": "Bunga papan Malang" },
      { "@type": "OfferCatalog", "name": "Standing flower Malang" },
      { "@type": "OfferCatalog", "name": "Hand bouquet Malang" },
      { "@type": "OfferCatalog", "name": "Bunga meja Malang" },
      { "@type": "OfferCatalog", "name": "Tanbulampot & pohon ucapan tanaman Malang" }
    ]
  }
};

const finalSchema = schema || defaultSchema;
---

<!doctype html>
<html lang="id">
  <head>
    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-BK1L7D9N5D"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-BK1L7D9N5D');
    </script>

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/x-icon" href={withBase('/favicon.ico')} />
    <link rel="shortcut icon" type="image/x-icon" href={withBase('/favicon.ico')} />
    <link rel="icon" type="image/png" sizes="48x48" href={withBase('/favicon-48.png')} />
    <link rel="icon" type="image/png" sizes="96x96" href={withBase('/favicon-96.png')} />
    <link rel="icon" type="image/png" sizes="192x192" href={withBase('/favicon-192.png')} />
    <link rel="apple-touch-icon" sizes="180x180" href={withBase('/apple-touch-icon.png')} />
    <link rel="manifest" href={withBase('/site.webmanifest')} />
    <meta name="generator" content={Astro.generator} />

    <SEOHead
      title={title}
      description={description}
      keywords={keywords}
      image={image}
      type={type}
      schema={finalSchema}
      robots={robots}
      canonical={canonical}
    />
    <!-- Critical Anti-FOUC CSS: guarantees SVGs and icons remain strictly bounded on hard refresh before external styles finish parsing -->
    <style is:inline>
      svg {
        box-sizing: border-box;
        max-width: 100%;
        vertical-align: middle;
      }
      /* Pre-apply common utility sizes immediately upon first paint */
      svg.h-3, svg.w-3 { width: 0.75rem !important; height: 0.75rem !important; }
      svg.h-3\.5, svg.w-3\.5 { width: 0.875rem !important; height: 0.875rem !important; }
      svg.h-4, svg.w-4 { width: 1rem !important; height: 1rem !important; }
      svg.h-5, svg.w-5 { width: 1.25rem !important; height: 1.25rem !important; }
      svg.h-6, svg.w-6 { width: 1.5rem !important; height: 1.5rem !important; }
      svg.h-7, svg.w-7 { width: 1.75rem !important; height: 1.75rem !important; }
      svg.h-8, svg.w-8 { width: 2rem !important; height: 2rem !important; }
      svg.h-9, svg.w-9 { width: 2.25rem !important; height: 2.25rem !important; }
      svg.h-10, svg.w-10 { width: 2.5rem !important; height: 2.5rem !important; }
      svg.h-12, svg.w-12 { width: 3rem !important; height: 3rem !important; }
      svg.h-16, svg.w-16 { width: 4rem !important; height: 4rem !important; }

      /* Safe bounds for standalone button and link icons */
      a > svg:not([width]):not(#logo-shield svg):not(#mobile-logo-shield svg):not(.brand-shield svg),
      button > svg:not([width]):not(#logo-shield svg):not(#mobile-logo-shield svg):not(.brand-shield svg) {
        max-width: 1.5rem;
        max-height: 1.5rem;
      }

      /* Keep brand logo shield stable */
      #logo-shield svg,
      #mobile-logo-shield svg,
      .brand-shield svg {
        width: 100% !important;
        height: 100% !important;
      }
    </style>
    <noscript>
      <style>
        [data-image-loader] { opacity: 1 !important; transform: none !important; }
        .image-skeleton { display: none !important; }
      </style>
    </noscript>
    <slot name="head" />
  </head>
  <body class="flex flex-col min-h-screen bg-clean-ivory text-slate-800">
    <Navbar />
    <main class="flex-grow">
      <slot />
    </main>
    {showTestimonials && <Testimonials />}
    {showTestimonials && <CustomerGallery />}
    <SeoInfoStrip />
    <Footer />
    <FloatingWhatsApp />
    <script define:vars={{ SUPABASE_URL, SUPABASE_ANON_KEY }}>
      document.addEventListener('click', function(event) {
        const target = event.target instanceof Element ? event.target.closest('a[href*="/produk/"]') : null;
        if (!(target instanceof HTMLAnchorElement)) return;
        const slug = target.href.match(/\/produk\/([^/?#]+)/)?.[1];
        if (!slug) return;

        fetch(`${SUPABASE_URL}/rest/v1/rpc/record_product_click`, {
          method: 'POST',
          headers: { apikey: SUPABASE_ANON_KEY, 'Content-Type': 'application/json' },
          body: JSON.stringify({ p_product_slug: decodeURIComponent(slug) }),
          keepalive: true,
        }).then(async function(response) {
          if (!response.ok) {
            console.error('[Zaloma] Gagal mencatat klik produk:', await response.text());
          }
        }).catch(function(error) {
          console.error('[Zaloma] Gagal mengirim catatan klik produk:', error);
        });
      }, true);

      function initImageLoaders() {
        document.querySelectorAll('[data-image-loader]').forEach(function(image) {
          if (!(image instanceof HTMLImageElement)) return;
          var frame = image.closest('[data-image-frame]');
          if (!frame) return;

          /** @param {string} className */
          function markReady(className) {
            frame.classList.remove('is-loading');
            frame.classList.add(className);
          }

          frame.classList.add('is-loading');

          if (image.complete && image.naturalWidth > 0) {
            markReady('is-loaded');
            return;
          }

          image.addEventListener('load', function() {
            markReady('is-loaded');
          }, { once: true });

          image.addEventListener('error', function() {
            markReady('is-error');
          }, { once: true });
        });
      }

      initImageLoaders();
      document.addEventListener('astro:page-load', initImageLoaders);
    </script>
  </body>
</html>
